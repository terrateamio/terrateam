(library
 (name sgs_migrations)
 (wrapped false)
 (libraries
  abb
  abbs
  containers
  data_mig
  logs
  mql
  mql_sql
  pgsql_io
  pgsql_pool
  sgs_config
  sgs_migrations_ex)
 (preprocessor_deps
  (glob_files_rec migrations/*))
 (preprocess
  (pps ppx_blob)))

; Guard: every migration file in migrations/ must be registered in the
; `migrations` list of sgs_migrations.ml. A file without a matching
; ("name", run_sql [%blob ...]) entry never runs in production, and nothing
; else fails when it is missing. The missing-file direction (a registered
; entry whose file is gone) already fails the ppx_blob build; the script
; reports it with a clearer message. The script is exported to the public
; repo by an exact path in copy.bara.sky.template (MONOREPO_FILES).

(rule
 (alias check-migrations)
 (deps
  sgs_migrations.ml
  %{workspace_root}/scripts/check_migrations_registered.sh
  (glob_files migrations/*.sql))
 (action
  (run
   bash
   %{workspace_root}/scripts/check_migrations_registered.sh
   sgs_migrations.ml
   migrations)))
