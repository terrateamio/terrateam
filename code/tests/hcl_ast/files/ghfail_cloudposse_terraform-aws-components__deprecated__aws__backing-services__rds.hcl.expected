            }
          ]
        ],
        [ "Attribute", "length", [ "Int", 16 ] ],
        [ "Attribute", "special", [ "Bool", true ] ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "locals",
      "labels": [],
      "body": [
        [
          "Attribute",
          "rds_enabled",
          [
            "Equal",
            [
              [ "Attr", [ [ "Id", "var" ], [ "A_string", "rds_enabled" ] ] ],
              [ "String", "true" ]
            ]
          ]
        ],
        [
          "Attribute",
          "rds_admin_user",
          [
            "Cond",
            {
              "if_": [
                "Gt",
                [
                  [
                    "Fun_call",
                    [
                      "length",
                      [
                        [
                          "Attr",
                          [
                            [ "Id", "var" ], [ "A_string", "rds_admin_user" ]
                          ]
                        ]
                      ]
                    ]
                  ],
                  [ "Int", 0 ]
                ]
              ],
              "then_": [
                "Attr", [ [ "Id", "var" ], [ "A_string", "rds_admin_user" ] ]
              ],
              "else_": [
                "Fun_call",
                [
                  "join",
                  [
                    [ "String", "" ],
                    [
                      "Attr",
                      [
                        [
                          "Attr",
                          [
                            [
                              "Attr",
                              [
                                [ "Id", "random_string" ],
                                [ "A_string", "rds_admin_user" ]
                              ]
                            ],
                            [ "A_splat" ]
                          ]
                        ],
                        [ "A_string", "result" ]
                      ]
                    ]
                  ]
                ]
              ]
            }
          ]
        ],
        [
          "Attribute",
          "rds_admin_password",
          [
            "Cond",
            {
              "if_": [
                "Gt",
                [
                  [
                    "Fun_call",
                    [
                      "length",
                      [
                        [
                          "Attr",
                          [
                            [ "Id", "var" ],
                            [ "A_string", "rds_admin_password" ]
                          ]
                        ]
                      ]
                    ]
                  ],
                  [ "Int", 0 ]
                ]
              ],
              "then_": [
                "Attr",
                [ [ "Id", "var" ], [ "A_string", "rds_admin_password" ] ]
              ],
              "else_": [
                "Fun_call",
                [
                  "join",
                  [
                    [ "String", "" ],
                    [
                      "Attr",
                      [
                        [
                          "Attr",
                          [
                            [
                              "Attr",
                              [
                                [ "Id", "random_string" ],
                                [ "A_string", "rds_admin_password" ]
                              ]
                            ],
                            [ "A_splat" ]
                          ]
                        ],
                        [ "A_string", "result" ]
                      ]
                    ]
                  ]
                ]
              ]
            }
          ]
        ],
        [
          "Attribute",
          "rds_db_name",
          [
            "Fun_call",
            [
              "join",
              [
                [ "String", "" ],
                [
                  "Attr",
                  [
                    [
                      "Attr",
                      [
                        [
                          "Attr",
                          [
                            [ "Id", "random_pet" ],
                            [ "A_string", "rds_db_name" ]
                          ]
                        ],
                        [ "A_splat" ]
                      ]
                    ],
                    [ "A_string", "id" ]
                  ]
                ]
              ]
            ]
          ]
        ]
      ]
    }
  ],
  [
