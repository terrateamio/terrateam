        [
          "Attribute",
          "count",
          [
            "Cond",
            {
              "if_": [
                "Attr", [ [ "Id", "local" ], [ "A_string", "rds_enabled" ] ]
              ],
              "then_": [ "Int", 1 ],
              "else_": [ "Int", 0 ]
            }
          ]
        ],
        [ "Attribute", "length", [ "Int", 8 ] ],
        [ "Attribute", "special", [ "Bool", false ] ],
        [ "Attribute", "number", [ "Bool", false ] ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "resource",
      "labels": [
        [ "Lit", "random_string" ], [ "Lit", "rds_admin_password" ]
      ],
