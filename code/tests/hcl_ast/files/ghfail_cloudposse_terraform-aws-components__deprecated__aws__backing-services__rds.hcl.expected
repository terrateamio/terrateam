  [
    "Block",
    {
      "type_": "resource",
      "labels": [ [ "Lit", "random_pet" ], [ "Lit", "rds_db_name" ] ],
      "body": [
        [
          "Attribute",
          "count",
          [
            "Cond",
            {
              "if_": [
                "Attr", [ [ "Id", "local" ], [ "A_string", "rds_enabled" ] ]
              ],
              "then_": [ "Int", 1 ],
              "else_": [ "Int", 0 ]
            }
          ]
        ],
        [ "Attribute", "separator", [ "String", "_" ] ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "resource",
      "labels": [ [ "Lit", "random_string" ], [ "Lit", "rds_admin_user" ] ],
