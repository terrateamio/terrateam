  [
    "Block",
    {
      "type_": "resource",
      "labels": [
        [ "Lit", "signalfx_list_chart" ], [ "Lit", "APM_IMM-Exec_4" ]
      ],
      "body": [
        [ "Attribute", "color_by", [ "String", "Metric" ] ],
        [
          "Attribute",
          "description",
          [ "String", "Error rate Top and Bottom 5 (12 week comparison)" ]
        ],
        [ "Attribute", "disable_sampling", [ "Bool", true ] ],
        [ "Attribute", "hide_missing_values", [ "Bool", false ] ],
        [ "Attribute", "max_delay", [ "Int", 0 ] ],
        [ "Attribute", "max_precision", [ "Int", 2 ] ],
        [
