  [
    "Block",
    {
      "type_": "resource",
      "labels": [
        [ "Lit", "signalfx_list_chart" ], [ "Lit", "APM_IMM-Exec_0" ]
      ],
      "body": [
        [ "Attribute", "color_by", [ "String", "Metric" ] ],
        [
          "Attribute",
          "description",
          [
            "String", "Traffic Change Top and Bottom 5 (12 week comparison)"
          ]
        ],
        [ "Attribute", "disable_sampling", [ "Bool", false ] ],
        [ "Attribute", "hide_missing_values", [ "Bool", false ] ],
        [ "Attribute", "max_delay", [ "Int", 0 ] ],
        [ "Attribute", "max_precision", [ "Int", 2 ] ],
        [
          "Attribute",
          "name",
          [ "String", "Request rate 12 week comparison" ]
        ],
        [
          "Attribute",
          "program_text",
          [
            "Heredoc",
            [
              "EOF",
              "\nA = data('service.request.count', filter=filter('sf_environment', '*') and filter('sf_service', '*'), rollup='rate').sum(by=['sf_service']).mean(over='7d').publish(label='A', enable=False)\nB = data('service.request.count', filter=filter('sf_environment', '*') and filter('sf_service', '*'), rollup='rate').sum(by=['sf_service']).timeshift('12w').mean(over='7d').publish(label='B', enable=False)\nC = (((A-B)/B)*100).mean(by=['sf_service']).mean(over='7d').top(count=5).publish(label='C')\nD = (((A-B)/B)*100).mean(by=['sf_service']).mean(over='7d').bottom(count=5).publish(label='D')\n"
            ]
          ]
        ],
        [ "Attribute", "refresh_interval", [ "Int", 3600 ] ],
        [ "Attribute", "secondary_visualization", [ "String", "None" ] ],
        [ "Attribute", "sort_by", [ "String", "-value" ] ],
        [ "Attribute", "time_range", [ "Int", 900 ] ],
        [ "Attribute", "unit_prefix", [ "String", "Metric" ] ],
        [
          "Block",
          {
            "type_": "viz_options",
