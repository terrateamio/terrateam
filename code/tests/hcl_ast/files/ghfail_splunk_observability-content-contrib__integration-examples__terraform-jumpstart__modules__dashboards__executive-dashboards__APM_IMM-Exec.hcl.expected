  [
    "Block",
    {
      "type_": "resource",
      "labels": [
        [ "Lit", "signalfx_list_chart" ], [ "Lit", "APM_IMM-Exec_1" ]
      ],
      "body": [
        [ "Attribute", "color_by", [ "String", "Scale" ] ],
        [ "Attribute", "description", [ "String", "Requests compared" ] ],
        [ "Attribute", "disable_sampling", [ "Bool", false ] ],
        [ "Attribute", "hide_missing_values", [ "Bool", false ] ],
        [ "Attribute", "max_delay", [ "Int", 0 ] ],
        [ "Attribute", "max_precision", [ "Int", 2 ] ],
        [
          "Attribute",
          "name",
          [ "String", "Total Request (4 & 12 week comparisons)" ]
        ],
        [
          "Attribute",
          "program_text",
          [
            "Heredoc",
            [
              "EOF",
              "\nC = data('service.request.count', filter=(not filter('sf_dimensionalized', '*')) and filter('sf_environment', '*') and filter('sf_service', '*'), rollup='rate').sum(over='1d').sum().publish(label='C')\nD = data('service.request.count', filter=(not filter('sf_dimensionalized', '*')) and filter('sf_environment', '*') and filter('sf_service', '*'), rollup='rate').sum(over='1d').sum().timeshift('4w').publish(label='D', enable=False)\nE = data('service.request.count', filter=(not filter('sf_dimensionalized', '*')) and filter('sf_environment', '*') and filter('sf_service', '*'), rollup='rate').sum(over='1d').sum().timeshift('12w').publish(label='E', enable=False)\nF = (((C-D)/C)*100).publish(label='F')\nG = (((C-E)/C)*100).publish(label='G')\n"
            ]
          ]
        ],
        [ "Attribute", "secondary_visualization", [ "String", "Radial" ] ],
        [ "Attribute", "time_range", [ "Int", 900 ] ],
        [ "Attribute", "unit_prefix", [ "String", "Metric" ] ],
        [
