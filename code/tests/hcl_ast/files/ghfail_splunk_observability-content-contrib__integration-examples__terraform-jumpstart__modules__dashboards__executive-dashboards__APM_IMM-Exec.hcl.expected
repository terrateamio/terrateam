          [
            "Heredoc",
            [
              "EOF",
              "\nfilter_ = filter('sf_environment', '*') and filter('sf_service', '*') and (not filter('sf_dimensionalized', '*'))\nA = data('service.request.count', filter=filter_ and filter('sf_error', 'true'), rollup='delta').sum(by=['sf_environment', 'sf_service']).mean(over='7d').publish(label='A', enable=False)\nB = data('service.request.count', filter=filter_, rollup='delta').sum(by=['sf_environment', 'sf_service']).mean(over='7d').publish(label='B', enable=False)\nC = combine(100*((A if A is not None else 0) / B)).publish(label='C', enable=False)\nD = combine(100*((A if A is not None else 0) / B)).timeshift('12w').publish(label='D', enable=False)\n        \nE = (((C-D)/D)*100).mean(by=['sf_service']).mean(over='7d').top(count=5).publish(label='% Change')\nF = (((C-D)/D)*100).mean(by=['sf_service']).mean(over='7d').bottom(count=5).publish(label='% Change')\n"
            ]
          ]
        ],
        [ "Attribute", "secondary_visualization", [ "String", "None" ] ],
