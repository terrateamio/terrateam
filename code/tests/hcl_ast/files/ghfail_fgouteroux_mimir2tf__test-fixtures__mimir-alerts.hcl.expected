                [
                  "String",
                  "max by(cluster, namespace, user) (cortex_bucket_blocks_partials_count) > 0"
                ]
              ],
              [ "Attribute", "for", [ "String", "6h" ] ],
              [
                "Attribute",
                "labels",
                [
                  "Object",
                  [ [ [ "Bare", "severity" ], [ "String", "warning" ] ] ]
                ]
              ],
              [
                "Attribute",
                "annotations",
                [
                  "Object",
                  [
                    [
                      [ "Bare", "runbook_url" ],
                      [
                        "String",
                        "https://grafana.com/docs/mimir/latest/operators-guide/mimir-runbooks/#mimirtenanthaspartialblocks"
                      ]
                    ],
                    [
                      [ "Bare", "message" ],
                      [
                        "String",
                        "Mimir tenant {{ $labels.user }} in {{ $labels.cluster }}/{{ $labels.namespace }} has {{ $value }} partial blocks."
                      ]
                    ]
                  ]
                ]
              ]
            ]
          }
        ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "resource",
      "labels": [
        [ "Lit", "mimir_rule_group_alerting" ],
        [ "Lit", "mimir_compactor_alerts" ]
      ],
      "body": [
        [ "Attribute", "name", [ "String", "mimir_compactor_alerts" ] ],
        [ "Attribute", "namespace", [ "String", "default" ] ],
        [
          "Block",
          {
            "type_": "rule",
            "labels": [],
            "body": [
              [
                "Attribute",
                "alert",
                [
                  "String", "MimirCompactorHasNotSuccessfullyCleanedUpBlocks"
                ]
              ],
              [
                "Attribute",
                "expr",
                [
                  "Heredoc",
                  [
                    "EOT",
                    "\n# The \"last successful run\" metric is updated even if the compactor owns no tenants,\n# so this alert correctly doesn't fire if compactor has nothing to do.\n(time() - cortex_compactor_block_cleanup_last_successful_run_timestamp_seconds > 60 * 60 * 6)\n"
                  ]
                ]
              ],
              [ "Attribute", "for", [ "String", "1h" ] ],
              [
                "Attribute",
                "labels",
                [
                  "Object",
                  [ [ [ "Bare", "severity" ], [ "String", "critical" ] ] ]
                ]
              ],
              [
                "Attribute",
                "annotations",
                [
                  "Object",
                  [
                    [
                      [ "Bare", "message" ],
                      [
                        "String",
                        "Mimir Compactor {{ $labels.pod }} in {{ $labels.cluster }}/{{ $labels.namespace }} has not successfully cleaned up blocks in the last 6 hours."
                      ]
                    ],
                    [
                      [ "Bare", "runbook_url" ],
                      [
                        "String",
                        "https://grafana.com/docs/mimir/latest/operators-guide/mimir-runbooks/#mimircompactorhasnotsuccessfullycleanedupblocks"
                      ]
                    ]
                  ]
                ]
              ]
            ]
          }
        ],
        [
          "Block",
          {
            "type_": "rule",
            "labels": [],
            "body": [
              [
                "Attribute",
                "alert",
                [ "String", "MimirCompactorHasNotSuccessfullyRunCompaction" ]
              ],
              [
                "Attribute",
                "expr",
                [
                  "Heredoc",
                  [
                    "EOT",
                    "\n# The \"last successful run\" metric is updated even if the compactor owns no tenants,\n# so this alert correctly doesn't fire if compactor has nothing to do.\n(time() - cortex_compactor_last_successful_run_timestamp_seconds > 60 * 60 * 24)\nand\n(cortex_compactor_last_successful_run_timestamp_seconds > 0)\n"
                  ]
                ]
              ],
              [ "Attribute", "for", [ "String", "1h" ] ],
              [
                "Attribute",
                "labels",
                [
                  "Object",
                  [
                    [ [ "Bare", "severity" ], [ "String", "critical" ] ],
                    [ [ "Bare", "reason" ], [ "String", "in-last-24h" ] ]
                  ]
                ]
              ],
              [
                "Attribute",
                "annotations",
                [
                  "Object",
                  [
                    [
                      [ "Bare", "message" ],
                      [
                        "String",
                        "Mimir Compactor {{ $labels.pod }} in {{ $labels.cluster }}/{{ $labels.namespace }} has not run compaction in the last 24 hours."
                      ]
                    ],
                    [
                      [ "Bare", "runbook_url" ],
                      [
                        "String",
                        "https://grafana.com/docs/mimir/latest/operators-guide/mimir-runbooks/#mimircompactorhasnotsuccessfullyruncompaction"
                      ]
                    ]
                  ]
                ]
              ]
            ]
          }
        ],
        [
          "Block",
          {
            "type_": "rule",
            "labels": [],
            "body": [
              [
                "Attribute",
                "alert",
                [ "String", "MimirCompactorHasNotSuccessfullyRunCompaction" ]
              ],
              [
                "Attribute",
                "expr",
                [
                  "Heredoc",
                  [
                    "EOT",
                    "\n# The \"last successful run\" metric is updated even if the compactor owns no tenants,\n# so this alert correctly doesn't fire if compactor has nothing to do.\ncortex_compactor_last_successful_run_timestamp_seconds == 0\n"
                  ]
                ]
              ],
              [ "Attribute", "for", [ "String", "1d" ] ],
              [
                "Attribute",
                "labels",
                [
                  "Object",
                  [
                    [ [ "Bare", "reason" ], [ "String", "since-startup" ] ],
                    [ [ "Bare", "severity" ], [ "String", "critical" ] ]
                  ]
                ]
              ],
              [
                "Attribute",
                "annotations",
                [
                  "Object",
                  [
                    [
                      [ "Bare", "message" ],
                      [
                        "String",
                        "Mimir Compactor {{ $labels.pod }} in {{ $labels.cluster }}/{{ $labels.namespace }} has not run compaction in the last 24 hours."
                      ]
                    ],
                    [
                      [ "Bare", "runbook_url" ],
                      [
                        "String",
                        "https://grafana.com/docs/mimir/latest/operators-guide/mimir-runbooks/#mimircompactorhasnotsuccessfullyruncompaction"
                      ]
                    ]
                  ]
                ]
              ]
            ]
          }
        ],
        [
          "Block",
          {
            "type_": "rule",
            "labels": [],
            "body": [
              [
                "Attribute",
                "alert",
                [ "String", "MimirCompactorHasNotSuccessfullyRunCompaction" ]
              ],
              [
                "Attribute",
                "expr",
                [
                  "String",
                  "increase(cortex_compactor_runs_failed_total{reason!=\"shutdown\"}[2h]) >= 2"
                ]
              ],
              [
                "Attribute",
                "labels",
                [
                  "Object",
                  [
                    [
                      [ "Bare", "reason" ],
                      [ "String", "consecutive-failures" ]
                    ],
                    [ [ "Bare", "severity" ], [ "String", "critical" ] ]
                  ]
                ]
              ],
              [
                "Attribute",
                "annotations",
                [
                  "Object",
                  [
                    [
                      [ "Bare", "message" ],
                      [
                        "String",
                        "Mimir Compactor {{ $labels.pod }} in {{ $labels.cluster }}/{{ $labels.namespace }} failed to run 2 consecutive compactions."
                      ]
                    ],
                    [
                      [ "Bare", "runbook_url" ],
                      [
                        "String",
                        "https://grafana.com/docs/mimir/latest/operators-guide/mimir-runbooks/#mimircompactorhasnotsuccessfullyruncompaction"
                      ]
                    ]
                  ]
                ]
              ]
            ]
          }
        ],
        [
          "Block",
          {
            "type_": "rule",
            "labels": [],
            "body": [
              [
                "Attribute",
                "alert",
                [ "String", "MimirCompactorHasNotUploadedBlocks" ]
              ],
              [
                "Attribute",
                "expr",
                [
                  "Heredoc",
                  [
                    "EOT",
                    "\n(time() - (max by(cluster, namespace, pod) (thanos_objstore_bucket_last_successful_upload_time{component=\"compactor\"})) > 60 * 60 * 24)\nand\n(max by(cluster, namespace, pod) (thanos_objstore_bucket_last_successful_upload_time{component=\"compactor\"}) > 0)\nand\n# Only if some compactions have started. We don't want to fire this alert if the compactor has nothing to do\n# (e.g. there are more replicas than required because running as part of mimir-backend).\n(sum by(cluster, namespace, pod) (rate(cortex_compactor_group_compaction_runs_started_total[24h])) > 0)\n"
                  ]
                ]
              ],
              [ "Attribute", "for", [ "String", "15m" ] ],
              [
                "Attribute",
                "labels",
                [
                  "Object",
                  [ [ [ "Bare", "severity" ], [ "String", "critical" ] ] ]
                ]
              ],
              [
                "Attribute",
                "annotations",
                [
                  "Object",
                  [
                    [
                      [ "Bare", "message" ],
                      [
                        "String",
                        "Mimir Compactor {{ $labels.pod }} in {{ $labels.cluster }}/{{ $labels.namespace }} has not uploaded any block in the last 24 hours."
                      ]
                    ],
                    [
                      [ "Bare", "runbook_url" ],
                      [
                        "String",
                        "https://grafana.com/docs/mimir/latest/operators-guide/mimir-runbooks/#mimircompactorhasnotuploadedblocks"
                      ]
                    ]
                  ]
                ]
              ]
            ]
          }
        ],
        [
          "Block",
          {
            "type_": "rule",
            "labels": [],
            "body": [
              [
                "Attribute",
                "alert",
                [ "String", "MimirCompactorHasNotUploadedBlocks" ]
              ],
              [
                "Attribute",
                "expr",
                [
                  "Heredoc",
                  [
                    "EOT",
                    "\n(max by(cluster, namespace, pod) (thanos_objstore_bucket_last_successful_upload_time{component=\"compactor\"}) == 0)\nand\n# Only if some compactions have started. We don't want to fire this alert if the compactor has nothing to do\n# (e.g. there are more replicas than required because running as part of mimir-backend).\n(sum by(cluster, namespace, pod) (rate(cortex_compactor_group_compaction_runs_started_total[24h])) > 0)\n"
                  ]
                ]
              ],
              [ "Attribute", "for", [ "String", "1d" ] ],
              [
                "Attribute",
                "labels",
                [
                  "Object",
                  [ [ [ "Bare", "severity" ], [ "String", "critical" ] ] ]
                ]
              ],
              [
                "Attribute",
                "annotations",
                [
                  "Object",
                  [
                    [
                      [ "Bare", "message" ],
                      [
                        "String",
                        "Mimir Compactor {{ $labels.pod }} in {{ $labels.cluster }}/{{ $labels.namespace }} has not uploaded any block in the last 24 hours."
                      ]
                    ],
                    [
                      [ "Bare", "runbook_url" ],
                      [
                        "String",
                        "https://grafana.com/docs/mimir/latest/operators-guide/mimir-runbooks/#mimircompactorhasnotuploadedblocks"
                      ]
                    ]
                  ]
                ]
              ]
            ]
          }
        ],
        [
          "Block",
          {
            "type_": "rule",
            "labels": [],
            "body": [
              [
                "Attribute",
                "alert",
                [
                  "String", "MimirCompactorSkippedBlocksWithOutOfOrderChunks"
                ]
              ],
              [
                "Attribute",
                "expr",
                [
                  "String",
                  "increase(cortex_compactor_blocks_marked_for_no_compaction_total{reason=\"block-index-out-of-order-chunk\"}[5m]) > 0"
                ]
              ],
              [ "Attribute", "for", [ "String", "1m" ] ],
              [
                "Attribute",
                "labels",
                [
                  "Object",
                  [ [ [ "Bare", "severity" ], [ "String", "warning" ] ] ]
                ]
              ],
              [
                "Attribute",
                "annotations",
                [
                  "Object",
                  [
                    [
                      [ "Bare", "message" ],
                      [
                        "String",
                        "Mimir Compactor {{ $labels.pod }} in {{ $labels.cluster }}/{{ $labels.namespace }} has found and ignored blocks with out of order chunks."
                      ]
                    ],
                    [
                      [ "Bare", "runbook_url" ],
                      [
                        "String",
                        "https://grafana.com/docs/mimir/latest/operators-guide/mimir-runbooks/#mimircompactorskippedblockswithoutoforderchunks"
                      ]
                    ]
                  ]
                ]
              ]
            ]
          }
        ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "resource",
      "labels": [
        [ "Lit", "mimir_rule_group_alerting" ],
        [ "Lit", "mimir_autoscaling" ]
      ],
      "body": [
        [ "Attribute", "name", [ "String", "mimir_autoscaling" ] ],
        [ "Attribute", "namespace", [ "String", "default" ] ],
        [
          "Block",
          {
            "type_": "rule",
            "labels": [],
            "body": [
              [
                "Attribute",
                "alert",
                [ "String", "MimirAutoscalerNotActive" ]
              ],
              [
                "Attribute",
                "expr",
                [
                  "Heredoc",
                  [
                    "EOT",
                    "\n(\n    kube_horizontalpodautoscaler_status_condition{condition=\"ScalingActive\",status=\"false\"}\n    # Match only Mimir namespaces.\n    * on(cluster, namespace) group_left max by(cluster, namespace) (cortex_build_info)\n    # Add \"metric\" label.\n    + on(cluster, namespace, horizontalpodautoscaler) group_right label_replace(kube_horizontalpodautoscaler_spec_target_metric*0, \"metric\", \"$1\", \"metric_name\", \"(.+)\")\n    > 0\n)\n# Alert only if the scaling metric exists and is > 0. If the KEDA ScaledObject is configured to scale down 0,\n# then HPA ScalingActive may be false when expected to run 0 replicas. In this case, the scaling metric exported\n# by KEDA could not exist at all or being exposed with a value of 0.\nand on (cluster, namespace, metric)\n(label_replace(keda_metrics_adapter_scaler_metrics_value, \"namespace\", \"$0\", \"exported_namespace\", \".+\") > 0)\n"
                  ]
                ]
              ],
              [ "Attribute", "for", [ "String", "1h" ] ],
              [
                "Attribute",
                "labels",
                [
                  "Object",
                  [ [ [ "Bare", "severity" ], [ "String", "critical" ] ] ]
                ]
              ],
              [
                "Attribute",
                "annotations",
                [
                  "Object",
                  [
                    [
                      [ "Bare", "message" ],
                      [
                        "String",
                        "The Horizontal Pod Autoscaler (HPA) {{ $labels.horizontalpodautoscaler }} in {{ $labels.namespace }} is not active."
                      ]
                    ],
                    [
                      [ "Bare", "runbook_url" ],
                      [
                        "String",
                        "https://grafana.com/docs/mimir/latest/operators-guide/mimir-runbooks/#mimirautoscalernotactive"
                      ]
                    ]
                  ]
                ]
              ]
            ]
          }
        ],
        [
          "Block",
          {
            "type_": "rule",
            "labels": [],
            "body": [
              [
                "Attribute",
                "alert",
                [ "String", "MimirAutoscalerKedaFailing" ]
              ],
              [
                "Attribute",
                "expr",
                [
                  "Heredoc",
                  [
                    "EOT",
                    "\n(\n    # Find KEDA scalers reporting errors.\n    label_replace(rate(keda_metrics_adapter_scaler_errors[5m]), \"namespace\", \"$1\", \"exported_namespace\", \"(.*)\")\n    # Match only Mimir namespaces.\n    * on(cluster, namespace) group_left max by(cluster, namespace) (cortex_build_info)\n)\n> 0\n"
                  ]
                ]
              ],
              [ "Attribute", "for", [ "String", "1h" ] ],
              [
                "Attribute",
                "labels",
                [
                  "Object",
                  [ [ [ "Bare", "severity" ], [ "String", "critical" ] ] ]
                ]
              ],
              [
                "Attribute",
                "annotations",
                [
                  "Object",
                  [
                    [
                      [ "Bare", "message" ],
                      [
                        "String",
                        "The Keda ScaledObject {{ $labels.scaledObject }} in {{ $labels.namespace }} is experiencing errors."
                      ]
                    ],
                    [
                      [ "Bare", "runbook_url" ],
                      [
                        "String",
                        "https://grafana.com/docs/mimir/latest/operators-guide/mimir-runbooks/#mimirautoscalerkedafailing"
                      ]
                    ]
                  ]
                ]
              ]
            ]
          }
        ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "resource",
      "labels": [
        [ "Lit", "mimir_rule_group_alerting" ],
        [ "Lit", "mimir_continuous_test" ]
      ],
      "body": [
        [ "Attribute", "name", [ "String", "mimir_continuous_test" ] ],
        [ "Attribute", "namespace", [ "String", "default" ] ],
        [
          "Block",
          {
            "type_": "rule",
            "labels": [],
            "body": [
              [
                "Attribute",
                "alert",
                [ "String", "MimirContinuousTestNotRunningOnWrites" ]
              ],
              [
                "Attribute",
                "expr",
                [
                  "String",
                  "sum by(cluster, namespace, test) (rate(mimir_continuous_test_writes_failed_total[5m])) > 0"
                ]
              ],
              [ "Attribute", "for", [ "String", "1h" ] ],
              [
                "Attribute",
                "labels",
                [
                  "Object",
                  [ [ [ "Bare", "severity" ], [ "String", "warning" ] ] ]
                ]
              ],
              [
                "Attribute",
                "annotations",
                [
                  "Object",
                  [
                    [
                      [ "Bare", "runbook_url" ],
                      [
                        "String",
                        "https://grafana.com/docs/mimir/latest/operators-guide/mimir-runbooks/#mimircontinuoustestnotrunningonwrites"
                      ]
                    ],
                    [
                      [ "Bare", "message" ],
                      [
                        "String",
                        "Mimir continuous test {{ $labels.test }} in {{ $labels.cluster }}/{{ $labels.namespace }} is not effectively running because writes are failing."
                      ]
                    ]
                  ]
                ]
              ]
            ]
          }
        ],
        [
          "Block",
          {
            "type_": "rule",
            "labels": [],
            "body": [
              [
                "Attribute",
                "alert",
                [ "String", "MimirContinuousTestNotRunningOnReads" ]
              ],
              [
                "Attribute",
                "expr",
                [
                  "String",
                  "sum by(cluster, namespace, test) (rate(mimir_continuous_test_queries_failed_total[5m])) > 0"
                ]
              ],
              [ "Attribute", "for", [ "String", "1h" ] ],
              [
                "Attribute",
                "labels",
                [
                  "Object",
                  [ [ [ "Bare", "severity" ], [ "String", "warning" ] ] ]
                ]
              ],
              [
                "Attribute",
                "annotations",
                [
                  "Object",
                  [
                    [
                      [ "Bare", "message" ],
                      [
                        "String",
                        "Mimir continuous test {{ $labels.test }} in {{ $labels.cluster }}/{{ $labels.namespace }} is not effectively running because queries are failing."
                      ]
                    ],
                    [
                      [ "Bare", "runbook_url" ],
                      [
                        "String",
                        "https://grafana.com/docs/mimir/latest/operators-guide/mimir-runbooks/#mimircontinuoustestnotrunningonreads"
                      ]
                    ]
                  ]
                ]
              ]
            ]
          }
        ],
        [
          "Block",
          {
            "type_": "rule",
            "labels": [],
            "body": [
              [
                "Attribute",
                "alert",
                [ "String", "MimirContinuousTestFailed" ]
              ],
              [
                "Attribute",
                "expr",
                [
                  "String",
                  "sum by(cluster, namespace, test) (rate(mimir_continuous_test_query_result_checks_failed_total[10m])) > 0"
                ]
              ],
              [
                "Attribute",
                "labels",
                [
                  "Object",
                  [ [ [ "Bare", "severity" ], [ "String", "warning" ] ] ]
                ]
              ],
              [
                "Attribute",
                "annotations",
                [
                  "Object",
                  [
                    [
                      [ "Bare", "message" ],
                      [
                        "String",
                        "Mimir continuous test {{ $labels.test }} in {{ $labels.cluster }}/{{ $labels.namespace }} failed when asserting query results."
                      ]
                    ],
                    [
                      [ "Bare", "runbook_url" ],
                      [
                        "String",
                        "https://grafana.com/docs/mimir/latest/operators-guide/mimir-runbooks/#mimircontinuoustestfailed"
                      ]
                    ]
                  ]
                ]
              ]
            ]
          }
        ]
      ]
    }
  ]
]
