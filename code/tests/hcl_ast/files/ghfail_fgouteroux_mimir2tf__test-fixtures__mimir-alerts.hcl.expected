  [
    "Block",
    {
      "type_": "resource",
      "labels": [
        [ "Lit", "mimir_rule_group_alerting" ],
        [ "Lit", "mimir_blocks_alerts" ]
      ],
      "body": [
        [ "Attribute", "name", [ "String", "mimir_blocks_alerts" ] ],
        [ "Attribute", "namespace", [ "String", "default" ] ],
        [
          "Block",
          {
            "type_": "rule",
            "labels": [],
            "body": [
              [
                "Attribute",
                "alert",
                [ "String", "MimirIngesterHasNotShippedBlocks" ]
              ],
              [
                "Attribute",
                "expr",
                [
                  "Heredoc",
                  [
                    "EOT",
                    "\n(min by(cluster, namespace, pod) (time() - thanos_shipper_last_successful_upload_time) > 60 * 60 * 4)\nand\n(max by(cluster, namespace, pod) (thanos_shipper_last_successful_upload_time) > 0)\nand\n# Only if the ingester has ingested samples over the last 4h.\n(max by(cluster, namespace, pod) (max_over_time(cluster_namespace_pod:cortex_ingester_ingested_samples_total:rate1m[4h])) > 0)\nand\n# Only if the ingester was ingesting samples 4h ago. This protects against the case where the ingester replica\n# had ingested samples in the past, then no traffic was received for a long period and then it starts\n# receiving samples again. Without this check, the alert would fire as soon as it gets back receiving\n# samples, while the a block shipping is expected within the next 4h.\n(max by(cluster, namespace, pod) (max_over_time(cluster_namespace_pod:cortex_ingester_ingested_samples_total:rate1m[1h] offset 4h)) > 0)\n"
                  ]
                ]
              ],
              [ "Attribute", "for", [ "String", "15m" ] ],
              [
                "Attribute",
                "labels",
                [
                  "Object",
                  [ [ [ "Bare", "severity" ], [ "String", "critical" ] ] ]
                ]
              ],
              [
                "Attribute",
                "annotations",
                [
                  "Object",
                  [
                    [
                      [ "Bare", "message" ],
                      [
                        "String",
                        "Mimir Ingester {{ $labels.pod }} in {{ $labels.cluster }}/{{ $labels.namespace }} has not shipped any block in the last 4 hours."
                      ]
                    ],
                    [
                      [ "Bare", "runbook_url" ],
                      [
                        "String",
                        "https://grafana.com/docs/mimir/latest/operators-guide/mimir-runbooks/#mimiringesterhasnotshippedblocks"
                      ]
                    ]
                  ]
                ]
              ]
            ]
          }
        ],
        [
          "Block",
          {
            "type_": "rule",
            "labels": [],
            "body": [
              [
                "Attribute",
                "alert",
                [ "String", "MimirIngesterHasNotShippedBlocksSinceStart" ]
              ],
              [
                "Attribute",
                "expr",
                [
                  "Heredoc",
                  [
                    "EOT",
                    "\n(max by(cluster, namespace, pod) (thanos_shipper_last_successful_upload_time) == 0)\nand\n(max by(cluster, namespace, pod) (max_over_time(cluster_namespace_pod:cortex_ingester_ingested_samples_total:rate1m[4h])) > 0)\n"
                  ]
                ]
              ],
              [ "Attribute", "for", [ "String", "4h" ] ],
              [
                "Attribute",
                "labels",
                [
                  "Object",
                  [ [ [ "Bare", "severity" ], [ "String", "critical" ] ] ]
                ]
              ],
              [
                "Attribute",
                "annotations",
                [
                  "Object",
                  [
                    [
                      [ "Bare", "message" ],
                      [
                        "String",
                        "Mimir Ingester {{ $labels.pod }} in {{ $labels.cluster }}/{{ $labels.namespace }} has not shipped any block in the last 4 hours."
                      ]
                    ],
                    [
                      [ "Bare", "runbook_url" ],
                      [
                        "String",
                        "https://grafana.com/docs/mimir/latest/operators-guide/mimir-runbooks/#mimiringesterhasnotshippedblockssincestart"
                      ]
                    ]
                  ]
                ]
              ]
            ]
          }
        ],
        [
          "Block",
          {
            "type_": "rule",
            "labels": [],
            "body": [
              [
                "Attribute",
                "alert",
                [ "String", "MimirIngesterHasUnshippedBlocks" ]
              ],
              [
                "Attribute",
                "expr",
                [
                  "Heredoc",
                  [
                    "EOT",
                    "\n(time() - cortex_ingester_oldest_unshipped_block_timestamp_seconds > 3600)\nand\n(cortex_ingester_oldest_unshipped_block_timestamp_seconds > 0)\n"
                  ]
                ]
              ],
              [ "Attribute", "for", [ "String", "15m" ] ],
              [
                "Attribute",
                "labels",
                [
                  "Object",
                  [ [ [ "Bare", "severity" ], [ "String", "critical" ] ] ]
                ]
              ],
              [
                "Attribute",
                "annotations",
                [
                  "Object",
                  [
                    [
                      [ "Bare", "message" ],
                      [
                        "String",
                        "Mimir Ingester {{ $labels.pod }} in {{ $labels.cluster }}/{{ $labels.namespace }} has compacted a block {{ $value | humanizeDuration }} ago but it hasn't been successfully uploaded to the storage yet."
                      ]
                    ],
                    [
                      [ "Bare", "runbook_url" ],
                      [
                        "String",
                        "https://grafana.com/docs/mimir/latest/operators-guide/mimir-runbooks/#mimiringesterhasunshippedblocks"
                      ]
                    ]
                  ]
                ]
              ]
            ]
          }
        ],
        [
