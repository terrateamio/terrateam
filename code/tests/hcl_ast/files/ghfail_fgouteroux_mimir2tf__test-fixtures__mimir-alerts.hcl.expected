  [
    "Block",
    {
      "type_": "resource",
      "labels": [
        [ "Lit", "mimir_rule_group_alerting" ],
        [ "Lit", "mimir-rollout-alerts" ]
      ],
      "body": [
        [ "Attribute", "name", [ "String", "mimir-rollout-alerts" ] ],
        [ "Attribute", "namespace", [ "String", "default" ] ],
        [
          "Block",
          {
            "type_": "rule",
            "labels": [],
            "body": [
              [ "Attribute", "alert", [ "String", "MimirRolloutStuck" ] ],
              [
                "Attribute",
                "expr",
                [
                  "Heredoc",
                  [
                    "EOT",
                    "\n(\n  max without (revision) (\n    sum without(statefulset) (label_replace(kube_statefulset_status_current_revision, \"rollout_group\", \"$1\", \"statefulset\", \"(.*?)(?:-zone-[a-z])?\"))\n      unless\n    sum without(statefulset) (label_replace(kube_statefulset_status_update_revision, \"rollout_group\", \"$1\", \"statefulset\", \"(.*?)(?:-zone-[a-z])?\"))\n  )\n    *\n  (\n    sum without(statefulset) (label_replace(kube_statefulset_replicas, \"rollout_group\", \"$1\", \"statefulset\", \"(.*?)(?:-zone-[a-z])?\"))\n      !=\n    sum without(statefulset) (label_replace(kube_statefulset_status_replicas_updated, \"rollout_group\", \"$1\", \"statefulset\", \"(.*?)(?:-zone-[a-z])?\"))\n  )\n) and (\n  changes(sum without(statefulset) (label_replace(kube_statefulset_status_replicas_updated, \"rollout_group\", \"$1\", \"statefulset\", \"(.*?)(?:-zone-[a-z])?\"))[15m:1m])\n    ==\n  0\n)\n* on(cluster, namespace) group_left max by(cluster, namespace) (cortex_build_info)\n"
                  ]
                ]
              ],
              [ "Attribute", "for", [ "String", "30m" ] ],
              [
                "Attribute",
                "labels",
                [
                  "Object",
                  [ [ [ "Bare", "severity" ], [ "String", "warning" ] ] ]
                ]
              ],
              [
                "Attribute",
                "annotations",
                [
                  "Object",
                  [
                    [
                      [ "Bare", "message" ],
                      [
                        "String",
                        "The {{ $labels.rollout_group }} rollout is stuck in {{ $labels.cluster }}/{{ $labels.namespace }}."
                      ]
                    ],
                    [
                      [ "Bare", "runbook_url" ],
                      [
                        "String",
                        "https://grafana.com/docs/mimir/latest/operators-guide/mimir-runbooks/#mimirrolloutstuck"
                      ]
                    ]
                  ]
                ]
              ]
            ]
          }
        ],
        [
          "Block",
          {
            "type_": "rule",
            "labels": [],
            "body": [
              [ "Attribute", "alert", [ "String", "MimirRolloutStuck" ] ],
              [
                "Attribute",
                "expr",
                [
                  "Heredoc",
                  [
                    "EOT",
                    "\n(\n  sum without(deployment) (label_replace(kube_deployment_spec_replicas, \"rollout_group\", \"$1\", \"deployment\", \"(.*?)(?:-zone-[a-z])?\"))\n    !=\n  sum without(deployment) (label_replace(kube_deployment_status_replicas_updated, \"rollout_group\", \"$1\", \"deployment\", \"(.*?)(?:-zone-[a-z])?\"))\n) and (\n  changes(sum without(deployment) (label_replace(kube_deployment_status_replicas_updated, \"rollout_group\", \"$1\", \"deployment\", \"(.*?)(?:-zone-[a-z])?\"))[15m:1m])\n    ==\n  0\n)\n* on(cluster, namespace) group_left max by(cluster, namespace) (cortex_build_info)\n"
                  ]
                ]
              ],
              [ "Attribute", "for", [ "String", "30m" ] ],
              [
                "Attribute",
                "labels",
                [
                  "Object",
                  [ [ [ "Bare", "severity" ], [ "String", "warning" ] ] ]
                ]
              ],
              [
                "Attribute",
                "annotations",
                [
                  "Object",
                  [
                    [
                      [ "Bare", "message" ],
                      [
                        "String",
                        "The {{ $labels.rollout_group }} rollout is stuck in {{ $labels.cluster }}/{{ $labels.namespace }}."
                      ]
                    ],
                    [
                      [ "Bare", "runbook_url" ],
                      [
                        "String",
                        "https://grafana.com/docs/mimir/latest/operators-guide/mimir-runbooks/#mimirrolloutstuck"
                      ]
                    ]
                  ]
                ]
              ]
            ]
          }
        ],
        [
          "Block",
          {
            "type_": "rule",
            "labels": [],
            "body": [
              [
                "Attribute",
                "alert",
                [ "String", "RolloutOperatorNotReconciling" ]
              ],
              [
                "Attribute",
                "expr",
                [
                  "String",
                  "max by(cluster, namespace, rollout_group) (time() - rollout_operator_last_successful_group_reconcile_timestamp_seconds) > 600"
                ]
              ],
              [ "Attribute", "for", [ "String", "5m" ] ],
              [
                "Attribute",
                "labels",
                [
                  "Object",
                  [ [ [ "Bare", "severity" ], [ "String", "critical" ] ] ]
                ]
              ],
              [
                "Attribute",
                "annotations",
                [
                  "Object",
                  [
                    [
                      [ "Bare", "runbook_url" ],
                      [
                        "String",
                        "https://grafana.com/docs/mimir/latest/operators-guide/mimir-runbooks/#rolloutoperatornotreconciling"
                      ]
                    ],
                    [
                      [ "Bare", "message" ],
                      [
                        "String",
                        "Rollout operator is not reconciling the rollout group {{ $labels.rollout_group }} in {{ $labels.cluster }}/{{ $labels.namespace }}."
                      ]
                    ]
                  ]
                ]
              ]
            ]
          }
        ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "resource",
      "labels": [
        [ "Lit", "mimir_rule_group_alerting" ],
        [ "Lit", "mimir-provisioning" ]
      ],
      "body": [
        [ "Attribute", "name", [ "String", "mimir-provisioning" ] ],
        [ "Attribute", "namespace", [ "String", "default" ] ],
        [
          "Block",
          {
            "type_": "rule",
            "labels": [],
            "body": [
              [
                "Attribute",
                "alert",
                [ "String", "MimirProvisioningTooManyActiveSeries" ]
              ],
              [
                "Attribute",
                "expr",
                [
                  "String",
                  "avg by (cluster, namespace) (cortex_ingester_memory_series) > 1.6e6"
                ]
              ],
              [ "Attribute", "for", [ "String", "2h" ] ],
              [
                "Attribute",
                "labels",
                [
                  "Object",
                  [ [ [ "Bare", "severity" ], [ "String", "warning" ] ] ]
                ]
              ],
              [
                "Attribute",
                "annotations",
                [
                  "Object",
                  [
                    [
                      [ "Bare", "message" ],
                      [
                        "String",
                        "The number of in-memory series per ingester in {{ $labels.cluster }}/{{ $labels.namespace }} is too high."
                      ]
                    ],
                    [
                      [ "Bare", "runbook_url" ],
                      [
                        "String",
                        "https://grafana.com/docs/mimir/latest/operators-guide/mimir-runbooks/#mimirprovisioningtoomanyactiveseries"
                      ]
                    ]
                  ]
                ]
              ]
            ]
          }
        ],
        [
          "Block",
          {
            "type_": "rule",
            "labels": [],
            "body": [
              [
                "Attribute",
                "alert",
                [ "String", "MimirProvisioningTooManyWrites" ]
              ],
              [
                "Attribute",
                "expr",
                [
                  "String",
                  "avg by (cluster, namespace) (cluster_namespace_pod:cortex_ingester_ingested_samples_total:rate1m) > 80e3"
                ]
              ],
              [ "Attribute", "for", [ "String", "15m" ] ],
              [
                "Attribute",
                "labels",
                [
                  "Object",
                  [ [ [ "Bare", "severity" ], [ "String", "warning" ] ] ]
                ]
              ],
              [
                "Attribute",
                "annotations",
                [
                  "Object",
                  [
                    [
                      [ "Bare", "message" ],
                      [
                        "String",
                        "Ingesters in {{ $labels.cluster }}/{{ $labels.namespace }} ingest too many samples per second."
                      ]
                    ],
                    [
                      [ "Bare", "runbook_url" ],
                      [
                        "String",
                        "https://grafana.com/docs/mimir/latest/operators-guide/mimir-runbooks/#mimirprovisioningtoomanywrites"
                      ]
                    ]
                  ]
                ]
              ]
            ]
          }
        ],
        [
          "Block",
          {
            "type_": "rule",
            "labels": [],
            "body": [
              [
                "Attribute",
                "alert",
                [ "String", "MimirAllocatingTooMuchMemory" ]
              ],
              [
                "Attribute",
                "expr",
                [
                  "Heredoc",
                  [
                    "EOT",
                    "\n(\n  # We use RSS instead of working set memory because of the ingester's extensive usage of mmap.\n  # See: https://github.com/grafana/mimir/issues/2466\n  container_memory_rss{container=~\"(ingester|mimir-write|mimir-backend)\"}\n    /\n  ( container_spec_memory_limit_bytes{container=~\"(ingester|mimir-write|mimir-backend)\"} > 0 )\n) > 0.65\n"
                  ]
                ]
              ],
              [ "Attribute", "for", [ "String", "15m" ] ],
              [
                "Attribute",
                "labels",
                [
                  "Object",
                  [ [ [ "Bare", "severity" ], [ "String", "warning" ] ] ]
                ]
              ],
              [
                "Attribute",
                "annotations",
                [
                  "Object",
                  [
                    [
                      [ "Bare", "message" ],
                      [
                        "String",
                        "Instance {{ $labels.pod }} in {{ $labels.cluster }}/{{ $labels.namespace }} is using too much memory."
                      ]
                    ],
                    [
                      [ "Bare", "runbook_url" ],
                      [
                        "String",
                        "https://grafana.com/docs/mimir/latest/operators-guide/mimir-runbooks/#mimirallocatingtoomuchmemory"
                      ]
                    ]
                  ]
                ]
              ]
            ]
          }
        ],
        [
          "Block",
          {
            "type_": "rule",
            "labels": [],
            "body": [
              [
                "Attribute",
                "alert",
                [ "String", "MimirAllocatingTooMuchMemory" ]
              ],
              [
                "Attribute",
                "expr",
                [
                  "Heredoc",
                  [
                    "EOT",
                    "\n(\n  # We use RSS instead of working set memory because of the ingester's extensive usage of mmap.\n  # See: https://github.com/grafana/mimir/issues/2466\n  container_memory_rss{container=~\"(ingester|mimir-write|mimir-backend)\"}\n    /\n  ( container_spec_memory_limit_bytes{container=~\"(ingester|mimir-write|mimir-backend)\"} > 0 )\n) > 0.8\n"
                  ]
                ]
              ],
              [ "Attribute", "for", [ "String", "15m" ] ],
              [
                "Attribute",
                "labels",
                [
                  "Object",
                  [ [ [ "Bare", "severity" ], [ "String", "critical" ] ] ]
                ]
              ],
              [
                "Attribute",
                "annotations",
                [
                  "Object",
                  [
                    [
                      [ "Bare", "message" ],
                      [
                        "String",
                        "Instance {{ $labels.pod }} in {{ $labels.cluster }}/{{ $labels.namespace }} is using too much memory."
                      ]
                    ],
                    [
                      [ "Bare", "runbook_url" ],
                      [
                        "String",
                        "https://grafana.com/docs/mimir/latest/operators-guide/mimir-runbooks/#mimirallocatingtoomuchmemory"
                      ]
                    ]
                  ]
                ]
              ]
            ]
          }
        ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "resource",
