[
  [
    "Block",
    {
      "type_": "resource",
      "labels": [
        [ "Lit", "mimir_rule_group_alerting" ], [ "Lit", "mimir_alerts" ]
      ],
      "body": [
        [ "Attribute", "name", [ "String", "mimir_alerts" ] ],
        [ "Attribute", "namespace", [ "String", "default" ] ],
        [
          "Block",
          {
            "type_": "rule",
            "labels": [],
            "body": [
              [
                "Attribute", "alert", [ "String", "MimirIngesterUnhealthy" ]
              ],
              [
                "Attribute",
                "expr",
                [
                  "String",
                  "min by (cluster, namespace) (cortex_ring_members{state=\"Unhealthy\", name=\"ingester\"}) > 0"
                ]
              ],
              [ "Attribute", "for", [ "String", "15m" ] ],
              [
                "Attribute",
                "labels",
                [
                  "Object",
                  [ [ [ "Bare", "severity" ], [ "String", "critical" ] ] ]
                ]
              ],
              [
                "Attribute",
                "annotations",
                [
                  "Object",
                  [
                    [
                      [ "Bare", "message" ],
                      [
                        "String",
                        "Mimir cluster {{ $labels.cluster }}/{{ $labels.namespace }} has {{ printf \"%f\" $value }} unhealthy ingester(s)."
                      ]
                    ],
                    [
                      [ "Bare", "runbook_url" ],
                      [
                        "String",
                        "https://grafana.com/docs/mimir/latest/operators-guide/mimir-runbooks/#mimiringesterunhealthy"
                      ]
                    ]
                  ]
                ]
              ]
            ]
          }
        ],
        [
          "Block",
          {
            "type_": "rule",
            "labels": [],
            "body": [
              [ "Attribute", "alert", [ "String", "MimirRequestErrors" ] ],
              [
                "Attribute",
                "expr",
                [
                  "Heredoc",
                  [
                    "EOT",
                    "\n100 * sum by (cluster, namespace, job, route) (rate(cortex_request_duration_seconds_count{status_code=~\"5..\",route!~\"ready\"}[1m]))\n  /\nsum by (cluster, namespace, job, route) (rate(cortex_request_duration_seconds_count{route!~\"ready\"}[1m]))\n  > 1\n"
                  ]
                ]
              ],
              [ "Attribute", "for", [ "String", "15m" ] ],
              [
                "Attribute",
                "labels",
                [
                  "Object",
                  [ [ [ "Bare", "severity" ], [ "String", "critical" ] ] ]
                ]
              ],
              [
                "Attribute",
                "annotations",
                [
                  "Object",
                  [
                    [
                      [ "Bare", "message" ],
                      [
                        "String",
                        "The route {{ $labels.route }} in {{ $labels.cluster }}/{{ $labels.namespace }} is experiencing {{ printf \"%.2f\" $value }}% errors."
                      ]
                    ],
                    [
                      [ "Bare", "runbook_url" ],
                      [
                        "String",
                        "https://grafana.com/docs/mimir/latest/operators-guide/mimir-runbooks/#mimirrequesterrors"
                      ]
                    ]
                  ]
                ]
              ]
            ]
          }
        ],
        [
          "Block",
          {
            "type_": "rule",
            "labels": [],
            "body": [
              [ "Attribute", "alert", [ "String", "MimirRequestLatency" ] ],
              [
                "Attribute",
                "expr",
                [
                  "Heredoc",
                  [
                    "EOT",
                    "\ncluster_namespace_job_route:cortex_request_duration_seconds:99quantile{route!~\"metrics|/frontend.Frontend/Process|ready|/schedulerpb.SchedulerForFrontend/FrontendLoop|/schedulerpb.SchedulerForQuerier/QuerierLoop\"}\n   >\n2.5\n"
                  ]
                ]
              ],
              [ "Attribute", "for", [ "String", "15m" ] ],
              [
                "Attribute",
                "labels",
                [
                  "Object",
                  [ [ [ "Bare", "severity" ], [ "String", "warning" ] ] ]
                ]
              ],
              [
                "Attribute",
                "annotations",
                [
                  "Object",
                  [
                    [
                      [ "Bare", "runbook_url" ],
                      [
                        "String",
                        "https://grafana.com/docs/mimir/latest/operators-guide/mimir-runbooks/#mimirrequestlatency"
                      ]
                    ],
                    [
                      [ "Bare", "message" ],
                      [
                        "String",
                        "{{ $labels.job }} {{ $labels.route }} is experiencing {{ printf \"%.2f\" $value }}s 99th percentile latency."
                      ]
                    ]
                  ]
                ]
              ]
            ]
          }
        ],
        [
          "Block",
          {
            "type_": "rule",
            "labels": [],
            "body": [
              [ "Attribute", "alert", [ "String", "MimirQueriesIncorrect" ] ],
              [
                "Attribute",
                "expr",
                [
                  "Heredoc",
                  [
                    "EOT",
                    "\n100 * sum by (cluster, namespace) (rate(test_exporter_test_case_result_total{result=\"fail\"}[5m]))\n  /\nsum by (cluster, namespace) (rate(test_exporter_test_case_result_total[5m])) > 1\n"
                  ]
                ]
              ],
              [ "Attribute", "for", [ "String", "15m" ] ],
              [
                "Attribute",
                "labels",
                [
                  "Object",
                  [ [ [ "Bare", "severity" ], [ "String", "warning" ] ] ]
                ]
              ],
              [
                "Attribute",
                "annotations",
                [
                  "Object",
                  [
                    [
                      [ "Bare", "message" ],
                      [
                        "String",
                        "The Mimir cluster {{ $labels.cluster }}/{{ $labels.namespace }} is experiencing {{ printf \"%.2f\" $value }}% incorrect query results."
                      ]
                    ],
                    [
                      [ "Bare", "runbook_url" ],
                      [
                        "String",
                        "https://grafana.com/docs/mimir/latest/operators-guide/mimir-runbooks/#mimirqueriesincorrect"
                      ]
                    ]
                  ]
                ]
              ]
            ]
          }
        ],
        [
          "Block",
          {
            "type_": "rule",
            "labels": [],
            "body": [
              [
                "Attribute",
                "alert",
                [ "String", "MimirInconsistentRuntimeConfig" ]
              ],
              [
                "Attribute",
                "expr",
                [
                  "String",
                  "count(count by(cluster, namespace, job, sha256) (cortex_runtime_config_hash)) without(sha256) > 1"
                ]
              ],
              [ "Attribute", "for", [ "String", "1h" ] ],
              [
                "Attribute",
                "labels",
                [
                  "Object",
                  [ [ [ "Bare", "severity" ], [ "String", "critical" ] ] ]
                ]
              ],
              [
                "Attribute",
                "annotations",
                [
                  "Object",
                  [
                    [
                      [ "Bare", "message" ],
                      [
                        "String",
                        "An inconsistent runtime config file is used across cluster {{ $labels.cluster }}/{{ $labels.namespace }}."
                      ]
                    ],
                    [
                      [ "Bare", "runbook_url" ],
                      [
                        "String",
                        "https://grafana.com/docs/mimir/latest/operators-guide/mimir-runbooks/#mimirinconsistentruntimeconfig"
                      ]
                    ]
                  ]
                ]
              ]
            ]
          }
        ],
        [
          "Block",
          {
            "type_": "rule",
            "labels": [],
            "body": [
              [ "Attribute", "alert", [ "String", "MimirBadRuntimeConfig" ] ],
              [
                "Attribute",
                "expr",
                [
                  "Heredoc",
                  [
                    "EOT",
                    "\n# The metric value is reset to 0 on error while reloading the config at runtime.\ncortex_runtime_config_last_reload_successful == 0\n"
                  ]
                ]
              ],
              [ "Attribute", "for", [ "String", "5m" ] ],
              [
                "Attribute",
                "labels",
                [
                  "Object",
                  [ [ [ "Bare", "severity" ], [ "String", "critical" ] ] ]
                ]
              ],
              [
                "Attribute",
                "annotations",
                [
                  "Object",
                  [
                    [
                      [ "Bare", "message" ],
                      [
                        "String",
                        "{{ $labels.job }} failed to reload runtime config."
                      ]
                    ],
                    [
                      [ "Bare", "runbook_url" ],
                      [
                        "String",
                        "https://grafana.com/docs/mimir/latest/operators-guide/mimir-runbooks/#mimirbadruntimeconfig"
                      ]
                    ]
                  ]
                ]
              ]
            ]
          }
        ],
        [
          "Block",
          {
            "type_": "rule",
            "labels": [],
            "body": [
              [
                "Attribute",
                "alert",
                [ "String", "MimirFrontendQueriesStuck" ]
              ],
              [
                "Attribute",
                "expr",
                [
                  "String",
                  "sum by (cluster, namespace, job) (min_over_time(cortex_query_frontend_queue_length[1m])) > 0"
                ]
              ],
              [ "Attribute", "for", [ "String", "5m" ] ],
              [
                "Attribute",
                "labels",
                [
                  "Object",
                  [ [ [ "Bare", "severity" ], [ "String", "critical" ] ] ]
                ]
              ],
              [
                "Attribute",
                "annotations",
                [
                  "Object",
                  [
                    [
                      [ "Bare", "message" ],
                      [
                        "String",
                        "There are {{ $value }} queued up queries in {{ $labels.cluster }}/{{ $labels.namespace }} {{ $labels.job }}."
                      ]
                    ],
                    [
                      [ "Bare", "runbook_url" ],
                      [
                        "String",
                        "https://grafana.com/docs/mimir/latest/operators-guide/mimir-runbooks/#mimirfrontendqueriesstuck"
                      ]
                    ]
                  ]
                ]
              ]
            ]
          }
        ],
        [
          "Block",
          {
            "type_": "rule",
            "labels": [],
            "body": [
              [
                "Attribute",
                "alert",
                [ "String", "MimirSchedulerQueriesStuck" ]
              ],
              [
                "Attribute",
                "expr",
                [
                  "String",
                  "sum by (cluster, namespace, job) (min_over_time(cortex_query_scheduler_queue_length[1m])) > 0"
                ]
              ],
              [ "Attribute", "for", [ "String", "7m" ] ],
              [
                "Attribute",
                "labels",
                [
                  "Object",
                  [ [ [ "Bare", "severity" ], [ "String", "critical" ] ] ]
                ]
              ],
              [
                "Attribute",
                "annotations",
                [
                  "Object",
                  [
                    [
                      [ "Bare", "message" ],
                      [
                        "String",
                        "There are {{ $value }} queued up queries in {{ $labels.cluster }}/{{ $labels.namespace }} {{ $labels.job }}."
                      ]
                    ],
                    [
                      [ "Bare", "runbook_url" ],
                      [
                        "String",
                        "https://grafana.com/docs/mimir/latest/operators-guide/mimir-runbooks/#mimirschedulerqueriesstuck"
                      ]
                    ]
                  ]
                ]
              ]
            ]
          }
        ],
        [
          "Block",
          {
            "type_": "rule",
            "labels": [],
            "body": [
              [
                "Attribute", "alert", [ "String", "MimirCacheRequestErrors" ]
              ],
              [
                "Attribute",
                "expr",
                [
                  "Heredoc",
                  [
                    "EOT",
                    "\n(\n  sum by(cluster, namespace, name, operation) (\n    rate(thanos_memcached_operation_failures_total[1m])\n    or\n    rate(thanos_cache_operation_failures_total[1m])\n  )\n  /\n  sum by(cluster, namespace, name, operation) (\n    rate(thanos_memcached_operations_total[1m])\n    or\n    rate(thanos_cache_operations_total[1m])\n  )\n) * 100 > 5\n"
                  ]
                ]
              ],
              [ "Attribute", "for", [ "String", "5m" ] ],
              [
                "Attribute",
                "labels",
                [
                  "Object",
                  [ [ [ "Bare", "severity" ], [ "String", "warning" ] ] ]
                ]
              ],
              [
                "Attribute",
                "annotations",
                [
                  "Object",
                  [
                    [
                      [ "Bare", "message" ],
                      [
                        "String",
                        "The cache {{ $labels.name }} used by Mimir {{ $labels.cluster }}/{{ $labels.namespace }} is experiencing {{ printf \"%.2f\" $value }}% errors for {{ $labels.operation }} operation."
                      ]
                    ],
                    [
                      [ "Bare", "runbook_url" ],
                      [
                        "String",
                        "https://grafana.com/docs/mimir/latest/operators-guide/mimir-runbooks/#mimircacherequesterrors"
                      ]
                    ]
                  ]
                ]
              ]
            ]
          }
        ],
        [
          "Block",
          {
            "type_": "rule",
            "labels": [],
            "body": [
              [ "Attribute", "alert", [ "String", "MimirIngesterRestarts" ] ],
              [
                "Attribute",
                "expr",
                [
                  "String",
                  "changes(process_start_time_seconds{job=~\".*/(ingester.*|cortex|mimir|mimir-write.*)\"}[30m]) >= 2"
                ]
              ],
              [
                "Attribute",
                "labels",
                [
                  "Object",
                  [ [ [ "Bare", "severity" ], [ "String", "warning" ] ] ]
                ]
              ],
              [
                "Attribute",
                "annotations",
                [
                  "Object",
                  [
                    [
                      [ "Bare", "message" ],
                      [
                        "String",
                        "{{ $labels.job }}/{{ $labels.pod }} has restarted {{ printf \"%.2f\" $value }} times in the last 30 mins."
                      ]
                    ],
                    [
                      [ "Bare", "runbook_url" ],
                      [
                        "String",
                        "https://grafana.com/docs/mimir/latest/operators-guide/mimir-runbooks/#mimiringesterrestarts"
                      ]
                    ]
                  ]
                ]
              ]
            ]
          }
        ],
        [
          "Block",
          {
            "type_": "rule",
            "labels": [],
            "body": [
              [ "Attribute", "alert", [ "String", "MimirKVStoreFailure" ] ],
              [
                "Attribute",
                "expr",
                [
                  "Heredoc",
                  [
                    "EOT",
                    "\n(\n  sum by(cluster, namespace, pod, status_code, kv_name) (rate(cortex_kv_request_duration_seconds_count{status_code!~\"2.+\"}[1m]))\n  /\n  sum by(cluster, namespace, pod, status_code, kv_name) (rate(cortex_kv_request_duration_seconds_count[1m]))\n)\n# We want to get alerted only in case there's a constant failure.\n== 1\n"
                  ]
                ]
              ],
              [ "Attribute", "for", [ "String", "5m" ] ],
              [
                "Attribute",
                "labels",
                [
                  "Object",
                  [ [ [ "Bare", "severity" ], [ "String", "critical" ] ] ]
                ]
              ],
              [
                "Attribute",
                "annotations",
                [
                  "Object",
                  [
                    [
                      [ "Bare", "message" ],
                      [
                        "String",
                        "Mimir {{ $labels.pod }} in  {{ $labels.cluster }}/{{ $labels.namespace }} is failing to talk to the KV store {{ $labels.kv_name }}."
                      ]
                    ],
                    [
                      [ "Bare", "runbook_url" ],
                      [
                        "String",
                        "https://grafana.com/docs/mimir/latest/operators-guide/mimir-runbooks/#mimirkvstorefailure"
                      ]
                    ]
                  ]
                ]
              ]
            ]
          }
        ],
        [
          "Block",
          {
            "type_": "rule",
            "labels": [],
            "body": [
              [
                "Attribute",
                "alert",
                [ "String", "MimirMemoryMapAreasTooHigh" ]
              ],
              [
                "Attribute",
                "expr",
                [
                  "String",
                  "process_memory_map_areas{job=~\".*/(ingester.*|cortex|mimir|mimir-write.*|store-gateway.*|cortex|mimir|mimir-backend.*)\"} / process_memory_map_areas_limit{job=~\".*/(ingester.*|cortex|mimir|mimir-write.*|store-gateway.*|cortex|mimir|mimir-backend.*)\"} > 0.8"
                ]
              ],
              [ "Attribute", "for", [ "String", "5m" ] ],
              [
                "Attribute",
                "labels",
                [
                  "Object",
                  [ [ [ "Bare", "severity" ], [ "String", "critical" ] ] ]
                ]
              ],
              [
                "Attribute",
                "annotations",
                [
                  "Object",
                  [
                    [
                      [ "Bare", "message" ],
                      [
                        "String",
                        "{{ $labels.job }}/{{ $labels.pod }} has a number of mmap-ed areas close to the limit."
                      ]
                    ],
                    [
                      [ "Bare", "runbook_url" ],
                      [
                        "String",
                        "https://grafana.com/docs/mimir/latest/operators-guide/mimir-runbooks/#mimirmemorymapareastoohigh"
                      ]
                    ]
                  ]
                ]
              ]
            ]
          }
        ],
        [
          "Block",
          {
            "type_": "rule",
            "labels": [],
            "body": [
              [
                "Attribute",
                "alert",
                [ "String", "MimirDistributorForwardingErrorRate" ]
              ],
              [
                "Attribute",
                "expr",
                [
                  "Heredoc",
                  [
                    "EOT",
                    "\nsum by (cluster, namespace) (rate(cortex_distributor_forward_errors_total{}[1m]))\n/\nsum by (cluster, namespace) (rate(cortex_distributor_forward_requests_total{}[1m]))\n> 0.01\n"
                  ]
                ]
              ],
              [ "Attribute", "for", [ "String", "5m" ] ],
              [
                "Attribute",
                "labels",
                [
                  "Object",
                  [ [ [ "Bare", "severity" ], [ "String", "critical" ] ] ]
                ]
              ],
              [
                "Attribute",
                "annotations",
                [
                  "Object",
                  [
                    [
                      [ "Bare", "message" ],
                      [
                        "String",
                        "Mimir in {{ $labels.cluster }}/{{ $labels.namespace }} has a high failure rate when forwarding samples."
                      ]
                    ],
                    [
                      [ "Bare", "runbook_url" ],
                      [
                        "String",
                        "https://grafana.com/docs/mimir/latest/operators-guide/mimir-runbooks/#mimirdistributorforwardingerrorrate"
                      ]
                    ]
                  ]
                ]
              ]
            ]
          }
        ],
        [
          "Block",
          {
            "type_": "rule",
            "labels": [],
            "body": [
              [
                "Attribute",
                "alert",
                [ "String", "MimirIngesterInstanceHasNoTenants" ]
              ],
              [
                "Attribute",
                "expr",
                [
                  "Heredoc",
                  [
                    "EOT",
                    "\n(min by(cluster, namespace, pod) (cortex_ingester_memory_users) == 0)\nand on (cluster, namespace)\n# Only if there are more time-series than would be expected due to continuous testing load\n(\n  sum by(cluster, namespace) (cortex_ingester_memory_series)\n  /\n  max by(cluster, namespace) (cortex_distributor_replication_factor)\n) > 100000\n"
                  ]
                ]
              ],
              [ "Attribute", "for", [ "String", "1h" ] ],
              [
                "Attribute",
                "labels",
                [
                  "Object",
                  [ [ [ "Bare", "severity" ], [ "String", "warning" ] ] ]
                ]
              ],
              [
                "Attribute",
                "annotations",
                [
                  "Object",
                  [
                    [
                      [ "Bare", "message" ],
                      [
                        "String",
                        "Mimir ingester {{ $labels.pod }} in {{ $labels.cluster }}/{{ $labels.namespace }} has no tenants assigned."
                      ]
                    ],
                    [
                      [ "Bare", "runbook_url" ],
                      [
                        "String",
                        "https://grafana.com/docs/mimir/latest/operators-guide/mimir-runbooks/#mimiringesterinstancehasnotenants"
                      ]
                    ]
                  ]
                ]
              ]
            ]
          }
        ],
        [
          "Block",
          {
            "type_": "rule",
            "labels": [],
            "body": [
              [
                "Attribute",
                "alert",
                [ "String", "MimirRulerInstanceHasNoRuleGroups" ]
              ],
              [
                "Attribute",
                "expr",
                [
                  "Heredoc",
                  [
                    "EOT",
                    "\n# Alert on ruler instances in microservices mode that have no rule groups assigned,\nmin by(cluster, namespace, pod) (cortex_ruler_managers_total{pod=~\"(.*mimir-)?ruler.*\"}) == 0\n# but only if other ruler instances of the same cell do have rule groups assigned\nand on (cluster, namespace)\n(max by(cluster, namespace) (cortex_ruler_managers_total) > 0)\n# and there are more than two instances overall\nand on (cluster, namespace)\n(count by (cluster, namespace) (cortex_ruler_managers_total) > 2)\n"
                  ]
                ]
              ],
              [ "Attribute", "for", [ "String", "1h" ] ],
              [
                "Attribute",
                "labels",
                [
                  "Object",
                  [ [ [ "Bare", "severity" ], [ "String", "warning" ] ] ]
                ]
              ],
              [
                "Attribute",
                "annotations",
                [
                  "Object",
                  [
                    [
                      [ "Bare", "message" ],
                      [
                        "String",
                        "Mimir ruler {{ $labels.pod }} in {{ $labels.cluster }}/{{ $labels.namespace }} has no rule groups assigned."
                      ]
                    ],
                    [
                      [ "Bare", "runbook_url" ],
                      [
                        "String",
                        "https://grafana.com/docs/mimir/latest/operators-guide/mimir-runbooks/#mimirrulerinstancehasnorulegroups"
                      ]
                    ]
                  ]
                ]
              ]
            ]
          }
        ],
        [
          "Block",
          {
            "type_": "rule",
            "labels": [],
            "body": [
              [
                "Attribute",
                "alert",
                [ "String", "MimirRingMembersMismatch" ]
              ],
              [
                "Attribute",
                "expr",
                [
                  "Heredoc",
                  [
                    "EOT",
                    "\n(\n  avg by(cluster, namespace) (sum by(cluster, namespace, pod) (cortex_ring_members{name=\"ingester\",job=~\".*/(ingester.*|cortex|mimir|mimir-write.*)\"}))\n  != sum by(cluster, namespace) (up{job=~\".*/(ingester.*|cortex|mimir|mimir-write.*)\"})\n)\nand\n(\n  count by(cluster, namespace) (cortex_build_info) > 0\n)\n"
                  ]
                ]
              ],
              [ "Attribute", "for", [ "String", "15m" ] ],
              [
                "Attribute",
                "labels",
                [
                  "Object",
                  [
                    [ [ "Bare", "component" ], [ "String", "ingester" ] ],
                    [ [ "Bare", "severity" ], [ "String", "warning" ] ]
                  ]
                ]
              ],
              [
                "Attribute",
                "annotations",
                [
                  "Object",
                  [
                    [
                      [ "Bare", "message" ],
                      [
                        "String",
                        "Number of members in Mimir ingester hash ring does not match the expected number in {{ $labels.cluster }}/{{ $labels.namespace }}."
                      ]
                    ],
                    [
                      [ "Bare", "runbook_url" ],
                      [
                        "String",
                        "https://grafana.com/docs/mimir/latest/operators-guide/mimir-runbooks/#mimirringmembersmismatch"
                      ]
                    ]
                  ]
                ]
              ]
            ]
          }
        ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "resource",
      "labels": [
        [ "Lit", "mimir_rule_group_alerting" ],
        [ "Lit", "mimir_instance_limits_alerts" ]
      ],
      "body": [
        [ "Attribute", "name", [ "String", "mimir_instance_limits_alerts" ] ],
        [ "Attribute", "namespace", [ "String", "default" ] ],
        [
          "Block",
          {
            "type_": "rule",
            "labels": [],
            "body": [
              [
                "Attribute",
                "alert",
                [ "String", "MimirIngesterReachingSeriesLimit" ]
              ],
              [
                "Attribute",
                "expr",
                [
                  "Heredoc",
                  [
                    "EOT",
                    "\n(\n    (cortex_ingester_memory_series / ignoring(limit) cortex_ingester_instance_limits{limit=\"max_series\"})\n    and ignoring (limit)\n    (cortex_ingester_instance_limits{limit=\"max_series\"} > 0)\n) > 0.8\n"
                  ]
                ]
              ],
              [ "Attribute", "for", [ "String", "3h" ] ],
              [
                "Attribute",
                "labels",
                [
                  "Object",
                  [ [ [ "Bare", "severity" ], [ "String", "warning" ] ] ]
                ]
              ],
              [
                "Attribute",
                "annotations",
                [
                  "Object",
                  [
                    [
                      [ "Bare", "message" ],
                      [
                        "String",
