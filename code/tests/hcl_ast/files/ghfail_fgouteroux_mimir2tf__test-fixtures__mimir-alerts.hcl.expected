                      ]
                    ],
                    [
                      [ "Bare", "runbook_url" ],
                      [
                        "String",
                        "https://grafana.com/docs/mimir/latest/operators-guide/mimir-runbooks/#mimirbucketindexnotupdated"
                      ]
                    ]
                  ]
                ]
