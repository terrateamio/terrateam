              [
                "Attribute",
                "annotations",
                [
                  "Object",
                  [
                    [
                      [ "Bare", "message" ],
                      [
                        "String",
                        "Mimir Ruler {{ $labels.pod }} in {{ $labels.cluster }}/{{ $labels.namespace }} is experiencing {{ printf \"%.2f\" $value }}% write (push) errors."
