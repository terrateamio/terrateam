        [
          "Block",
          {
            "type_": "rule",
            "labels": [],
            "body": [
              [
                "Attribute",
                "alert",
                [ "String", "MimirQuerierHasNotScanTheBucket" ]
              ],
              [
                "Attribute",
                "expr",
                [
                  "Heredoc",
                  [
                    "EOT",
                    "\n(time() - cortex_querier_blocks_last_successful_scan_timestamp_seconds > 60 * 30)\nand\ncortex_querier_blocks_last_successful_scan_timestamp_seconds > 0\n"
                  ]
                ]
              ],
              [ "Attribute", "for", [ "String", "5m" ] ],
              [
                "Attribute",
                "labels",
                [
                  "Object",
                  [ [ [ "Bare", "severity" ], [ "String", "critical" ] ] ]
                ]
              ],
              [
                "Attribute",
                "annotations",
                [
                  "Object",
                  [
                    [
                      [ "Bare", "message" ],
                      [
                        "String",
                        "Mimir Querier {{ $labels.pod }} in {{ $labels.cluster }}/{{ $labels.namespace }} has not successfully scanned the bucket since {{ $value | humanizeDuration }}."
                      ]
                    ],
                    [
                      [ "Bare", "runbook_url" ],
                      [
                        "String",
                        "https://grafana.com/docs/mimir/latest/operators-guide/mimir-runbooks/#mimirquerierhasnotscanthebucket"
                      ]
                    ]
                  ]
                ]
              ]
            ]
          }
        ],
        [
          "Block",
          {
            "type_": "rule",
            "labels": [],
            "body": [
              [
                "Attribute",
                "alert",
                [ "String", "MimirQuerierHighRefetchRate" ]
              ],
              [
                "Attribute",
                "expr",
                [
                  "Heredoc",
                  [
                    "EOT",
                    "\n100 * (\n  (\n    sum by(cluster, namespace) (rate(cortex_querier_storegateway_refetches_per_query_count[5m]))\n    -\n    sum by(cluster, namespace) (rate(cortex_querier_storegateway_refetches_per_query_bucket{le=\"0.0\"}[5m]))\n  )\n  /\n  sum by(cluster, namespace) (rate(cortex_querier_storegateway_refetches_per_query_count[5m]))\n)\n> 1\n"
                  ]
                ]
              ],
              [ "Attribute", "for", [ "String", "10m" ] ],
              [
                "Attribute",
                "labels",
                [
                  "Object",
                  [ [ [ "Bare", "severity" ], [ "String", "warning" ] ] ]
                ]
              ],
              [
                "Attribute",
                "annotations",
                [
                  "Object",
                  [
                    [
                      [ "Bare", "message" ],
                      [
                        "String",
                        "Mimir Queries in {{ $labels.cluster }}/{{ $labels.namespace }} are refetching series from different store-gateways (because of missing blocks) for the {{ printf \"%.0f\" $value }}% of queries."
                      ]
                    ],
                    [
                      [ "Bare", "runbook_url" ],
                      [
                        "String",
                        "https://grafana.com/docs/mimir/latest/operators-guide/mimir-runbooks/#mimirquerierhighrefetchrate"
                      ]
                    ]
                  ]
                ]
              ]
            ]
          }
        ],
        [
          "Block",
          {
            "type_": "rule",
            "labels": [],
            "body": [
              [
                "Attribute",
                "alert",
                [ "String", "MimirStoreGatewayHasNotSyncTheBucket" ]
              ],
              [
                "Attribute",
                "expr",
                [
                  "Heredoc",
                  [
                    "EOT",
                    "\n(time() - cortex_bucket_stores_blocks_last_successful_sync_timestamp_seconds{component=\"store-gateway\"} > 60 * 30)\nand\ncortex_bucket_stores_blocks_last_successful_sync_timestamp_seconds{component=\"store-gateway\"} > 0\n"
                  ]
                ]
              ],
              [ "Attribute", "for", [ "String", "5m" ] ],
              [
                "Attribute",
                "labels",
                [
                  "Object",
                  [ [ [ "Bare", "severity" ], [ "String", "critical" ] ] ]
                ]
              ],
              [
                "Attribute",
                "annotations",
                [
                  "Object",
                  [
                    [
                      [ "Bare", "message" ],
                      [
                        "String",
                        "Mimir store-gateway {{ $labels.pod }} in {{ $labels.cluster }}/{{ $labels.namespace }} has not successfully synched the bucket since {{ $value | humanizeDuration }}."
                      ]
                    ],
                    [
                      [ "Bare", "runbook_url" ],
                      [
                        "String",
                        "https://grafana.com/docs/mimir/latest/operators-guide/mimir-runbooks/#mimirstoregatewayhasnotsyncthebucket"
                      ]
                    ]
                  ]
                ]
              ]
            ]
          }
        ],
        [
          "Block",
          {
            "type_": "rule",
            "labels": [],
            "body": [
              [
                "Attribute",
                "alert",
                [ "String", "MimirStoreGatewayNoSyncedTenants" ]
              ],
              [
                "Attribute",
                "expr",
                [
                  "String",
                  "min by(cluster, namespace, pod) (cortex_bucket_stores_tenants_synced{component=\"store-gateway\"}) == 0"
                ]
              ],
              [ "Attribute", "for", [ "String", "1h" ] ],
              [
                "Attribute",
                "labels",
                [
                  "Object",
                  [ [ [ "Bare", "severity" ], [ "String", "warning" ] ] ]
                ]
              ],
              [
                "Attribute",
                "annotations",
                [
                  "Object",
                  [
                    [
                      [ "Bare", "message" ],
                      [
                        "String",
                        "Mimir store-gateway {{ $labels.pod }} in {{ $labels.cluster }}/{{ $labels.namespace }} is not syncing any blocks for any tenant."
                      ]
                    ],
                    [
                      [ "Bare", "runbook_url" ],
                      [
                        "String",
                        "https://grafana.com/docs/mimir/latest/operators-guide/mimir-runbooks/#mimirstoregatewaynosyncedtenants"
                      ]
                    ]
                  ]
                ]
              ]
            ]
          }
        ],
        [
          "Block",
          {
            "type_": "rule",
            "labels": [],
            "body": [
              [
                "Attribute",
                "alert",
                [ "String", "MimirBucketIndexNotUpdated" ]
              ],
              [
