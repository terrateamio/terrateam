  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "vmseries_universal" ] ],
      "body": [
        [
          "Attribute",
          "description",
          [
            "Heredoc",
            [
              "EOF",
              "\nA map defining common settings for all created VM-Series instances. \n  \nIt duplicates popular properties from `vmseries` variable, specifically `vmseries.image` and `vmseries.virtual_machine` maps.\nHowever, if values are set in those maps, they still take precedence over the ones set within this variable. As a result, all\nuniversal properties can be overriden on a per-VM basis.\n\nFollowing properties are supported:\n  \n- `version`           - (`string`, optional) describes the PAN-OS image version from Azure Marketplace.\n- `size`              - (`string`, optional, defaults to module default) Azure VM size (type). Consult the *VM-Series\n                        Deployment Guide* as only a few selected sizes are supported.\n- `bootstrap_options` - (`map`, optional, mutually exclusive with `bootstrap_package`) bootstrap options passed to PAN-OS\n                        when launched for the 1st time, for details see module documentation.\n- `bootstrap_package` - (`map`, optional, mutually exclusive with `bootstrap_options`) a map defining content of the bootstrap\n                        package. For details and available properties refer to `vmseries` variable.\n"
            ]
          ]
        ],
        [ "Attribute", "default", [ "Object", [] ] ],
        [
          "Attribute",
          "type",
          [
            "Fun_call",
