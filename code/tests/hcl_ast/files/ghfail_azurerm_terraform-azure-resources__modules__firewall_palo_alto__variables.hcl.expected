  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "vnet_peerings" ] ],
      "body": [
        [
          "Attribute",
          "description",
          [
            "Heredoc",
            [
              "EOF",
              "\nA map defining VNET peerings.\n\nFollowing properties are supported:\n- `local_vnet_name`            - (`string`, required) name of the local VNET.\n- `local_resource_group_name`  - (`string`, optional) name of the resource group, in which local VNET exists.\n- `remote_vnet_name`           - (`string`, required) name of the remote VNET.\n- `remote_resource_group_name` - (`string`, optional) name of the resource group, in which remote VNET exists.\n"
            ]
          ]
        ],
        [ "Attribute", "default", [ "Object", [] ] ],
        [
          "Attribute",
          "type",
          [
            "Fun_call",
            [
              "map",
              [
                [
                  "Fun_call",
                  [
                    "object",
                    [
                      [
                        "Object",
                        [
                          [
                            [ "Bare", "local_vnet_name" ], [ "Id", "string" ]
                          ],
                          [
                            [ "Bare", "local_resource_group_name" ],
                            [
                              "Fun_call",
                              [ "optional", [ [ "Id", "string" ] ] ]
                            ]
                          ],
                          [
                            [ "Bare", "remote_vnet_name" ],
                            [ "Id", "string" ]
                          ],
                          [
                            [ "Bare", "remote_resource_group_name" ],
                            [
                              "Fun_call",
                              [ "optional", [ [ "Id", "string" ] ] ]
                            ]
                          ]
                        ]
                      ]
                    ]
                  ]
                ]
              ]
            ]
          ]
        ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "public_ips" ] ],
      "body": [
        [
          "Attribute",
          "description",
          [
            "Heredoc",
            [
              "EOF",
              "\nA map defining Public IP Addresses and Prefixes.\n\nFollowing properties are available:\n\n- `public_ip_addresses` - (`map`, optional) map of objects describing Public IP Addresses, please refer to\n                          [module documentation](../../modules/public_ip/README.md#public_ip_addresses)\n                          for available properties.\n- `public_ip_prefixes`  - (`map`, optional) map of objects describing Public IP Prefixes, please refer to\n                          [module documentation](../../modules/public_ip/README.md#public_ip_prefixes)\n                          for available properties.\n"
            ]
          ]
        ],
        [ "Attribute", "default", [ "Object", [] ] ],
        [
          "Attribute",
          "type",
          [
            "Fun_call",
            [
              "object",
