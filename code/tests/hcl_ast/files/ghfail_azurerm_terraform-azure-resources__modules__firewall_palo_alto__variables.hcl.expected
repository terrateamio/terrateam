  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "availability_sets" ] ],
      "body": [
        [
          "Attribute",
          "description",
          [
            "Heredoc",
            [
              "EOF",
              "\nA map defining availability sets. Can be used to provide infrastructure high availability when zones cannot be used.\n\nFollowing properties are supported:\n\n- `name`                - (`string`, required) name of the Application Insights.\n- `update_domain_count` - (`number`, optional, defaults to Azure default) specifies the number of update domains that are used.\n- `fault_domain_count`  - (`number`, optional, defaults to Azure default) specifies the number of fault domains that are used.\n\n**Note!** \\\nPlease keep in mind that Azure defaults are not working for every region (especially the small ones, without any Availability\nZones). Please verify how many update and fault domain are supported in a region before deploying this resource.\n"
            ]
          ]
        ],
        [ "Attribute", "default", [ "Object", [] ] ],
        [ "Attribute", "nullable", [ "Bool", false ] ],
        [
          "Attribute",
          "type",
          [
            "Fun_call",
            [
              "map",
              [
                [
                  "Fun_call",
                  [
                    "object",
                    [
                      [
                        "Object",
                        [
                          [ [ "Bare", "name" ], [ "Id", "string" ] ],
                          [
                            [ "Bare", "update_domain_count" ],
                            [
                              "Fun_call",
                              [ "optional", [ [ "Id", "number" ] ] ]
                            ]
                          ],
                          [
                            [ "Bare", "fault_domain_count" ],
                            [
                              "Fun_call",
                              [ "optional", [ [ "Id", "number" ] ] ]
                            ]
                          ]
                        ]
                      ]
                    ]
                  ]
                ]
              ]
            ]
          ]
        ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "ngfw_metrics" ] ],
      "body": [
        [
          "Attribute",
          "description",
          [
            "Heredoc",
            [
              "EOF",
              "\nA map controlling metrics-relates resources.\n\nWhen set to explicit `null` (default) it will disable any metrics resources in this deployment.\n\nWhen defined it will either create or source a Log Analytics Workspace and create Application Insights instances (one per each\nScale Set). All instances will be automatically connected to the workspace. The name of the Application Insights instance will\nbe derived from the Scale Set name and suffixed with `-ai`.\n\nAll the settings available below are common to the Log Analytics Workspace and Application Insight instances.\n\nFollowing properties are available:\n\n- `name`                      - (`string`, required) name of the (common) Log Analytics Workspace.\n- `create_workspace`          - (`bool`, optional, defaults to `true`) controls whether we create or source an existing Log\n                                Analytics Workspace.\n- `resource_group_name`       - (`string`, optional, defaults to `var.resource_group_name`) name of the Resource Group hosting\n                                the Log Analytics Workspace.\n- `sku`                       - (`string`, optional, defaults to module default) the SKU of the Log Analytics Workspace.\n- `metrics_retention_in_days` - (`number`, optional, defaults to module default) workspace and insights data retention in days,\n                                possible values are between 30 and 730. For sourced Workspaces this applies only to the\n                                Application Insights instances.\n"
            ]
          ]
        ],
        [ "Attribute", "default", [ "Null" ] ],
        [
          "Attribute",
          "type",
          [
            "Fun_call",
            [
              "object",
              [
                [
                  "Object",
                  [
                    [ [ "Bare", "name" ], [ "Id", "string" ] ],
                    [
                      [ "Bare", "create_workspace" ],
                      [
                        "Fun_call",
                        [
                          "optional", [ [ "Id", "bool" ], [ "Bool", true ] ]
                        ]
                      ]
                    ],
                    [
                      [ "Bare", "resource_group_name" ],
                      [ "Fun_call", [ "optional", [ [ "Id", "string" ] ] ] ]
                    ],
                    [
                      [ "Bare", "sku" ],
                      [ "Fun_call", [ "optional", [ [ "Id", "string" ] ] ] ]
                    ],
                    [
                      [ "Bare", "metrics_retention_in_days" ],
                      [ "Fun_call", [ "optional", [ [ "Id", "number" ] ] ] ]
                    ]
                  ]
                ]
              ]
            ]
          ]
        ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "bootstrap_storages" ] ],
      "body": [
        [
          "Attribute",
          "description",
          [
            "Heredoc",
            [
              "EOF",
              "\nA map defining Azure Storage Accounts used to host file shares for bootstrapping NGFWs.\n\nYou can create or re-use an existing Storage Account and/or File Share. For details on all available properties please refer to\n[module's documentation](../../modules/bootstrap/README.md). Following is just an extract of the most important ones:\n\n- `name`                      - (`string`, required) name of the Storage Account that will be created or sourced.\n\n  **Note** \\\n  For new Storage Accounts this name will not be prefixed with `var.name_prefix`. \\\n  Please note the limitations on naming. This has to be a globally unique name, between 3 and 63 chars, only lower-case letters\n  and numbers.\n\n- `resource_group_name`       - (`string`, optional, defaults to `null`) name of the Resource Group that hosts (sourced) or\n                                will host (created) a Storage Account. When skipped the code will fall back to\n                                `var.resource_group_name`.\n- `storage_account`           - (`map`, optional, defaults to `{}`) a map controlling basic Storage Account configuration.\n\n  The property you should pay attention to is:\n\n  - `create` - (`bool`, optional, defaults to module default) controls if the Storage Account specified in the `name` property\n               will be created or sourced.\n\n  For detailed documentation see [module's documentation](../../modules/bootstrap/README.md#storage_account).\n\n- `storage_network_security`  - (`map`, optional, defaults to `{}`) a map defining network security settings for a **new**\n                                storage account.\n\n  The properties you should pay attention to are:\n\n  - `allowed_subnet_keys` - (`list`, optional, defaults to `[]`) a list of keys pointing to Subnet definitions in the\n                            `var.vnets` map. These Subnets will have dedicated access to the Storage Account. For this to work\n                            they also need to have the Storage Account Service Endpoint enabled.\n  - `vnet_key`            - (`string`, optional) a key pointing to a VNET definition in the `var.vnets` map that stores the\n                            Subnets described in `allowed_subnet_keys`.\n\n  For detailed documentation see [module's documentation](../../modules/bootstrap/README.md#storage_network_security).\n\n- `file_shares_configuration` - (`map`, optional, defaults to `{}`) a map defining common File Share setting.\n\n  The properties you should pay attention to are:\n\n  - `create_file_shares`            - (`bool`, optional, defaults to module default) controls if the File Shares defined in the\n                                      `file_shares` property will be created or sourced.\n  - `disable_package_dirs_creation` - (`bool`, optional, defaults to module default) for sourced File Shares, controls if the\n                                      bootstrap package folder structure will be created.\n\n  For detailed documentation see [module's documentation](../../modules/bootstrap/README.md#file_shares_configuration).\n\n- `file_shares`               - (`map`, optional, defaults to `{}`) a map that holds File Shares and bootstrap package\n                                configuration. For detailed description see\n                                [module's documentation](../../modules/bootstrap/README.md#file_shares).\n"
            ]
          ]
        ],
        [ "Attribute", "default", [ "Object", [] ] ],
        [ "Attribute", "nullable", [ "Bool", false ] ],
        [
          "Attribute",
          "type",
          [
            "Fun_call",
            [
              "map",
              [
                [
                  "Fun_call",
                  [
                    "object",
                    [
                      [
                        "Object",
                        [
                          [ [ "Bare", "name" ], [ "Id", "string" ] ],
                          [
                            [ "Bare", "resource_group_name" ],
                            [
                              "Fun_call",
                              [ "optional", [ [ "Id", "string" ] ] ]
                            ]
                          ],
                          [
                            [ "Bare", "storage_account" ],
                            [
                              "Fun_call",
                              [
                                "optional",
                                [
                                  [
                                    "Fun_call",
                                    [
                                      "object",
                                      [
                                        [
                                          "Object",
                                          [
                                            [
                                              [ "Bare", "create" ],
                                              [
                                                "Fun_call",
                                                [
                                                  "optional",
                                                  [ [ "Id", "bool" ] ]
                                                ]
                                              ]
                                            ],
                                            [
                                              [ "Bare", "replication_type" ],
                                              [
                                                "Fun_call",
                                                [
                                                  "optional",
