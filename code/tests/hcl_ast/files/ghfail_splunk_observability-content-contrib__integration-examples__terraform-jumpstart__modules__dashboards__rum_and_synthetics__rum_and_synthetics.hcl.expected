              "\n<table width=\"100%\" height=\"100%\" rules=\"none\"><tr><td valign=\"middle\" align=\"center\" bgcolor=\"#ab006b\">\n<font size=\"6\" color=\"white\"> Real-User and Synthetics Test Data </font>\n</td></tr></table>\n"
            ]
          ]
        ],
        [ "Attribute", "name", [ "String", "Web Vitals" ] ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "resource",
      "labels": [
        [ "Lit", "signalfx_single_value_chart" ],
        [ "Lit", "rum_and_synthetics_1" ]
      ],
      "body": [
        [ "Attribute", "color_by", [ "String", "Dimension" ] ],
        [ "Attribute", "description", [ "String", "p75" ] ],
        [ "Attribute", "is_timestamp_hidden", [ "Bool", false ] ],
        [ "Attribute", "max_delay", [ "Int", 0 ] ],
        [ "Attribute", "max_precision", [ "Int", 0 ] ],
        [ "Attribute", "name", [ "String", "Real-User Page Load Latency" ] ],
        [
          "Attribute",
          "program_text",
          [
            "Heredoc",
            [
              "EOF",
              "\nA = data('rum.page_view.time.ns.p75', filter=filter('app', '*') and filter('sf_environment', '*')).percentile(pct=75, by=['app', 'sf_environment']).publish(label='A', enable=False)\nB = (A/1000000000).publish(label='B')\n"
            ]
          ]
        ],
        [ "Attribute", "secondary_visualization", [ "String", "None" ] ],
        [ "Attribute", "show_spark_line", [ "Bool", false ] ],
        [ "Attribute", "unit_prefix", [ "String", "Metric" ] ],
        [
          "Block",
          {
            "type_": "viz_options",
            "labels": [],
            "body": [
              [
                "Attribute",
                "display_name",
                [ "String", "Real-User Latency in Seconds" ]
              ],
              [ "Attribute", "label", [ "String", "B" ] ],
              [ "Attribute", "value_suffix", [ "String", "sec" ] ]
            ]
          }
        ],
        [
          "Block",
          {
            "type_": "viz_options",
            "labels": [],
