                      ],
                      [
                        "Attr",
                        [
                          [ "Id", "var" ],
                          [ "A_string", "provisioning_mode" ]
                        ]
                      ]
                    ]
                  ]
                ]
              ],
              [
                "Attribute",
                "error_message",
                [
                  "String",
                  "The provisioning mode must be one of the following: dedicated, distributed, combined"
                ]
