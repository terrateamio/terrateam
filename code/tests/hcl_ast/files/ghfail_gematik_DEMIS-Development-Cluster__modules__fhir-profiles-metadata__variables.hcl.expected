        [
          "Attribute",
          "description",
          [
            "String",
            "Provisioning mode for the FHIR Profiles Metadata. Allowed values are: dedicated, distributed, combined"
          ]
        ],
        [ "Attribute", "type", [ "Id", "string" ] ],
        [ "Attribute", "nullable", [ "Bool", false ] ],
        [ "Attribute", "default", [ "String", "dedicated" ] ],
        [
          "Block",
