  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "profile_type" ] ],
      "body": [
        [
          "Attribute",
          "description",
          [
            "String",
            "Profile types for the validation services. Allowed values are: fhir-profile-snapshots, igs-profile-snapshots, ars-profile-snapshots, are-profile-snapshots"
          ]
        ],
        [ "Attribute", "type", [ "Id", "string" ] ],
        [
          "Block",
          {
            "type_": "validation",
            "labels": [],
            "body": [
              [
                "Attribute",
                "condition",
                [
                  "Fun_call",
                  [
                    "contains",
                    [
                      [
                        "Tuple",
                        [
                          [ "String", "fhir-profile-snapshots" ],
                          [ "String", "igs-profile-snapshots" ],
                          [ "String", "ars-profile-snapshots" ],
                          [ "String", "are-profile-snapshots" ]
                        ]
                      ],
                      [
                        "Attr",
                        [ [ "Id", "var" ], [ "A_string", "profile_type" ] ]
                      ]
                    ]
                  ]
                ]
              ],
              [
                "Attribute",
                "error_message",
                [
                  "String",
                  "The profile type must be one of the following: fhir-profile-snapshots, igs-profile-snapshots, ars-profile-snapshots, are-profile-snapshots"
                ]
              ]
            ]
          }
        ]
      ]
    }
  ],
  [
    "Block",
    {
