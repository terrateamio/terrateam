        [
          "Block",
          {
            "type_": "validation",
            "labels": [],
            "body": [
              [
                "Attribute",
                "condition",
                [
                  "Fun_call",
                  [
                    "alltrue",
                    [
                      [
                        "For_tuple",
                        {
                          "identifiers": [ "custom_domain", [] ],
                          "input": [
                            "Attr",
                            [
                              [ "Id", "var" ],
                              [ "A_string", "custom_domains" ]
                            ]
                          ],
                          "output": [
                            "Log_and",
                            [
                              [
                                "Log_and",
                                [
                                  [
                                    "Fun_call",
                                    [
                                      "can",
                                      [
                                        [
                                          "Fun_call",
                                          [
                                            "regex",
                                            [
                                              [
                                                "String",
                                                "^[a-zA-Z0-9][0-9A-Za-z-]*[a-zA-Z0-9]$"
                                              ],
                                              [
                                                "Attr",
                                                [
                                                  [ "Id", "custom_domain" ],
                                                  [ "A_string", "name" ]
                                                ]
                                              ]
                                            ]
                                          ]
                                        ]
                                      ]
                                    ]
                                  ],
                                  [
                                    "Gte",
                                    [
                                      [
                                        "Fun_call",
                                        [
                                          "length",
                                          [
                                            [
                                              "Attr",
                                              [
                                                [ "Id", "custom_domain" ],
                                                [ "A_string", "name" ]
                                              ]
                                            ]
                                          ]
                                        ]
                                      ],
                                      [ "Int", 2 ]
                                    ]
                                  ]
                                ]
                              ],
                              [
                                "Lte",
                                [
                                  [
                                    "Fun_call",
                                    [
                                      "length",
                                      [
                                        [
                                          "Attr",
                                          [
                                            [ "Id", "custom_domain" ],
                                            [ "A_string", "name" ]
                                          ]
                                        ]
                                      ]
                                    ]
                                  ],
                                  [ "Int", 260 ]
                                ]
                              ]
                            ]
                          ],
                          "cond": null
                        }
                      ]
                    ]
                  ]
                ]
              ],
              [
                "Attribute",
                "error_message",
                [
                  "String",
                  "Custom domain names must be between 2 and 260 characters in length, must begin with a letter or number, end with a letter or number and contain only letters, numbers and hyphens."
                ]
              ]
            ]
          }
        ]
      ]
    }
