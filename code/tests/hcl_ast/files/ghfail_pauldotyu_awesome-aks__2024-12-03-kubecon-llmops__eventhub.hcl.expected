  ],
  [
    "Block",
    {
      "type_": "resource",
      "labels": [
        [ "Lit", "azurerm_monitor_alert_prometheus_rule_group" ],
        [ "Lit", "example" ]
      ],
      "body": [
        [
          "Attribute",
          "resource_group_name",
          [
            "Attr",
            [
              [
                "Attr",
                [
                  [ "Id", "azurerm_resource_group" ],
                  [ "A_string", "example" ]
                ]
              ],
              [ "A_string", "name" ]
            ]
          ]
        ],
        [
          "Attribute",
          "location",
          [
            "Attr",
            [
              [
                "Attr",
                [
                  [ "Id", "azurerm_resource_group" ],
                  [ "A_string", "example" ]
                ]
              ],
              [ "A_string", "location" ]
            ]
          ]
        ],
        [
          "Attribute",
          "cluster_name",
          [
            "Attr",
            [
              [
                "Attr",
                [
                  [ "Id", "azurerm_kubernetes_cluster" ],
                  [ "A_string", "example" ]
                ]
              ],
              [ "A_string", "name" ]
            ]
          ]
        ],
        [
          "Attribute",
          "name",
          [
            "Template",
            [
              [ "Literal", "ProductRecordingRulesRuleGroup - " ],
              [
                "Interpolation",
                {
                  "expr": [
                    "Attr",
                    [
                      [
                        "Attr",
                        [
                          [ "Id", "azurerm_kubernetes_cluster" ],
                          [ "A_string", "example" ]
                        ]
                      ],
                      [ "A_string", "name" ]
                    ]
                  ],
                  "strip_before": false,
                  "strip_after": false
                }
              ]
            ]
          ]
        ],
        [
          "Attribute",
          "description",
          [ "String", "Model tuning required when product count increases." ]
        ],
        [ "Attribute", "rule_group_enabled", [ "Bool", true ] ],
        [ "Attribute", "interval", [ "String", "PT1M" ] ],
        [
          "Attribute",
          "scopes",
          [
            "Tuple",
            [
              [
                "Attr",
                [
                  [
                    "Attr",
                    [
                      [ "Id", "azurerm_monitor_workspace" ],
                      [ "A_string", "example" ]
                    ]
                  ],
                  [ "A_string", "id" ]
                ]
              ],
              [
                "Attr",
                [
                  [
                    "Attr",
                    [
                      [ "Id", "azurerm_kubernetes_cluster" ],
                      [ "A_string", "example" ]
                    ]
                  ],
                  [ "A_string", "id" ]
                ]
              ]
            ]
          ]
        ],
        [
          "Block",
          {
            "type_": "rule",
            "labels": [],
            "body": [
              [
                "Attribute",
                "alert",
                [ "String", "Total_Product_Count_Delta" ]
              ],
              [ "Attribute", "severity", [ "Int", 3 ] ],
              [ "Attribute", "enabled", [ "Bool", true ] ],
              [ "Attribute", "for", [ "String", "PT1M" ] ],
              [
                "Attribute",
                "expression",
                [
                  "Heredoc",
                  [
                    "EOF",
                    "\nidelta(total_product_count{job=\"product-service\"}[60s]) > 0\n"
                  ]
                ]
              ],
              [
                "Block",
                {
                  "type_": "action",
                  "labels": [],
                  "body": [
                    [
                      "Attribute",
                      "action_group_id",
                      [
                        "Attr",
                        [
                          [
                            "Attr",
                            [
                              [ "Id", "azurerm_monitor_action_group" ],
                              [ "A_string", "email" ]
                            ]
                          ],
                          [ "A_string", "id" ]
                        ]
                      ]
                    ]
                  ]
                }
              ],
              [
                "Block",
                {
                  "type_": "action",
                  "labels": [],
                  "body": [
                    [
                      "Attribute",
                      "action_group_id",
                      [
                        "Attr",
                        [
                          [
                            "Attr",
                            [
                              [ "Id", "azurerm_monitor_action_group" ],
                              [ "A_string", "eventhub" ]
                            ]
                          ],
                          [ "A_string", "id" ]
                        ]
                      ]
                    ]
                  ]
                }
              ],
              [
                "Block",
                {
                  "type_": "alert_resolution",
                  "labels": [],
                  "body": [
                    [ "Attribute", "auto_resolved", [ "Bool", true ] ],
                    [ "Attribute", "time_to_resolve", [ "String", "PT30M" ] ]
                  ]
                }
              ]
            ]
          }
        ]
      ]
    }
  ]
]
