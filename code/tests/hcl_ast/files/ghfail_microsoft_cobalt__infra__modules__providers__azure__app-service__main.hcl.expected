[
  [
    "Block",
    {
      "type_": "data",
      "labels": [ [ "Lit", "azurerm_client_config" ], [ "Lit", "current" ] ],
      "body": []
    }
  ],
  [
    "Block",
    {
      "type_": "locals",
      "labels": [],
      "body": [
        [
          "Attribute",
          "access_restriction_description",
          [ "String", "blocking public traffic to app service" ]
        ],
        [
          "Attribute",
          "access_restriction_name",
          [ "String", "vnet_restriction" ]
        ],
        [
          "Attribute",
          "app_names",
          [
            "Fun_call",
            [
              "keys",
              [
                [
                  "Attr",
                  [ [ "Id", "var" ], [ "A_string", "app_service_config" ] ]
                ]
              ]
            ]
          ]
        ],
        [
          "Attribute",
          "app_configs",
          [
            "Fun_call",
            [
              "values",
              [
                [
                  "Attr",
                  [ [ "Id", "var" ], [ "A_string", "app_service_config" ] ]
                ]
              ]
            ]
          ]
        ],
        [
          "Attribute",
          "app_linux_fx_versions",
          [
            "For_object",
            {
              "identifiers": [ "app_name", [] ],
              "input": [
                "Attr", [ [ "Id", "local" ], [ "A_string", "app_names" ] ]
              ],
              "key_output": [ "Id", "app_name" ],
              "value_output": [
                "Cond",
                {
                  "if_": [
                    "Equal",
                    [
                      [
                        "Attr",
                        [
                          [
                            "Idx",
                            [
                              [
                                "Attr",
                                [
                                  [ "Id", "var" ],
                                  [ "A_string", "app_service_config" ]
                                ]
                              ],
                              [ "Id", "app_name" ]
                            ]
                          ],
                          [ "A_string", "image" ]
                        ]
                      ],
                      [ "Null" ]
                    ]
                  ],
                  "then_": [
                    "Attr",
                    [
                      [
                        "Idx",
                        [
                          [
                            "Attr",
                            [
                              [ "Id", "var" ],
                              [ "A_string", "app_service_config" ]
                            ]
                          ],
                          [ "Id", "app_name" ]
                        ]
                      ],
                      [ "A_string", "linux_fx_version" ]
                    ]
                  ],
                  "else_": [
                    "Cond",
                    {
                      "if_": [
                        "Equal",
                        [
                          [
                            "Attr",
                            [
                              [
                                "Idx",
                                [
                                  [
                                    "Attr",
                                    [
                                      [ "Id", "var" ],
                                      [ "A_string", "app_service_config" ]
                                    ]
                                  ],
                                  [ "Id", "app_name" ]
                                ]
                              ],
                              [ "A_string", "image" ]
                            ]
                          ],
                          [ "String", "" ]
                        ]
                      ],
                      "then_": [ "String", "DOCKER" ],
                      "else_": [
                        "Fun_call",
                        [
                          "format",
                          [
                            [ "String", "DOCKER|%s/%s" ],
                            [
                              "Attr",
                              [
                                [ "Id", "var" ],
                                [ "A_string", "docker_registry_server_url" ]
                              ]
                            ],
                            [
                              "Attr",
                              [
                                [
                                  "Idx",
                                  [
                                    [
                                      "Attr",
                                      [
                                        [ "Id", "var" ],
                                        [ "A_string", "app_service_config" ]
                                      ]
                                    ],
                                    [ "Id", "app_name" ]
                                  ]
                                ],
                                [ "A_string", "image" ]
                              ]
                            ]
                          ]
                        ]
                      ]
                    }
                  ]
                }
              ],
              "cond": null
            }
          ]
        ],
        [
          "Attribute",
          "static_app_settings",
          [
            "Object",
            [
              [
                [ "Bare", "DOCKER_REGISTRY_SERVER_URL" ],
                [
                  "Cond",
                  {
                    "if_": [
                      "Not_equal",
                      [
                        [
                          "Attr",
                          [
                            [ "Id", "var" ],
                            [ "A_string", "docker_registry_server_url" ]
                          ]
                        ],
                        [ "String", "" ]
                      ]
                    ],
                    "then_": [
                      "Fun_call",
                      [
                        "format",
                        [
                          [ "String", "https://%s" ],
                          [
                            "Attr",
                            [
                              [ "Id", "var" ],
                              [ "A_string", "docker_registry_server_url" ]
                            ]
                          ]
                        ]
                      ]
                    ],
                    "else_": [ "String", "" ]
                  }
                ]
              ],
              [
                [ "Bare", "WEBSITES_ENABLE_APP_SERVICE_STORAGE" ],
                [ "Bool", false ]
              ],
              [
                [ "Bare", "DOCKER_REGISTRY_SERVER_USERNAME" ],
                [
                  "Attr",
                  [
                    [ "Id", "var" ],
                    [ "A_string", "docker_registry_server_username" ]
                  ]
                ]
              ],
              [
                [ "Bare", "DOCKER_REGISTRY_SERVER_PASSWORD" ],
                [
                  "Attr",
                  [
                    [ "Id", "var" ],
                    [ "A_string", "docker_registry_server_password" ]
                  ]
                ]
              ],
              [
                [ "Bare", "APPLICATIONINSIGHTS_CONNECTION_STRING" ],
                [
                  "Fun_call",
                  [
                    "format",
                    [
                      [ "String", "InstrumentationKey=%s" ],
                      [
                        "Attr",
                        [
                          [ "Id", "var" ],
                          [ "A_string", "app_insights_instrumentation_key" ]
                        ]
                      ]
                    ]
                  ]
                ]
              ],
              [
                [ "Bare", "ApplicationInsightsAgent_EXTENSION_VERSION" ],
                [
                  "Attr",
                  [ [ "Id", "var" ], [ "A_string", "app_insights_version" ] ]
                ]
              ],
              [
                [ "Bare", "KEYVAULT_URI" ],
                [ "Attr", [ [ "Id", "var" ], [ "A_string", "vault_uri" ] ] ]
              ]
            ]
          ]
        ],
        [
          "Attribute",
          "app_service_settings",
          [
            "Fun_call",
            [
              "merge",
              [
                [
                  "Fun_call",
                  [
                    "tomap",
                    [
                      [
                        "Attr",
                        [
                          [ "Id", "local" ],
                          [ "A_string", "static_app_settings" ]
                        ]
                      ]
                    ]
                  ]
                ],
                [
                  "Attr",
                  [ [ "Id", "var" ], [ "A_string", "app_service_settings" ] ]
                ]
              ]
            ]
          ]
        ]
      ]
    }
