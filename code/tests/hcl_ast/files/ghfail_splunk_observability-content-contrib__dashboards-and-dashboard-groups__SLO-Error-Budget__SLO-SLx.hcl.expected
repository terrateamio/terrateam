[
  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "slo_service_name" ] ],
      "body": [
        [ "Attribute", "type", [ "Id", "string" ] ],
        [
          "Attribute",
          "default",
          [ "String", "placeholder-name-add-your-own-name" ]
        ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "detector_name" ] ],
      "body": [
        [ "Attribute", "type", [ "Id", "string" ] ],
        [ "Attribute", "default", [ "String", "SLO detector" ] ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "resource",
      "labels": [
        [ "Lit", "signalfx_detector" ], [ "Lit", "slo_downtime_minutes" ]
      ],
      "body": [
        [
          "Attribute",
          "name",
          [
            "Template",
            [
              [
                "Interpolation",
                {
                  "expr": [
                    "Attr",
                    [ [ "Id", "var" ], [ "A_string", "slo_service_name" ] ]
                  ],
                  "strip_before": false,
                  "strip_after": false
                }
              ],
              [ "Literal", " " ],
              [
                "Interpolation",
                {
                  "expr": [
                    "Attr",
                    [ [ "Id", "var" ], [ "A_string", "detector_name" ] ]
                  ],
                  "strip_before": false,
                  "strip_after": false
                }
              ]
            ]
          ]
        ],
        [
          "Attribute",
          "description",
          [ "String", "SLx detector based on successful traffic" ]
        ],
        [ "Attribute", "max_delay", [ "Int", 30 ] ],
        [
          "Attribute",
          "tags",
          [ "Tuple", [ [ "String", "SLO" ], [ "String", "dev" ] ] ]
        ],
        [
          "Attribute",
          "program_text",
          [
            "Template_heredoc",
            [
              "EOF",
              [
                [
                  "Literal",
                  "\nfilter_ = filter('sf_environment', '*') and filter('sf_service', '"
                ],
                [
                  "Interpolation",
                  {
                    "expr": [
                      "Attr",
                      [ [ "Id", "var" ], [ "A_string", "slo_service_name" ] ]
                    ],
                    "strip_before": false,
                    "strip_after": false
                  }
                ],
                [
                  "Literal",
                  "') and filter('sf_kind', 'SERVER', 'CONSUMER') and (not filter('sf_dimensionalized', '*')) and (not filter('sf_serviceMesh', '*'))\nA = data('spans.count', filter=filter_ and filter('sf_error', 'false'), rollup='rate').sum().publish(label='Success', enable=False)\nB = data('spans.count', filter=filter_, rollup='rate').sum().publish(label='All Traffic', enable=False)\nC = combine(100*((A if A is not None else 0)/B)).publish(label='Success Rate %')\n        \nconstant = const(30)\n\n### Force detector to retrigger ever minute when in a breaching state.\n### This gives us \"downtime mintues\"\ndetect(when(C < 99, duration(\"30s\")), off=when(constant < 100, duration(\"20s\")), mode='split').publish('Success Ratio Detector')\n"
                ]
              ]
            ]
          ]
        ],
        [
          "Block",
          {
            "type_": "rule",
            "labels": [],
            "body": [
              [
                "Attribute",
                "description",
                [ "String", "Successful traffic < 99 (downtime minutes)" ]
              ],
              [ "Attribute", "severity", [ "String", "Warning" ] ],
              [
                "Attribute",
                "detect_label",
                [ "String", "Success Ratio Detector" ]
              ],
              [ "Attribute", "notifications", [ "Tuple", [] ] ]
            ]
          }
        ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "resource",
      "labels": [
        [ "Lit", "signalfx_dashboard_group" ],
        [ "Lit", "slo_dashboard_group" ]
      ],
