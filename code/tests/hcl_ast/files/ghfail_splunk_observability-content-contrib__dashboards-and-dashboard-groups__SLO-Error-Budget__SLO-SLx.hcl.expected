        [
          "Attribute",
          "description",
          [ "String", "SLO / SLx Level Dashboards" ]
        ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "resource",
      "labels": [
        [ "Lit", "signalfx_time_chart" ],
        [ "Lit", "SLO-SLx-Investigation_0" ]
      ],
      "body": [
        [ "Attribute", "axes_include_zero", [ "Bool", false ] ],
        [ "Attribute", "axes_precision", [ "Int", 0 ] ],
        [ "Attribute", "color_by", [ "String", "Dimension" ] ],
        [
          "Attribute",
          "description",
          [ "String", "Downtime minutes over 31 day cycle" ]
        ],
        [ "Attribute", "disable_sampling", [ "Bool", false ] ],
        [ "Attribute", "max_delay", [ "Int", 0 ] ],
        [ "Attribute", "minimum_resolution", [ "Int", 0 ] ],
        [ "Attribute", "name", [ "String", "Downtime Minutes (SLO)" ] ],
        [
          "Attribute",
          "on_chart_legend_dimension",
          [ "String", "plot_label" ]
        ],
        [ "Attribute", "plot_type", [ "String", "ColumnChart" ] ],
        [
          "Attribute",
          "program_text",
          [
            "Template_heredoc",
            [
              "EOF",
              [
                [ "Literal", "\nA = alerts(detector_name='" ],
                [
                  "Interpolation",
                  {
                    "expr": [
                      "Attr",
                      [ [ "Id", "var" ], [ "A_string", "slo_service_name" ] ]
                    ],
                    "strip_before": false,
                    "strip_after": false
                  }
                ],
                [ "Literal", " " ],
                [
                  "Interpolation",
                  {
                    "expr": [
                      "Attr",
                      [ [ "Id", "var" ], [ "A_string", "detector_name" ] ]
                    ],
                    "strip_before": false,
                    "strip_after": false
                  }
                ],
                [
                  "Literal",
                  "').count().publish(label='A', enable=False)\nalert_stream = (A).sum().fill(0).publish(label=\"alert_stream\")\n        \ndowntime = (alert_stream).sum(cycle='month', cycle_start='1d', partial_values=True).fill().publish(label=\"Downtime Minutes\")\n"
                ]
              ]
            ]
          ]
        ],
        [ "Attribute", "show_data_markers", [ "Bool", true ] ],
        [ "Attribute", "show_event_lines", [ "Bool", true ] ],
        [ "Attribute", "stacked", [ "Bool", false ] ],
        [ "Attribute", "time_range", [ "Int", 900 ] ],
        [ "Attribute", "unit_prefix", [ "String", "Metric" ] ],
        [
          "Block",
          {
            "type_": "event_options",
            "labels": [],
            "body": [
              [
                "Attribute",
                "display_name",
                [
                  "Template",
                  [
                    [
                      "Interpolation",
                      {
                        "expr": [
                          "Attr",
                          [
                            [ "Id", "var" ],
                            [ "A_string", "slo_service_name" ]
                          ]
                        ],
                        "strip_before": false,
                        "strip_after": false
                      }
                    ],
                    [ "Literal", " " ],
                    [
                      "Interpolation",
                      {
                        "expr": [
                          "Attr",
                          [
                            [ "Id", "var" ], [ "A_string", "detector_name" ]
                          ]
                        ],
                        "strip_before": false,
                        "strip_after": false
                      }
                    ]
                  ]
                ]
              ],
              [ "Attribute", "label", [ "String", "A" ] ]
            ]
          }
        ],
        [
          "Block",
          {
            "type_": "histogram_options",
            "labels": [],
            "body": [ [ "Attribute", "color_theme", [ "String", "red" ] ] ]
          }
        ],
        [
          "Block",
          {
            "type_": "viz_options",
            "labels": [],
            "body": [
              [ "Attribute", "axis", [ "String", "left" ] ],
              [
                "Attribute", "display_name", [ "String", "Downtime Minutes" ]
              ],
              [ "Attribute", "label", [ "String", "Downtime Minutes" ] ]
            ]
          }
        ],
        [
          "Block",
          {
            "type_": "viz_options",
            "labels": [],
            "body": [
              [ "Attribute", "axis", [ "String", "left" ] ],
              [ "Attribute", "color", [ "String", "green" ] ],
              [ "Attribute", "display_name", [ "String", "alert_stream" ] ],
              [ "Attribute", "label", [ "String", "alert_stream" ] ],
              [ "Attribute", "plot_type", [ "String", "ColumnChart" ] ]
            ]
          }
        ]
      ]
    }
