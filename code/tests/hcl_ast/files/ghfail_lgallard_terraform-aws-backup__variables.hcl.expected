    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "restore_testing_iam_role_arn" ] ],
      "body": [
        [
          "Attribute",
          "description",
          [
            "String",
            "The ARN of an existing IAM role for restore testing operations. If not provided, a new role will be created."
          ]
        ],
        [ "Attribute", "type", [ "Id", "string" ] ],
        [ "Attribute", "default", [ "Null" ] ],
        [
          "Block",
          {
            "type_": "validation",
            "labels": [],
            "body": [
              [
                "Attribute",
                "condition",
                [
                  "Cond",
                  {
                    "if_": [
                      "Equal",
                      [
                        [
                          "Attr",
                          [
                            [ "Id", "var" ],
                            [ "A_string", "restore_testing_iam_role_arn" ]
                          ]
                        ],
                        [ "Null" ]
                      ]
                    ],
                    "then_": [ "Bool", true ],
                    "else_": [
                      "Log_and",
                      [
                        [
                          "Fun_call",
                          [
                            "can",
                            [
                              [
                                "Fun_call",
                                [
                                  "regex",
                                  [
                                    [
                                      "String",
                                      "^arn:aws:iam::[0-9]{12}:role/"
                                    ],
                                    [
                                      "Attr",
                                      [
                                        [ "Id", "var" ],
                                        [
                                          "A_string",
                                          "restore_testing_iam_role_arn"
                                        ]
                                      ]
                                    ]
                                  ]
                                ]
                              ]
                            ]
                          ]
                        ],
                        [
                          "Not",
                          [
                            "Fun_call",
                            [
                              "can",
                              [
                                [
                                  "Fun_call",
                                  [
                                    "regex",
                                    [
                                      [
                                        "String",
                                        "(?i)(test|temp|delete|remove)"
                                      ],
                                      [
                                        "Attr",
                                        [
                                          [ "Id", "var" ],
                                          [
                                            "A_string",
                                            "restore_testing_iam_role_arn"
                                          ]
                                        ]
                                      ]
                                    ]
                                  ]
                                ]
                              ]
                            ]
                          ]
                        ]
                      ]
                    ]
                  }
                ]
              ],
              [
                "Attribute",
                "error_message",
                [
                  "String",
                  "The restore_testing_iam_role_arn must be a valid IAM role ARN. Avoid using 'test', 'temp', 'delete', or 'remove' in role names for security reasons."
                ]
              ]
            ]
          }
        ]
      ]
    }
