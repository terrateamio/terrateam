  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "enable_strict_region_validation" ] ],
      "body": [
        [
          "Attribute",
          "description",
          [
            "String",
            "Enable strict validation that region settings apply to the expected region. Requires expected_region to be set. When enabled, Terraform will fail if the provider region doesn't match expected_region, preventing accidental misconfiguration in multi-region setups."
          ]
        ],
        [ "Attribute", "type", [ "Id", "bool" ] ],
        [ "Attribute", "default", [ "Bool", false ] ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "expected_region" ] ],
      "body": [
        [
          "Attribute",
          "description",
          [
            "String",
            "Expected AWS region for region settings deployment. Used with enable_strict_region_validation to prevent applying settings to the wrong region in multi-provider configurations. If null, no region validation is performed."
          ]
        ],
        [ "Attribute", "type", [ "Id", "string" ] ],
        [ "Attribute", "default", [ "Null" ] ],
        [
          "Block",
          {
            "type_": "validation",
            "labels": [],
            "body": [
              [
                "Attribute",
                "condition",
                [
                  "Log_or",
                  [
                    [
                      "Equal",
                      [
                        [
                          "Attr",
                          [
                            [ "Id", "var" ],
                            [ "A_string", "expected_region" ]
                          ]
                        ],
                        [ "Null" ]
                      ]
                    ],
                    [
                      "Fun_call",
                      [
                        "can",
                        [
                          [
                            "Fun_call",
                            [
                              "regex",
                              [
                                [ "String", "^[a-z]{2}-[a-z]+-[0-9]{1}$" ],
                                [
                                  "Attr",
                                  [
                                    [ "Id", "var" ],
                                    [ "A_string", "expected_region" ]
                                  ]
                                ]
                              ]
                            ]
                          ]
                        ]
                      ]
                    ]
                  ]
                ]
              ],
              [
                "Attribute",
                "error_message",
                [
                  "String",
                  "The expected_region must be a valid AWS region format (e.g., 'us-east-1', 'eu-west-1') or null."
                ]
              ]
            ]
          }
        ]
      ]
    }
  ]
