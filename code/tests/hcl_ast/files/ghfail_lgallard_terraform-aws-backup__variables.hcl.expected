        [ "Attribute", "type", [ "Id", "bool" ] ],
        [ "Attribute", "default", [ "Bool", false ] ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "global_settings" ] ],
      "body": [
        [
          "Attribute",
          "description",
          [
            "String",
            "Global settings for AWS Backup. Currently supports isCrossAccountBackupEnabled for centralized cross-account backup governance."
          ]
        ],
        [
          "Attribute",
          "type",
          [ "Fun_call", [ "map", [ [ "Id", "string" ] ] ] ]
        ],
        [
          "Attribute",
          "default",
          [
            "Object",
            [
              [
                [ "Quoted", "isCrossAccountBackupEnabled" ],
                [ "String", "false" ]
              ]
            ]
          ]
        ],
        [
          "Block",
          {
            "type_": "validation",
            "labels": [],
            "body": [
              [
                "Attribute",
                "condition",
                [
                  "Cond",
                  {
                    "if_": [
                      "Fun_call",
                      [
                        "can",
                        [
                          [
                            "Idx",
                            [
                              [
                                "Attr",
                                [
                                  [ "Id", "var" ],
                                  [ "A_string", "global_settings" ]
                                ]
                              ],
                              [ "String", "isCrossAccountBackupEnabled" ]
                            ]
                          ]
                        ]
                      ]
                    ],
                    "then_": [
                      "Fun_call",
                      [
                        "contains",
                        [
                          [
                            "Tuple",
                            [ [ "String", "true" ], [ "String", "false" ] ]
                          ],
                          [
                            "Idx",
                            [
                              [
                                "Attr",
                                [
                                  [ "Id", "var" ],
                                  [ "A_string", "global_settings" ]
                                ]
                              ],
                              [ "String", "isCrossAccountBackupEnabled" ]
                            ]
                          ]
                        ]
                      ]
                    ],
                    "else_": [ "Bool", true ]
                  }
                ]
              ],
              [
                "Attribute",
                "error_message",
                [
                  "String",
                  "isCrossAccountBackupEnabled must be either 'true' or 'false' as a string (not boolean). This setting controls cross-account backup capabilities for enterprise governance."
                ]
              ]
