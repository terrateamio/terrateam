              [
                "Attribute",
                "condition",
                [
                  "Cond",
                  {
                    "if_": [
                      "Equal",
                      [
                        [
                          "Attr",
                          [
                            [ "Id", "var" ],
                            [ "A_string", "max_retention_days" ]
                          ]
                        ],
                        [ "Null" ]
                      ]
                    ],
                    "then_": [ "Bool", true ],
                    "else_": [
                      "Log_and",
                      [
                        [
                          "Gte",
                          [
                            [
                              "Attr",
                              [
                                [ "Id", "var" ],
                                [ "A_string", "max_retention_days" ]
                              ]
                            ],
                            [ "Int", 1 ]
                          ]
                        ],
                        [
                          "Lte",
                          [
                            [
                              "Attr",
                              [
                                [ "Id", "var" ],
                                [ "A_string", "max_retention_days" ]
                              ]
                            ],
                            [ "Int", 2555 ]
                          ]
                        ]
                      ]
                    ]
                  }
                ]
              ],
              [
                "Attribute",
                "error_message",
                [
                  "String",
                  "The max_retention_days must be between 1 and 2555 days (7 years maximum for compliance)."
                ]
              ]
            ]
          }
        ]
      ]
    }
  ],
  [
