                          ]
                        ],
                        [ "Null" ]
                      ]
                    ],
                    "then_": [ "Bool", true ],
                    "else_": [
                      "Fun_call",
                      [
                        "can",
                        [
                          [
                            "Fun_call",
                            [
                              "regex",
                              [
                                [
                                  "String", "^[A-Za-z_]+(/[A-Za-z0-9_+-]+)+$"
                                ],
                                [
                                  "Attr",
                                  [
                                    [ "Id", "var" ],
                                    [
                                      "A_string",
                                      "rule_schedule_expression_timezone"
                                    ]
                                  ]
                                ]
                              ]
                            ]
                          ]
                        ]
                      ]
                    ]
                  }
                ]
              ],
              [
                "Attribute",
                "error_message",
                [
                  "String",
                  "The schedule_expression_timezone must be a valid IANA timezone string (e.g., 'America/New_York', 'Europe/London', 'America/Argentina/Buenos_Aires')."
                ]
              ]
            ]
          }
        ]
      ]
    }
  ],
