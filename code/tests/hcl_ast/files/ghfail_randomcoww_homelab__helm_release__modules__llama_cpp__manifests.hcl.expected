[
  [
    "Block",
    {
      "type_": "locals",
      "labels": [],
      "body": [
        [ "Attribute", "llama_cpp_port", [ "Int", 8080 ] ],
        [ "Attribute", "models_path", [ "String", "/models" ] ],
        [ "Attribute", "llama_swap_path", [ "String", "/llama-swap" ] ],
        [
          "Attribute",
          "config_file",
          [ "String", "/var/lib/llama-cpp/config.yaml" ]
        ],
        [
          "Attribute",
          "models",
          [
            "For_tuple",
            {
              "identifiers": [ "k", [ "image" ] ],
              "input": [
                "Attr", [ [ "Id", "var" ], [ "A_string", "models" ] ]
              ],
              "output": [
                "Object",
                [
                  [ [ "Bare", "key" ], [ "Id", "k" ] ],
                  [
                    [ "Bare", "image" ],
                    [
                      "Attr", [ [ "Id", "image" ], [ "A_string", "image" ] ]
                    ]
                  ],
                  [
                    [ "Bare", "file" ],
                    [ "Attr", [ [ "Id", "image" ], [ "A_string", "file" ] ] ]
                  ]
                ]
              ],
              "cond": null
            }
          ]
        ],
        [
          "Attribute",
          "manifests",
          [
            "Tuple",
            [
              [
                "Attr",
                [
                  [
                    "Attr",
                    [ [ "Id", "module" ], [ "A_string", "statefulset" ] ]
                  ],
                  [ "A_string", "manifest" ]
                ]
              ],
              [
                "Attr",
                [
                  [
                    "Attr", [ [ "Id", "module" ], [ "A_string", "service" ] ]
                  ],
                  [ "A_string", "manifest" ]
                ]
              ],
              [
                "Attr",
                [
                  [
                    "Attr",
                    [ [ "Id", "module" ], [ "A_string", "httproute" ] ]
                  ],
                  [ "A_string", "manifest" ]
                ]
              ],
              [
                "Attr",
                [
                  [
                    "Attr", [ [ "Id", "module" ], [ "A_string", "secret" ] ]
                  ],
                  [ "A_string", "manifest" ]
                ]
              ]
            ]
          ]
        ]
      ]
    }
