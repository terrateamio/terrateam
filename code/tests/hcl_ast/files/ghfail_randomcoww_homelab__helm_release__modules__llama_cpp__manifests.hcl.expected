                                              ]
                                            ]
                                          ]
                                        ]
                                      ],
                                      [
                                        [ "Bare", "apiKeys" ],
                                        [
                                          "For_tuple",
                                          {
                                            "identifiers": [ "i", [ "k" ] ],
                                            "input": [
                                              "Attr",
                                              [
                                                [ "Id", "var" ],
                                                [ "A_string", "api_keys" ]
                                              ]
                                            ],
                                            "output": [
                                              "Template",
                                              [
                                                [
                                                  "Literal", "${env.API_KEY_"
                                                ],
                                                [
                                                  "Interpolation",
                                                  {
                                                    "expr": [ "Id", "i" ],
                                                    "strip_before": false,
                                                    "strip_after": false
                                                  }
                                                ],
                                                [ "Literal", "}" ]
                                              ]
                                            ],
                                            "cond": null
                                          }
                                        ]
                                      ]
                                    ]
                                  ]
                                ]
                              ]
                            ]
                          ]
                        ]
                      ]
                    ]
                  ]
                ],
                [
                  "For_object",
                  {
                    "identifiers": [ "i", [ "k" ] ],
                    "input": [
