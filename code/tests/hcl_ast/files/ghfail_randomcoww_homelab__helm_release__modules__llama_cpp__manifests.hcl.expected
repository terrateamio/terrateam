                              [
                                "merge",
                                [
                                  [
                                    "Attr",
                                    [
                                      [ "Id", "var" ],
                                      [ "A_string", "llama_swap_config" ]
                                    ]
                                  ],
                                  [
                                    "Object",
                                    [
                                      [
                                        [ "Bare", "macros" ],
                                        [
                                          "Fun_call",
                                          [
                                            "merge",
                                            [
                                              [
                                                "Object",
                                                [
                                                  [
                                                    [ "Bare", "model_path" ],
