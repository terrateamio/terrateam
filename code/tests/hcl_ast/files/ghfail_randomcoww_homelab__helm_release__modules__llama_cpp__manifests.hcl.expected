                    ],
                    "key_output": [
                      "Template",
                      [
                        [ "Literal", "API_KEY_" ],
                        [
                          "Interpolation",
                          {
                            "expr": [ "Id", "i" ],
                            "strip_before": false,
                            "strip_after": false
                          }
                        ]
                      ]
                    ],
                    "value_output": [ "Id", "k" ],
                    "cond": null
                  }
                ]
              ]
            ]
