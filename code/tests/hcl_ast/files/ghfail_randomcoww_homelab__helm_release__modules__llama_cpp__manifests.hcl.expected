                                                    ]
                                                  ],
                                                  [
                                                    [ "Bare", "default_cmd" ],
                                                    [
                                                      "Heredoc",
                                                      [
                                                        "EOF",
                                                        "\n/app/llama-server \\\n--port $${PORT} \\\n--flash-attn on \\\n--no-webui \\\n--context-shift \\\n--no-mmap\n"
                                                      ]
                                                    ]
                                                  ]
                                                ]
                                              ],
                                              [
                                                "For_object",
                                                {
                                                  "identifiers": [
                                                    "_", [ "v" ]
                                                  ],
                                                  "input": [
                                                    "Attr",
                                                    [
                                                      [ "Id", "local" ],
                                                      [
                                                        "A_string", "models"
                                                      ]
                                                    ]
                                                  ],
                                                  "key_output": [
                                                    "Template",
                                                    [
                                                      [
                                                        "Interpolation",
                                                        {
                                                          "expr": [
                                                            "Attr",
                                                            [
                                                              [ "Id", "v" ],
                                                              [
                                                                "A_string",
                                                                "key"
                                                              ]
                                                            ]
                                                          ],
                                                          "strip_before": false,
                                                          "strip_after": false
                                                        }
                                                      ]
                                                    ]
                                                  ],
                                                  "value_output": [
                                                    "Template",
                                                    [
                                                      [
                                                        "Interpolation",
                                                        {
                                                          "expr": [
                                                            "Attr",
                                                            [
                                                              [
                                                                "Id", "local"
                                                              ],
                                                              [
                                                                "A_string",
                                                                "models_path"
                                                              ]
                                                            ]
                                                          ],
                                                          "strip_before": false,
                                                          "strip_after": false
                                                        }
                                                      ],
                                                      [ "Literal", "/" ],
                                                      [
                                                        "Interpolation",
                                                        {
                                                          "expr": [
                                                            "Attr",
                                                            [
                                                              [ "Id", "v" ],
                                                              [
                                                                "A_string",
                                                                "key"
                                                              ]
                                                            ]
                                                          ],
                                                          "strip_before": false,
                                                          "strip_after": false
                                                        }
                                                      ],
                                                      [ "Literal", "/" ],
                                                      [
                                                        "Interpolation",
                                                        {
                                                          "expr": [
                                                            "Attr",
                                                            [
                                                              [ "Id", "v" ],
                                                              [
                                                                "A_string",
                                                                "file"
                                                              ]
                                                            ]
                                                          ],
                                                          "strip_before": false,
                                                          "strip_after": false
                                                        }
                                                      ]
                                                    ]
                                                  ],
                                                  "cond": null
