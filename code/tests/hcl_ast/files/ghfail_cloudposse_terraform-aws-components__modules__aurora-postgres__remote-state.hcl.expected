        [
          "Attribute",
          "environment",
          [
            "Attr",
            [
              [ "Id", "var" ],
              [ "A_string", "dns_gbl_delegated_environment_name" ]
            ]
          ]
        ],
        [
          "Attribute",
          "context",
          [
            "Attr",
            [
              [ "Attr", [ [ "Id", "module" ], [ "A_string", "cluster" ] ] ],
              [ "A_string", "context" ]
