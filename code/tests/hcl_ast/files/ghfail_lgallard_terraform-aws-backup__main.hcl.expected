  [
    "Block",
    {
      "type_": "resource",
      "labels": [
        [ "Lit", "null_resource" ], [ "Lit", "vault_name_validation" ]
      ],
      "body": [
        [
          "Attribute",
          "count",
          [
            "Cond",
            {
              "if_": [
                "Attr",
                [
                  [ "Id", "local" ],
                  [ "A_string", "vault_name_validation_failed" ]
                ]
              ],
              "then_": [ "Int", 1 ],
              "else_": [ "Int", 0 ]
            }
          ]
        ],
        [
          "Block",
          {
            "type_": "provisioner",
            "labels": [ [ "Lit", "local-exec" ] ],
            "body": [
              [
                "Attribute",
                "command",
                [
                  "Template_heredoc",
                  [
                    "EOF",
                    [
                      [
                        "Literal",
                        "\necho \"ERROR: Vault name validation failed!\"\necho \"The vault name '"
                      ],
                      [
                        "Interpolation",
                        {
                          "expr": [
                            "Attr",
                            [ [ "Id", "var" ], [ "A_string", "vault_name" ] ]
                          ],
                          "strip_before": false,
                          "strip_after": false
                        }
                      ],
                      [
                        "Literal",
                        "' contains restricted words (test, temp, delete, remove, default).\"\necho \"These words are not recommended for security reasons.\"\necho \"\"\necho \"Solutions:\"\necho \"1. Change the vault name to avoid these words\"\necho \"2. For existing vaults, set: vault_name_validation_bypass = true\"\necho \"\"\nexit 1\n"
                      ]
                    ]
                  ]
                ]
              ]
            ]
          }
        ],
        [
          "Block",
          {
            "type_": "lifecycle",
            "labels": [],
            "body": [
              [ "Attribute", "create_before_destroy", [ "Bool", true ] ]
            ]
          }
        ]
      ]
    }
  ],
