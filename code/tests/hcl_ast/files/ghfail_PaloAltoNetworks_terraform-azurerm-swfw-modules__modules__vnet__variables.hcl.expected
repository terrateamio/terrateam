  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "create_virtual_network" ] ],
      "body": [
        [
          "Attribute",
          "description",
          [
            "Heredoc",
            [
              "EOF",
              "\nControls Virtual Network creation.\n  \nWhen set to `true`, creates the Virtual Network, otherwise just use a pre-existing network.\n"
            ]
          ]
        ],
        [ "Attribute", "default", [ "Bool", true ] ],
        [ "Attribute", "nullable", [ "Bool", false ] ],
        [ "Attribute", "type", [ "Id", "bool" ] ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "address_space" ] ],
      "body": [
        [
          "Attribute",
          "description",
          [
            "Heredoc",
            [
              "EOF",
              "\nThe address space used by the virtual network.\n  \nYou can supply more than one address space. Required only when you create a VNET.\n"
            ]
          ]
        ],
        [ "Attribute", "default", [ "Null" ] ],
        [
          "Attribute",
          "type",
          [ "Fun_call", [ "list", [ [ "Id", "string" ] ] ] ]
        ],
        [
          "Block",
          {
            "type_": "validation",
            "labels": [],
            "body": [
              [
                "Attribute",
                "condition",
                [
                  "Fun_call",
                  [
                    "alltrue",
                    [
                      [
                        "For_tuple",
                        {
                          "identifiers": [ "v", [] ],
                          "input": [
                            "Fun_call",
                            [
                              "coalesce",
                              [
                                [
                                  "Attr",
                                  [
                                    [ "Id", "var" ],
                                    [ "A_string", "address_space" ]
                                  ]
                                ],
                                [ "Tuple", [] ]
                              ]
                            ]
                          ],
                          "output": [
                            "Fun_call",
                            [
                              "can",
                              [
                                [
                                  "Fun_call",
                                  [
                                    "regex",
                                    [
                                      [
                                        "String",
                                        "^(\\d{1,3}\\.){3}\\d{1,3}\\/[12]?[0-9]$"
                                      ],
                                      [ "Id", "v" ]
                                    ]
                                  ]
                                ]
                              ]
                            ]
                          ],
                          "cond": null
                        }
                      ]
                    ]
                  ]
                ]
              ],
              [
                "Attribute",
                "error_message",
                [
                  "Heredoc",
                  [
                    "EOF",
                    "\nAll items in var.address_space should be in CIDR notation, with the maximum subnet of /29.\n"
                  ]
                ]
              ]
            ]
          }
        ]
      ]
    }
  ],
  [
    "Block",
    {
