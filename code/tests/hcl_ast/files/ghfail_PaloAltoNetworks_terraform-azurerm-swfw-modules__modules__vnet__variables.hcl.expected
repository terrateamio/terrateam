                                                  ],
                                                  [
                                                    [ "Bare", "protocol" ],
                                                    [ "Id", "string" ]
                                                  ],
                                                  [
                                                    [
                                                      "Bare",
                                                      "source_port_range"
                                                    ],
                                                    [
                                                      "Fun_call",
                                                      [
                                                        "optional",
                                                        [
                                                          [ "Id", "string" ]
                                                        ]
                                                      ]
                                                    ]
                                                  ],
                                                  [
                                                    [
                                                      "Bare",
                                                      "source_port_ranges"
                                                    ],
                                                    [
                                                      "Fun_call",
                                                      [
                                                        "optional",
                                                        [
                                                          [
                                                            "Fun_call",
                                                            [
                                                              "list",
                                                              [
                                                                [
                                                                  "Id",
                                                                  "string"
                                                                ]
                                                              ]
                                                            ]
                                                          ]
                                                        ]
                                                      ]
                                                    ]
                                                  ],
                                                  [
                                                    [
                                                      "Bare",
                                                      "source_address_prefix"
                                                    ],
                                                    [
                                                      "Fun_call",
                                                      [
                                                        "optional",
                                                        [
                                                          [ "Id", "string" ]
                                                        ]
                                                      ]
                                                    ]
                                                  ],
                                                  [
                                                    [
                                                      "Bare",
                                                      "source_address_prefixes"
                                                    ],
                                                    [
                                                      "Fun_call",
                                                      [
                                                        "optional",
                                                        [
                                                          [
                                                            "Fun_call",
