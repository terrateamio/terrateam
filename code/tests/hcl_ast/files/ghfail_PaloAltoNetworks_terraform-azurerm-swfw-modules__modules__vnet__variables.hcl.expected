                        "Object",
                        [
                          [ [ "Bare", "name" ], [ "Id", "string" ] ],
                          [
                            [ "Bare", "bgp_route_propagation_enabled" ],
                            [
                              "Fun_call",
                              [
                                "optional",
                                [ [ "Id", "bool" ], [ "Bool", true ] ]
                              ]
                            ]
                          ],
                          [
