                            [
                              "Fun_call",
                              [ "optional", [ [ "Id", "string" ] ] ]
                            ]
                          ],
                          [
                            [ "Bare", "route_table_key" ],
                            [
                              "Fun_call",
                              [ "optional", [ [ "Id", "string" ] ] ]
                            ]
                          ],
                          [
                            [ "Bare", "default_outbound_access_enabled" ],
