                "Attribute",
                "condition",
                [
                  "Fun_call",
                  [
                    "alltrue",
                    [
                      [
                        "For_tuple",
                        {
                          "identifiers": [ "v", [] ],
                          "input": [
                            "Fun_call",
                            [
                              "coalesce",
                              [
                                [
                                  "Attr",
                                  [
                                    [ "Id", "var" ],
                                    [ "A_string", "dns_servers" ]
                                  ]
                                ],
                                [ "Tuple", [] ]
                              ]
                            ]
                          ],
                          "output": [
                            "Fun_call",
                            [
                              "can",
                              [
                                [
                                  "Fun_call",
                                  [
                                    "regex",
                                    [
                                      [
                                        "String",
                                        "^(\\d{1,3}\\.){3}\\d{1,3}$"
                                      ],
                                      [ "Id", "v" ]
                                    ]
                                  ]
                                ]
                              ]
                            ]
                          ],
                          "cond": null
                        }
                      ]
                    ]
                  ]
                ]
              ],
              [
                "Attribute",
                "error_message",
                [
                  "Heredoc",
                  [
                    "EOF",
                    "\nAll items in var.dns_servers should be valid IP addresses.\n"
                  ]
                ]
              ]
            ]
          }
        ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "vnet_encryption" ] ],
      "body": [
        [
          "Attribute",
          "description",
          [
            "Heredoc",
            [
              "EOF",
              "\nEnables Azure Virtual Network encryption feature (in `AllowUnencrypted` mode by default).\nWhen set to `null` VNET encryption is disabled.\n"
            ]
          ]
        ],
        [ "Attribute", "default", [ "String", "AllowUnencrypted" ] ],
        [ "Attribute", "type", [ "Id", "string" ] ],
        [
          "Block",
          {
            "type_": "validation",
            "labels": [],
            "body": [
              [
                "Attribute",
                "condition",
                [
                  "Cond",
                  {
                    "if_": [
                      "Not_equal",
                      [
                        [
                          "Attr",
                          [
                            [ "Id", "var" ],
                            [ "A_string", "vnet_encryption" ]
                          ]
                        ],
                        [ "Null" ]
                      ]
                    ],
                    "then_": [
                      "Fun_call",
                      [
                        "contains",
                        [
                          [ "Tuple", [ [ "String", "AllowUnencrypted" ] ] ],
                          [
                            "Attr",
                            [
                              [ "Id", "var" ],
                              [ "A_string", "vnet_encryption" ]
                            ]
                          ]
                        ]
                      ]
                    ],
                    "else_": [ "Bool", true ]
                  }
                ]
              ],
              [
                "Attribute",
                "error_message",
                [
                  "Heredoc",
                  [
                    "EOF",
                    "\nThe `vnet_encryption` variable must be of \"AllowUnencrypted\" (encryption enabled) or `null` (encryption disabled).\n"
                  ]
                ]
              ]
            ]
          }
        ]
      ]
    }
  ],
  [
    "Block",
