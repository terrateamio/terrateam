              [ [ "Bare", "portMappings" ], [ "Tuple", [] ] ],
              [
                [ "Bare", "volumesFrom" ],
                [
                  "Tuple",
                  [
                    [
                      "Object",
                      [
                        [
                          [ "Bare", "sourceContainer" ],
                          [
                            "Attr",
                            [
                              [ "Id", "local" ],
                              [ "A_string", "bootstrap_container_name" ]
                            ]
                          ]
                        ]
                      ]
                    ]
                  ]
                ]
              ],
              [
                [ "Bare", "healthCheck" ],
                [
                  "Object",
                  [
                    [ [ "Bare", "interval" ], [ "Int", 30 ] ],
                    [ [ "Bare", "retries" ], [ "Int", 10 ] ],
                    [ [ "Bare", "timeout" ], [ "Int", 60 ] ],
                    [ [ "Bare", "startPeriod" ], [ "Int", 300 ] ],
                    [
                      [ "Bare", "command" ],
                      [
                        "Tuple",
                        [
                          [ "String", "CMD-SHELL" ],
                          [
                            "Template",
                            [
                              [ "Literal", "[ -f " ],
                              [
                                "Interpolation",
                                {
                                  "expr": [
                                    "Attr",
                                    [
                                      [ "Id", "local" ],
                                      [
                                        "A_string",
                                        "metadata_container_status_file"
                                      ]
                                    ]
                                  ],
                                  "strip_before": false,
                                  "strip_after": false
                                }
                              ],
                              [ "Literal", " ];" ]
                            ]
                          ]
                        ]
                      ]
                    ]
                  ]
                ]
              ],
              [
                [ "Bare", "entryPoint" ],
                [
