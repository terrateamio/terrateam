                    [ "Id", "local" ],
                    [ "A_string", "metadata_container_name" ]
                  ]
                ]
              ],
              [
                [ "Bare", "image" ],
                [
                  "Attr",
                  [ [ "Id", "var" ], [ "A_string", "aws_cli_docker_image" ] ]
                ]
              ],
              [ [ "Bare", "essential" ], [ "String", "false" ] ],
              [
                [ "Bare", "logConfiguration" ],
                [
                  "Object",
                  [
                    [ [ "Bare", "logDriver" ], [ "String", "awslogs" ] ],
                    [
                      [ "Bare", "options" ],
                      [
                        "Object",
                        [
                          [
                            [ "Bare", "awslogs-group" ],
                            [
                              "Attr",
                              [
                                [
                                  "Attr",
