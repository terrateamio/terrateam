                [
                  [ "Literal", "aws s3 cp " ],
                  [
                    "Interpolation",
                    {
                      "expr": [
                        "Attr",
                        [ [ "Id", "local" ], [ "A_string", "node_id_file" ] ]
                      ],
                      "strip_before": false,
                      "strip_after": false
                    }
                  ],
                  [ "Literal", " s3://" ],
                  [
                    "Interpolation",
                    {
                      "expr": [
                        "Attr",
                        [
                          [ "Id", "local" ],
                          [ "A_string", "s3_revision_folder" ]
                        ]
                      ],
                      "strip_before": false,
                      "strip_after": false
                    }
                  ],
                  [ "Literal", "/nodeids/" ],
                  [
                    "Interpolation",
                    {
                      "expr": [
                        "Attr",
                        [
                          [ "Id", "local" ],
                          [ "A_string", "normalized_host_ip" ]
                        ]
                      ],
                      "strip_before": false,
                      "strip_after": false
                    }
                  ]
                ]
              ],
              [
                "Template",
                [
                  [ "Literal", "aws s3 cp " ],
                  [
                    "Interpolation",
                    {
                      "expr": [
                        "Attr",
                        [ [ "Id", "local" ], [ "A_string", "host_ip_file" ] ]
                      ],
                      "strip_before": false,
                      "strip_after": false
                    }
                  ],
                  [ "Literal", " s3://" ],
                  [
                    "Interpolation",
                    {
                      "expr": [
                        "Attr",
                        [
                          [ "Id", "local" ],
                          [ "A_string", "s3_revision_folder" ]
                        ]
                      ],
                      "strip_before": false,
                      "strip_after": false
                    }
                  ],
