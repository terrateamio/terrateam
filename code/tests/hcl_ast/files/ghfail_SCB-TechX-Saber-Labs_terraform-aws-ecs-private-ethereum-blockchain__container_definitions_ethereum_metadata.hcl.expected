[
  [
    "Block",
    {
      "type_": "locals",
      "labels": [],
      "body": [
        [
          "Attribute",
          "s3_revision_folder",
          [
            "Template",
            [
              [
                "Interpolation",
                {
                  "expr": [
                    "Attr",
                    [ [ "Id", "local" ], [ "A_string", "ethereum_bucket" ] ]
                  ],
                  "strip_before": false,
                  "strip_after": false
                }
              ],
              [ "Literal", "/rev_$TASK_REVISION" ]
            ]
          ]
        ],
        [
          "Attribute",
          "normalized_host_ip",
          [ "String", "ip_$(echo $HOST_IP | sed -e 's/\\./_/g')" ]
        ],
        [
          "Attribute",
          "metadata_commands",
          [
            "Tuple",
            [
              [ "String", "set -e" ],
              [ "String", "echo Wait until Node Key is ready ..." ],
              [
                "Template",
                [
                  [ "Literal", "while [ ! -f \"" ],
                  [
                    "Interpolation",
                    {
                      "expr": [
                        "Attr",
                        [ [ "Id", "local" ], [ "A_string", "node_id_file" ] ]
                      ],
                      "strip_before": false,
                      "strip_after": false
                    }
                  ],
                  [ "Literal", "\" ]; do sleep 1; done" ]
                ]
              ],
              [ "String", "yum install jq -y" ],
              [
                "String",
                "export TASK_REVISION=$(curl -s 169.254.170.2/v2/metadata | jq '.Revision' -r)"
              ],
              [ "String", "echo \"Task Revision: $TASK_REVISION\"" ],
              [
                "Template",
                [
                  [ "Literal", "echo $TASK_REVISION > " ],
                  [
                    "Interpolation",
                    {
                      "expr": [
                        "Attr",
                        [
                          [ "Id", "local" ],
                          [ "A_string", "task_revision_file" ]
                        ]
                      ],
                      "strip_before": false,
                      "strip_after": false
                    }
                  ]
                ]
              ],
              [
                "Template",
                [
                  [
                    "Literal",
                    "export HOST_IP=$(curl -s 169.254.170.2/v2/metadata | jq '.Containers[] | select(.Name == \""
                  ],
                  [
                    "Interpolation",
                    {
                      "expr": [
                        "Attr",
                        [
                          [ "Id", "local" ],
                          [ "A_string", "metadata_container_name" ]
                        ]
                      ],
                      "strip_before": false,
                      "strip_after": false
                    }
                  ],
                  [
                    "Literal",
                    "\") | .Networks[] | select(.NetworkMode == \"awsvpc\") | .IPv4Addresses[0]' -r )"
                  ]
                ]
              ],
              [ "String", "echo \"Host IP: $HOST_IP\"" ],
              [
                "Template",
                [
                  [ "Literal", "echo $HOST_IP > " ],
                  [
                    "Interpolation",
                    {
                      "expr": [
                        "Attr",
                        [ [ "Id", "local" ], [ "A_string", "host_ip_file" ] ]
                      ],
                      "strip_before": false,
                      "strip_after": false
                    }
                  ]
                ]
              ],
              [
                "String",
                "export TASK_ARN=$(curl -s 169.254.170.2/v2/metadata | jq -r '.TaskARN')"
              ],
              [
                "Template",
                [
                  [ "Literal", "aws ecs describe-tasks --cluster " ],
                  [
                    "Interpolation",
                    {
                      "expr": [
                        "Attr",
                        [
                          [ "Id", "local" ],
                          [ "A_string", "ecs_cluster_name" ]
                        ]
                      ],
                      "strip_before": false,
                      "strip_after": false
                    }
                  ],
                  [
                    "Literal",
                    " --tasks $TASK_ARN | jq -r '.tasks[0] | .group' > "
                  ],
                  [
                    "Interpolation",
                    {
                      "expr": [
                        "Attr",
                        [ [ "Id", "local" ], [ "A_string", "service_file" ] ]
                      ],
                      "strip_before": false,
                      "strip_after": false
                    }
                  ]
                ]
              ],
              [
                "Template",
                [
                  [ "Literal", "mkdir -p " ],
                  [
                    "Interpolation",
                    {
                      "expr": [
                        "Attr",
                        [ [ "Id", "local" ], [ "A_string", "hosts_folder" ] ]
                      ],
                      "strip_before": false,
                      "strip_after": false
                    }
                  ]
                ]
              ],
              [
                "Template",
                [
                  [ "Literal", "mkdir -p " ],
                  [
                    "Interpolation",
                    {
                      "expr": [
                        "Attr",
                        [
                          [ "Id", "local" ],
                          [ "A_string", "node_ids_folder" ]
                        ]
                      ],
                      "strip_before": false,
                      "strip_after": false
                    }
                  ]
                ]
              ],
              [
                "Template",
                [
                  [ "Literal", "mkdir -p " ],
                  [
                    "Interpolation",
                    {
                      "expr": [
                        "Attr",
                        [
                          [ "Id", "local" ],
                          [ "A_string", "accounts_folder" ]
                        ]
                      ],
                      "strip_before": false,
                      "strip_after": false
                    }
                  ]
                ]
              ],
              [
