          ]
        ],
        [
          "Attribute",
          "type",
          [ "Fun_call", [ "list", [ [ "Id", "any" ] ] ] ]
        ],
        [ "Attribute", "default", [ "Tuple", [] ] ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "ephemeral_storage_size" ] ],
      "body": [
        [ "Attribute", "type", [ "Id", "number" ] ],
        [
          "Attribute",
          "description",
          [
            "String",
            "The number of GBs to provision for ephemeral storage on Fargate tasks. Must be greater than or equal to 21 and less than or equal to 200"
          ]
        ],
        [ "Attribute", "default", [ "Int", 0 ] ],
        [
          "Block",
          {
            "type_": "validation",
            "labels": [],
            "body": [
              [
                "Attribute",
                "condition",
                [
                  "Log_or",
                  [
                    [
                      "Equal",
                      [
                        [
                          "Attr",
                          [
                            [ "Id", "var" ],
                            [ "A_string", "ephemeral_storage_size" ]
                          ]
                        ],
                        [ "Int", 0 ]
                      ]
                    ],
                    [
                      "Log_and",
                      [
                        [
                          "Gte",
                          [
                            [
                              "Attr",
                              [
                                [ "Id", "var" ],
                                [ "A_string", "ephemeral_storage_size" ]
                              ]
                            ],
                            [ "Int", 21 ]
                          ]
                        ],
                        [
                          "Lte",
                          [
                            [
                              "Attr",
                              [
                                [ "Id", "var" ],
                                [ "A_string", "ephemeral_storage_size" ]
                              ]
                            ],
                            [ "Int", 200 ]
                          ]
                        ]
                      ]
                    ]
                  ]
                ]
              ],
              [
                "Attribute",
                "error_message",
                [
                  "String",
                  "The ephemeral_storage_size value must be inclusively between 21 and 200."
                ]
              ]
            ]
          }
        ]
      ]
    }
  ],
  [
