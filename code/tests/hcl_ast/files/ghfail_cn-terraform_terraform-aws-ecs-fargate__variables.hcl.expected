          "type",
          [ "Fun_call", [ "map", [ [ "Id", "string" ] ] ] ]
        ],
        [
          "Attribute",
          "description",
          [
            "String",
            "The configuration options to send to the `docker_labels`"
          ]
        ],
        [ "Attribute", "default", [ "Null" ] ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "start_timeout" ] ],
      "body": [
        [ "Attribute", "type", [ "Id", "number" ] ],
        [
          "Attribute",
          "description",
          [
            "String",
            "Time duration (in seconds) to wait before giving up on resolving dependencies for a container"
          ]
        ],
        [ "Attribute", "default", [ "Null" ] ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "stop_timeout" ] ],
      "body": [
        [ "Attribute", "type", [ "Id", "number" ] ],
        [
          "Attribute",
          "description",
          [
            "String",
            "Time duration (in seconds) to wait before the container is forcefully killed if it doesn't exit normally on its own"
          ]
        ],
        [ "Attribute", "default", [ "Null" ] ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "privileged" ] ],
      "body": [
        [ "Attribute", "type", [ "Id", "bool" ] ],
        [
          "Attribute",
          "description",
          [
            "String",
            "When this variable is `true`, the container is given elevated privileges on the host container instance (similar to the root user). This parameter is not supported for Windows containers or tasks using the Fargate launch type."
          ]
        ],
        [ "Attribute", "default", [ "Null" ] ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "system_controls" ] ],
      "body": [
        [
          "Attribute",
          "type",
          [
            "Fun_call",
            [ "list", [ [ "Fun_call", [ "map", [ [ "Id", "string" ] ] ] ] ] ]
          ]
        ],
        [
          "Attribute",
          "description",
          [
            "String",
            "A list of namespaced kernel parameters to set in the container, mapping to the --sysctl option to docker run. This is a list of maps: { namespace = \"\", value = \"\"}"
          ]
        ],
        [ "Attribute", "default", [ "Tuple", [] ] ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "variable",
