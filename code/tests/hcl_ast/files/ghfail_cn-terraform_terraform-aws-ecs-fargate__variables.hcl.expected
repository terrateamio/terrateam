  ],
  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "deployment_maximum_percent" ] ],
      "body": [
        [
          "Attribute",
          "description",
          [
            "String",
            "(Optional) The upper limit (as a percentage of the service's desiredCount) of the number of running tasks that can be running in a service during a deployment."
          ]
        ],
        [ "Attribute", "type", [ "Id", "number" ] ],
        [ "Attribute", "default", [ "Int", 200 ] ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "deployment_minimum_healthy_percent" ] ],
      "body": [
        [
          "Attribute",
          "description",
          [
            "String",
            "(Optional) The lower limit (as a percentage of the service's desiredCount) of the number of running tasks that must remain running and healthy in a service during a deployment."
          ]
        ],
        [ "Attribute", "type", [ "Id", "number" ] ],
        [ "Attribute", "default", [ "Int", 100 ] ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "deployment_controller" ] ],
      "body": [
        [
          "Attribute",
          "description",
          [ "String", "(Optional) Deployment controller" ]
        ],
        [
          "Attribute",
          "type",
          [ "Fun_call", [ "list", [ [ "Id", "any" ] ] ] ]
        ],
        [
          "Attribute",
          "default",
          [
            "Tuple",
            [ [ "Object", [ [ [ "Bare", "type" ], [ "String", "ECS" ] ] ] ] ]
          ]
        ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "desired_count" ] ],
      "body": [
        [
          "Attribute",
          "description",
          [
            "String",
            "(Optional) The number of instances of the task definition to place and keep running. Defaults to 0."
          ]
        ],
        [ "Attribute", "type", [ "Id", "number" ] ],
        [ "Attribute", "default", [ "Int", 1 ] ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "enable_ecs_managed_tags" ] ],
      "body": [
        [
          "Attribute",
          "description",
          [
            "String",
            "(Optional) Specifies whether to enable Amazon ECS managed tags for the tasks within the service."
          ]
        ],
        [ "Attribute", "type", [ "Id", "bool" ] ],
        [ "Attribute", "default", [ "Bool", false ] ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "force_new_deployment" ] ],
      "body": [
        [
          "Attribute",
          "description",
          [
            "String",
            "(Optional) Enable to force a new task deployment of the service. This can be used to update tasks to use a newer Docker image with same image/tag combination (e.g. myimage:latest), roll Fargate tasks onto a newer platform version, or immediately deploy ordered_placement_strategy and placement_constraints updates."
          ]
        ],
        [ "Attribute", "default", [ "Bool", false ] ],
        [ "Attribute", "type", [ "Id", "bool" ] ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "enable_execute_command" ] ],
      "body": [
        [
          "Attribute",
          "description",
          [
            "String",
            "(Optional) Specifies whether to enable Amazon ECS Exec for the tasks within the service."
          ]
        ],
        [ "Attribute", "type", [ "Id", "bool" ] ],
        [ "Attribute", "default", [ "Bool", false ] ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "health_check_grace_period_seconds" ] ],
      "body": [
        [
          "Attribute",
          "description",
          [
            "String",
            "(Optional) Seconds to ignore failing load balancer health checks on newly instantiated tasks to prevent premature shutdown, up to 2147483647. Only valid for services configured to use load balancers."
          ]
        ],
        [ "Attribute", "type", [ "Id", "number" ] ],
        [ "Attribute", "default", [ "Int", 0 ] ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "ordered_placement_strategy" ] ],
      "body": [
        [
          "Attribute",
          "description",
          [
            "String",
            "(Optional) Service level strategy rules that are taken into consideration during task placement. List from top to bottom in order of precedence. The maximum number of ordered_placement_strategy blocks is 5. This is a list of maps where each map should contain \"id\" and \"field\""
          ]
        ],
        [
          "Attribute",
          "type",
          [ "Fun_call", [ "list", [ [ "Id", "any" ] ] ] ]
        ],
        [ "Attribute", "default", [ "Tuple", [] ] ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "ecs_service_placement_constraints" ] ],
      "body": [
        [
          "Attribute",
          "type",
          [ "Fun_call", [ "list", [ [ "Id", "any" ] ] ] ]
        ],
        [
          "Attribute",
          "description",
          [
            "String",
            "(Optional) rules that are taken into consideration during task placement. Maximum number of placement_constraints is 10. This is a list of maps, where each map should contain \"type\" and \"expression\""
          ]
        ],
        [ "Attribute", "default", [ "Tuple", [] ] ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "platform_version" ] ],
      "body": [
        [
          "Attribute",
          "description",
          [
            "String",
            "(Optional) The platform version on which to run your service. Defaults to 1.4.0. More information about Fargate platform versions can be found in the AWS ECS User Guide."
          ]
        ],
        [ "Attribute", "default", [ "String", "1.4.0" ] ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "propagate_tags" ] ],
      "body": [
        [
          "Attribute",
          "description",
          [
            "String",
            "(Optional) Specifies whether to propagate the tags from the task definition or the service to the tasks. The valid values are SERVICE and TASK_DEFINITION. Default to SERVICE"
          ]
        ],
        [ "Attribute", "default", [ "String", "SERVICE" ] ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "service_registries" ] ],
      "body": [
        [
          "Attribute",
          "description",
          [
            "String",
            "(Optional) The service discovery registries for the service. The maximum number of service_registries blocks is 1. This is a map that should contain the following fields \"registry_arn\", \"port\", \"container_port\" and \"container_name\""
          ]
        ],
        [
          "Attribute", "type", [ "Fun_call", [ "map", [ [ "Id", "any" ] ] ] ]
        ],
        [ "Attribute", "default", [ "Object", [] ] ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "enable_autoscaling" ] ],
      "body": [
        [
          "Attribute",
          "description",
          [
            "String",
            "(Optional) If true, autoscaling alarms will be created."
          ]
        ],
        [ "Attribute", "type", [ "Id", "bool" ] ],
        [ "Attribute", "default", [ "Bool", true ] ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "deployment_circuit_breaker_enabled" ] ],
      "body": [
        [
          "Attribute",
          "description",
          [
            "String",
            "(Optional) You can enable the deployment circuit breaker to cause a service deployment to transition to a failed state if tasks are persistently failing to reach RUNNING state or are failing healthcheck."
          ]
        ],
        [ "Attribute", "type", [ "Id", "bool" ] ],
        [ "Attribute", "default", [ "Bool", false ] ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "deployment_circuit_breaker_rollback" ] ],
      "body": [
        [
          "Attribute",
          "description",
          [
            "String",
            "(Optional) The optional rollback option causes Amazon ECS to roll back to the last completed deployment upon a deployment failure."
          ]
        ],
        [ "Attribute", "type", [ "Id", "bool" ] ],
        [ "Attribute", "default", [ "Bool", false ] ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "wait_for_ready_state" ] ],
      "body": [
        [
          "Attribute",
          "description",
          [
            "String",
            "(Optional) If true, Terraform will wait for the service to reach a steady state (like aws ecs wait services-stable) before continuing. Default false."
          ]
        ],
        [ "Attribute", "type", [ "Id", "bool" ] ],
        [ "Attribute", "default", [ "Bool", false ] ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "public_subnets_ids" ] ],
      "body": [
        [
          "Attribute",
          "description",
          [
            "String",
            "The public subnets associated with the task or service."
          ]
        ],
        [
          "Attribute",
          "type",
          [ "Fun_call", [ "list", [ [ "Id", "any" ] ] ] ]
        ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "private_subnets_ids" ] ],
      "body": [
        [
          "Attribute",
          "description",
          [
            "String",
            "The private subnets associated with the task or service."
          ]
        ],
        [
          "Attribute",
          "type",
          [ "Fun_call", [ "list", [ [ "Id", "any" ] ] ] ]
        ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "ecs_service_security_groups" ] ],
      "body": [
        [
          "Attribute",
          "description",
          [
            "String",
            "(Optional) The security groups associated with the task or service. If you do not specify a security group, the default security group for the VPC is used."
          ]
        ],
        [
          "Attribute",
          "type",
          [ "Fun_call", [ "list", [ [ "Id", "any" ] ] ] ]
        ],
        [ "Attribute", "default", [ "Tuple", [] ] ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "assign_public_ip" ] ],
      "body": [
        [
          "Attribute",
          "description",
          [
            "String",
            "(Optional) Assign a public IP address to the ENI (Fargate launch type only). If true service will be associated with public subnets. Default false. "
          ]
        ],
        [ "Attribute", "type", [ "Id", "bool" ] ],
        [ "Attribute", "default", [ "Bool", false ] ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "custom_lb_arn" ] ],
      "body": [
        [
          "Attribute",
          "description",
          [
            "String",
            "ARN of the Load Balancer to use in the ECS service. If provided, this module will not create a load balancer and will use the one provided in this variable"
          ]
        ],
        [ "Attribute", "type", [ "Id", "string" ] ],
        [ "Attribute", "default", [ "Null" ] ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "additional_lbs" ] ],
      "body": [
        [ "Attribute", "default", [ "Object", [] ] ],
        [
          "Attribute",
          "description",
          [ "String", "Additional load balancers to add to ECS service" ]
        ],
        [
          "Attribute",
          "type",
          [
            "Fun_call",
            [
              "map",
              [
                [
                  "Fun_call",
                  [
                    "object",
                    [
                      [
                        "Object",
                        [
                          [
                            [ "Bare", "target_group_arn" ],
                            [ "Id", "string" ]
                          ],
                          [
                            [ "Bare", "container_port" ], [ "Id", "number" ]
                          ]
                        ]
                      ]
                    ]
                  ]
                ]
              ]
            ]
          ]
        ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "lb_internal" ] ],
      "body": [
        [
          "Attribute",
          "description",
          [ "String", "(Optional) If true, the LB will be internal." ]
        ],
        [ "Attribute", "type", [ "Id", "bool" ] ],
        [ "Attribute", "default", [ "Bool", false ] ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "lb_security_groups" ] ],
      "body": [
        [
          "Attribute",
          "description",
          [
            "String",
            "(Optional) A list of security group IDs to assign to the LB."
          ]
        ],
        [
          "Attribute",
          "type",
          [ "Fun_call", [ "list", [ [ "Id", "string" ] ] ] ]
        ],
        [ "Attribute", "default", [ "Tuple", [] ] ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "lb_drop_invalid_header_fields" ] ],
      "body": [
        [
          "Attribute",
          "description",
          [
            "String",
            "(Optional) Indicates whether HTTP headers with header fields that are not valid are removed by the load balancer (true) or routed to targets (false). The default is false. Elastic Load Balancing requires that message header names contain only alphanumeric characters and hyphens."
          ]
        ],
        [ "Attribute", "type", [ "Id", "bool" ] ],
        [ "Attribute", "default", [ "Bool", false ] ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "lb_idle_timeout" ] ],
      "body": [
        [
          "Attribute",
          "description",
          [
            "String",
            "(Optional) The time in seconds that the connection is allowed to be idle. Default: 60."
          ]
        ],
        [ "Attribute", "type", [ "Id", "number" ] ],
        [ "Attribute", "default", [ "Int", 60 ] ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "lb_enable_deletion_protection" ] ],
      "body": [
        [
          "Attribute",
          "description",
          [
            "String",
            "(Optional) If true, deletion of the load balancer will be disabled via the AWS API. This will prevent Terraform from deleting the load balancer. Defaults to false."
          ]
        ],
        [ "Attribute", "type", [ "Id", "bool" ] ],
        [ "Attribute", "default", [ "Bool", false ] ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "lb_enable_cross_zone_load_balancing" ] ],
      "body": [
        [
          "Attribute",
          "description",
          [
            "String",
            "(Optional) If true, cross-zone load balancing of the load balancer will be enabled. Defaults to false."
          ]
        ],
        [ "Attribute", "type", [ "Id", "bool" ] ],
        [ "Attribute", "default", [ "Bool", false ] ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "lb_enable_http2" ] ],
      "body": [
        [
          "Attribute",
          "description",
          [
            "String",
            "(Optional) Indicates whether HTTP/2 is enabled in the load balancer. Defaults to true."
          ]
        ],
        [ "Attribute", "type", [ "Id", "bool" ] ],
        [ "Attribute", "default", [ "Bool", true ] ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "lb_ip_address_type" ] ],
      "body": [
        [
          "Attribute",
          "description",
          [
            "String",
            "(Optional) The type of IP addresses used by the subnets for your load balancer. The possible values are ipv4 and dualstack. Defaults to ipv4"
          ]
        ],
        [ "Attribute", "type", [ "Id", "string" ] ],
        [ "Attribute", "default", [ "String", "ipv4" ] ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "lb_waf_web_acl_arn" ] ],
      "body": [
        [
          "Attribute",
          "description",
          [ "String", "ARN of a WAFV2 to associate with the ALB" ]
        ],
        [ "Attribute", "type", [ "Id", "string" ] ],
        [ "Attribute", "default", [ "String", "" ] ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "enable_s3_logs" ] ],
      "body": [
        [
          "Attribute",
          "description",
          [
            "String",
            "(Optional) If true, all resources to send LB logs to S3 will be created"
          ]
        ],
        [ "Attribute", "type", [ "Id", "bool" ] ],
        [ "Attribute", "default", [ "Bool", true ] ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "block_s3_bucket_public_access" ] ],
      "body": [
        [
          "Attribute",
          "description",
          [
            "String",
            "(Optional) If true, public access to the S3 bucket will be blocked."
          ]
        ],
        [ "Attribute", "type", [ "Id", "bool" ] ],
        [ "Attribute", "default", [ "Bool", true ] ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "enable_s3_bucket_server_side_encryption" ] ],
      "body": [
        [
          "Attribute",
          "description",
          [
            "String",
            "(Optional) If true, server side encryption will be applied."
          ]
        ],
        [ "Attribute", "type", [ "Id", "bool" ] ],
        [ "Attribute", "default", [ "Bool", true ] ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "variable",
      "labels": [
        [ "Lit", "s3_bucket_server_side_encryption_sse_algorithm" ]
      ],
      "body": [
        [
          "Attribute",
          "description",
          [
            "String",
            "(Optional) The server-side encryption algorithm to use. Valid values are AES256 and aws:kms"
          ]
        ],
        [ "Attribute", "type", [ "Id", "string" ] ],
        [ "Attribute", "default", [ "String", "AES256" ] ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "s3_bucket_server_side_encryption_key" ] ],
      "body": [
        [
          "Attribute",
          "description",
          [
            "String",
            "(Optional) The AWS KMS master key ID used for the SSE-KMS encryption. This can only be used when you set the value of sse_algorithm as aws:kms. The default aws/s3 AWS KMS master key is used if this element is absent while the sse_algorithm is aws:kms."
          ]
        ],
        [ "Attribute", "type", [ "Id", "string" ] ],
        [ "Attribute", "default", [ "Null" ] ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "lb_http_ports" ] ],
      "body": [
        [
          "Attribute",
          "description",
          [
            "String",
            "Map containing objects with two fields, listener_port and the target_group_port to redirect HTTP requests"
          ]
        ],
        [
          "Attribute", "type", [ "Fun_call", [ "map", [ [ "Id", "any" ] ] ] ]
        ],
        [
          "Attribute",
          "default",
          [
            "Object",
            [
              [
                [ "Bare", "default-http" ],
                [
                  "Object",
                  [
                    [ [ "Bare", "listener_port" ], [ "Int", 80 ] ],
                    [ [ "Bare", "target_group_port" ], [ "Int", 80 ] ]
                  ]
                ]
              ]
            ]
          ]
        ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "lb_http_ingress_cidr_blocks" ] ],
      "body": [
        [
          "Attribute",
          "description",
          [
            "String",
            "List of CIDR blocks to allowed to access the Load Balancer through HTTP"
          ]
        ],
        [
          "Attribute",
          "type",
          [ "Fun_call", [ "list", [ [ "Id", "string" ] ] ] ]
        ],
        [
          "Attribute", "default", [ "Tuple", [ [ "String", "0.0.0.0/0" ] ] ]
        ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "lb_http_ingress_prefix_list_ids" ] ],
      "body": [
        [
          "Attribute",
          "description",
          [
            "String",
            "List of prefix list IDs blocks to allowed to access the Load Balancer through HTTP"
          ]
        ],
        [
          "Attribute",
          "type",
          [ "Fun_call", [ "list", [ [ "Id", "string" ] ] ] ]
        ],
        [ "Attribute", "default", [ "Tuple", [] ] ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "lb_https_ports" ] ],
      "body": [
        [
          "Attribute",
          "description",
          [
            "String",
            "Map containing objects with two fields, listener_port and the target_group_port to redirect HTTPS requests"
          ]
        ],
        [
          "Attribute", "type", [ "Fun_call", [ "map", [ [ "Id", "any" ] ] ] ]
        ],
        [
          "Attribute",
          "default",
          [
            "Object",
            [
              [
                [ "Bare", "default-https" ],
                [
                  "Object",
                  [
                    [ [ "Bare", "listener_port" ], [ "Int", 443 ] ],
                    [ [ "Bare", "target_group_port" ], [ "Int", 443 ] ]
                  ]
                ]
              ]
            ]
          ]
        ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "lb_https_ingress_cidr_blocks" ] ],
      "body": [
        [
          "Attribute",
          "description",
          [
            "String",
            "List of CIDR blocks to allowed to access the Load Balancer through HTTPS"
          ]
        ],
        [
          "Attribute",
          "type",
          [ "Fun_call", [ "list", [ [ "Id", "string" ] ] ] ]
        ],
        [
          "Attribute", "default", [ "Tuple", [ [ "String", "0.0.0.0/0" ] ] ]
        ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "lb_https_ingress_prefix_list_ids" ] ],
      "body": [
        [
          "Attribute",
          "description",
          [
            "String",
            "List of prefix list IDs blocks to allowed to access the Load Balancer through HTTPS"
          ]
        ],
        [
          "Attribute",
          "type",
          [ "Fun_call", [ "list", [ [ "Id", "string" ] ] ] ]
        ],
        [ "Attribute", "default", [ "Tuple", [] ] ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "lb_deregistration_delay" ] ],
      "body": [
        [
          "Attribute",
          "description",
          [
            "String",
            "(Optional) The amount time for Elastic Load Balancing to wait before changing the state of a deregistering target from draining to unused. The range is 0-3600 seconds. The default value is 300 seconds."
          ]
        ],
        [ "Attribute", "type", [ "Id", "number" ] ],
        [ "Attribute", "default", [ "Int", 300 ] ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "lb_slow_start" ] ],
      "body": [
        [
          "Attribute",
          "description",
          [
            "String",
            "(Optional) The amount time for targets to warm up before the load balancer sends them a full share of requests. The range is 30-900 seconds or 0 to disable. The default value is 0 seconds."
          ]
        ],
        [ "Attribute", "type", [ "Id", "number" ] ],
        [ "Attribute", "default", [ "Int", 0 ] ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "lb_load_balancing_algorithm_type" ] ],
      "body": [
        [
          "Attribute",
          "description",
          [
            "String",
            "(Optional) Determines how the load balancer selects targets when routing requests. The value is round_robin or least_outstanding_requests. The default is round_robin."
          ]
        ],
        [ "Attribute", "type", [ "Id", "string" ] ],
        [ "Attribute", "default", [ "String", "round_robin" ] ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "lb_stickiness" ] ],
      "body": [
        [
          "Attribute",
          "description",
          [
            "String",
            "(Optional) A Stickiness block. Provide three fields. type, the type of sticky sessions. The only current possible value is lb_cookie. cookie_duration, the time period, in seconds, during which requests from a client should be routed to the same target. After this time period expires, the load balancer-generated cookie is considered stale. The range is 1 second to 1 week (604800 seconds). The default value is 1 day (86400 seconds). enabled, boolean to enable / disable stickiness. Default is true."
          ]
        ],
        [
          "Attribute",
          "type",
          [
            "Fun_call",
            [
              "object",
              [
                [
                  "Object",
                  [
                    [ [ "Bare", "type" ], [ "Id", "string" ] ],
                    [ [ "Bare", "cookie_duration" ], [ "Id", "string" ] ],
                    [ [ "Bare", "enabled" ], [ "Id", "bool" ] ]
                  ]
                ]
              ]
            ]
          ]
        ],
        [
          "Attribute",
          "default",
          [
            "Object",
            [
              [ [ "Bare", "type" ], [ "String", "lb_cookie" ] ],
              [ [ "Bare", "cookie_duration" ], [ "Int", 86400 ] ],
              [ [ "Bare", "enabled" ], [ "Bool", true ] ]
            ]
          ]
        ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "lb_target_group_health_check_enabled" ] ],
      "body": [
        [
          "Attribute",
          "description",
          [
            "String",
            "(Optional) Indicates whether health checks are enabled. Defaults to true."
          ]
        ],
        [ "Attribute", "type", [ "Id", "bool" ] ],
        [ "Attribute", "default", [ "Bool", true ] ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "lb_target_group_health_check_interval" ] ],
      "body": [
        [
          "Attribute",
          "description",
          [
            "String",
            "(Optional) The approximate amount of time, in seconds, between health checks of an individual target. Minimum value 5 seconds, Maximum value 300 seconds. Default 30 seconds."
          ]
        ],
        [ "Attribute", "type", [ "Id", "number" ] ],
        [ "Attribute", "default", [ "Int", 30 ] ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "lb_target_group_health_check_path" ] ],
      "body": [
        [
          "Attribute",
          "description",
          [ "String", "The destination for the health check request." ]
        ],
        [ "Attribute", "type", [ "Id", "string" ] ],
        [ "Attribute", "default", [ "String", "/" ] ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "lb_target_group_health_check_timeout" ] ],
      "body": [
        [
          "Attribute",
          "description",
          [
            "String",
            "(Optional) The amount of time, in seconds, during which no response means a failed health check. The range is 2 to 120 seconds, and the default is 5 seconds."
          ]
        ],
        [ "Attribute", "type", [ "Id", "number" ] ],
        [ "Attribute", "default", [ "Int", 5 ] ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "variable",
      "labels": [
        [ "Lit", "lb_target_group_health_check_healthy_threshold" ]
      ],
      "body": [
        [
          "Attribute",
          "description",
          [
            "String",
            "(Optional) The number of consecutive health checks successes required before considering an unhealthy target healthy. Defaults to 3."
          ]
        ],
        [ "Attribute", "type", [ "Id", "number" ] ],
        [ "Attribute", "default", [ "Int", 3 ] ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "variable",
      "labels": [
        [ "Lit", "lb_target_group_health_check_unhealthy_threshold" ]
      ],
      "body": [
        [
          "Attribute",
          "description",
          [
            "String",
            "(Optional) The number of consecutive health check failures required before considering the target unhealthy. Defaults to 3."
          ]
        ],
        [ "Attribute", "type", [ "Id", "number" ] ],
        [ "Attribute", "default", [ "Int", 3 ] ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "lb_target_group_health_check_matcher" ] ],
      "body": [
        [
          "Attribute",
          "description",
          [
            "String",
            "The HTTP codes to use when checking for a successful response from a target. You can specify multiple values (for example, \"200,202\") or a range of values (for example, \"200-299\"). Default is 200."
          ]
        ],
        [ "Attribute", "type", [ "Id", "string" ] ],
        [ "Attribute", "default", [ "String", "200" ] ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "ssl_policy" ] ],
      "body": [
        [
          "Attribute",
          "description",
          [
            "String",
            "(Optional) The name of the SSL Policy for the listener. . Required if var.https_ports is set."
          ]
        ],
        [ "Attribute", "type", [ "Id", "string" ] ],
        [ "Attribute", "default", [ "Null" ] ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "default_certificate_arn" ] ],
      "body": [
        [
          "Attribute",
          "description",
          [
            "String",
            "(Optional) The ARN of the default SSL server certificate. Required if var.https_ports is set."
          ]
        ],
        [ "Attribute", "type", [ "Id", "string" ] ],
        [ "Attribute", "default", [ "Null" ] ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "variable",
      "labels": [
        [ "Lit", "additional_certificates_arn_for_https_listeners" ]
      ],
      "body": [
        [
          "Attribute",
          "description",
          [
            "String",
            "(Optional) List of SSL server certificate ARNs for HTTPS listener. Use it if you need to set additional certificates besides default_certificate_arn"
          ]
        ],
        [
          "Attribute",
          "type",
          [ "Fun_call", [ "list", [ [ "Id", "any" ] ] ] ]
        ],
        [ "Attribute", "default", [ "Tuple", [] ] ]
      ]
    }
  ]
]
