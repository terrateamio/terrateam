            [
              "EOD",
              "\nList of scripts to be used for TaskEpilog. Programs for the slurmd to execute\nas the slurm job's owner after termination of each task.\nSee https://slurm.schedmd.com/slurm.conf.html#OPT_TaskEpilog.\n"
            ]
          ]
        ],
        [
          "Attribute",
          "type",
          [
            "Fun_call",
            [
              "list",
              [
                [
                  "Fun_call",
                  [
