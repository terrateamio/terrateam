[
  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "project_id" ] ],
      "body": [
        [ "Attribute", "type", [ "Id", "string" ] ],
        [
          "Attribute",
          "description",
          [ "String", "Project ID to create resources in." ]
        ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "deployment_name" ] ],
      "body": [
        [
          "Attribute", "description", [ "String", "Name of the deployment." ]
        ],
        [ "Attribute", "type", [ "Id", "string" ] ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "slurm_cluster_name" ] ],
      "body": [
        [ "Attribute", "type", [ "Id", "string" ] ],
        [
          "Attribute",
          "description",
          [
            "Heredoc",
            [
              "EOD",
              "\nCluster name, used for resource naming and slurm accounting.\nIf not provided it will default to the first 8 characters of the deployment name (removing any invalid characters).\n"
            ]
          ]
        ],
        [ "Attribute", "default", [ "Null" ] ],
        [
          "Block",
          {
            "type_": "validation",
            "labels": [],
            "body": [
              [
                "Attribute",
                "condition",
                [
                  "Log_or",
                  [
                    [
                      "Equal",
                      [
                        [
                          "Attr",
                          [
                            [ "Id", "var" ],
                            [ "A_string", "slurm_cluster_name" ]
                          ]
                        ],
                        [ "Null" ]
                      ]
                    ],
                    [
                      "Fun_call",
                      [
                        "can",
                        [
                          [
                            "Fun_call",
                            [
                              "regex",
                              [
                                [ "String", "^[a-z]([-a-z0-9]{0,19})$" ],
                                [
                                  "Attr",
                                  [
                                    [ "Id", "var" ],
                                    [ "A_string", "slurm_cluster_name" ]
                                  ]
                                ]
                              ]
                            ]
                          ]
                        ]
                      ]
                    ]
                  ]
                ]
              ],
              [
                "Attribute",
                "error_message",
                [
                  "String",
                  "Variable 'slurm_cluster_name' must be a match of regex '^[a-z]([-a-z0-9]{0,19})$'."
                ]
              ]
            ]
          }
        ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "region" ] ],
      "body": [
        [ "Attribute", "type", [ "Id", "string" ] ],
        [
          "Attribute",
          "description",
          [ "String", "The default region to place resources in." ]
        ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "zone" ] ],
      "body": [
        [ "Attribute", "type", [ "Id", "string" ] ],
        [
          "Attribute",
          "description",
          [
            "Heredoc",
            [
              "EOD",
              "\nZone where the instances should be created. If not specified, instances will be\nspread across available zones in the region.\n"
            ]
          ]
        ],
        [ "Attribute", "default", [ "Null" ] ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "create_bucket" ] ],
      "body": [
        [
          "Attribute",
          "description",
          [
            "Heredoc",
            [
              "EOD",
              "\nCreate GCS bucket instead of using an existing one.\n"
            ]
          ]
        ],
        [ "Attribute", "type", [ "Id", "bool" ] ],
        [ "Attribute", "default", [ "Bool", true ] ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "bucket_name" ] ],
      "body": [
        [
          "Attribute",
          "description",
          [
            "Heredoc",
            [
              "EOD",
              "\nName of GCS bucket.\nIgnored when 'create_bucket' is true.\n"
            ]
          ]
        ],
        [ "Attribute", "type", [ "Id", "string" ] ],
        [ "Attribute", "default", [ "Null" ] ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "bucket_dir" ] ],
      "body": [
        [
          "Attribute",
          "description",
          [
            "String",
            "Bucket directory for cluster files to be put into. If not specified, then one will be chosen based on slurm_cluster_name."
          ]
        ],
        [ "Attribute", "type", [ "Id", "string" ] ],
        [ "Attribute", "default", [ "Null" ] ]
      ]
    }
