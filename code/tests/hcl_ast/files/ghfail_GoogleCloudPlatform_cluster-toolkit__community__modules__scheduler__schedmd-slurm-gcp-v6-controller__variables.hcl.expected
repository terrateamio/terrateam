      "labels": [ [ "Lit", "slurm_conf_tpl" ] ],
      "body": [
        [ "Attribute", "type", [ "Id", "string" ] ],
        [
          "Attribute",
          "description",
          [
            "String",
            "Slurm slurm.conf template file path. This path is used only if raw content is not provided in 'slurm_conf_template'."
          ]
        ],
        [ "Attribute", "default", [ "Null" ] ]
      ]
    }
  ],
  [
    "Block",
