        [ "Attribute", "default", [ "Bool", false ] ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "extra_logging_flags" ] ],
      "body": [
        [
          "Attribute",
          "type",
          [ "Fun_call", [ "map", [ [ "Id", "bool" ] ] ] ]
        ],
        [
          "Attribute",
          "description",
          [ "String", "The only available flag is `trace_api`" ]
        ],
        [ "Attribute", "default", [ "Object", [] ] ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "enable_cleanup_compute" ] ],
      "body": [
        [
          "Attribute",
          "description",
          [
            "Heredoc",
            [
              "EOD",
              "\nEnables automatic cleanup of compute nodes and resource policies (e.g.\nplacement groups) managed by this module, when cluster is destroyed.\n\n*WARNING*: Toggling this off will impact the running workload.\nDeployed compute nodes will be destroyed.\n"
            ]
          ]
        ],
        [ "Attribute", "type", [ "Id", "bool" ] ],
        [ "Attribute", "default", [ "Bool", true ] ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "enable_bigquery_load" ] ],
      "body": [
        [
          "Attribute",
          "description",
          [
            "Heredoc",
            [
              "EOD",
              "\nEnables loading of cluster job usage into big query.\n\nNOTE: Requires Google Bigquery API.\n"
            ]
          ]
        ],
        [ "Attribute", "type", [ "Id", "bool" ] ],
        [ "Attribute", "default", [ "Bool", false ] ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "enable_slurm_auth" ] ],
      "body": [
        [
          "Attribute",
          "description",
          [
            "Heredoc",
            [ "EOD", "\nEnables slurm authentication instead of munge.\n\n" ]
          ]
        ],
        [ "Attribute", "type", [ "Id", "bool" ] ],
        [ "Attribute", "default", [ "Bool", false ] ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "cloud_parameters" ] ],
      "body": [
        [
          "Attribute",
          "description",
          [
            "String",
            "cloud.conf options. Defaults inherited from [Slurm GCP repo](https://github.com/GoogleCloudPlatform/slurm-gcp/blob/master/terraform/slurm_cluster/modules/slurm_files/README_TF.md#input_cloud_parameters)"
          ]
        ],
        [
          "Attribute",
          "type",
          [
            "Fun_call",
            [
              "object",
              [
                [
                  "Object",
                  [
                    [
                      [ "Bare", "no_comma_params" ],
                      [
                        "Fun_call",
                        [
                          "optional", [ [ "Id", "bool" ], [ "Bool", false ] ]
                        ]
                      ]
                    ],
                    [
                      [ "Bare", "private_data" ],
                      [
                        "Fun_call",
                        [
                          "optional",
                          [
                            [
                              "Fun_call", [ "list", [ [ "Id", "string" ] ] ]
                            ]
                          ]
                        ]
                      ]
                    ],
                    [
                      [ "Bare", "scheduler_parameters" ],
                      [
                        "Fun_call",
                        [
                          "optional",
                          [
                            [
                              "Fun_call", [ "list", [ [ "Id", "string" ] ] ]
                            ]
                          ]
                        ]
                      ]
                    ],
                    [
                      [ "Bare", "resume_rate" ],
                      [ "Fun_call", [ "optional", [ [ "Id", "number" ] ] ] ]
                    ],
                    [
                      [ "Bare", "resume_timeout" ],
                      [ "Fun_call", [ "optional", [ [ "Id", "number" ] ] ] ]
                    ],
                    [
                      [ "Bare", "suspend_rate" ],
                      [ "Fun_call", [ "optional", [ [ "Id", "number" ] ] ] ]
                    ],
                    [
                      [ "Bare", "suspend_timeout" ],
                      [ "Fun_call", [ "optional", [ [ "Id", "number" ] ] ] ]
                    ],
                    [
                      [ "Bare", "slurmd_timeout" ],
                      [ "Fun_call", [ "optional", [ [ "Id", "number" ] ] ] ]
                    ],
                    [
                      [ "Bare", "unkillable_step_timeout" ],
                      [ "Fun_call", [ "optional", [ [ "Id", "number" ] ] ] ]
                    ],
                    [
                      [ "Bare", "topology_plugin" ],
                      [ "Fun_call", [ "optional", [ [ "Id", "string" ] ] ] ]
                    ],
                    [
                      [ "Bare", "topology_param" ],
                      [ "Fun_call", [ "optional", [ [ "Id", "string" ] ] ] ]
                    ],
                    [
                      [ "Bare", "tree_width" ],
                      [ "Fun_call", [ "optional", [ [ "Id", "number" ] ] ] ]
                    ],
                    [
                      [ "Bare", "prolog_flags" ],
                      [ "Fun_call", [ "optional", [ [ "Id", "string" ] ] ] ]
                    ],
                    [
                      [ "Bare", "switch_type" ],
                      [ "Fun_call", [ "optional", [ [ "Id", "string" ] ] ] ]
                    ]
                  ]
                ]
              ]
            ]
          ]
        ],
        [ "Attribute", "default", [ "Object", [] ] ],
        [ "Attribute", "nullable", [ "Bool", false ] ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "enable_default_mounts" ] ],
      "body": [
        [
          "Attribute",
          "description",
          [
            "Heredoc",
            [
              "EOD",
              "\nEnable default global network storage from the controller\n- /home\n- /opt/apps\n"
            ]
          ]
        ],
        [ "Attribute", "type", [ "Id", "bool" ] ],
        [ "Attribute", "default", [ "Bool", true ] ]
      ]
    }
  ],
