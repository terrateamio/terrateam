                                  [
                                    "Not_equal",
                                    [
                                      [
                                        "Attr",
                                        [
                                          [ "Id", "script" ],
                                          [ "A_string", "source" ]
                                        ]
                                      ],
                                      [ "Null" ]
                                    ]
                                  ]
                                ]
                              ]
                            ]
                          ],
                          "cond": null
                        }
                      ]
                    ]
