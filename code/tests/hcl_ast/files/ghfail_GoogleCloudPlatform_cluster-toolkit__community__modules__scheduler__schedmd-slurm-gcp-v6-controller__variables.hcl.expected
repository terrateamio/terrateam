  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "enable_external_prolog_epilog" ] ],
      "body": [
        [
          "Attribute",
          "description",
          [
            "Heredoc",
            [
              "EOD",
              "\nAutomatically enable a script that will execute prolog and epilog scripts\nshared by NFS from the controller to compute nodes. Find more details at:\nhttps://github.com/GoogleCloudPlatform/slurm-gcp/blob/master/tools/prologs-epilogs/README.md\n"
            ]
          ]
        ],
        [ "Attribute", "type", [ "Id", "bool" ] ],
        [ "Attribute", "default", [ "Null" ] ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "cloudsql" ] ],
      "body": [
        [
          "Attribute",
          "description",
          [
            "Heredoc",
            [
              "EOD",
              "\nUse this database instead of the one on the controller.\n  server_ip : Address of the database server.\n  user      : The user to access the database as.\n  password  : The password, given the user, to access the given database. (sensitive)\n  db_name   : The database to access.\n  user_managed_replication : The list of location and (optional) kms_key_name for secret\n"
            ]
          ]
        ],
        [
          "Attribute",
          "type",
          [
            "Fun_call",
            [
              "object",
              [
                [
                  "Object",
                  [
                    [ [ "Bare", "server_ip" ], [ "Id", "string" ] ],
                    [ [ "Bare", "user" ], [ "Id", "string" ] ],
                    [ [ "Bare", "password" ], [ "Id", "string" ] ],
                    [ [ "Bare", "db_name" ], [ "Id", "string" ] ],
                    [
                      [ "Bare", "user_managed_replication" ],
                      [
                        "Fun_call",
                        [
                          "optional",
                          [
                            [
                              "Fun_call",
                              [
                                "list",
                                [
                                  [
                                    "Fun_call",
                                    [
                                      "object",
                                      [
                                        [
                                          "Object",
                                          [
                                            [
                                              [ "Bare", "location" ],
                                              [ "Id", "string" ]
                                            ],
                                            [
                                              [ "Bare", "kms_key_name" ],
                                              [
                                                "Fun_call",
                                                [
                                                  "optional",
                                                  [ [ "Id", "string" ] ]
                                                ]
                                              ]
                                            ]
                                          ]
                                        ]
                                      ]
                                    ]
                                  ]
                                ]
                              ]
                            ],
                            [ "Tuple", [] ]
                          ]
                        ]
                      ]
                    ]
                  ]
                ]
              ]
            ]
          ]
        ],
        [ "Attribute", "default", [ "Null" ] ],
        [ "Attribute", "sensitive", [ "Bool", true ] ]
      ]
    }
  ],
  [
