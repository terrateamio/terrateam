                                    [
                                      [
                                        "Attr",
                                        [
                                          [ "Id", "script" ],
                                          [ "A_string", "content" ]
                                        ]
                                      ],
                                      [ "Null" ]
                                    ]
                                  ],
                                  [
                                    "Not_equal",
                                    [
                                      [
                                        "Attr",
                                        [
                                          [ "Id", "script" ],
                                          [ "A_string", "source" ]
                                        ]
                                      ],
                                      [ "Null" ]
                                    ]
                                  ]
                                ]
                              ]
                            ]
                          ],
                          "cond": null
                        }
                      ]
                    ]
                  ]
                ]
              ],
              [
                "Attribute",
                "error_message",
                [
