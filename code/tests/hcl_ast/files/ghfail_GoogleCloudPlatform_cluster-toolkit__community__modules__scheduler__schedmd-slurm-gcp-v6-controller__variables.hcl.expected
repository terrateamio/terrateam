                                  [
                                    "Equal",
                                    [
                                      [
                                        "Attr",
                                        [
                                          [ "Id", "script" ],
                                          [ "A_string", "source" ]
                                        ]
                                      ],
                                      [ "Null" ]
                                    ]
                                  ]
                                ]
                              ],
                              [
                                "Log_and",
                                [
                                  [
                                    "Equal",
                                    [
                                      [
                                        "Attr",
                                        [
                                          [ "Id", "script" ],
                                          [ "A_string", "content" ]
                                        ]
                                      ],
                                      [ "Null" ]
                                    ]
                                  ],
                                  [
                                    "Not_equal",
                                    [
                                      [
                                        "Attr",
                                        [
                                          [ "Id", "script" ],
                                          [ "A_string", "source" ]
                                        ]
                                      ],
                                      [ "Null" ]
                                    ]
                                  ]
                                ]
                              ]
