                          ],
                          "output": [
                            "Log_or",
                            [
                              [
                                "Log_and",
                                [
                                  [
                                    "Not_equal",
                                    [
                                      [
                                        "Attr",
                                        [
                                          [ "Id", "script" ],
                                          [ "A_string", "content" ]
                                        ]
                                      ],
