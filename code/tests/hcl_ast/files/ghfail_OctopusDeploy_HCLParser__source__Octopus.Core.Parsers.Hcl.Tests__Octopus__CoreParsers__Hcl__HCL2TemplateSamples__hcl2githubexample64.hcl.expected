  ],
  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "associate_public_ip_address" ] ],
      "body": [
        [ "Attribute", "type", [ "Id", "bool" ] ],
        [
          "Attribute",
          "description",
          [
            "String",
            "Associate a public ip address with an instance in a VPC"
          ]
        ],
        [ "Attribute", "default", [ "Bool", false ] ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "subnets" ] ],
