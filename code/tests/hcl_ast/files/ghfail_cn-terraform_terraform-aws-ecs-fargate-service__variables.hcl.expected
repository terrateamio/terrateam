  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "lb_deregistration_delay" ] ],
      "body": [
        [
          "Attribute",
          "description",
          [
            "String",
            "(Optional) The amount time for Elastic Load Balancing to wait before changing the state of a deregistering target from draining to unused. The range is 0-3600 seconds. The default value is 300 seconds."
          ]
        ],
        [ "Attribute", "type", [ "Id", "number" ] ],
        [ "Attribute", "default", [ "Int", 300 ] ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "lb_slow_start" ] ],
      "body": [
        [
          "Attribute",
          "description",
          [
            "String",
            "(Optional) The amount time for targets to warm up before the load balancer sends them a full share of requests. The range is 30-900 seconds or 0 to disable. The default value is 0 seconds."
          ]
        ],
        [ "Attribute", "type", [ "Id", "number" ] ],
        [ "Attribute", "default", [ "Int", 0 ] ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "lb_load_balancing_algorithm_type" ] ],
      "body": [
        [
          "Attribute",
          "description",
          [
            "String",
            "(Optional) Determines how the load balancer selects targets when routing requests. The value is round_robin or least_outstanding_requests. The default is round_robin."
          ]
        ],
        [ "Attribute", "type", [ "Id", "string" ] ],
        [ "Attribute", "default", [ "String", "round_robin" ] ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "lb_stickiness" ] ],
      "body": [
        [
          "Attribute",
          "description",
          [
            "String",
            "(Optional) A Stickiness block. Provide three fields. type, the type of sticky sessions. The only current possible value is lb_cookie. cookie_duration, the time period, in seconds, during which requests from a client should be routed to the same target. After this time period expires, the load balancer-generated cookie is considered stale. The range is 1 second to 1 week (604800 seconds). The default value is 1 day (86400 seconds). enabled, boolean to enable / disable stickiness. Default is true."
          ]
        ],
        [
          "Attribute",
          "type",
          [
            "Fun_call",
            [
              "object",
              [
                [
                  "Object",
                  [
                    [ [ "Bare", "type" ], [ "Id", "string" ] ],
                    [ [ "Bare", "cookie_duration" ], [ "Id", "string" ] ],
                    [ [ "Bare", "enabled" ], [ "Id", "bool" ] ]
                  ]
                ]
              ]
            ]
          ]
        ],
        [
          "Attribute",
          "default",
          [
            "Object",
            [
              [ [ "Bare", "type" ], [ "String", "lb_cookie" ] ],
              [ [ "Bare", "cookie_duration" ], [ "Int", 86400 ] ],
              [ [ "Bare", "enabled" ], [ "Bool", true ] ]
            ]
          ]
        ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "lb_target_group_health_check_enabled" ] ],
      "body": [
        [
          "Attribute",
          "description",
          [
            "String",
            "(Optional) Indicates whether health checks are enabled. Defaults to true."
          ]
        ],
        [ "Attribute", "type", [ "Id", "bool" ] ],
        [ "Attribute", "default", [ "Bool", true ] ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "lb_target_group_health_check_interval" ] ],
      "body": [
        [
          "Attribute",
          "description",
          [
            "String",
            "(Optional) The approximate amount of time, in seconds, between health checks of an individual target. Minimum value 5 seconds, Maximum value 300 seconds. Default 30 seconds."
          ]
        ],
        [ "Attribute", "type", [ "Id", "number" ] ],
        [ "Attribute", "default", [ "Int", 30 ] ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "lb_target_group_health_check_path" ] ],
      "body": [
        [
          "Attribute",
          "description",
          [ "String", "The destination for the health check request." ]
        ],
        [ "Attribute", "type", [ "Id", "string" ] ],
        [ "Attribute", "default", [ "String", "/" ] ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "lb_target_group_health_check_port" ] ],
      "body": [
        [
          "Attribute",
          "description",
          [
            "String",
            "(Optional) The port to use to connect with the target. Valid values are either ports 1-65536, or traffic-port. Defaults to traffic-port."
          ]
        ],
        [ "Attribute", "type", [ "Id", "string" ] ],
        [ "Attribute", "default", [ "String", "traffic-port" ] ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "lb_target_group_health_check_protocol" ] ],
      "body": [
        [
          "Attribute",
          "description",
          [
            "String",
            "(Optional) The protocol the load balancer uses when performing health checks on targets. Valid values are HTTP and HTTPS. Defaults to HTTP."
          ]
        ],
        [ "Attribute", "type", [ "Id", "string" ] ],
        [ "Attribute", "default", [ "String", "HTTP" ] ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "lb_target_group_health_check_timeout" ] ],
      "body": [
        [
          "Attribute",
          "description",
          [
            "String",
            "(Optional) The amount of time, in seconds, during which no response means a failed health check. The range is 2 to 120 seconds, and the default is 5 seconds."
          ]
        ],
        [ "Attribute", "type", [ "Id", "number" ] ],
        [ "Attribute", "default", [ "Int", 5 ] ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "variable",
      "labels": [
        [ "Lit", "lb_target_group_health_check_healthy_threshold" ]
      ],
      "body": [
        [
          "Attribute",
          "description",
          [
            "String",
            "(Optional) The number of consecutive health checks successes required before considering an unhealthy target healthy. Defaults to 3."
          ]
        ],
        [ "Attribute", "type", [ "Id", "number" ] ],
        [ "Attribute", "default", [ "Int", 3 ] ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "variable",
      "labels": [
        [ "Lit", "lb_target_group_health_check_unhealthy_threshold" ]
      ],
      "body": [
        [
          "Attribute",
          "description",
          [
            "String",
            "(Optional) The number of consecutive health check failures required before considering the target unhealthy. Defaults to 3."
          ]
        ],
        [ "Attribute", "type", [ "Id", "number" ] ],
        [ "Attribute", "default", [ "Int", 3 ] ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "lb_target_group_health_check_matcher" ] ],
      "body": [
        [
          "Attribute",
          "description",
          [
            "String",
            "The HTTP codes to use when checking for a successful response from a target. You can specify multiple values (for example, \"200,202\") or a range of values (for example, \"200-299\"). Default is 200."
          ]
        ],
        [ "Attribute", "type", [ "Id", "string" ] ],
        [ "Attribute", "default", [ "String", "200" ] ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "ssl_policy" ] ],
      "body": [
        [
          "Attribute",
          "description",
          [
            "String",
            "(Optional) The name of the SSL Policy for the listener. . Required if var.https_ports is set."
          ]
        ],
        [ "Attribute", "type", [ "Id", "string" ] ],
        [ "Attribute", "default", [ "Null" ] ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "default_certificate_arn" ] ],
      "body": [
        [
          "Attribute",
          "description",
          [
            "String",
            "(Optional) The ARN of the default SSL server certificate. Required if var.https_ports is set."
          ]
        ],
        [ "Attribute", "type", [ "Id", "string" ] ],
        [ "Attribute", "default", [ "Null" ] ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "variable",
      "labels": [
        [ "Lit", "additional_certificates_arn_for_https_listeners" ]
      ],
      "body": [
        [
          "Attribute",
          "description",
          [
            "String",
            "(Optional) List of SSL server certificate ARNs for HTTPS listener. Use it if you need to set additional certificates besides default_certificate_arn"
          ]
        ],
        [
          "Attribute",
          "type",
          [ "Fun_call", [ "list", [ [ "Id", "any" ] ] ] ]
        ],
        [ "Attribute", "default", [ "Tuple", [] ] ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "enable_s3_logs" ] ],
      "body": [
        [
          "Attribute",
          "description",
          [
            "String",
            "(Optional) If true, all LoadBalancer logs will be send to S3.  If true, and log_bucket_id is *not* provided, this module will create the bucket with other provided s3 bucket configuration options"
          ]
        ],
        [ "Attribute", "type", [ "Id", "bool" ] ],
        [ "Attribute", "default", [ "Bool", true ] ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "log_bucket_id" ] ],
      "body": [
        [
          "Attribute",
          "description",
          [
            "String",
            "(Optional) if provided, the ID of a previously-defined S3 bucket to send LB logs to."
          ]
        ],
        [ "Attribute", "type", [ "Id", "string" ] ],
        [ "Attribute", "default", [ "Null" ] ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "block_s3_bucket_public_access" ] ],
      "body": [
        [
          "Attribute",
          "description",
          [
            "String",
            "(Optional) If true, public access to the S3 bucket will be blocked.  Ignored if log_bucket_id is provided."
          ]
        ],
        [ "Attribute", "type", [ "Id", "bool" ] ],
        [ "Attribute", "default", [ "Bool", true ] ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "enable_s3_bucket_server_side_encryption" ] ],
      "body": [
        [
          "Attribute",
          "description",
          [
            "String",
            "(Optional) If true, server side encryption will be applied.  Ignored if log_bucket_id is provided."
          ]
        ],
        [ "Attribute", "type", [ "Id", "bool" ] ],
        [ "Attribute", "default", [ "Bool", true ] ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "variable",
      "labels": [
        [ "Lit", "s3_bucket_server_side_encryption_sse_algorithm" ]
      ],
      "body": [
        [
          "Attribute",
          "description",
          [
            "String",
            "(Optional) The server-side encryption algorithm to use. Valid values are AES256 and aws:kms.  Ignored if log_bucket_id is provided."
          ]
        ],
        [ "Attribute", "type", [ "Id", "string" ] ],
        [ "Attribute", "default", [ "String", "AES256" ] ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "s3_bucket_server_side_encryption_key" ] ],
      "body": [
        [
          "Attribute",
          "description",
          [
            "String",
            "(Optional) The AWS KMS master key ID used for the SSE-KMS encryption. This can only be used when you set the value of sse_algorithm as aws:kms. The default aws/s3 AWS KMS master key is used if this element is absent while the sse_algorithm is aws:kms.    Ignored if log_bucket_id is provided."
          ]
        ],
        [ "Attribute", "type", [ "Id", "string" ] ],
        [ "Attribute", "default", [ "Null" ] ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "access_logs_prefix" ] ],
      "body": [
        [
          "Attribute",
          "description",
          [
            "String",
            "(Optional) if access logging to an S3 bucket, this sets a prefix in the bucket beneath which this LB's logs will be organized."
          ]
        ],
        [ "Attribute", "type", [ "Id", "string" ] ],
        [ "Attribute", "default", [ "Null" ] ]
      ]
    }
  ]
]
