[
  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "name_prefix" ] ],
      "body": [
        [
          "Attribute",
          "description",
          [
            "String",
            "Name prefix for resources on AWS. Max length is 15 characters."
          ]
        ],
        [ "Attribute", "type", [ "Id", "string" ] ],
        [
          "Block",
          {
            "type_": "validation",
            "labels": [],
            "body": [
              [
                "Attribute",
                "condition",
                [
                  "Lte",
                  [
                    [
                      "Fun_call",
                      [
                        "length",
                        [
                          [
                            "Attr",
                            [
                              [ "Id", "var" ], [ "A_string", "name_prefix" ]
                            ]
                          ]
                        ]
                      ]
                    ],
                    [ "Int", 15 ]
                  ]
                ]
              ],
              [
                "Attribute",
                "error_message",
                [
                  "String", "The name prefix must be 15 characters or less."
                ]
              ]
            ]
          }
        ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "vpc_id" ] ],
      "body": [
        [ "Attribute", "description", [ "String", "ID of the VPC" ] ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "ecs_cluster_arn" ] ],
      "body": [
        [ "Attribute", "description", [ "String", "ARN of an ECS cluster" ] ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "deployment_maximum_percent" ] ],
      "body": [
        [
          "Attribute",
          "description",
          [
            "String",
            "(Optional) The upper limit (as a percentage of the service's desiredCount) of the number of running tasks that can be running in a service during a deployment."
          ]
        ],
        [ "Attribute", "type", [ "Id", "number" ] ],
        [ "Attribute", "default", [ "Int", 200 ] ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "deployment_minimum_healthy_percent" ] ],
      "body": [
        [
          "Attribute",
          "description",
          [
            "String",
            "(Optional) The lower limit (as a percentage of the service's desiredCount) of the number of running tasks that must remain running and healthy in a service during a deployment."
          ]
        ],
        [ "Attribute", "type", [ "Id", "number" ] ],
        [ "Attribute", "default", [ "Int", 100 ] ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "deployment_circuit_breaker_enabled" ] ],
      "body": [
        [
          "Attribute",
          "description",
          [
            "String",
            "(Optional) You can enable the deployment circuit breaker to cause a service deployment to transition to a failed state if tasks are persistently failing to reach RUNNING state or are failing healthcheck."
          ]
        ],
        [ "Attribute", "type", [ "Id", "bool" ] ],
        [ "Attribute", "default", [ "Bool", false ] ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "deployment_circuit_breaker_rollback" ] ],
      "body": [
        [
          "Attribute",
          "description",
          [
            "String",
            "(Optional) The optional rollback option causes Amazon ECS to roll back to the last completed deployment upon a deployment failure."
          ]
        ],
        [ "Attribute", "type", [ "Id", "bool" ] ],
        [ "Attribute", "default", [ "Bool", false ] ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "desired_count" ] ],
      "body": [
        [
          "Attribute",
          "description",
          [
            "String",
            "(Optional) The number of instances of the task definition to place and keep running. Defaults to 0."
          ]
        ],
        [ "Attribute", "type", [ "Id", "number" ] ],
        [ "Attribute", "default", [ "Int", 1 ] ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "tags" ] ],
      "body": [
        [
          "Attribute",
          "type",
          [ "Fun_call", [ "map", [ [ "Id", "string" ] ] ] ]
        ],
        [ "Attribute", "default", [ "Object", [] ] ],
        [ "Attribute", "description", [ "String", "Resource tags" ] ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "enable_ecs_managed_tags" ] ],
      "body": [
        [
          "Attribute",
          "description",
          [
            "String",
            "(Optional) Specifies whether to enable Amazon ECS managed tags for the tasks within the service."
          ]
        ],
        [ "Attribute", "type", [ "Id", "bool" ] ],
        [ "Attribute", "default", [ "Bool", false ] ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "health_check_grace_period_seconds" ] ],
      "body": [
        [
          "Attribute",
          "description",
          [
            "String",
            "(Optional) Seconds to ignore failing load balancer health checks on newly instantiated tasks to prevent premature shutdown, up to 2147483647. Only valid for services configured to use load balancers."
          ]
        ],
        [ "Attribute", "type", [ "Id", "number" ] ],
        [ "Attribute", "default", [ "Int", 0 ] ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "ordered_placement_strategy" ] ],
      "body": [
        [
          "Attribute",
          "description",
          [
            "String",
            "(Optional) Service level strategy rules that are taken into consideration during task placement. List from top to bottom in order of precedence. The maximum number of ordered_placement_strategy blocks is 5. This is a list of maps where each map should contain \"id\" and \"field\""
          ]
        ],
        [
          "Attribute",
          "type",
          [ "Fun_call", [ "list", [ [ "Id", "any" ] ] ] ]
        ],
        [ "Attribute", "default", [ "Tuple", [] ] ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "deployment_controller" ] ],
      "body": [
        [
          "Attribute",
          "description",
          [ "String", "(Optional) Deployment controller default: 'ECS'" ]
        ],
        [
          "Attribute",
          "type",
          [ "Fun_call", [ "list", [ [ "Id", "any" ] ] ] ]
        ],
        [
          "Attribute",
          "default",
          [
            "Tuple",
            [ [ "Object", [ [ [ "Bare", "type" ], [ "String", "ECS" ] ] ] ] ]
          ]
        ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "placement_constraints" ] ],
      "body": [
        [
          "Attribute",
          "type",
          [ "Fun_call", [ "list", [ [ "Id", "any" ] ] ] ]
        ],
        [
          "Attribute",
          "description",
          [
            "String",
            "(Optional) rules that are taken into consideration during task placement. Maximum number of placement_constraints is 10. This is a list of maps, where each map should contain \"type\" and \"expression\""
          ]
        ],
        [ "Attribute", "default", [ "Tuple", [] ] ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "platform_version" ] ],
      "body": [
        [
          "Attribute",
          "description",
          [
            "String",
            "(Optional) The platform version on which to run your service. Defaults to 1.4.0. More information about Fargate platform versions can be found in the AWS ECS User Guide."
          ]
        ],
        [ "Attribute", "default", [ "String", "1.4.0" ] ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "propagate_tags" ] ],
      "body": [
        [
          "Attribute",
          "description",
          [
            "String",
            "(Optional) Specifies whether to propagate the tags from the task definition or the service to the tasks. The valid values are SERVICE and TASK_DEFINITION. Default to SERVICE"
          ]
        ],
        [ "Attribute", "default", [ "String", "SERVICE" ] ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "service_registries" ] ],
      "body": [
        [
          "Attribute",
          "description",
          [
            "String",
            "(Optional) The service discovery registries for the service. The maximum number of service_registries blocks is 1. This is a map that should contain the following fields \"registry_arn\", \"port\", \"container_port\" and \"container_name\""
          ]
        ],
        [
          "Attribute", "type", [ "Fun_call", [ "map", [ [ "Id", "any" ] ] ] ]
        ],
        [ "Attribute", "default", [ "Object", [] ] ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "task_definition_arn" ] ],
      "body": [
        [
          "Attribute",
          "description",
          [
            "String",
            "(Optional) The full ARN of the task definition that you want to run in your service."
          ]
        ],
        [ "Attribute", "default", [ "String", "" ] ],
        [ "Attribute", "type", [ "Id", "string" ] ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "force_new_deployment" ] ],
      "body": [
        [
          "Attribute",
          "description",
          [
            "String",
            "(Optional) Enable to force a new task deployment of the service. This can be used to update tasks to use a newer Docker image with same image/tag combination (e.g. myimage:latest), roll Fargate tasks onto a newer platform version, or immediately deploy ordered_placement_strategy and placement_constraints updates."
          ]
        ],
        [ "Attribute", "type", [ "Id", "bool" ] ],
        [ "Attribute", "default", [ "Bool", false ] ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "enable_execute_command" ] ],
      "body": [
        [
          "Attribute",
          "description",
          [
            "String",
            "(Optional) Specifies whether to enable Amazon ECS Exec for the tasks within the service."
          ]
        ],
        [ "Attribute", "type", [ "Id", "bool" ] ],
        [ "Attribute", "default", [ "Bool", false ] ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "wait_for_ready_state" ] ],
      "body": [
        [
          "Attribute",
          "description",
          [
            "String",
            "(Optional) If true, Terraform will wait for the service to reach a steady state (like aws ecs wait services-stable) before continuing. Default false."
          ]
        ],
        [ "Attribute", "type", [ "Id", "bool" ] ],
        [ "Attribute", "default", [ "Bool", false ] ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "public_subnets" ] ],
      "body": [
        [
          "Attribute",
          "description",
          [
            "String",
            "The public subnets associated with the task or service."
          ]
        ],
        [
          "Attribute",
          "type",
          [ "Fun_call", [ "list", [ [ "Id", "any" ] ] ] ]
        ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "private_subnets" ] ],
      "body": [
        [
          "Attribute",
          "description",
          [
            "String",
            "The private subnets associated with the task or service."
          ]
        ],
        [
          "Attribute",
          "type",
          [ "Fun_call", [ "list", [ [ "Id", "any" ] ] ] ]
        ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "security_groups" ] ],
      "body": [
        [
          "Attribute",
          "description",
          [
            "String",
            "(Optional) The security groups associated with the task or service. If you do not specify a security group, the default security group for the VPC is used."
          ]
        ],
        [
          "Attribute",
          "type",
          [ "Fun_call", [ "list", [ [ "Id", "any" ] ] ] ]
        ],
        [ "Attribute", "default", [ "Tuple", [] ] ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "assign_public_ip" ] ],
      "body": [
        [
          "Attribute",
          "description",
          [
            "String",
            "(Optional) Assign a public IP address to the ENI (Fargate launch type only). If true service will be associated with public subnets. Default false. "
          ]
        ],
        [ "Attribute", "type", [ "Id", "bool" ] ],
        [ "Attribute", "default", [ "Bool", false ] ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "ecs_tasks_sg_allow_egress_to_anywhere" ] ],
      "body": [
        [
          "Attribute",
          "description",
          [
            "String",
            "(Optional) If true an egress rule will be created to allow traffic to anywhere (0.0.0.0/0). If false no egress rule will be created. Defaults to true"
          ]
        ],
        [ "Attribute", "type", [ "Id", "bool" ] ],
        [ "Attribute", "default", [ "Bool", true ] ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "container_name" ] ],
      "body": [
        [
          "Attribute",
          "description",
          [ "String", "Name of the running container" ]
        ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "enable_autoscaling" ] ],
      "body": [
        [
          "Attribute",
          "description",
          [
            "String",
            "(Optional) If true, autoscaling alarms will be created."
          ]
        ],
        [ "Attribute", "type", [ "Id", "bool" ] ],
        [ "Attribute", "default", [ "Bool", true ] ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "ecs_cluster_name" ] ],
      "body": [
        [
          "Attribute",
          "description",
          [
            "String",
            "(Optional) Name of the ECS cluster. Required only if autoscaling is enabled"
          ]
        ],
        [ "Attribute", "type", [ "Id", "string" ] ],
        [ "Attribute", "default", [ "Null" ] ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "max_cpu_threshold" ] ],
      "body": [
        [
          "Attribute",
          "description",
          [ "String", "Threshold for max CPU usage" ]
        ],
        [ "Attribute", "default", [ "String", "85" ] ],
        [ "Attribute", "type", [ "Id", "string" ] ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "min_cpu_threshold" ] ],
      "body": [
        [
          "Attribute",
          "description",
          [ "String", "Threshold for min CPU usage" ]
        ],
        [ "Attribute", "default", [ "String", "10" ] ],
        [ "Attribute", "type", [ "Id", "string" ] ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "max_cpu_evaluation_period" ] ],
      "body": [
        [
          "Attribute",
          "description",
          [
            "String",
            "The number of periods over which data is compared to the specified threshold for max cpu metric alarm"
          ]
        ],
        [ "Attribute", "default", [ "String", "3" ] ],
        [ "Attribute", "type", [ "Id", "string" ] ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "min_cpu_evaluation_period" ] ],
      "body": [
        [
          "Attribute",
          "description",
          [
            "String",
            "The number of periods over which data is compared to the specified threshold for min cpu metric alarm"
          ]
        ],
        [ "Attribute", "default", [ "String", "3" ] ],
        [ "Attribute", "type", [ "Id", "string" ] ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "max_cpu_period" ] ],
      "body": [
        [
          "Attribute",
          "description",
          [
            "String",
            "The period in seconds over which the specified statistic is applied for max cpu metric alarm"
          ]
        ],
        [ "Attribute", "default", [ "String", "60" ] ],
        [ "Attribute", "type", [ "Id", "string" ] ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "min_cpu_period" ] ],
      "body": [
        [
          "Attribute",
          "description",
          [
            "String",
            "The period in seconds over which the specified statistic is applied for min cpu metric alarm"
          ]
        ],
        [ "Attribute", "default", [ "String", "60" ] ],
        [ "Attribute", "type", [ "Id", "string" ] ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "scale_target_max_capacity" ] ],
      "body": [
        [
          "Attribute",
          "description",
          [ "String", "The max capacity of the scalable target" ]
        ],
        [ "Attribute", "default", [ "Int", 5 ] ],
        [ "Attribute", "type", [ "Id", "number" ] ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "scale_target_min_capacity" ] ],
      "body": [
        [
          "Attribute",
          "description",
          [ "String", "The min capacity of the scalable target" ]
        ],
        [ "Attribute", "default", [ "Int", 1 ] ],
        [ "Attribute", "type", [ "Id", "number" ] ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "custom_lb_arn" ] ],
      "body": [
        [
          "Attribute",
          "description",
          [
            "String",
            "ARN of the Load Balancer to use in the ECS service. If provided, this module will not create a load balancer and will use the one provided in this variable"
          ]
        ],
        [ "Attribute", "type", [ "Id", "string" ] ],
        [ "Attribute", "default", [ "Null" ] ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "additional_lbs" ] ],
      "body": [
        [ "Attribute", "default", [ "Object", [] ] ],
        [
          "Attribute",
          "description",
          [ "String", "Additional load balancers to add to ECS service" ]
        ],
        [
          "Attribute",
          "type",
          [
            "Fun_call",
            [
              "map",
              [
                [
                  "Fun_call",
                  [
                    "object",
                    [
                      [
                        "Object",
                        [
                          [
                            [ "Bare", "target_group_arn" ],
                            [ "Id", "string" ]
                          ],
                          [
                            [ "Bare", "container_port" ], [ "Id", "number" ]
                          ]
                        ]
                      ]
                    ]
                  ]
                ]
              ]
            ]
          ]
        ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "lb_internal" ] ],
      "body": [
        [
          "Attribute",
          "description",
          [ "String", "(Optional) If true, the LB will be internal." ]
        ],
        [ "Attribute", "type", [ "Id", "bool" ] ],
        [ "Attribute", "default", [ "Bool", false ] ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "lb_security_groups" ] ],
      "body": [
        [
          "Attribute",
          "description",
          [
            "String",
            "(Optional) A list of security group IDs to assign to the LB."
          ]
        ],
        [
          "Attribute",
          "type",
          [ "Fun_call", [ "list", [ [ "Id", "string" ] ] ] ]
        ],
        [ "Attribute", "default", [ "Tuple", [] ] ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "lb_drop_invalid_header_fields" ] ],
      "body": [
        [
          "Attribute",
          "description",
          [
            "String",
            "(Optional) Indicates whether HTTP headers with header fields that are not valid are removed by the load balancer (true) or routed to targets (false). The default is false. Elastic Load Balancing requires that message header names contain only alphanumeric characters and hyphens."
          ]
        ],
        [ "Attribute", "type", [ "Id", "bool" ] ],
        [ "Attribute", "default", [ "Bool", false ] ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "lb_idle_timeout" ] ],
      "body": [
        [
          "Attribute",
          "description",
          [
            "String",
            "(Optional) The time in seconds that the connection is allowed to be idle. Default: 60."
          ]
        ],
        [ "Attribute", "type", [ "Id", "number" ] ],
        [ "Attribute", "default", [ "Int", 60 ] ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "lb_enable_deletion_protection" ] ],
      "body": [
        [
          "Attribute",
          "description",
          [
            "String",
            "(Optional) If true, deletion of the load balancer will be disabled via the AWS API. This will prevent Terraform from deleting the load balancer. Defaults to false."
          ]
        ],
        [ "Attribute", "type", [ "Id", "bool" ] ],
        [ "Attribute", "default", [ "Bool", false ] ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "lb_enable_cross_zone_load_balancing" ] ],
      "body": [
        [
          "Attribute",
          "description",
          [
            "String",
            "(Optional) If true, cross-zone load balancing of the load balancer will be enabled. Defaults to false."
          ]
        ],
        [ "Attribute", "type", [ "Id", "bool" ] ],
        [ "Attribute", "default", [ "Bool", false ] ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "lb_enable_http2" ] ],
      "body": [
        [
          "Attribute",
          "description",
          [
            "String",
            "(Optional) Indicates whether HTTP/2 is enabled in the load balancer. Defaults to true."
          ]
        ],
        [ "Attribute", "type", [ "Id", "bool" ] ],
        [ "Attribute", "default", [ "Bool", true ] ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "lb_ip_address_type" ] ],
      "body": [
        [
          "Attribute",
          "description",
          [
            "String",
            "(Optional) The type of IP addresses used by the subnets for your load balancer. The possible values are ipv4 and dualstack. Defaults to ipv4"
          ]
        ],
        [ "Attribute", "type", [ "Id", "string" ] ],
        [ "Attribute", "default", [ "String", "ipv4" ] ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "waf_web_acl_arn" ] ],
      "body": [
        [
          "Attribute",
          "description",
          [ "String", "ARN of a WAFV2 to associate with the ALB" ]
        ],
        [ "Attribute", "type", [ "Id", "string" ] ],
        [ "Attribute", "default", [ "String", "" ] ]
      ]
    }
  ],
  [
    "Block",
