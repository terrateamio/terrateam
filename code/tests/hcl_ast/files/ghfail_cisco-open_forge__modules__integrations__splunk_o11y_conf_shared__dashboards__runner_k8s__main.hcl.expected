          "Attribute",
          "program_text",
          [
            "String",
            "A = data('k8s.deployment.desired', rollup='latest').sum(by=['k8s.cluster.name', 'k8s.namespace.name', 'k8s.deployment.name']).sum().publish(label='A')"
          ]
        ],
        [ "Attribute", "color_by", [ "String", "Dimension" ] ],
        [ "Attribute", "refresh_interval", [ "Int", 5 ] ],
        [
          "Block",
          {
            "type_": "viz_options",
            "labels": [],
            "body": [
              [
                "Attribute",
                "display_name",
                [ "String", "Desired pods by deployments" ]
              ],
              [ "Attribute", "label", [ "String", "A" ] ]
            ]
          }
        ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "resource",
      "labels": [
        [ "Lit", "signalfx_list_chart" ],
        [ "Lit", "k8s_network_errors_per_sec" ]
      ],
      "body": [
