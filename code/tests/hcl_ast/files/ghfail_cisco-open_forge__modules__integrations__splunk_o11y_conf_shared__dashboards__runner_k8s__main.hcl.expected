  [
    "Block",
    {
      "type_": "resource",
      "labels": [
        [ "Lit", "signalfx_list_chart" ], [ "Lit", "k8s_pods_by_phase" ]
      ],
      "body": [
        [ "Attribute", "name", [ "String", "# Pods by phase" ] ],
        [ "Attribute", "description", [ "String", "" ] ],
        [
          "Attribute",
          "program_text",
          [
            "Heredoc",
            [
              "EOF",
              "\nB = data('k8s.pod.phase', rollup='latest').between(1.5, 2.5, low_inclusive=True, high_inclusive=True).count().publish(label='B')\nA = data('k8s.pod.phase', rollup='latest').between(0, 1.5, low_inclusive=True, high_inclusive=True).count().publish(label='A')\nC = data('k8s.pod.phase', rollup='latest').between(2.5, 3.5, low_inclusive=True, high_inclusive=True).count().publish(label='C')\nD = data('k8s.pod.phase', rollup='latest').between(3.5, 4.5, low_inclusive=True, high_inclusive=True).count().publish(label='D')\nE = data('k8s.pod.phase', rollup='latest').between(4.5, 5.5, low_inclusive=True, high_inclusive=True).count().publish(label='E')\n"
            ]
          ]
        ],
        [ "Attribute", "sort_by", [ "String", "+sf_originatingMetric" ] ],
        [ "Attribute", "disable_sampling", [ "Bool", true ] ],
        [ "Attribute", "max_precision", [ "Int", 4 ] ],
        [ "Attribute", "refresh_interval", [ "Int", 5 ] ],
        [ "Attribute", "time_range", [ "Int", 900 ] ],
        [
          "Block",
          {
            "type_": "legend_options_fields",
