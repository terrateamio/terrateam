          [
            "String",
            "A = data('k8s.pod.network.errors', filter=filter('k8s.cluster.name', '*') and filter('k8s.namespace.name', '*') and filter('k8s.deployment.name', '*', match_missing=True) and filter('sf_tags', '*', match_missing=True), rollup='rate').sum(by=['k8s.pod.name', 'k8s.cluster.name', 'k8s.node.name', 'k8s.pod.uid']).publish(label='A')"
          ]
        ],
        [ "Attribute", "sort_by", [ "String", "-value" ] ],
        [ "Attribute", "disable_sampling", [ "Bool", true ] ],
        [ "Attribute", "max_precision", [ "Int", 4 ] ],
        [ "Attribute", "refresh_interval", [ "Int", 5 ] ],
        [ "Attribute", "time_range", [ "Int", 900 ] ],
        [
          "Block",
          {
            "type_": "legend_options_fields",
            "labels": [],
            "body": [
              [ "Attribute", "enabled", [ "Bool", true ] ],
              [ "Attribute", "property", [ "String", "k8s.pod.name" ] ]
            ]
          }
        ],
        [
          "Block",
          {
            "type_": "legend_options_fields",
            "labels": [],
            "body": [
              [ "Attribute", "enabled", [ "Bool", false ] ],
              [
                "Attribute", "property", [ "String", "sf_originatingMetric" ]
              ]
            ]
          }
        ],
        [
          "Block",
          {
            "type_": "legend_options_fields",
            "labels": [],
            "body": [
              [ "Attribute", "enabled", [ "Bool", false ] ],
              [ "Attribute", "property", [ "String", "sf_metric" ] ]
            ]
          }
        ],
        [
          "Block",
          {
            "type_": "legend_options_fields",
            "labels": [],
            "body": [
              [ "Attribute", "enabled", [ "Bool", true ] ],
              [ "Attribute", "property", [ "String", "k8s.node.name" ] ]
            ]
          }
        ],
        [
          "Block",
          {
            "type_": "legend_options_fields",
            "labels": [],
            "body": [
              [ "Attribute", "enabled", [ "Bool", false ] ],
              [ "Attribute", "property", [ "String", "k8s.cluster.name" ] ]
            ]
          }
        ],
        [
          "Block",
          {
            "type_": "legend_options_fields",
            "labels": [],
            "body": [
              [ "Attribute", "enabled", [ "Bool", false ] ],
              [ "Attribute", "property", [ "String", "k8s.pod.uid" ] ]
            ]
          }
        ],
        [
          "Block",
          {
            "type_": "viz_options",
            "labels": [],
            "body": [
              [ "Attribute", "color", [ "String", "brown" ] ],
              [
                "Attribute",
                "display_name",
                [ "String", "Network error / sec" ]
              ],
              [ "Attribute", "label", [ "String", "A" ] ]
            ]
          }
        ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "resource",
      "labels": [
        [ "Lit", "signalfx_time_chart" ], [ "Lit", "k8s_memory_usage_pct" ]
      ],
      "body": [
        [ "Attribute", "name", [ "String", "Memory usage (%)" ] ],
        [
          "Attribute",
          "description",
          [ "String", "With EKS/Fargate metric data can possibly go >100%" ]
        ],
        [
          "Attribute",
          "program_text",
          [
            "Heredoc",
            [
              "EOF",
              "\nA = data('container.memory.usage', filter=filter('k8s.cluster.name', '*') and filter('k8s.namespace.name', '*') and filter('k8s.deployment.name', '*', match_missing=True) and filter('sf_tags', '*', match_missing=True)).sum(by=['k8s.pod.name', 'k8s.node.name', 'k8s.cluster.name', 'k8s.pod.uid']).publish(label='A', enable=False)\nB = data('k8s.container.memory_limit', filter=filter('k8s.cluster.name', '*') and filter('k8s.namespace.name', '*') and filter('k8s.deployment.name', '*', match_missing=True) and filter('sf_tags', '*', match_missing=True)).sum(by=['k8s.pod.name', 'k8s.node.name', 'k8s.cluster.name', 'k8s.pod.uid']).above(0, inclusive=True).publish(label='B', enable=False)\nC = (A/B*100).publish(label='C')\n"
            ]
          ]
        ],
        [ "Attribute", "plot_type", [ "String", "LineChart" ] ],
        [ "Attribute", "time_range", [ "Int", 900 ] ],
        [ "Attribute", "disable_sampling", [ "Bool", true ] ],
        [ "Attribute", "axes_precision", [ "Int", 0 ] ],
        [ "Attribute", "axes_include_zero", [ "Bool", true ] ],
        [
          "Block",
          {
            "type_": "axis_left",
            "labels": [],
            "body": [
              [
                "Attribute",
                "high_watermark",
                [ "Float", 1.7976931348623157e+308 ]
              ],
              [ "Attribute", "label", [ "String", "% memory used" ] ],
              [
                "Attribute",
                "low_watermark",
                [ "Minus", [ "Float", 1.7976931348623157e+308 ] ]
              ],
              [ "Attribute", "max_value", [ "Int", 110 ] ],
              [
                "Attribute",
                "min_value",
                [ "Minus", [ "Float", 1.7976931348623157e+308 ] ]
              ]
            ]
          }
        ],
        [
          "Block",
          {
            "type_": "histogram_options",
            "labels": [],
            "body": [ [ "Attribute", "color_theme", [ "String", "gold" ] ] ]
          }
        ],
        [
          "Block",
          {
            "type_": "legend_options_fields",
            "labels": [],
            "body": [
              [ "Attribute", "enabled", [ "Bool", true ] ],
              [ "Attribute", "property", [ "String", "k8s.pod.name" ] ]
            ]
          }
        ],
        [
          "Block",
          {
            "type_": "legend_options_fields",
            "labels": [],
            "body": [
              [ "Attribute", "enabled", [ "Bool", false ] ],
              [ "Attribute", "property", [ "String", "sf_metric" ] ]
            ]
          }
        ],
        [
          "Block",
          {
            "type_": "legend_options_fields",
            "labels": [],
            "body": [
              [ "Attribute", "enabled", [ "Bool", true ] ],
              [ "Attribute", "property", [ "String", "k8s.node.name" ] ]
            ]
          }
        ],
        [
          "Block",
          {
            "type_": "legend_options_fields",
            "labels": [],
            "body": [
              [ "Attribute", "enabled", [ "Bool", true ] ],
              [ "Attribute", "property", [ "String", "k8s.cluster.name" ] ]
            ]
          }
        ],
        [
          "Block",
          {
            "type_": "legend_options_fields",
            "labels": [],
            "body": [
              [ "Attribute", "enabled", [ "Bool", true ] ],
              [ "Attribute", "property", [ "String", "k8s.pod.uid" ] ]
            ]
          }
        ],
        [
          "Block",
          {
            "type_": "viz_options",
            "labels": [],
            "body": [
              [ "Attribute", "axis", [ "String", "left" ] ],
              [
                "Attribute", "display_name", [ "String", "Memory used (%)" ]
              ],
              [ "Attribute", "label", [ "String", "C" ] ],
              [ "Attribute", "value_suffix", [ "String", "%" ] ]
            ]
          }
        ],
        [
          "Block",
          {
            "type_": "viz_options",
            "labels": [],
            "body": [
              [ "Attribute", "axis", [ "String", "left" ] ],
              [ "Attribute", "color", [ "String", "blue" ] ],
              [ "Attribute", "display_name", [ "String", "Container" ] ],
              [ "Attribute", "label", [ "String", "A" ] ]
            ]
          }
        ],
        [
          "Block",
          {
