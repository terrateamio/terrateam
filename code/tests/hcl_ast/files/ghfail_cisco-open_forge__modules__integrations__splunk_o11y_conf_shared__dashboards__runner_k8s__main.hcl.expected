  [
    "Block",
    {
      "type_": "resource",
      "labels": [
        [ "Lit", "signalfx_single_value_chart" ],
        [ "Lit", "k8s_active_pods" ]
      ],
      "body": [
        [ "Attribute", "name", [ "String", "# Active pods" ] ],
        [
          "Attribute",
          "description",
          [
            "String",
            "This may include \"pause\" containers used internally by k8s"
          ]
        ],
        [
          "Attribute",
          "program_text",
          [
            "String",
            "A = data('k8s.pod.phase').between(1.5, 2.5, low_inclusive=True, high_inclusive=True).count().publish(label='A')"
          ]
        ],
        [ "Attribute", "color_by", [ "String", "Dimension" ] ],
        [ "Attribute", "refresh_interval", [ "Int", 5 ] ],
        [
          "Block",
          {
            "type_": "viz_options",
            "labels": [],
            "body": [
              [ "Attribute", "display_name", [ "String", "Number of pods" ] ],
              [ "Attribute", "label", [ "String", "A" ] ]
            ]
          }
        ]
      ]
    }
  ],
