[
  [
    "Block",
    {
      "type_": "resource",
      "labels": [
        [ "Lit", "signalfx_single_value_chart" ],
        [ "Lit", "k8s_available_pods_by_deployments" ]
      ],
      "body": [
        [
          "Attribute",
          "name",
          [ "String", "# Available pods by deployments" ]
        ],
        [
          "Attribute",
          "description",
          [ "String", "Number of pods ready by deployments" ]
        ],
        [
          "Attribute",
          "program_text",
          [
            "String",
            "A = data('k8s.deployment.available', rollup='latest').sum(by=['k8s.cluster.name', 'k8s.namespace.name', 'k8s.deployment.name']).sum().publish(label='A')"
          ]
        ],
        [ "Attribute", "color_by", [ "String", "Dimension" ] ],
        [ "Attribute", "refresh_interval", [ "Int", 5 ] ],
        [
          "Block",
          {
            "type_": "viz_options",
            "labels": [],
            "body": [
              [ "Attribute", "display_name", [ "String", "Available pods" ] ],
              [ "Attribute", "label", [ "String", "A" ] ]
            ]
          }
        ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "resource",
      "labels": [
        [ "Lit", "signalfx_list_chart" ],
        [ "Lit", "k8s_top_10_cpu_usage_per_pod" ]
      ],
      "body": [
        [
          "Attribute",
          "name",
          [ "String", "Top 10 CPU usage per pod (CPU units)" ]
        ],
        [ "Attribute", "description", [ "String", "Pod name | Node name" ] ],
        [
          "Attribute",
          "program_text",
          [
            "Heredoc",
            [
              "EOF",
              "\nA = data('container_cpu_utilization', rollup='rate').mean(by=['k8s.pod.name', 'k8s.node.name', 'k8s.cluster.name', 'k8s.pod.uid']).scale(0.01).top(count=10).publish(label='A')\nB = data('container.cpu.time').mean(by=['k8s.pod.name', 'k8s.node.name', 'k8s.cluster.name', 'k8s.pod.uid']).top(count=10).publish(label='B')\n"
            ]
          ]
        ],
        [ "Attribute", "sort_by", [ "String", "-value" ] ],
        [ "Attribute", "disable_sampling", [ "Bool", true ] ],
        [ "Attribute", "hide_missing_values", [ "Bool", true ] ],
        [ "Attribute", "max_precision", [ "Int", 5 ] ],
        [ "Attribute", "refresh_interval", [ "Int", 5 ] ],
        [ "Attribute", "time_range", [ "Int", 900 ] ],
        [
          "Block",
          {
            "type_": "legend_options_fields",
            "labels": [],
            "body": [
              [ "Attribute", "enabled", [ "Bool", false ] ],
              [ "Attribute", "property", [ "String", "sf_metric" ] ]
            ]
          }
        ],
        [
          "Block",
          {
            "type_": "legend_options_fields",
            "labels": [],
            "body": [
              [ "Attribute", "enabled", [ "Bool", true ] ],
              [ "Attribute", "property", [ "String", "k8s.pod.name" ] ]
            ]
          }
        ],
        [
          "Block",
          {
            "type_": "legend_options_fields",
            "labels": [],
            "body": [
              [ "Attribute", "enabled", [ "Bool", true ] ],
              [ "Attribute", "property", [ "String", "k8s.node.name" ] ]
            ]
          }
        ],
        [
          "Block",
          {
            "type_": "legend_options_fields",
            "labels": [],
            "body": [
              [ "Attribute", "enabled", [ "Bool", false ] ],
              [
                "Attribute", "property", [ "String", "sf_originatingMetric" ]
              ]
            ]
          }
        ],
        [
          "Block",
          {
            "type_": "legend_options_fields",
            "labels": [],
            "body": [
              [ "Attribute", "enabled", [ "Bool", false ] ],
              [ "Attribute", "property", [ "String", "k8s.cluster.name" ] ]
            ]
          }
        ],
        [
          "Block",
          {
            "type_": "legend_options_fields",
            "labels": [],
            "body": [
              [ "Attribute", "enabled", [ "Bool", false ] ],
              [ "Attribute", "property", [ "String", "k8s.pod.uid" ] ]
            ]
          }
        ],
        [
          "Block",
          {
            "type_": "viz_options",
            "labels": [],
            "body": [
              [
                "Attribute",
                "display_name",
                [ "String", "OTel pre translated CPU usage" ]
              ],
              [ "Attribute", "label", [ "String", "B" ] ]
            ]
          }
        ],
        [
          "Block",
          {
            "type_": "viz_options",
            "labels": [],
            "body": [
              [
                "Attribute",
                "display_name",
                [ "String", "Top 10 pods by average CPU usage" ]
              ],
              [ "Attribute", "label", [ "String", "A" ] ]
            ]
          }
        ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "resource",
      "labels": [
        [ "Lit", "signalfx_time_chart" ],
        [ "Lit", "k8s_network_bytes_per_sec" ]
      ],
      "body": [
        [ "Attribute", "name", [ "String", "Network bytes / sec" ] ],
        [ "Attribute", "description", [ "String", "" ] ],
        [
          "Attribute",
          "program_text",
          [
            "String",
            "A = data('k8s.pod.network.io', filter=filter('k8s.cluster.name', '*') and filter('k8s.namespace.name', '*') and filter('sf_tags', '*', match_missing=True) and filter('k8s.deployment.name', '*', match_missing=True), rollup='rate', extrapolation='zero').sum(by=['k8s.pod.name', 'k8s.node.name', 'k8s.cluster.name', 'k8s.pod.uid']).publish(label='A')"
          ]
        ],
        [ "Attribute", "plot_type", [ "String", "ColumnChart" ] ],
        [ "Attribute", "time_range", [ "Int", 900 ] ],
        [ "Attribute", "unit_prefix", [ "String", "Binary" ] ],
        [ "Attribute", "axes_precision", [ "Int", 0 ] ],
        [ "Attribute", "disable_sampling", [ "Bool", true ] ],
        [
          "Block",
          {
            "type_": "axis_left",
            "labels": [],
            "body": [
              [
                "Attribute",
                "high_watermark",
                [ "Float", 1.7976931348623157e+308 ]
              ],
              [ "Attribute", "label", [ "String", "Rx bytes /sec (RED)" ] ],
              [
                "Attribute",
                "low_watermark",
                [ "Minus", [ "Float", 1.7976931348623157e+308 ] ]
              ],
              [
                "Attribute",
                "max_value",
                [ "Float", 1.7976931348623157e+308 ]
              ],
              [ "Attribute", "min_value", [ "Int", 0 ] ]
            ]
          }
        ],
        [
          "Block",
          {
            "type_": "axis_right",
            "labels": [],
            "body": [
              [
                "Attribute",
                "high_watermark",
                [ "Float", 1.7976931348623157e+308 ]
              ],
              [ "Attribute", "label", [ "String", "Tx bytes /sec (BLUE)" ] ],
              [
                "Attribute",
                "low_watermark",
                [ "Minus", [ "Float", 1.7976931348623157e+308 ] ]
              ],
              [
                "Attribute",
                "max_value",
                [ "Float", 1.7976931348623157e+308 ]
              ],
              [ "Attribute", "min_value", [ "Int", 0 ] ]
            ]
          }
        ],
        [
          "Block",
          {
            "type_": "histogram_options",
            "labels": [],
            "body": [ [ "Attribute", "color_theme", [ "String", "gold" ] ] ]
          }
        ],
        [
          "Block",
          {
            "type_": "viz_options",
            "labels": [],
            "body": [
              [ "Attribute", "axis", [ "String", "left" ] ],
              [ "Attribute", "color", [ "String", "brown" ] ],
              [
                "Attribute",
                "display_name",
                [ "String", "Network bytes / sec" ]
              ],
              [ "Attribute", "label", [ "String", "A" ] ],
              [ "Attribute", "value_unit", [ "String", "Byte" ] ]
            ]
          }
        ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "resource",
      "labels": [
        [ "Lit", "signalfx_single_value_chart" ],
        [ "Lit", "k8s_desired_pods_by_deployments" ]
      ],
      "body": [
        [
          "Attribute", "name", [ "String", "# Desired pods by deployments" ]
