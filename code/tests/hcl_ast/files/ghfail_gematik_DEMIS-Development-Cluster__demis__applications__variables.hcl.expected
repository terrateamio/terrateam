    {
      "type_": "variable",
      "labels": [ [ "Lit", "timeout_retry_overrides" ] ],
      "body": [
        [
          "Attribute",
          "description",
          [
            "String",
            "Defines retry and timeout configurations per service. Each definition must include a service name and can optionally include timeout and retry settings."
          ]
        ],
        [
          "Attribute",
          "type",
          [
            "Fun_call",
            [
              "list",
              [
                [
                  "Fun_call",
                  [
                    "object",
                    [
                      [
                        "Object",
                        [
                          [ [ "Bare", "service" ], [ "Id", "string" ] ],
                          [
                            [ "Bare", "timeout" ],
                            [
                              "Fun_call",
                              [ "optional", [ [ "Id", "string" ] ] ]
                            ]
                          ],
                          [
                            [ "Bare", "retries" ],
                            [
                              "Fun_call",
                              [
                                "optional",
                                [
                                  [
                                    "Fun_call",
                                    [
                                      "object",
                                      [
                                        [
                                          "Object",
                                          [
                                            [
                                              [ "Bare", "enable" ],
                                              [
                                                "Fun_call",
                                                [
                                                  "optional",
                                                  [ [ "Id", "bool" ] ]
                                                ]
                                              ]
                                            ],
                                            [
                                              [ "Bare", "attempts" ],
                                              [
                                                "Fun_call",
                                                [
                                                  "optional",
                                                  [ [ "Id", "number" ] ]
                                                ]
                                              ]
                                            ],
                                            [
                                              [ "Bare", "perTryTimeout" ],
                                              [
                                                "Fun_call",
                                                [
                                                  "optional",
                                                  [ [ "Id", "string" ] ]
                                                ]
                                              ]
                                            ],
                                            [
                                              [ "Bare", "retryOn" ],
                                              [
                                                "Fun_call",
                                                [
                                                  "optional",
                                                  [ [ "Id", "string" ] ]
                                                ]
                                              ]
                                            ]
                                          ]
                                        ]
                                      ]
                                    ]
                                  ]
                                ]
                              ]
                            ]
                          ]
                        ]
                      ]
                    ]
                  ]
                ]
              ]
            ]
          ]
        ],
        [ "Attribute", "default", [ "Tuple", [] ] ],
        [
          "Block",
          {
            "type_": "validation",
            "labels": [],
            "body": [
              [
                "Attribute",
                "condition",
                [
                  "Cond",
                  {
                    "if_": [
                      "Gt",
                      [
                        [
                          "Fun_call",
                          [
                            "length",
                            [
                              [
                                "Attr",
                                [
                                  [ "Id", "var" ],
                                  [ "A_string", "timeout_retry_overrides" ]
                                ]
                              ]
                            ]
                          ]
                        ],
                        [ "Int", 0 ]
                      ]
                    ],
                    "then_": [
                      "Fun_call",
                      [
                        "alltrue",
                        [
                          [
                            "For_tuple",
                            {
                              "identifiers": [ "conf", [] ],
                              "input": [
                                "Attr",
                                [
                                  [ "Id", "var" ],
                                  [ "A_string", "timeout_retry_overrides" ]
                                ]
                              ],
                              "output": [
                                "Gt",
                                [
                                  [
                                    "Fun_call",
                                    [
                                      "length",
                                      [
                                        [
                                          "Attr",
                                          [
                                            [ "Id", "conf" ],
                                            [ "A_string", "service" ]
                                          ]
                                        ]
                                      ]
                                    ]
                                  ],
                                  [ "Int", 0 ]
                                ]
                              ],
                              "cond": null
                            }
                          ]
                        ]
                      ]
                    ],
                    "else_": [ "Bool", true ]
                  }
                ]
              ],
              [
                "Attribute",
                "error_message",
                [ "String", "Service name must not be empty" ]
              ]
            ]
          }
        ]
      ]
    }
