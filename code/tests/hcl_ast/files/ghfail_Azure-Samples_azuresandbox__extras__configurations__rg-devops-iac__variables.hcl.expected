[
  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "aad_tenant_id" ] ],
      "body": [
        [ "Attribute", "type", [ "Id", "string" ] ],
        [
          "Attribute",
          "description",
          [ "String", "The Microsoft Entra tenant id." ]
        ],
        [
          "Block",
          {
            "type_": "validation",
            "labels": [],
            "body": [
              [
                "Attribute",
                "condition",
                [
                  "Fun_call",
                  [
                    "can",
                    [
                      [
                        "Fun_call",
                        [
                          "regex",
                          [
                            [
                              "String",
                              "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
                            ],
                            [
                              "Attr",
                              [
                                [ "Id", "var" ],
                                [ "A_string", "aad_tenant_id" ]
                              ]
                            ]
                          ]
                        ]
                      ]
                    ]
                  ]
                ]
              ],
              [
                "Attribute",
                "error_message",
                [
                  "String",
                  "Must be a valid GUID in the format 'xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx'."
                ]
              ]
            ]
          }
        ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "arm_client_id" ] ],
      "body": [
        [ "Attribute", "type", [ "Id", "string" ] ],
        [
          "Attribute",
          "description",
          [
            "String",
            "The AppId of the service principal used for authenticating with Azure. Must have a 'Contributor' role assignment."
          ]
        ],
        [
          "Block",
          {
            "type_": "validation",
            "labels": [],
            "body": [
              [
                "Attribute",
                "condition",
                [
                  "Fun_call",
                  [
                    "can",
                    [
                      [
                        "Fun_call",
                        [
                          "regex",
                          [
                            [
                              "String",
                              "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
                            ],
                            [
                              "Attr",
                              [
                                [ "Id", "var" ],
                                [ "A_string", "arm_client_id" ]
                              ]
                            ]
                          ]
                        ]
                      ]
                    ]
                  ]
                ]
              ],
              [
                "Attribute",
                "error_message",
                [
                  "String",
                  "Must be a valid GUID in the format 'xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx'."
                ]
              ]
            ]
          }
        ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "arm_client_secret" ] ],
      "body": [
        [ "Attribute", "type", [ "Id", "string" ] ],
        [
          "Attribute",
          "description",
          [
            "String",
            "The password for the service principal used for authenticating with Azure. Set interactively or using an environment variable 'TF_VAR_arm_client_secret'."
          ]
        ],
        [ "Attribute", "sensitive", [ "Bool", true ] ],
        [
          "Block",
          {
            "type_": "validation",
            "labels": [],
            "body": [
              [
                "Attribute",
                "condition",
                [
                  "Gte",
                  [
                    [
                      "Fun_call",
                      [
                        "length",
                        [
                          [
                            "Attr",
                            [
                              [ "Id", "var" ],
                              [ "A_string", "arm_client_secret" ]
                            ]
                          ]
                        ]
                      ]
                    ],
                    [ "Int", 8 ]
                  ]
                ]
              ],
              [
                "Attribute",
                "error_message",
                [ "String", "Must be at least 8 characters long." ]
              ]
            ]
          }
        ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "location" ] ],
      "body": [
        [ "Attribute", "type", [ "Id", "string" ] ],
        [
          "Attribute",
          "description",
          [
            "String",
            "The name of the Azure Region where resources will be provisioned."
          ]
        ],
        [
          "Block",
          {
            "type_": "validation",
            "labels": [],
            "body": [
              [
                "Attribute",
                "condition",
                [
                  "Fun_call",
                  [
                    "can",
                    [
                      [
                        "Fun_call",
                        [
                          "regex",
                          [
                            [ "String", "^[a-z0-9-]+$" ],
                            [
                              "Attr",
                              [ [ "Id", "var" ], [ "A_string", "location" ] ]
                            ]
                          ]
                        ]
                      ]
                    ]
                  ]
                ]
              ],
              [
                "Attribute",
                "error_message",
                [
                  "String",
                  "Must be a valid Azure region name. It should only contain lowercase letters, numbers, and dashes."
                ]
              ]
            ]
          }
        ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "storage_access_tier" ] ],
      "body": [
        [ "Attribute", "type", [ "Id", "string" ] ],
        [
          "Attribute",
          "description",
          [ "String", "The access tier for the new storage account." ]
        ],
        [ "Attribute", "default", [ "String", "Hot" ] ],
        [
          "Block",
          {
            "type_": "validation",
            "labels": [],
            "body": [
              [
                "Attribute",
                "condition",
                [
                  "Fun_call",
                  [
                    "contains",
                    [
                      [
                        "Tuple",
                        [
                          [ "String", "Hot" ],
                          [ "String", "Cool" ],
                          [ "String", "Archive" ]
                        ]
                      ],
                      [
                        "Attr",
                        [
                          [ "Id", "var" ],
                          [ "A_string", "storage_access_tier" ]
                        ]
                      ]
                    ]
                  ]
                ]
              ],
              [
                "Attribute",
                "error_message",
                [
                  "String",
                  "storage_access_tier must be one of: Hot, Cool, or Archive (case-sensitive, as per Azure Blob Storage access tiers)."
                ]
              ]
            ]
          }
        ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "storage_replication_type" ] ],
      "body": [
        [ "Attribute", "type", [ "Id", "string" ] ],
        [
          "Attribute",
          "description",
          [
            "String", "The type of replication for the new storage account."
          ]
        ],
        [ "Attribute", "default", [ "String", "LRS" ] ],
        [
          "Block",
          {
            "type_": "validation",
            "labels": [],
            "body": [
              [
                "Attribute",
                "condition",
                [
                  "Fun_call",
                  [
                    "contains",
                    [
                      [
                        "Tuple",
                        [
                          [ "String", "LRS" ],
                          [ "String", "GRS" ],
                          [ "String", "RAGRS" ],
                          [ "String", "ZRS" ],
                          [ "String", "GZRS" ],
                          [ "String", "RAGZRS" ]
                        ]
                      ],
                      [
                        "Attr",
                        [
                          [ "Id", "var" ],
                          [ "A_string", "storage_replication_type" ]
                        ]
                      ]
                    ]
                  ]
                ]
              ],
              [
                "Attribute",
                "error_message",
                [
                  "String",
                  "storage_replication_type must be one of: LRS, GRS, RAGRS, ZRS, GZRS, or RAGZRS (case-sensitive, as per Azure Storage replication types)."
                ]
              ]
            ]
          }
        ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "subnet_address_prefix" ] ],
      "body": [
        [ "Attribute", "type", [ "Id", "string" ] ],
        [
          "Attribute",
          "description",
          [ "String", "The address prefix for the miscellaneous subnet." ]
        ],
        [ "Attribute", "default", [ "String", "10.0.0.0/24" ] ],
        [
          "Block",
          {
            "type_": "validation",
            "labels": [],
            "body": [
              [
                "Attribute",
                "condition",
                [
                  "Fun_call",
                  [
                    "can",
                    [
                      [
                        "Fun_call",
                        [
                          "cidrhost",
                          [
                            [
                              "Attr",
                              [
                                [ "Id", "var" ],
                                [ "A_string", "subnet_address_prefix" ]
                              ]
                            ],
                            [ "Int", 0 ]
                          ]
                        ]
                      ]
                    ]
                  ]
                ]
              ],
              [
                "Attribute",
                "error_message",
                [ "String", "Must be valid IPv4 CIDR." ]
              ]
            ]
          }
        ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "subnet_name" ] ],
      "body": [
        [ "Attribute", "type", [ "Id", "string" ] ],
        [
          "Attribute",
          "description",
          [
            "String",
            "The name of the subnet to be created in the new virtual network."
          ]
        ],
        [ "Attribute", "default", [ "String", "snet-devops-01" ] ],
        [
          "Block",
          {
            "type_": "validation",
            "labels": [],
            "body": [
              [
                "Attribute",
                "condition",
                [
                  "Fun_call",
                  [
                    "can",
                    [
                      [
                        "Fun_call",
                        [
                          "regex",
                          [
                            [ "String", "^[a-zA-Z0-9-]{1,64}$" ],
                            [
                              "Attr",
                              [
                                [ "Id", "var" ],
                                [ "A_string", "subnet_name" ]
                              ]
                            ]
                          ]
                        ]
                      ]
                    ]
                  ]
                ]
              ],
              [
                "Attribute",
                "error_message",
                [
                  "String",
                  "Must conform to Azure subnet naming standards: it can only contain alphanumeric characters and hyphens (-), must start and end with an alphanumeric character, and must be between 1 and 64 characters long."
                ]
              ]
            ]
          }
        ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "subscription_id" ] ],
      "body": [
        [ "Attribute", "type", [ "Id", "string" ] ],
        [
          "Attribute",
          "description",
          [
            "String",
            "The Azure subscription id used to provision resources."
          ]
        ],
        [
          "Block",
          {
            "type_": "validation",
            "labels": [],
            "body": [
              [
                "Attribute",
                "condition",
                [
                  "Fun_call",
                  [
                    "can",
                    [
                      [
                        "Fun_call",
                        [
                          "regex",
                          [
                            [
                              "String",
                              "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
                            ],
                            [
                              "Attr",
                              [
                                [ "Id", "var" ],
                                [ "A_string", "subscription_id" ]
                              ]
                            ]
                          ]
                        ]
                      ]
                    ]
                  ]
                ]
              ],
              [
                "Attribute",
                "error_message",
                [
                  "String",
                  "Must be a valid GUID in the format 'xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx'."
                ]
              ]
            ]
          }
        ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "storage_container_name" ] ],
      "body": [
        [ "Attribute", "type", [ "Id", "string" ] ],
        [
          "Attribute",
          "description",
          [
            "String",
            "The name of the storage container to be created in the new storage account."
          ]
        ],
        [ "Attribute", "default", [ "String", "tfstate" ] ],
        [
          "Block",
          {
            "type_": "validation",
            "labels": [],
            "body": [
              [
                "Attribute",
                "condition",
                [
                  "Fun_call",
                  [
                    "can",
                    [
                      [
                        "Fun_call",
                        [
                          "regex",
                          [
                            [ "String", "^[a-z0-9][a-z0-9-]{2,61}[a-z0-9]$" ],
                            [
                              "Attr",
                              [
                                [ "Id", "var" ],
                                [ "A_string", "storage_container_name" ]
                              ]
                            ]
                          ]
                        ]
                      ]
                    ]
                  ]
                ]
              ],
              [
                "Attribute",
                "error_message",
                [
                  "String",
                  "Must conform to Azure storage container naming standards: it can only contain lowercase alphanumeric characters and hyphens (-), must start and end with an alphanumeric character, and must be between 3 and 63 characters long."
                ]
              ]
            ]
          }
        ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "tags" ] ],
      "body": [
        [
          "Attribute", "type", [ "Fun_call", [ "map", [ [ "Id", "any" ] ] ] ]
        ],
        [
          "Attribute",
          "description",
          [
            "String",
            "The tags in map format to be used when creating new resources."
          ]
        ],
        [
          "Attribute",
          "default",
          [
            "Object",
            [
              [ [ "Bare", "costcenter" ], [ "String", "mycostcenter" ] ],
              [ [ "Bare", "environment" ], [ "String", "dev" ] ],
              [ [ "Bare", "project" ], [ "String", "devops" ] ]
            ]
          ]
        ],
        [
          "Block",
          {
            "type_": "validation",
            "labels": [],
            "body": [
              [
                "Attribute",
                "condition",
                [
                  "Fun_call",
                  [
                    "alltrue",
                    [
                      [
                        "For_tuple",
                        {
                          "identifiers": [ "key", [ "value" ] ],
                          "input": [
                            "Attr",
                            [ [ "Id", "var" ], [ "A_string", "tags" ] ]
                          ],
                          "output": [
                            "Log_and",
                            [
                              [
                                "Fun_call",
                                [
                                  "can",
                                  [
                                    [
                                      "Fun_call",
                                      [
                                        "regex",
                                        [
                                          [
                                            "String",
                                            "^[a-zA-Z0-9._-]{1,512}$"
                                          ],
                                          [ "Id", "key" ]
                                        ]
                                      ]
                                    ]
                                  ]
                                ]
                              ],
                              [
                                "Fun_call",
                                [
                                  "can",
                                  [
                                    [
                                      "Fun_call",
                                      [
                                        "regex",
                                        [
                                          [
                                            "String",
                                            "^[a-zA-Z0-9._ -]{0,256}$"
                                          ],
                                          [ "Id", "value" ]
                                        ]
                                      ]
                                    ]
                                  ]
                                ]
                              ]
                            ]
                          ],
                          "cond": null
                        }
                      ]
                    ]
                  ]
                ]
              ],
              [
                "Attribute",
                "error_message",
                [
                  "String",
                  "Each tag key must be 1-512 characters long and consist of alphanumeric characters, periods (.), underscores (_), or hyphens (-). Each tag value must be 0-256 characters long and consist of alphanumeric characters, periods (.), underscores (_), spaces, or hyphens (-)."
                ]
              ]
            ]
          }
        ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "user_object_id" ] ],
      "body": [
        [ "Attribute", "type", [ "Id", "string" ] ],
        [
