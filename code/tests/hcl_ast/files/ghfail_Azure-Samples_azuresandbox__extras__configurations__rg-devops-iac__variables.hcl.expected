          "description",
          [ "String", "The object id of the user in Microsoft Entra ID." ]
        ],
        [
          "Block",
          {
            "type_": "validation",
            "labels": [],
            "body": [
              [
                "Attribute",
                "condition",
                [
                  "Fun_call",
                  [
                    "can",
                    [
                      [
                        "Fun_call",
                        [
                          "regex",
                          [
                            [
                              "String",
                              "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
                            ],
                            [
                              "Attr",
                              [
                                [ "Id", "var" ],
                                [ "A_string", "user_object_id" ]
                              ]
                            ]
                          ]
                        ]
                      ]
                    ]
                  ]
                ]
              ],
              [
                "Attribute",
                "error_message",
                [
                  "String",
                  "Must be a valid GUID in the format 'xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx'."
                ]
              ]
            ]
          }
        ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "vnet_address_space" ] ],
      "body": [
        [ "Attribute", "type", [ "Id", "string" ] ],
        [
          "Attribute",
          "description",
          [
            "String",
            "The address space in CIDR notation for the new virtual network."
          ]
        ],
        [ "Attribute", "default", [ "String", "10.0.0.0/16" ] ],
        [
          "Block",
          {
            "type_": "validation",
            "labels": [],
            "body": [
              [
                "Attribute",
                "condition",
                [
                  "Fun_call",
                  [
                    "can",
                    [
                      [
                        "Fun_call",
                        [
                          "cidrhost",
                          [
                            [
                              "Attr",
                              [
                                [ "Id", "var" ],
                                [ "A_string", "vnet_address_space" ]
                              ]
                            ],
                            [ "Int", 0 ]
                          ]
                        ]
                      ]
                    ]
                  ]
                ]
              ],
              [
                "Attribute",
                "error_message",
                [ "String", "Must be valid IPv4 CIDR." ]
              ]
            ]
          }
        ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "vnet_name" ] ],
      "body": [
        [ "Attribute", "type", [ "Id", "string" ] ],
        [
          "Attribute",
          "description",
          [
            "String",
            "The name of the new virtual network to be provisioned."
          ]
        ],
        [ "Attribute", "default", [ "String", "devops" ] ],
        [
          "Block",
          {
            "type_": "validation",
            "labels": [],
            "body": [
              [
                "Attribute",
                "condition",
                [
                  "Fun_call",
                  [
                    "can",
                    [
                      [
                        "Fun_call",
                        [
                          "regex",
                          [
                            [ "String", "^[a-zA-Z0-9-]{1,64}$" ],
                            [
                              "Attr",
                              [
                                [ "Id", "var" ], [ "A_string", "vnet_name" ]
                              ]
                            ]
                          ]
                        ]
                      ]
                    ]
                  ]
                ]
              ],
              [
                "Attribute",
                "error_message",
                [
                  "String",
                  "Must conform to Azure virtual network naming standards: it can only contain alphanumeric characters and hyphens (-), must start and end with an alphanumeric character, and must be between 1 and 64 characters long."
                ]
              ]
            ]
          }
        ]
      ]
    }
  ]
