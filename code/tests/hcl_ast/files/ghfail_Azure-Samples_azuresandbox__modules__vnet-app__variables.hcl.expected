  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "storage_share_quota_gb" ] ],
      "body": [
        [ "Attribute", "type", [ "Id", "number" ] ],
        [
          "Attribute",
          "description",
          [
            "String",
            "The storage quota for the Azure Files share to be provisioned in GB."
          ]
        ],
        [ "Attribute", "default", [ "Int", 1024 ] ],
        [
          "Block",
          {
            "type_": "validation",
            "labels": [],
            "body": [
              [
                "Attribute",
                "condition",
                [
                  "Log_and",
                  [
                    [
                      "Gte",
                      [
                        [
                          "Attr",
                          [
                            [ "Id", "var" ],
                            [ "A_string", "storage_share_quota_gb" ]
                          ]
                        ],
                        [ "Int", 1 ]
                      ]
                    ],
                    [
                      "Lte",
                      [
                        [
                          "Attr",
                          [
                            [ "Id", "var" ],
                            [ "A_string", "storage_share_quota_gb" ]
                          ]
                        ],
                        [ "Int", 5120 ]
                      ]
                    ]
                  ]
                ]
