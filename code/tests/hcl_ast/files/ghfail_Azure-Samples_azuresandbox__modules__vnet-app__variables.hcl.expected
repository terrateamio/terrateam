[
  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "adds_domain_name" ] ],
      "body": [
        [ "Attribute", "type", [ "Id", "string" ] ],
        [
          "Attribute", "description", [ "String", "The AD DS domain name." ]
        ],
        [
          "Block",
          {
            "type_": "validation",
            "labels": [],
            "body": [
              [
                "Attribute",
                "condition",
                [
                  "Lte",
                  [
                    [
                      "Fun_call",
                      [
                        "length",
                        [
                          [
                            "Attr",
                            [
                              [ "Id", "var" ],
                              [ "A_string", "adds_domain_name" ]
                            ]
                          ]
                        ]
                      ]
                    ],
                    [ "Int", 255 ]
                  ]
                ]
              ],
              [
                "Attribute",
                "error_message",
                [
                  "String",
                  "Must be a valid domain name with a maximum length of 255 characters."
                ]
              ]
            ]
          }
        ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "admin_password" ] ],
      "body": [
        [ "Attribute", "type", [ "Id", "string" ] ],
        [
          "Attribute",
          "description",
          [
            "String",
            "The password used when provisioning administrator accounts. This should be a strong password that meets Azure's complexity requirements."
          ]
        ],
        [ "Attribute", "sensitive", [ "Bool", true ] ],
        [
          "Block",
          {
            "type_": "validation",
            "labels": [],
            "body": [
              [
                "Attribute",
                "condition",
                [
                  "Log_and",
                  [
                    [
                      "Log_and",
                      [
                        [
                          "Log_and",
                          [
                            [
                              "Log_and",
                              [
                                [
                                  "Gte",
                                  [
                                    [
                                      "Fun_call",
                                      [
                                        "length",
                                        [
                                          [
                                            "Attr",
                                            [
                                              [ "Id", "var" ],
                                              [
                                                "A_string", "admin_password"
                                              ]
                                            ]
                                          ]
                                        ]
                                      ]
                                    ],
                                    [ "Int", 8 ]
                                  ]
                                ],
                                [
                                  "Fun_call",
                                  [
                                    "can",
                                    [
                                      [
                                        "Fun_call",
                                        [
                                          "regex",
                                          [
                                            [ "String", "[A-Z]" ],
                                            [
                                              "Attr",
                                              [
                                                [ "Id", "var" ],
                                                [
                                                  "A_string",
                                                  "admin_password"
                                                ]
                                              ]
                                            ]
                                          ]
                                        ]
                                      ]
                                    ]
                                  ]
                                ]
                              ]
                            ],
                            [
                              "Fun_call",
                              [
                                "can",
                                [
                                  [
                                    "Fun_call",
                                    [
                                      "regex",
                                      [
                                        [ "String", "[a-z]" ],
                                        [
                                          "Attr",
                                          [
                                            [ "Id", "var" ],
                                            [ "A_string", "admin_password" ]
                                          ]
                                        ]
                                      ]
                                    ]
                                  ]
                                ]
                              ]
                            ]
                          ]
                        ],
                        [
                          "Fun_call",
                          [
                            "can",
                            [
                              [
                                "Fun_call",
                                [
                                  "regex",
                                  [
                                    [ "String", "[0-9]" ],
                                    [
                                      "Attr",
                                      [
                                        [ "Id", "var" ],
                                        [ "A_string", "admin_password" ]
                                      ]
                                    ]
                                  ]
                                ]
                              ]
                            ]
                          ]
                        ]
                      ]
                    ],
                    [
                      "Fun_call",
                      [
                        "can",
                        [
                          [
                            "Fun_call",
                            [
                              "regex",
                              [
                                [
                                  "String",
                                  "[!@#$%^&*()_+=\\[\\]{};':\"\\\\|,.<>/?-]"
                                ],
                                [
                                  "Attr",
                                  [
                                    [ "Id", "var" ],
                                    [ "A_string", "admin_password" ]
                                  ]
                                ]
                              ]
                            ]
                          ]
                        ]
                      ]
                    ]
                  ]
                ]
              ],
              [
                "Attribute",
                "error_message",
                [
                  "String",
                  "Password must be at least 8 characters long and include uppercase, lowercase, number, and special character."
                ]
              ]
            ]
          }
        ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "admin_password_secret" ] ],
      "body": [
        [ "Attribute", "type", [ "Id", "string" ] ],
        [
          "Attribute",
          "description",
          [
            "String",
            "The name of the key vault secret containing the admin password"
          ]
        ],
        [
          "Block",
          {
            "type_": "validation",
            "labels": [],
            "body": [
              [
                "Attribute",
                "condition",
                [
                  "Fun_call",
                  [
                    "can",
                    [
                      [
                        "Fun_call",
                        [
                          "regex",
                          [
                            [ "String", "^[a-zA-Z0-9-]{1,127}$" ],
                            [
                              "Attr",
                              [
                                [ "Id", "var" ],
                                [ "A_string", "admin_password_secret" ]
                              ]
                            ]
                          ]
                        ]
                      ]
                    ]
                  ]
                ]
              ],
              [
                "Attribute",
                "error_message",
                [
                  "String",
                  "Must conform to Azure Key Vault secret naming requirements: it can only contain alphanumeric characters and hyphens, and must be between 1 and 127 characters long."
                ]
              ]
            ]
          }
        ]
      ]
    }
  ],
  [
