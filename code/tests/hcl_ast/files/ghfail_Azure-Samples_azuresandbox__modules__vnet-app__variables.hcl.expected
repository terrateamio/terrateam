    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "vm_jumpbox_win_storage_account_type" ] ],
      "body": [
        [ "Attribute", "type", [ "Id", "string" ] ],
        [
          "Attribute",
          "description",
          [
            "String",
            "The storage type to be used for the VMs OS and data disks."
          ]
        ],
        [ "Attribute", "default", [ "String", "Standard_LRS" ] ],
        [
          "Block",
          {
            "type_": "validation",
            "labels": [],
            "body": [
              [
                "Attribute",
                "condition",
                [
                  "Fun_call",
                  [
                    "contains",
                    [
                      [
                        "Tuple",
                        [
                          [ "String", "Standard_LRS" ],
                          [ "String", "Premium_LRS" ],
                          [ "String", "StandardSSD_LRS" ],
                          [ "String", "Premium_ZRS" ],
                          [ "String", "StandardSSD_ZRS" ]
                        ]
                      ],
                      [
                        "Attr",
                        [
                          [ "Id", "var" ],
                          [
                            "A_string", "vm_jumpbox_win_storage_account_type"
                          ]
                        ]
                      ]
                    ]
                  ]
                ]
              ],
              [
                "Attribute",
                "error_message",
                [
                  "String",
                  "Must be one of the valid Azure storage SKUs for managed disks: 'Standard_LRS', 'Premium_LRS', 'StandardSSD_LRS', 'Premium_ZRS', or 'StandardSSD_ZRS'."
                ]
              ]
            ]
          }
        ]
      ]
    }
  ],
