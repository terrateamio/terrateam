  ],
  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "virtual_network_shared_id" ] ],
      "body": [
        [ "Attribute", "type", [ "Id", "string" ] ],
        [
          "Attribute",
          "description",
          [
            "String",
            "The id of the existing shared services virtual network that the new spoke virtual network will be peered with."
          ]
        ],
        [
          "Block",
          {
            "type_": "validation",
