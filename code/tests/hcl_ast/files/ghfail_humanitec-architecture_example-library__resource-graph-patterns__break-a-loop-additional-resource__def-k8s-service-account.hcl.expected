[
  [
    "Block",
    {
      "type_": "resource",
      "labels": [
        [ "Lit", "humanitec_resource_definition" ],
        [ "Lit", "example-k8s-service-account" ]
      ],
      "body": [
        [ "Attribute", "driver_type", [ "String", "humanitec/template" ] ],
        [ "Attribute", "id", [ "String", "example-k8s-service-account" ] ],
        [ "Attribute", "name", [ "String", "example-k8s-service-account" ] ],
        [ "Attribute", "type", [ "String", "k8s-service-account" ] ],
        [
          "Attribute",
          "driver_inputs",
          [
            "Object",
            [
              [
                [ "Bare", "values_string" ],
                [
                  "Fun_call",
                  [
                    "jsonencode",
                    [
                      [
                        "Object",
                        [
                          [
                            [ "Quoted", "role_arn" ],
                            [ "String", "${resources.aws-role.outputs.arn}" ]
                          ],
                          [
                            [ "Quoted", "sa_name" ],
                            [
                              "String",
                              "${resources['config.sa-name-role-id'].outputs.sa_name}"
                            ]
                          ],
                          [
                            [ "Quoted", "templates" ],
                            [
                              "Object",
                              [
                                [
                                  [ "Quoted", "outputs" ],
                                  [
                                    "String",
                                    "name: {{ .driver.values.sa_name }}\n"
                                  ]
                                ],
                                [
                                  [ "Quoted", "manifests" ],
                                  [
                                    "Heredoc",
                                    [
                                      "END_OF_TEXT",
                                      "\nservice-account.yaml:\n  location: namespace\n  data: |\n    apiVersion: v1\n    kind: ServiceAccount\n    metadata:\n      name: {{ .driver.values.sa_name }}\n      annotations:\n        eks.amazonaws.com/role-arn: {{ .driver.values.role_arn }}\n"
                                    ]
                                  ]
                                ]
                              ]
                            ]
                          ]
                        ]
                      ]
                    ]
                  ]
                ]
              ]
            ]
          ]
        ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "resource",
      "labels": [
        [ "Lit", "humanitec_resource_definition_criteria" ],
        [ "Lit", "example-k8s-service-account_criteria_0" ]
      ],
      "body": [
        [
          "Attribute",
          "resource_definition_id",
          [
            "Attr",
            [
              [
                "Attr",
                [
                  [
                    "Attr",
                    [
                      [ "Id", "resource" ],
                      [ "A_string", "humanitec_resource_definition" ]
                    ]
                  ],
                  [ "A_string", "example-k8s-service-account" ]
                ]
              ],
              [ "A_string", "id" ]
            ]
          ]
        ],
        [
          "Attribute",
          "app_id",
          [ "String", "example-break-a-loop-additional-resource" ]
        ]
      ]
    }
  ]
]
