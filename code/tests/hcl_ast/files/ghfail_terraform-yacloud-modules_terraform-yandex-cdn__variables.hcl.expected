  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "ip_address_acl_policy_type" ] ],
      "body": [
        [
          "Attribute",
          "description",
          [
            "Heredoc",
            [
              "EOF",
              "\n    The policy type for ip_address_acl option,\n    one of \"allow\" or \"deny\" values.\n"
            ]
          ]
        ],
        [ "Attribute", "type", [ "Id", "string" ] ],
        [ "Attribute", "default", [ "String", "allow" ] ],
        [
          "Block",
          {
            "type_": "validation",
            "labels": [],
            "body": [
              [
                "Attribute",
                "condition",
                [
                  "Fun_call",
                  [
                    "contains",
                    [
                      [
                        "Tuple",
                        [ [ "String", "allow" ], [ "String", "deny" ] ]
                      ],
                      [
                        "Attr",
                        [
                          [ "Id", "var" ],
                          [ "A_string", "ip_address_acl_policy_type" ]
                        ]
                      ]
                    ]
                  ]
                ]
              ],
              [
                "Attribute",
                "error_message",
                [
                  "String",
                  "ip_address_acl_policy_type must be either 'allow' or 'deny'."
                ]
              ]
            ]
          }
        ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "origin_group_use_next" ] ],
      "body": [
        [
          "Attribute",
          "description",
          [
            "Heredoc",
            [
              "EOF",
              "\n    If the option is active (has true value),\n    in case the origin responds with 4XX or 5XX codes, use the next origin from the list.\n"
            ]
          ]
        ],
        [ "Attribute", "type", [ "Id", "bool" ] ],
        [ "Attribute", "default", [ "Bool", true ] ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "shielding" ] ],
      "body": [
        [
          "Attribute",
          "description",
          [ "String", "ID of the shielding location for CDN protection" ]
        ],
        [ "Attribute", "type", [ "Id", "string" ] ],
        [ "Attribute", "default", [ "Null" ] ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "rewrite_flag" ] ],
      "body": [
        [
          "Attribute",
          "description",
          [
            "Heredoc",
            [
              "EOF",
              "\n    Defines flag for the Rewrite option (default: `BREAK`).\n    Possible values:\n    - `LAST` - Stops processing of the current set of ngx_http_rewrite_module directives and starts a search for a new location matching changed URI.\n    - `BREAK` - Stops processing of the current set of the Rewrite option.\n    - `REDIRECT` - Returns a temporary redirect with the 302 code\n    - `PERMANENT` - Returns a permanent redirect with the 301 code\n"
            ]
          ]
        ],
        [ "Attribute", "type", [ "Id", "string" ] ],
        [ "Attribute", "default", [ "Null" ] ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "rewrite_pattern" ] ],
      "body": [
        [
          "Attribute",
          "description",
          [
            "Heredoc",
            [
              "EOF",
              "\n    An option for changing or redirecting query paths. The value must have the following format:\n    `<source path> <destination path>`, where both paths are regular expressions which use at least one group.\n    Example: `/foo/(.*) /bar/$1`\n"
            ]
          ]
        ],
        [ "Attribute", "type", [ "Id", "string" ] ],
        [ "Attribute", "default", [ "Null" ] ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "origin_group_origins" ] ],
      "body": [
        [
          "Attribute",
          "description",
          [
            "Heredoc",
            [
              "EOF",
              "\n    A map of objects representing the origins for the CDN origin group. Each object contains the following fields:\n    - enabled (optional, default: true): A boolean indicating whether the origin is enabled and used as a source for the CDN.\n    - source (required): The IP address or domain name of your origin (and the port).\n    - backup (optional, default: false): A boolean specifying whether the origin is used in its origin group as a backup. A backup origin is used when one of the active origins becomes unavailable.\n\n    Example:\n    {\n      origin1 = {\n        source = \"192.168.1.1:8080\"\n        backup = false\n      }\n      origin2 = {\n        source  = \"example.com:80\"\n        enabled = true\n        backup  = true\n      }\n    }\n"
            ]
          ]
        ],
        [
          "Attribute",
          "type",
          [
            "Fun_call",
            [
              "map",
              [
                [
                  "Fun_call",
                  [
                    "object",
                    [
                      [
                        "Object",
                        [
                          [
                            [ "Bare", "enabled" ],
                            [
                              "Fun_call",
                              [
                                "optional",
                                [ [ "Id", "bool" ], [ "Bool", true ] ]
                              ]
                            ]
                          ],
                          [ [ "Bare", "source" ], [ "Id", "string" ] ],
                          [
                            [ "Bare", "backup" ],
                            [
                              "Fun_call",
                              [
                                "optional",
                                [ [ "Id", "bool" ], [ "Bool", false ] ]
                              ]
                            ]
                          ]
                        ]
                      ]
                    ]
                  ]
                ]
              ]
            ]
          ]
        ],
        [ "Attribute", "default", [ "Object", [] ] ],
        [
          "Block",
          {
            "type_": "validation",
            "labels": [],
            "body": [
              [
                "Attribute",
                "condition",
                [
                  "Gte",
                  [
                    [
                      "Fun_call",
                      [
                        "length",
                        [
                          [
                            "Attr",
                            [
                              [ "Id", "var" ],
                              [ "A_string", "origin_group_origins" ]
                            ]
                          ]
                        ]
                      ]
                    ],
                    [ "Int", 1 ]
                  ]
                ]
              ],
              [
                "Attribute",
                "error_message",
                [
                  "String",
                  "At least one origin is required in origin_group_origins."
                ]
              ]
            ]
          }
        ],
        [
          "Block",
          {
            "type_": "validation",
            "labels": [],
            "body": [
              [
                "Attribute",
                "condition",
                [
                  "Fun_call",
                  [
                    "alltrue",
                    [
                      [
                        "For_tuple",
                        {
                          "identifiers": [ "origin_key", [ "origin" ] ],
                          "input": [
                            "Attr",
                            [
                              [ "Id", "var" ],
                              [ "A_string", "origin_group_origins" ]
                            ]
                          ],
                          "output": [
                            "Fun_call",
                            [
                              "can",
                              [
                                [
                                  "Fun_call",
                                  [
                                    "regex",
                                    [
                                      [
                                        "String",
                                        "^([a-zA-Z0-9][a-zA-Z0-9.-]{1,61}[a-zA-Z0-9]\\.[a-zA-Z]{2,}|(?:[0-9]{1,3}\\.){3}[0-9]{1,3}|localhost)(?::[0-9]{1,5})?$"
                                      ],
                                      [
                                        "Attr",
                                        [
                                          [ "Id", "origin" ],
                                          [ "A_string", "source" ]
                                        ]
                                      ]
                                    ]
                                  ]
                                ]
                              ]
                            ]
                          ],
                          "cond": null
                        }
                      ]
                    ]
                  ]
                ]
              ],
              [
                "Attribute",
                "error_message",
                [
                  "String",
                  "Invalid origin source format. Must be in format 'domain.com[:port]' or 'ip[:port]'. Port number should be 1-65535."
                ]
              ]
            ]
          }
        ]
      ]
    }
  ],
  [
