[
  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "cluster_name" ] ],
      "body": [
        [ "Attribute", "type", [ "Id", "string" ] ],
        [
          "Attribute",
          "description",
          [ "String", "Unique cluster name (prepended to dns_zone)" ]
        ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "dns_zone" ] ],
      "body": [
        [ "Attribute", "type", [ "Id", "string" ] ],
        [
          "Attribute",
          "description",
          [ "String", "AWS Route53 DNS Zone (e.g. aws.example.com)" ]
        ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "dns_zone_id" ] ],
      "body": [
        [ "Attribute", "type", [ "Id", "string" ] ],
        [
          "Attribute",
          "description",
          [ "String", "AWS Route53 DNS Zone ID (e.g. Z3PAABBCFAKEC0)" ]
        ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "controller_count" ] ],
      "body": [
        [ "Attribute", "type", [ "Id", "number" ] ],
        [
          "Attribute",
          "description",
          [ "String", "Number of controllers (i.e. masters)" ]
        ],
        [ "Attribute", "default", [ "Int", 1 ] ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "worker_count" ] ],
      "body": [
        [ "Attribute", "type", [ "Id", "number" ] ],
        [ "Attribute", "description", [ "String", "Number of workers" ] ],
        [ "Attribute", "default", [ "Int", 1 ] ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "controller_type" ] ],
      "body": [
        [ "Attribute", "type", [ "Id", "string" ] ],
        [
          "Attribute",
          "description",
          [ "String", "EC2 instance type for controllers" ]
        ],
        [ "Attribute", "default", [ "String", "t3.small" ] ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "worker_type" ] ],
      "body": [
        [ "Attribute", "type", [ "Id", "string" ] ],
        [
          "Attribute",
          "description",
          [ "String", "EC2 instance type for workers" ]
        ],
        [ "Attribute", "default", [ "String", "t3.small" ] ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "os_stream" ] ],
      "body": [
        [ "Attribute", "type", [ "Id", "string" ] ],
        [
          "Attribute",
          "description",
          [
            "String",
            "Fedora CoreOs image stream for instances (e.g. stable, testing, next)"
          ]
        ],
        [ "Attribute", "default", [ "String", "stable" ] ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "disk_size" ] ],
      "body": [
        [ "Attribute", "type", [ "Id", "number" ] ],
        [
          "Attribute",
          "description",
          [ "String", "Size of the EBS volume in GB" ]
        ],
        [ "Attribute", "default", [ "Int", 40 ] ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "disk_type" ] ],
      "body": [
        [ "Attribute", "type", [ "Id", "string" ] ],
        [
          "Attribute",
          "description",
          [ "String", "Type of the EBS volume (e.g. standard, gp2, io1)" ]
        ],
        [ "Attribute", "default", [ "String", "gp2" ] ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "disk_iops" ] ],
      "body": [
        [ "Attribute", "type", [ "Id", "number" ] ],
        [
          "Attribute",
          "description",
          [ "String", "IOPS of the EBS volume (e.g. 100)" ]
        ],
        [ "Attribute", "default", [ "Int", 0 ] ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "worker_price" ] ],
      "body": [
        [ "Attribute", "type", [ "Id", "number" ] ],
        [
          "Attribute",
          "description",
          [
            "String",
            "Spot price in USD for worker instances or 0 to use on-demand instances"
          ]
        ],
        [ "Attribute", "default", [ "Int", 0 ] ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "worker_target_groups" ] ],
      "body": [
        [
          "Attribute",
          "type",
          [ "Fun_call", [ "list", [ [ "Id", "string" ] ] ] ]
        ],
        [
          "Attribute",
          "description",
          [
            "String",
            "Additional target group ARNs to which worker instances should be added"
          ]
        ],
        [ "Attribute", "default", [ "Tuple", [] ] ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "controller_snippets" ] ],
      "body": [
        [
          "Attribute",
          "type",
          [ "Fun_call", [ "list", [ [ "Id", "string" ] ] ] ]
        ],
        [
          "Attribute",
          "description",
          [ "String", "Controller Fedora CoreOS Config snippets" ]
        ],
        [ "Attribute", "default", [ "Tuple", [] ] ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "worker_snippets" ] ],
      "body": [
        [
          "Attribute",
          "type",
          [ "Fun_call", [ "list", [ [ "Id", "string" ] ] ] ]
        ],
        [
          "Attribute",
          "description",
          [ "String", "Worker Fedora CoreOS Config snippets" ]
        ],
        [ "Attribute", "default", [ "Tuple", [] ] ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "ssh_authorized_key" ] ],
      "body": [
        [ "Attribute", "type", [ "Id", "string" ] ],
        [
          "Attribute",
          "description",
          [ "String", "SSH public key for user 'core'" ]
        ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "asset_dir" ] ],
      "body": [
        [ "Attribute", "type", [ "Id", "string" ] ],
        [
          "Attribute",
          "description",
          [
            "String",
            "Absolute path to a directory where generated assets should be placed (contains secrets)"
          ]
        ],
        [ "Attribute", "default", [ "String", "" ] ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "networking" ] ],
      "body": [
        [ "Attribute", "type", [ "Id", "string" ] ],
        [
          "Attribute",
          "description",
          [ "String", "Choice of networking provider (calico or flannel)" ]
        ],
        [ "Attribute", "default", [ "String", "calico" ] ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "network_mtu" ] ],
      "body": [
        [ "Attribute", "type", [ "Id", "number" ] ],
        [
          "Attribute",
          "description",
          [
            "String",
            "CNI interface MTU (applies to calico only). Use 8981 if using instances types with Jumbo frames."
          ]
        ],
        [ "Attribute", "default", [ "Int", 1480 ] ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "host_cidr" ] ],
      "body": [
        [ "Attribute", "type", [ "Id", "string" ] ],
        [
          "Attribute",
          "description",
          [ "String", "CIDR IPv4 range to assign to EC2 nodes" ]
        ],
        [ "Attribute", "default", [ "String", "10.0.0.0/16" ] ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "pod_cidr" ] ],
      "body": [
        [ "Attribute", "type", [ "Id", "string" ] ],
        [
          "Attribute",
          "description",
          [ "String", "CIDR IPv4 range to assign Kubernetes pods" ]
        ],
        [ "Attribute", "default", [ "String", "10.2.0.0/16" ] ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "service_cidr" ] ],
      "body": [
        [ "Attribute", "type", [ "Id", "string" ] ],
        [
          "Attribute",
          "description",
          [
            "Heredoc",
            [
              "EOD",
              "\nCIDR IPv4 range to assign Kubernetes services.\nThe 1st IP will be reserved for kube_apiserver, the 10th IP will be reserved for coredns.\n"
            ]
          ]
        ],
        [ "Attribute", "default", [ "String", "10.3.0.0/16" ] ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "enable_reporting" ] ],
      "body": [
        [ "Attribute", "type", [ "Id", "bool" ] ],
        [
          "Attribute",
          "description",
          [
            "String",
            "Enable usage or analytics reporting to upstreams (Calico)"
          ]
        ],
        [ "Attribute", "default", [ "Bool", false ] ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "enable_aggregation" ] ],
      "body": [
        [ "Attribute", "type", [ "Id", "bool" ] ],
        [
          "Attribute",
          "description",
          [
            "String",
            "Enable the Kubernetes Aggregation Layer (defaults to false)"
          ]
        ],
        [ "Attribute", "default", [ "Bool", false ] ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "worker_node_labels" ] ],
      "body": [
        [
          "Attribute",
          "type",
          [ "Fun_call", [ "list", [ [ "Id", "string" ] ] ] ]
        ],
        [
          "Attribute",
          "description",
          [ "String", "List of initial worker node labels" ]
        ],
        [ "Attribute", "default", [ "Tuple", [] ] ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "cluster_domain_suffix" ] ],
      "body": [
        [ "Attribute", "type", [ "Id", "string" ] ],
        [
          "Attribute",
          "description",
          [
            "String",
            "Queries for domains with the suffix will be answered by CoreDNS. Default is cluster.local (e.g. foo.default.svc.cluster.local)"
          ]
        ],
        [ "Attribute", "default", [ "String", "cluster.local" ] ]
      ]
    }
  ]
]
