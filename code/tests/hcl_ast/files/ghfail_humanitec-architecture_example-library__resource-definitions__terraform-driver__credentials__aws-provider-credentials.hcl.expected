[
  [
    "Block",
    {
      "type_": "resource",
      "labels": [
        [ "Lit", "humanitec_resource_definition" ],
        [ "Lit", "aws-provider-credentials" ]
      ],
      "body": [
        [ "Attribute", "driver_type", [ "String", "humanitec/terraform" ] ],
        [ "Attribute", "id", [ "String", "aws-provider-credentials" ] ],
        [ "Attribute", "name", [ "String", "aws-provider-credentials" ] ],
        [ "Attribute", "type", [ "String", "s3" ] ],
        [
          "Attribute",
          "driver_account",
          [ "String", "${resources['config.default#aws-account'].account}" ]
        ],
        [
          "Attribute",
          "driver_inputs",
          [
            "Object",
            [
              [
                [ "Bare", "values_string" ],
                [
                  "Fun_call",
                  [
                    "jsonencode",
                    [
                      [
                        "Object",
                        [
                          [
                            [ "Quoted", "credentials_config" ],
                            [
                              "Object",
                              [
                                [
                                  [ "Quoted", "variables" ],
                                  [
                                    "Object",
                                    [
                                      [
                                        [ "Quoted", "access_key_id" ],
                                        [ "String", "AccessKeyId" ]
                                      ],
                                      [
                                        [ "Quoted", "secret_access_key" ],
                                        [ "String", "SecretAccessKey" ]
                                      ],
                                      [
                                        [ "Quoted", "session_token" ],
                                        [ "String", "SessionToken" ]
                                      ]
                                    ]
                                  ]
                                ]
                              ]
                            ]
                          ],
                          [
                            [ "Quoted", "script" ],
                            [
                              "Heredoc",
                              [
                                "END_OF_TEXT",
                                "\n\nvariable \"access_key_id\" {\n  sensitive = true\n}\nvariable \"secret_access_key\" {\n  sensitive = true\n}\nvariable \"session_token\" {\n  sensitive = true\n}\nvariable \"region\" {}\n\nterraform {\n  required_providers {\n    aws = {\n      source = \"hashicorp/aws\"\n    }\n  }\n}\n\nprovider \"aws\" {\n  region     = var.region\n  access_key = var.access_key_id\n  secret_key = var.secret_access_key\n  token      = var.session_token\n}\n\noutput \"bucket\" {\n  value = aws_s3_bucket.bucket.bucket\n}\n\noutput \"region\" {\n  value = var.region\n}\n\nresource \"aws_s3_bucket\" \"bucket\" {\n  bucket = \"$\\{replace(\"$${context.res.id}\", \"/^.*\\\\./\", \"\")}-standard-$${context.env.id}-$${context.app.id}-$${context.org.id}\"\n  tags = {\n    Humanitec = true\n  }\n}\n"
                              ]
                            ]
                          ],
                          [
                            [ "Quoted", "variables" ],
                            [
                              "Object",
                              [
                                [
                                  [ "Quoted", "region" ],
                                  [
                                    "String",
                                    "${resources['config.default#aws-account'].outputs.region}"
                                  ]
                                ]
                              ]
                            ]
                          ]
                        ]
                      ]
                    ]
                  ]
                ]
              ]
            ]
          ]
        ]
      ]
    }
  ]
]
