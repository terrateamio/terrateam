[
  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "name" ] ],
      "body": [
        [
          "Attribute",
          "description",
          [ "String", "The name of the Application Gateway." ]
        ],
        [ "Attribute", "type", [ "Id", "string" ] ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "resource_group_name" ] ],
      "body": [
        [
          "Attribute",
          "description",
          [ "String", "The name of the Resource Group to use." ]
        ],
        [ "Attribute", "type", [ "Id", "string" ] ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "region" ] ],
      "body": [
        [
          "Attribute",
          "description",
          [
            "String",
            "The name of the Azure region to deploy the resources in."
          ]
        ],
        [ "Attribute", "type", [ "Id", "string" ] ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "tags" ] ],
      "body": [
        [
          "Attribute",
          "description",
          [ "String", "The map of tags to assign to all created resources." ]
        ],
        [ "Attribute", "default", [ "Object", [] ] ],
        [
          "Attribute",
          "type",
          [ "Fun_call", [ "map", [ [ "Id", "string" ] ] ] ]
        ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "subnet_id" ] ],
      "body": [
        [
          "Attribute",
          "description",
          [
            "String",
            "An ID of a subnet (must be dedicated to Application Gateway v2) that will host the Application Gateway."
          ]
        ],
        [ "Attribute", "type", [ "Id", "string" ] ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "zones" ] ],
      "body": [
        [
          "Attribute",
          "description",
          [
            "Heredoc",
            [
              "EOF",
              "\nA list of zones the Application Gateway should be available in. For non-zonal deployments this should be set to an empty list,\nas `null` will enforce the default value.\n\n**Note!** \\\nThis is also enforced on the Public IP. The Public IP object brings in some limitations as it can only be non-zonal, pinned to\na single zone or zone-redundant (so available in all zones in a region).\n\nTherefore make sure that if you specify more than one zone you specify all available in a region. You can use a subset, but the\nPublic IP will be created in all zones anyway. This fact will cause Terraform to recreate the IP resource during next \n`terraform apply` as there will be difference between the state and the actual configuration.\n\nFor details on zones currently available in a region of your choice refer to\n[Microsoft's documentation](https://docs.microsoft.com/en-us/azure/availability-zones/az-region).\n"
            ]
          ]
        ],
        [
          "Attribute",
          "default",
          [
            "Tuple",
            [ [ "String", "1" ], [ "String", "2" ], [ "String", "3" ] ]
          ]
        ],
        [
          "Attribute",
          "type",
          [ "Fun_call", [ "list", [ [ "Id", "string" ] ] ] ]
        ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "public_ip" ] ],
      "body": [
        [
          "Attribute",
          "description",
          [
            "Heredoc",
            [
              "EOF",
              "\nA map defining listener's public IP configuration.\n\nFollowing properties are available:\n- `create`              - (`bool`, optional, defaults to `true`) controls if the Public IP resource is created or sourced.\n- `name`                - (`string`, optional) name of the Public IP resource, required unless `public_ip` module and `id`\n                          property are used.\n- `resource_group_name` - (`string`, optional, defaults to `null`) name of the Resource Group hosting the Public IP resource, \n                          used only for sourced resources.\n- `id`                  - (`string`, optional, defaults to `null`) ID of the Public IP to associate with the Listener. \n                          Property is used when Public IP is not created or sourced within this module.\n"
            ]
          ]
        ],
        [
          "Attribute",
          "type",
          [
            "Fun_call",
            [
              "object",
              [
                [
                  "Object",
                  [
                    [
                      [ "Bare", "create" ],
                      [
                        "Fun_call",
                        [
                          "optional", [ [ "Id", "bool" ], [ "Bool", true ] ]
                        ]
                      ]
                    ],
                    [
                      [ "Bare", "name" ],
                      [ "Fun_call", [ "optional", [ [ "Id", "string" ] ] ] ]
                    ],
                    [
                      [ "Bare", "resource_group_name" ],
                      [ "Fun_call", [ "optional", [ [ "Id", "string" ] ] ] ]
                    ],
                    [
                      [ "Bare", "id" ],
                      [ "Fun_call", [ "optional", [ [ "Id", "string" ] ] ] ]
                    ]
                  ]
                ]
              ]
            ]
          ]
        ],
        [
          "Block",
          {
            "type_": "validation",
            "labels": [],
            "body": [
              [
                "Attribute",
                "condition",
                [
                  "Log_or",
                  [
                    [
                      "Not_equal",
                      [
                        [
                          "Attr",
                          [
                            [
                              "Attr",
                              [
                                [ "Id", "var" ], [ "A_string", "public_ip" ]
                              ]
                            ],
                            [ "A_string", "name" ]
                          ]
                        ],
                        [ "Null" ]
                      ]
                    ],
                    [
                      "Not_equal",
                      [
                        [
                          "Attr",
                          [
                            [
                              "Attr",
                              [
                                [ "Id", "var" ], [ "A_string", "public_ip" ]
                              ]
                            ],
                            [ "A_string", "id" ]
                          ]
                        ],
                        [ "Null" ]
                      ]
                    ]
                  ]
                ]
              ],
              [
                "Attribute",
                "error_message",
                [
                  "Heredoc",
                  [
                    "EOF", "\nEither `name` or `id` property must be set.\n"
                  ]
                ]
              ]
            ]
          }
        ],
        [
          "Block",
          {
            "type_": "validation",
            "labels": [],
            "body": [
              [
                "Attribute",
                "condition",
                [
                  "Cond",
                  {
                    "if_": [
                      "Not_equal",
                      [
                        [
                          "Attr",
                          [ [ "Id", "var" ], [ "A_string", "public_ip" ] ]
                        ],
                        [ "Null" ]
                      ]
                    ],
                    "then_": [
                      "Cond",
                      {
                        "if_": [
                          "Not_equal",
                          [
                            [
                              "Attr",
                              [
                                [
                                  "Attr",
                                  [
                                    [ "Id", "var" ],
                                    [ "A_string", "public_ip" ]
                                  ]
                                ],
                                [ "A_string", "id" ]
                              ]
                            ],
                            [ "Null" ]
                          ]
                        ],
                        "then_": [
                          "Log_and",
                          [
                            [
                              "Equal",
                              [
                                [
                                  "Attr",
                                  [
                                    [
                                      "Attr",
                                      [
                                        [ "Id", "var" ],
                                        [ "A_string", "public_ip" ]
                                      ]
                                    ],
                                    [ "A_string", "create" ]
                                  ]
                                ],
                                [ "Bool", false ]
                              ]
                            ],
                            [
                              "Equal",
                              [
                                [
                                  "Attr",
                                  [
                                    [
                                      "Attr",
                                      [
                                        [ "Id", "var" ],
                                        [ "A_string", "public_ip" ]
                                      ]
                                    ],
                                    [ "A_string", "name" ]
                                  ]
                                ],
                                [ "Null" ]
                              ]
                            ]
                          ]
                        ],
                        "else_": [ "Bool", true ]
                      }
                    ],
                    "else_": [ "Bool", true ]
                  }
                ]
              ],
              [
                "Attribute",
                "error_message",
                [
                  "Heredoc",
                  [
                    "EOF",
                    "\nWhen using `id` property, `create` must be set to `false` and `name` must not be set.\n"
                  ]
                ]
              ]
            ]
          }
        ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "domain_name_label" ] ],
      "body": [
        [
          "Attribute",
          "description",
          [
            "Heredoc",
            [
              "EOF",
              "\nA label for the Domain Name. Will be used to make up the FQDN. \nIf a domain name label is specified, an A DNS record is created for the public IP in the Microsoft Azure DNS system.\n"
            ]
          ]
        ],
        [ "Attribute", "default", [ "Null" ] ],
        [ "Attribute", "type", [ "Id", "string" ] ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "capacity" ] ],
      "body": [
        [
          "Attribute",
          "description",
          [
            "Heredoc",
            [
              "EOF",
              "\nA map defining whether static or autoscale configuration is used.\n  \nFollowing properties are available:\n- `static`    - (`number`, optional, defaults to `2`) static number of Application Gateway instances, takes values bewteen 1 \n                and 125.\n- `autoscale` - (`map`, optional, defaults to `null`) autoscaling configuration, when specified `static` is being ignored:\n  - `min` - (`number`, required) minimum number of instances during autoscaling.\n  - `max` - (`number`, required) maximum number of instances during autoscaling.\n"
            ]
          ]
        ],
        [ "Attribute", "default", [ "Object", [] ] ],
        [ "Attribute", "nullable", [ "Bool", false ] ],
        [
          "Attribute",
          "type",
          [
            "Fun_call",
            [
              "object",
              [
                [
                  "Object",
                  [
                    [
                      [ "Bare", "static" ],
                      [
                        "Fun_call",
                        [ "optional", [ [ "Id", "number" ], [ "Int", 2 ] ] ]
                      ]
                    ],
                    [
                      [ "Bare", "autoscale" ],
                      [
                        "Fun_call",
                        [
                          "optional",
                          [
                            [
                              "Fun_call",
                              [
                                "object",
                                [
                                  [
                                    "Object",
                                    [
                                      [
                                        [ "Bare", "min" ], [ "Id", "number" ]
                                      ],
                                      [
                                        [ "Bare", "max" ], [ "Id", "number" ]
                                      ]
                                    ]
                                  ]
                                ]
                              ]
                            ]
                          ]
                        ]
                      ]
                    ]
                  ]
                ]
              ]
            ]
          ]
        ],
        [
          "Block",
          {
            "type_": "validation",
            "labels": [],
            "body": [
              [
                "Attribute",
                "condition",
                [
                  "Log_and",
                  [
                    [
                      "Gte",
                      [
                        [
                          "Attr",
                          [
                            [
                              "Attr",
                              [ [ "Id", "var" ], [ "A_string", "capacity" ] ]
                            ],
                            [ "A_string", "static" ]
                          ]
                        ],
                        [ "Int", 1 ]
                      ]
                    ],
                    [
                      "Lte",
                      [
                        [
                          "Attr",
                          [
                            [
                              "Attr",
                              [ [ "Id", "var" ], [ "A_string", "capacity" ] ]
                            ],
                            [ "A_string", "static" ]
                          ]
                        ],
                        [ "Int", 125 ]
                      ]
                    ]
                  ]
                ]
              ],
              [
                "Attribute",
                "error_message",
                [
                  "Heredoc",
                  [
                    "EOF",
                    "\nThe `capacity.static` property can take values between 1 and 125.\n"
                  ]
                ]
              ]
            ]
          }
        ],
        [
          "Block",
          {
            "type_": "validation",
            "labels": [],
            "body": [
              [
                "Attribute",
                "condition",
                [
                  "Cond",
                  {
                    "if_": [
                      "Equal",
                      [
                        [
                          "Attr",
                          [
                            [
                              "Attr",
                              [ [ "Id", "var" ], [ "A_string", "capacity" ] ]
                            ],
                            [ "A_string", "autoscale" ]
                          ]
                        ],
                        [ "Null" ]
                      ]
                    ],
                    "then_": [ "Bool", true ],
                    "else_": [
                      "Log_and",
                      [
                        [
                          "Log_and",
                          [
                            [
                              "Log_and",
                              [
                                [
                                  "Gte",
                                  [
                                    [
                                      "Attr",
                                      [
                                        [
                                          "Attr",
                                          [
                                            [
                                              "Attr",
                                              [
                                                [ "Id", "var" ],
                                                [ "A_string", "capacity" ]
                                              ]
                                            ],
                                            [ "A_string", "autoscale" ]
                                          ]
                                        ],
                                        [ "A_string", "min" ]
                                      ]
                                    ],
                                    [ "Int", 1 ]
                                  ]
                                ],
                                [
                                  "Lte",
                                  [
                                    [
                                      "Attr",
                                      [
                                        [
                                          "Attr",
                                          [
                                            [
                                              "Attr",
                                              [
                                                [ "Id", "var" ],
                                                [ "A_string", "capacity" ]
                                              ]
                                            ],
                                            [ "A_string", "autoscale" ]
                                          ]
                                        ],
                                        [ "A_string", "min" ]
                                      ]
                                    ],
                                    [ "Int", 125 ]
                                  ]
                                ]
                              ]
                            ],
                            [
                              "Log_and",
                              [
                                [
                                  "Gte",
                                  [
                                    [
                                      "Attr",
                                      [
                                        [
                                          "Attr",
                                          [
                                            [
                                              "Attr",
                                              [
                                                [ "Id", "var" ],
                                                [ "A_string", "capacity" ]
                                              ]
                                            ],
                                            [ "A_string", "autoscale" ]
                                          ]
                                        ],
                                        [ "A_string", "max" ]
                                      ]
                                    ],
                                    [ "Int", 1 ]
                                  ]
                                ],
                                [
                                  "Lte",
                                  [
                                    [
                                      "Attr",
                                      [
                                        [
                                          "Attr",
                                          [
                                            [
                                              "Attr",
                                              [
                                                [ "Id", "var" ],
                                                [ "A_string", "capacity" ]
                                              ]
                                            ],
                                            [ "A_string", "autoscale" ]
                                          ]
                                        ],
                                        [ "A_string", "max" ]
                                      ]
                                    ],
                                    [ "Int", 125 ]
                                  ]
                                ]
                              ]
                            ]
                          ]
                        ],
                        [
                          "Lt",
                          [
                            [
                              "Attr",
                              [
                                [
                                  "Attr",
                                  [
                                    [
                                      "Attr",
                                      [
                                        [ "Id", "var" ],
                                        [ "A_string", "capacity" ]
                                      ]
                                    ],
                                    [ "A_string", "autoscale" ]
                                  ]
                                ],
                                [ "A_string", "min" ]
                              ]
                            ],
                            [
                              "Attr",
                              [
                                [
                                  "Attr",
                                  [
                                    [
                                      "Attr",
                                      [
                                        [ "Id", "var" ],
                                        [ "A_string", "capacity" ]
                                      ]
                                    ],
                                    [ "A_string", "autoscale" ]
                                  ]
                                ],
                                [ "A_string", "max" ]
                              ]
                            ]
                          ]
                        ]
                      ]
                    ]
                  }
                ]
              ],
              [
                "Attribute",
                "error_message",
                [
                  "Heredoc",
                  [
                    "EOF",
                    "\nThe `min` and `max` properties of the `capacity.autoscale` property can take values between 1 and 125 and `min` value has to\nbe lower then `max`.\n"
                  ]
                ]
              ]
            ]
          }
        ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "enable_http2" ] ],
      "body": [
        [
          "Attribute",
          "description",
          [ "String", "Enable HTTP2 on the Application Gateway." ]
        ],
        [ "Attribute", "default", [ "Bool", false ] ],
        [ "Attribute", "type", [ "Id", "bool" ] ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "waf" ] ],
      "body": [
        [
          "Attribute",
          "description",
          [
            "Heredoc",
            [
              "EOF",
              "\nA map defining only the SKU and providing basic WAF (Web Application Firewall) configuration for Application Gateway. This\nmodule does not support WAF rules configuration and advanced WAF settings.\n\nFollowing properties are available:\n- `prevention_mode`  - (`bool`, required) `true` sets WAF mode to `Prevention` mode, `false` to `Detection` mode.\n- `rule_set_type`    - (`string`, optional, defaults to `OWASP`) the type of the Rule Set used for this WAF.\n- `rule_set_version` - (`string`, optional, defaults to Azure defaults) the version of the Rule Set used for this WAF.\n"
            ]
          ]
        ],
        [ "Attribute", "default", [ "Null" ] ],
        [
          "Attribute",
          "type",
          [
            "Fun_call",
            [
              "object",
              [
                [
                  "Object",
                  [
                    [ [ "Bare", "prevention_mode" ], [ "Id", "bool" ] ],
                    [
                      [ "Bare", "rule_set_type" ],
                      [
                        "Fun_call",
                        [
                          "optional",
                          [ [ "Id", "string" ], [ "String", "OWASP" ] ]
                        ]
                      ]
                    ],
                    [
                      [ "Bare", "rule_set_version" ],
                      [ "Fun_call", [ "optional", [ [ "Id", "string" ] ] ] ]
                    ]
                  ]
                ]
              ]
            ]
          ]
        ],
        [
          "Block",
          {
            "type_": "validation",
            "labels": [],
            "body": [
              [
                "Attribute",
                "condition",
                [
                  "Cond",
                  {
                    "if_": [
                      "Equal",
                      [
                        [
                          "Attr", [ [ "Id", "var" ], [ "A_string", "waf" ] ]
                        ],
                        [ "Null" ]
                      ]
                    ],
                    "then_": [ "Bool", true ],
                    "else_": [
                      "Fun_call",
                      [
                        "contains",
                        [
                          [
                            "Tuple",
                            [
                              [ "String", "OWASP" ],
                              [ "String", "Microsoft_BotManagerRuleSet" ]
                            ]
                          ],
                          [
                            "Attr",
                            [
                              [
                                "Attr",
                                [ [ "Id", "var" ], [ "A_string", "waf" ] ]
                              ],
                              [ "A_string", "rule_set_type" ]
                            ]
                          ]
                        ]
                      ]
                    ]
                  }
                ]
              ],
              [
                "Attribute",
                "error_message",
                [
                  "Heredoc",
                  [
                    "EOF",
                    "\nFor `waf.rule_set_type` possible values are \\\"OWASP\\\" and \\\"Microsoft_BotManagerRuleSet\\\".\n"
                  ]
                ]
              ]
            ]
          }
        ],
        [
          "Block",
          {
            "type_": "validation",
            "labels": [],
            "body": [
              [
                "Attribute",
                "condition",
                [
                  "Cond",
                  {
                    "if_": [
                      "Equal",
                      [
                        [
                          "Fun_call",
                          [
                            "try",
                            [
                              [
                                "Attr",
                                [
                                  [
                                    "Attr",
                                    [
                                      [ "Id", "var" ], [ "A_string", "waf" ]
                                    ]
                                  ],
                                  [ "A_string", "rule_set_version" ]
                                ]
                              ],
                              [ "Null" ]
                            ]
                          ]
                        ],
                        [ "Null" ]
                      ]
                    ],
                    "then_": [ "Bool", true ],
                    "else_": [
                      "Fun_call",
                      [
                        "contains",
                        [
                          [
                            "Tuple",
                            [
                              [ "String", "0.1" ],
                              [ "String", "1.0" ],
                              [ "String", "2.2.9" ],
                              [ "String", "3.0" ],
                              [ "String", "3.1" ],
                              [ "String", "3.2" ]
                            ]
                          ],
                          [
                            "Attr",
                            [
                              [
                                "Attr",
                                [ [ "Id", "var" ], [ "A_string", "waf" ] ]
                              ],
                              [ "A_string", "rule_set_version" ]
                            ]
                          ]
                        ]
                      ]
                    ]
                  }
                ]
              ],
              [
                "Attribute",
                "error_message",
                [
                  "Heredoc",
                  [
                    "EOF",
                    "\nThe `waf.rule_set_version` property can be one of \\\"0.1\\\", \\\"1.0\\\", \\\"2.2.9\\\", \\\"3.0\\\", \\\"3.1\\\" or \\\"3.2\\\".\n"
                  ]
                ]
              ]
            ]
          }
        ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "managed_identities" ] ],
      "body": [
        [
          "Attribute",
          "description",
          [
            "Heredoc",
            [
              "EOF",
              "\nA list of existing User-Assigned Managed Identities.\n  \n**Note!** \\\nApplication Gateway uses Managed Identities to retrieve certificates from a Key Vault. These identities have to have at least\n`GET` access to Key Vault's secrets. Otherwise Application Gateway will not be able to use certificates stored in the Vault.\n"
            ]
          ]
        ],
        [ "Attribute", "default", [ "Null" ] ],
        [
          "Attribute",
          "type",
          [ "Fun_call", [ "list", [ [ "Id", "string" ] ] ] ]
        ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "global_ssl_policy" ] ],
      "body": [
        [
          "Attribute",
          "description",
          [
            "Heredoc",
            [
              "EOF",
              "\nA map defining global SSL settings.\n\nFollowing properties are available:\n- `type`                 - (`string`, required, but defaults to `Predefined`) type of an SSL policy, possible values include:\n                           `Predefined`, `Custom` or `CustomV2`.\n- `name`                 - (`string`, optional, defaults to `AppGwSslPolicy20220101S`) name of an SSL policy, supported only\n                           for `type` set to `Predefined`.\n    \n  **Note!** \\\n  Normally you can set it also for `Custom` policies but the name is discarded on Azure side causing an update to Application\n  Gateway each time Terraform code is run. Therefore this property is omitted in the code for `Custom` policies.\n\n  For the `Predefined` policies, check the\n  [Microsoft documentation](https://docs.microsoft.com/en-us/azure/application-gateway/application-gateway-ssl-policy-overview)\n  for possible values as they tend to change over time. The default value is currently (Q1 2023) is also Microsoft's default.\n\n- `min_protocol_version` - (`string`, optional, defaults to `null`) minimum version of the TLS protocol for SSL Policy, \n                           required only for `type` set to `Custom`.\n- `cipher_suites`        - (`list`, optional, defaults to `[]`) a list of accepted cipher suites, required only for `type` set\n                           to `Custom`. For possible values see [provider documentation](https://registry.terraform.io/providers/hashicorp/azurerm/latest/docs/resources/application_gateway#cipher_suites).\n"
            ]
          ]
        ],
        [ "Attribute", "default", [ "Object", [] ] ],
        [ "Attribute", "nullable", [ "Bool", false ] ],
        [
          "Attribute",
          "type",
          [
            "Fun_call",
            [
              "object",
              [
                [
                  "Object",
                  [
                    [
                      [ "Bare", "type" ],
                      [
                        "Fun_call",
                        [
                          "optional",
                          [ [ "Id", "string" ], [ "String", "Predefined" ] ]
                        ]
                      ]
                    ],
                    [
                      [ "Bare", "name" ],
                      [
                        "Fun_call",
                        [
