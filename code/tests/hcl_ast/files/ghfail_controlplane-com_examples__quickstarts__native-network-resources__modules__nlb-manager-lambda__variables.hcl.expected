[
  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "name" ] ],
      "body": [
        [ "Attribute", "type", [ "Id", "string" ] ],
        [ "Attribute", "default", [ "String", "cpln-nlb-manager" ] ],
        [
          "Attribute",
          "description",
          [
            "String",
            "The name of the native network resource configuration. Associated resources will use this name as a prefix"
          ]
        ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "vpc-id" ] ],
      "body": [
        [ "Attribute", "type", [ "Id", "string" ] ],
        [
          "Attribute",
          "description",
          [
            "String",
            "The name of the VPC in which the lambda function will run"
          ]
        ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "public-subnet-cidr" ] ],
      "body": [
        [ "Attribute", "type", [ "Id", "string" ] ],
        [
          "Attribute",
          "description",
          [
            "String",
            "A CIDR that will host a NAT gateway to allow the lambda function internet access"
          ]
        ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "private-subnets" ] ],
      "body": [
        [
          "Attribute",
          "type",
          [
            "Fun_call",
            [
              "map",
              [
                [
                  "Fun_call",
                  [
                    "object",
                    [
                      [
                        "Object",
                        [
                          [ [ "Bare", "CIDR" ], [ "Id", "string" ] ],
                          [
                            [ "Bare", "availability-zone" ],
                            [ "Id", "string" ]
                          ]
                        ]
                      ]
                    ]
                  ]
                ]
              ]
            ]
          ]
        ],
        [
          "Attribute",
          "description",
          [ "String", "A list of subnets in which the lambda will execute" ]
        ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "aws-region" ] ],
      "body": [
        [ "Attribute", "type", [ "Id", "string" ] ],
        [
          "Attribute",
          "description",
          [
            "String",
            "The name of the AWS region containing the network resources you wish to expose."
          ]
        ],
        [ "Attribute", "default", [ "String", "us-east-2" ] ]
      ]
    }
  ]
]
