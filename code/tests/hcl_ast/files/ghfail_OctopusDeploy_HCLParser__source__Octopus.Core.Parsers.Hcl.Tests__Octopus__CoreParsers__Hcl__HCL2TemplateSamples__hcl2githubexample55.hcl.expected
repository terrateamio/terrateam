[
  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "create_metric_alarm" ] ],
      "body": [
        [
          "Attribute",
          "description",
          [ "String", "Whether to create the Cloudwatch metric alarm" ]
        ],
        [ "Attribute", "type", [ "Id", "bool" ] ],
        [ "Attribute", "default", [ "Bool", true ] ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "alarm_name" ] ],
      "body": [
        [
          "Attribute",
          "description",
          [
            "String",
            "The descriptive name for the alarm. This name must be unique within the user's AWS account."
          ]
        ],
        [ "Attribute", "type", [ "Id", "string" ] ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "alarm_description" ] ],
      "body": [
        [
          "Attribute",
          "description",
          [ "String", "The description for the alarm." ]
        ],
        [ "Attribute", "type", [ "Id", "string" ] ],
        [ "Attribute", "default", [ "Null" ] ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "comparison_operator" ] ],
      "body": [
        [
          "Attribute",
          "description",
          [
            "String",
            "The arithmetic operation to use when comparing the specified Statistic and Threshold. The specified Statistic value is used as the first operand. Either of the following is supported: GreaterThanOrEqualToThreshold, GreaterThanThreshold, LessThanThreshold, LessThanOrEqualToThreshold."
          ]
        ],
        [ "Attribute", "type", [ "Id", "string" ] ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "evaluation_periods" ] ],
      "body": [
        [
          "Attribute",
          "description",
          [
            "String",
            "The number of periods over which data is compared to the specified threshold."
          ]
        ],
        [ "Attribute", "type", [ "Id", "number" ] ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "threshold" ] ],
      "body": [
        [
          "Attribute",
          "description",
          [
            "String",
            "The value against which the specified statistic is compared."
          ]
        ],
        [ "Attribute", "type", [ "Id", "number" ] ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "unit" ] ],
      "body": [
        [
          "Attribute",
          "description",
          [ "String", "The unit for the alarm's associated metric." ]
        ],
        [ "Attribute", "type", [ "Id", "string" ] ],
        [ "Attribute", "default", [ "Null" ] ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "metric_name" ] ],
      "body": [
        [
          "Attribute",
          "description",
          [
            "String",
            "The name for the alarm's associated metric. See docs for supported metrics."
          ]
        ],
        [ "Attribute", "type", [ "Id", "string" ] ],
        [ "Attribute", "default", [ "Null" ] ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "namespace" ] ],
      "body": [
        [
          "Attribute",
          "description",
          [
            "String",
            "The namespace for the alarm's associated metric. See docs for the list of namespaces. See docs for supported metrics."
          ]
        ],
        [ "Attribute", "type", [ "Id", "string" ] ],
        [ "Attribute", "default", [ "Null" ] ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "period" ] ],
      "body": [
        [
          "Attribute",
          "description",
          [
            "String",
            "The period in seconds over which the specified statistic is applied."
          ]
        ],
        [ "Attribute", "type", [ "Id", "string" ] ],
        [ "Attribute", "default", [ "Null" ] ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "statistic" ] ],
      "body": [
        [
          "Attribute",
          "description",
          [
            "String",
            "The statistic to apply to the alarm's associated metric. Either of the following is supported: SampleCount, Average, Sum, Minimum, Maximum"
          ]
        ],
        [ "Attribute", "type", [ "Id", "string" ] ],
        [ "Attribute", "default", [ "Null" ] ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "actions_enabled" ] ],
      "body": [
        [
          "Attribute",
          "description",
          [
            "String",
            "Indicates whether or not actions should be executed during any changes to the alarm's state. Defaults to true."
          ]
        ],
        [ "Attribute", "type", [ "Id", "bool" ] ],
        [ "Attribute", "default", [ "Bool", true ] ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "datapoints_to_alarm" ] ],
      "body": [
        [
          "Attribute",
          "description",
          [
            "String",
            "The number of datapoints that must be breaching to trigger the alarm."
          ]
        ],
        [ "Attribute", "type", [ "Id", "number" ] ],
        [ "Attribute", "default", [ "Null" ] ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "dimensions" ] ],
      "body": [
        [
          "Attribute",
          "description",
          [ "String", "The dimensions for the alarm's associated metric." ]
        ],
        [ "Attribute", "type", [ "Id", "any" ] ],
        [ "Attribute", "default", [ "Null" ] ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "alarm_actions" ] ],
      "body": [
        [
          "Attribute",
          "description",
          [
            "String",
            "The list of actions to execute when this alarm transitions into an ALARM state from any other state. Each action is specified as an Amazon Resource Name (ARN)."
          ]
        ],
        [
          "Attribute",
          "type",
          [ "Fun_call", [ "list", [ [ "Id", "string" ] ] ] ]
        ],
        [ "Attribute", "default", [ "Null" ] ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "insufficient_data_actions" ] ],
      "body": [
        [
          "Attribute",
          "description",
          [
            "String",
            "The list of actions to execute when this alarm transitions into an INSUFFICIENT_DATA state from any other state. Each action is specified as an Amazon Resource Name (ARN)."
          ]
        ],
        [
          "Attribute",
          "type",
          [ "Fun_call", [ "list", [ [ "Id", "string" ] ] ] ]
        ],
        [ "Attribute", "default", [ "Null" ] ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "ok_actions" ] ],
      "body": [
        [
          "Attribute",
          "description",
          [
            "String",
            "The list of actions to execute when this alarm transitions into an OK state from any other state. Each action is specified as an Amazon Resource Name (ARN)."
          ]
        ],
        [
          "Attribute",
          "type",
          [ "Fun_call", [ "list", [ [ "Id", "string" ] ] ] ]
        ],
        [ "Attribute", "default", [ "Null" ] ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "extended_statistic" ] ],
      "body": [
        [
          "Attribute",
          "description",
          [
            "String",
            "The percentile statistic for the metric associated with the alarm. Specify a value between p0.0 and p100."
          ]
        ],
        [ "Attribute", "type", [ "Id", "string" ] ],
        [ "Attribute", "default", [ "Null" ] ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "treat_missing_data" ] ],
      "body": [
        [
          "Attribute",
          "description",
          [
            "String",
            "Sets how this alarm is to handle missing data points. The following values are supported: missing, ignore, breaching and notBreaching."
          ]
        ],
        [ "Attribute", "type", [ "Id", "string" ] ],
        [ "Attribute", "default", [ "String", "missing" ] ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "evaluate_low_sample_count_percentiles" ] ],
      "body": [
        [
          "Attribute",
          "description",
          [
            "String",
            "Used only for alarms based on percentiles. If you specify ignore, the alarm state will not change during periods with too few data points to be statistically significant. If you specify evaluate or omit this parameter, the alarm will always be evaluated and possibly change state no matter how many data points are available. The following values are supported: ignore, and evaluate."
          ]
        ],
        [ "Attribute", "type", [ "Id", "string" ] ],
        [ "Attribute", "default", [ "Null" ] ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "metric_query" ] ],
      "body": [
        [
          "Attribute",
          "description",
          [
            "String",
            "Enables you to create an alarm based on a metric math expression. You may specify at most 20."
          ]
        ],
        [ "Attribute", "type", [ "Id", "any" ] ],
        [ "Attribute", "default", [ "Tuple", [] ] ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "tags" ] ],
      "body": [
        [
          "Attribute",
          "description",
          [ "String", "A mapping of tags to assign to all resources" ]
        ],
        [
          "Attribute",
          "type",
          [ "Fun_call", [ "map", [ [ "Id", "string" ] ] ] ]
        ],
        [ "Attribute", "default", [ "Object", [] ] ]
      ]
    }
  ]
]
