                  ],
                  "strip_before": false,
                  "strip_after": false
                }
              ],
              [ "Literal", "/kit" ]
            ]
          ]
        ],
        [
          "Attribute",
          "compliance_dir",
          [
            "Template",
            [
              [
                "Interpolation",
                {
                  "expr": [
                    "Attr", [ [ "Id", "var" ], [ "A_string", "repo_dir" ] ]
                  ],
                  "strip_before": false,
                  "strip_after": false
                }
              ],
              [ "Literal", "/compliance" ]
            ]
          ]
        ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "locals",
      "labels": [],
      "body": [
        [
          "Attribute",
          "platform_readmes",
          [
            "Fun_call",
            [
              "fileset",
              [
                [
                  "Template",
                  [
                    [
                      "Interpolation",
                      {
                        "expr": [
                          "Attr",
                          [
                            [ "Id", "var" ], [ "A_string", "foundation_dir" ]
                          ]
                        ],
                        "strip_before": false,
                        "strip_after": false
                      }
                    ],
                    [ "Literal", "/platforms" ]
                  ]
                ],
                [ "String", "*/README.md" ]
              ]
            ]
          ]
        ],
        [
          "Attribute",
          "kit_readmes",
          [
            "Fun_call",
            [
              "toset",
              [
                [
                  "For_tuple",
                  {
                    "identifiers": [ "x", [] ],
                    "input": [
                      "Fun_call",
                      [
                        "fileset",
                        [
                          [
                            "Attr",
                            [ [ "Id", "local" ], [ "A_string", "kit_dir" ] ]
                          ],
                          [ "String", "**/README.md" ]
                        ]
                      ]
                    ],
                    "output": [ "Id", "x" ],
                    "cond": [
                      "Log_and",
                      [
                        [
                          "Not",
                          [
                            "Fun_call",
                            [
                              "strcontains",
                              [ [ "Id", "x" ], [ "String", ".terraform" ] ]
                            ]
                          ]
                        ],
                        [
                          "Not",
                          [
                            "Fun_call",
                            [
                              "strcontains",
                              [
                                [ "Id", "x" ],
                                [ "String", ".terragrunt-cache" ]
                              ]
                            ]
                          ]
                        ]
                      ]
                    ]
                  }
                ]
              ]
            ]
          ]
        ],
        [
          "Attribute",
          "parsed_kit_modules",
          [
            "For_object",
            {
              "identifiers": [ "x", [] ],
              "input": [
                "Attr", [ [ "Id", "local" ], [ "A_string", "kit_readmes" ] ]
              ],
              "key_output": [
                "Fun_call",
                [
                  "trimsuffix", [ [ "Id", "x" ], [ "String", "/README.md" ] ]
                ]
              ],
              "value_output": [
                "Fun_call",
                [
                  "try",
                  [
                    [
                      "Fun_call",
                      [
                        "yamldecode",
                        [
                          [
                            "Idx",
                            [
                              [
                                "Fun_call",
                                [
                                  "regex",
                                  [
                                    [
                                      "String",
                                      "^---([\\s\\S]*)\\n---\\n[\\s\\S]*$"
                                    ],
                                    [
                                      "Fun_call",
                                      [
                                        "file",
                                        [
                                          [
                                            "Template",
                                            [
                                              [
                                                "Interpolation",
                                                {
                                                  "expr": [
                                                    "Attr",
                                                    [
                                                      [ "Id", "local" ],
                                                      [
                                                        "A_string", "kit_dir"
                                                      ]
                                                    ]
                                                  ],
                                                  "strip_before": false,
                                                  "strip_after": false
                                                }
                                              ],
                                              [ "Literal", "/" ],
                                              [
                                                "Interpolation",
                                                {
                                                  "expr": [ "Id", "x" ],
                                                  "strip_before": false,
                                                  "strip_after": false
                                                }
                                              ]
                                            ]
                                          ]
                                        ]
                                      ]
                                    ]
                                  ]
                                ]
                              ],
                              [ "Int", 0 ]
                            ]
                          ]
                        ]
                      ]
                    ],
                    [ "Null" ]
                  ]
                ]
              ],
              "cond": null
            }
          ]
        ],
        [
          "Attribute",
          "compliance_readmes",
          [
            "Fun_call",
            [
              "toset",
              [
                [
                  "For_tuple",
                  {
                    "identifiers": [ "x", [] ],
                    "input": [
                      "Fun_call",
                      [
                        "fileset",
                        [
                          [
                            "Attr",
                            [
                              [ "Id", "local" ],
                              [ "A_string", "compliance_dir" ]
                            ]
                          ],
                          [ "String", "**/*.md" ]
                        ]
                      ]
                    ],
                    "output": [ "Id", "x" ],
                    "cond": null
                  }
                ]
              ]
            ]
          ]
        ],
        [
          "Attribute",
          "parsed_compliance_controls",
          [
            "For_object",
            {
              "identifiers": [ "x", [] ],
              "input": [
                "Attr",
                [ [ "Id", "local" ], [ "A_string", "compliance_readmes" ] ]
              ],
              "key_output": [
                "Fun_call",
                [ "trimsuffix", [ [ "Id", "x" ], [ "String", ".md" ] ] ]
              ],
              "value_output": [
                "Fun_call",
                [
                  "try",
                  [
                    [
                      "Fun_call",
                      [
                        "yamldecode",
                        [
                          [
                            "Idx",
                            [
                              [
                                "Fun_call",
                                [
                                  "regex",
                                  [
                                    [
                                      "String",
                                      "^---([\\s\\S]*)\\n---\\n[\\s\\S]*$"
                                    ],
                                    [
                                      "Fun_call",
                                      [
                                        "file",
                                        [
                                          [
                                            "Template",
                                            [
                                              [
                                                "Interpolation",
                                                {
                                                  "expr": [
                                                    "Attr",
                                                    [
                                                      [ "Id", "local" ],
                                                      [
                                                        "A_string",
                                                        "compliance_dir"
                                                      ]
                                                    ]
                                                  ],
                                                  "strip_before": false,
                                                  "strip_after": false
                                                }
                                              ],
                                              [ "Literal", "/" ],
                                              [
                                                "Interpolation",
                                                {
                                                  "expr": [ "Id", "x" ],
                                                  "strip_before": false,
                                                  "strip_after": false
                                                }
                                              ]
                                            ]
                                          ]
                                        ]
                                      ]
                                    ]
                                  ]
                                ]
                              ],
                              [ "Int", 0 ]
                            ]
                          ]
                        ]
                      ]
                    ],
                    [ "Null" ]
                  ]
                ]
              ],
              "cond": null
            }
          ]
        ],
        [
          "Attribute",
          "kit_modules",
          [
            "For_object",
            {
              "identifiers": [ "key", [ "value" ] ],
              "input": [
                "Attr",
                [ [ "Id", "local" ], [ "A_string", "parsed_kit_modules" ] ]
              ],
              "key_output": [ "Id", "key" ],
              "value_output": [ "Id", "value" ],
              "cond": [ "Not_equal", [ [ "Id", "value" ], [ "Null" ] ] ]
            }
          ]
        ],
        [
          "Attribute",
          "kit_module_compliance_md",
          [
            "For_object",
            {
              "identifiers": [ "key", [ "value" ] ],
              "input": [
                "Attr", [ [ "Id", "local" ], [ "A_string", "kit_modules" ] ]
              ],
              "key_output": [ "Id", "key" ],
              "value_output": [
                "Fun_call",
                [
                  "join",
                  [
                    [ "String", "\n" ],
                    [
                      "Fun_call",
                      [
                        "compact",
                        [
                          [
                            "For_tuple",
                            {
                              "identifiers": [ "s", [] ],
                              "input": [
                                "Fun_call",
                                [
                                  "try",
                                  [
                                    [
                                      "Attr",
                                      [
                                        [ "Id", "value" ],
                                        [ "A_string", "compliance" ]
                                      ]
                                    ],
                                    [ "Tuple", [] ]
                                  ]
                                ]
                              ],
                              "output": [
                                "Fun_call",
                                [
                                  "try",
                                  [
                                    [
                                      "Template",
                                      [
                                        [ "Literal", "- [" ],
                                        [
                                          "Interpolation",
                                          {
                                            "expr": [
                                              "Attr",
                                              [
                                                [
                                                  "Idx",
                                                  [
                                                    [
                                                      "Attr",
                                                      [
                                                        [ "Id", "local" ],
                                                        [
                                                          "A_string",
                                                          "parsed_compliance_controls"
                                                        ]
                                                      ]
                                                    ],
                                                    [
                                                      "Attr",
                                                      [
                                                        [ "Id", "s" ],
                                                        [
                                                          "A_string",
                                                          "control"
                                                        ]
                                                      ]
                                                    ]
                                                  ]
                                                ],
                                                [ "A_string", "name" ]
                                              ]
                                            ],
                                            "strip_before": false,
                                            "strip_after": false
                                          }
                                        ],
                                        [ "Literal", "](/compliance/" ],
                                        [
                                          "Interpolation",
                                          {
                                            "expr": [
                                              "Attr",
                                              [
                                                [ "Id", "s" ],
                                                [ "A_string", "control" ]
                                              ]
                                            ],
                                            "strip_before": false,
                                            "strip_after": false
                                          }
                                        ],
                                        [ "Literal", ".md): " ],
                                        [
                                          "Interpolation",
                                          {
                                            "expr": [
                                              "Fun_call",
                                              [
                                                "trimspace",
                                                [
                                                  [
                                                    "Attr",
                                                    [
                                                      [ "Id", "s" ],
                                                      [
                                                        "A_string",
                                                        "statement"
                                                      ]
                                                    ]
                                                  ]
                                                ]
                                              ]
                                            ],
                                            "strip_before": false,
                                            "strip_after": false
                                          }
                                        ]
                                      ]
                                    ],
                                    [
                                      "Template",
                                      [
                                        [
                                          "Literal",
                                          "<!-- error locating compliance control "
                                        ],
                                        [
                                          "Interpolation",
                                          {
                                            "expr": [
                                              "Attr",
                                              [
                                                [ "Id", "s" ],
                                                [ "A_string", "control" ]
                                              ]
                                            ],
                                            "strip_before": false,
                                            "strip_after": false
                                          }
                                        ],
                                        [ "Literal", " -->" ]
                                      ]
                                    ]
                                  ]
                                ]
                              ],
                              "cond": null
                            }
                          ]
                        ]
                      ]
                    ]
                  ]
                ]
              ],
              "cond": null
            }
          ]
        ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "resource",
      "labels": [ [ "Lit", "null_resource" ], [ "Lit", "copy_template" ] ],
      "body": [
        [
          "Attribute",
          "triggers",
          [
            "Object",
            [
              [
                [ "Bare", "output_dir" ],
                [ "Attr", [ [ "Id", "var" ], [ "A_string", "output_dir" ] ] ]
              ],
              [
                [ "Bare", "template_dir_files" ],
                [
                  "Fun_call",
                  [
                    "join",
                    [
                      [ "String", " " ],
                      [
                        "Fun_call",
                        [
                          "fileset",
                          [
                            [
                              "Attr",
                              [
                                [ "Id", "var" ],
                                [ "A_string", "template_dir" ]
                              ]
                            ],
                            [ "String", "**/*" ]
                          ]
                        ]
                      ]
                    ]
                  ]
                ]
              ]
            ]
          ]
        ],
        [
          "Block",
          {
            "type_": "provisioner",
            "labels": [ [ "Lit", "local-exec" ] ],
            "body": [
              [ "Attribute", "when", [ "Id", "create" ] ],
              [
                "Attribute",
                "command",
                [
                  "Template",
                  [
                    [ "Literal", "mkdir -p " ],
                    [
                      "Interpolation",
                      {
                        "expr": [
                          "Attr",
                          [ [ "Id", "var" ], [ "A_string", "output_dir" ] ]
                        ],
                        "strip_before": false,
                        "strip_after": false
                      }
                    ],
                    [ "Literal", " && cp -a -R -L " ],
                    [
                      "Interpolation",
                      {
                        "expr": [
                          "Attr",
                          [ [ "Id", "var" ], [ "A_string", "template_dir" ] ]
                        ],
                        "strip_before": false,
                        "strip_after": false
                      }
                    ],
                    [ "Literal", "/* " ],
                    [
                      "Interpolation",
                      {
                        "expr": [
                          "Attr",
                          [ [ "Id", "var" ], [ "A_string", "output_dir" ] ]
                        ],
                        "strip_before": false,
                        "strip_after": false
                      }
                    ]
                  ]
                ]
              ]
            ]
          }
        ],
        [
          "Block",
          {
            "type_": "provisioner",
            "labels": [ [ "Lit", "local-exec" ] ],
            "body": [
              [ "Attribute", "when", [ "Id", "destroy" ] ],
              [
                "Attribute",
                "command",
                [
                  "Template",
                  [
                    [ "Literal", "cd " ],
                    [
                      "Interpolation",
                      {
                        "expr": [
                          "Attr",
                          [
                            [
                              "Attr",
                              [
                                [ "Id", "self" ], [ "A_string", "triggers" ]
                              ]
                            ],
                            [ "A_string", "output_dir" ]
                          ]
                        ],
                        "strip_before": false,
                        "strip_after": false
                      }
                    ],
                    [ "Literal", " && rm -f " ],
                    [
                      "Interpolation",
                      {
                        "expr": [
                          "Attr",
                          [
                            [
                              "Attr",
                              [
                                [ "Id", "self" ], [ "A_string", "triggers" ]
                              ]
                            ],
                            [ "A_string", "template_dir_files" ]
                          ]
                        ],
                        "strip_before": false,
                        "strip_after": false
                      }
                    ]
                  ]
                ]
              ]
            ]
          }
        ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "resource",
      "labels": [ [ "Lit", "null_resource" ], [ "Lit", "copy_compliance" ] ],
      "body": [
        [
          "Attribute",
          "triggers",
          [
            "Object",
            [
              [
                [ "Bare", "output_dir" ],
                [ "Attr", [ [ "Id", "var" ], [ "A_string", "output_dir" ] ] ]
              ],
              [
                [ "Bare", "template_dir_files" ],
                [
                  "Fun_call",
                  [
                    "join",
                    [
                      [ "String", " " ],
                      [
                        "Fun_call",
                        [
                          "fileset",
                          [
                            [
                              "Attr",
                              [
                                [ "Id", "local" ],
                                [ "A_string", "compliance_dir" ]
                              ]
                            ],
                            [ "String", "**/*" ]
                          ]
                        ]
                      ]
                    ]
                  ]
                ]
              ]
            ]
          ]
        ],
        [
          "Block",
          {
            "type_": "provisioner",
            "labels": [ [ "Lit", "local-exec" ] ],
            "body": [
              [ "Attribute", "when", [ "Id", "create" ] ],
              [
                "Attribute",
                "command",
                [
                  "Template",
                  [
                    [ "Literal", "mkdir -p " ],
                    [
                      "Interpolation",
                      {
                        "expr": [
                          "Attr",
                          [ [ "Id", "var" ], [ "A_string", "output_dir" ] ]
                        ],
                        "strip_before": false,
                        "strip_after": false
                      }
                    ],
                    [ "Literal", "/docs/compliance && cp -a -R -L " ],
                    [
                      "Interpolation",
                      {
                        "expr": [
                          "Attr",
                          [
                            [ "Id", "local" ],
                            [ "A_string", "compliance_dir" ]
