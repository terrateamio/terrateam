[
  [
    "Block",
    {
      "type_": "locals",
      "labels": [],
      "body": [
        [
          "Attribute",
          "terragrunt_modules",
          [
            "Fun_call",
            [
              "toset",
              [
                [
                  "For_tuple",
                  {
                    "identifiers": [ "x", [] ],
                    "input": [
                      "Fun_call",
                      [
                        "fileset",
                        [
                          [
                            "Attr",
                            [
                              [ "Id", "var" ],
                              [ "A_string", "foundation_dir" ]
                            ]
                          ],
                          [ "String", "**/terragrunt.hcl" ]
                        ]
                      ]
                    ],
                    "output": [
                      "Fun_call",
                      [
                        "trimsuffix",
                        [ [ "Id", "x" ], [ "String", "/terragrunt.hcl" ] ]
                      ]
                    ],
                    "cond": [
                      "Log_and",
                      [
                        [
                          "Not",
                          [
                            "Fun_call",
                            [
                              "strcontains",
                              [
                                [ "Id", "x" ],
                                [ "String", ".terragrunt-cache" ]
                              ]
                            ]
                          ]
                        ],
                        [
                          "Not",
                          [
                            "Fun_call",
                            [
                              "strcontains",
                              [ [ "Id", "x" ], [ "String", "/tenants/" ] ]
                            ]
                          ]
                        ]
                      ]
                    ]
                  }
                ]
              ]
            ]
          ]
        ],
        [
          "Attribute",
          "terragrunt_to_kit_modules",
          [
            "For_object",
            {
              "identifiers": [ "key", [] ],
              "input": [
                "Attr",
                [ [ "Id", "local" ], [ "A_string", "terragrunt_modules" ] ]
              ],
              "key_output": [ "Id", "key" ],
              "value_output": [
                "Cond",
                {
                  "if_": [
                    "Fun_call",
                    [
                      "startswith",
                      [ [ "Id", "key" ], [ "String", "platforms/" ] ]
                    ]
                  ],
                  "then_": [
                    "Fun_call",
                    [
                      "trimprefix",
                      [ [ "Id", "key" ], [ "String", "platforms/" ] ]
                    ]
                  ],
                  "else_": [
                    "Template",
                    [
                      [ "Literal", "foundation/" ],
                      [
                        "Interpolation",
                        {
                          "expr": [ "Id", "key" ],
                          "strip_before": false,
                          "strip_after": false
                        }
                      ]
                    ]
                  ]
                }
              ],
              "cond": null
            }
          ]
        ],
        [
          "Attribute",
          "platform_modules_azure",
          [
            "Fun_call",
            [
              "toset",
              [
                [
                  "For_tuple",
                  {
                    "identifiers": [ "x", [] ],
                    "input": [
                      "Attr",
                      [
                        [ "Id", "local" ],
                        [ "A_string", "terragrunt_modules" ]
                      ]
                    ],
                    "output": [ "Id", "x" ],
                    "cond": [
                      "Fun_call",
                      [
                        "startswith",
                        [ [ "Id", "x" ], [ "String", "platforms/azure" ] ]
                      ]
                    ]
                  }
                ]
              ]
            ]
          ]
        ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "data",
      "labels": [
        [ "Lit", "terraform_remote_state" ], [ "Lit", "docs_azure" ]
      ],
      "body": [
        [
          "Attribute",
          "for_each",
          [
            "Attr",
            [ [ "Id", "local" ], [ "A_string", "platform_modules_azure" ] ]
          ]
        ],
        [ "Attribute", "backend", [ "String", "azurerm" ] ],
        [
          "Attribute",
          "config",
          [
            "Object",
            [
              [ [ "Bare", "use_azuread_auth" ], [ "Bool", true ] ],
              [
                [ "Bare", "tenant_id" ],
                [
                  "Attr",
                  [
                    [
                      "Attr",
                      [
                        [
                          "Attr",
                          [ [ "Id", "var" ], [ "A_string", "platforms" ] ]
                        ],
                        [ "A_string", "azure" ]
                      ]
                    ],
                    [ "A_string", "aad_tenant_id" ]
                  ]
                ]
              ],
              [
                [ "Bare", "subscription_id" ],
                [
                  "Attr",
                  [
                    [
                      "Attr",
                      [
                        [
                          "Attr",
                          [ [ "Id", "var" ], [ "A_string", "platforms" ] ]
                        ],
                        [ "A_string", "azure" ]
                      ]
                    ],
                    [ "A_string", "subscription_id" ]
                  ]
                ]
              ],
              [
                [ "Bare", "resource_group_name" ],
                [
                  "Attr",
                  [
                    [
                      "Attr",
                      [
                        [
                          "Attr",
                          [
                            [
                              "Attr",
                              [
                                [ "Id", "var" ], [ "A_string", "platforms" ]
                              ]
                            ],
                            [ "A_string", "azure" ]
                          ]
                        ],
                        [ "A_string", "tfstateconfig" ]
                      ]
                    ],
                    [ "A_string", "resource_group_name" ]
                  ]
                ]
              ],
              [
                [ "Bare", "storage_account_name" ],
                [
                  "Attr",
                  [
                    [
                      "Attr",
                      [
                        [
                          "Attr",
                          [
                            [
                              "Attr",
                              [
                                [ "Id", "var" ], [ "A_string", "platforms" ]
                              ]
                            ],
                            [ "A_string", "azure" ]
                          ]
                        ],
                        [ "A_string", "tfstateconfig" ]
                      ]
                    ],
                    [ "A_string", "storage_account_name" ]
                  ]
                ]
              ],
              [
                [ "Bare", "container_name" ],
                [
                  "Attr",
                  [
                    [
                      "Attr",
                      [
                        [
                          "Attr",
                          [
                            [
                              "Attr",
                              [
                                [ "Id", "var" ], [ "A_string", "platforms" ]
                              ]
                            ],
                            [ "A_string", "azure" ]
                          ]
                        ],
                        [ "A_string", "tfstateconfig" ]
                      ]
                    ],
                    [ "A_string", "container_name" ]
                  ]
                ]
              ],
              [
                [ "Bare", "key" ],
                [
                  "Template",
                  [
                    [
                      "Interpolation",
                      {
                        "expr": [
                          "Fun_call",
                          [
                            "trimprefix",
                            [
                              [
                                "Attr",
                                [ [ "Id", "each" ], [ "A_string", "key" ] ]
                              ],
                              [ "String", "platforms/azure/" ]
                            ]
                          ]
                        ],
                        "strip_before": false,
                        "strip_after": false
                      }
                    ],
                    [ "Literal", ".tfstate" ]
                  ]
                ]
              ]
            ]
          ]
        ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "locals",
      "labels": [],
      "body": [
