[
  [
    "Block",
    {
      "type_": "resource",
      "labels": [ [ "Lit", "aws_instance" ], [ "Lit", "Mouse" ] ],
      "body": [
        [
          "Attribute",
          "count",
          [ "Attr", [ [ "Id", "var" ], [ "A_string", "instance_count" ] ] ]
        ],
        [
          "Attribute",
          "placement_group",
          [
            "Template",
            [
              [
                "Interpolation",
                {
                  "expr": [
                    "Attr",
                    [ [ "Id", "var" ], [ "A_string", "placement_group" ] ]
                  ],
                  "strip_before": false,
                  "strip_after": false
                }
              ]
            ]
          ]
        ],
        [
          "Attribute",
          "ami",
          [
            "Template",
            [
              [
                "Interpolation",
                {
                  "expr": [
                    "Attr", [ [ "Id", "var" ], [ "A_string", "ami" ] ]
                  ],
                  "strip_before": false,
                  "strip_after": false
                }
              ]
            ]
          ]
        ],
        [
          "Attribute",
          "instance_type",
          [
            "Template",
            [
              [
                "Interpolation",
                {
                  "expr": [
                    "Attr",
                    [ [ "Id", "var" ], [ "A_string", "instance_type" ] ]
                  ],
                  "strip_before": false,
                  "strip_after": false
                }
              ]
            ]
          ]
        ],
        [
          "Attribute",
          "security_groups",
          [
            "Tuple",
            [
              [
                "Template",
                [
                  [
                    "Interpolation",
                    {
                      "expr": [
                        "Attr",
                        [
                          [
                            "Attr",
                            [
                              [ "Id", "aws_security_group" ],
                              [ "A_string", "allow_ssh_and_http" ]
                            ]
                          ],
                          [ "A_string", "name" ]
                        ]
                      ],
                      "strip_before": false,
                      "strip_after": false
                    }
                  ]
                ]
              ]
            ]
          ]
        ],
        [
          "Attribute",
          "tags",
          [
            "Object",
            [
              [
                [ "Bare", "Name" ],
                [
                  "Template",
                  [
                    [
                      "Interpolation",
                      {
                        "expr": [
                          "Attr",
                          [
                            [ "Id", "var" ], [ "A_string", "instance_name" ]
                          ]
                        ],
                        "strip_before": false,
                        "strip_after": false
                      }
                    ],
                    [ "Literal", "-" ],
                    [
                      "Interpolation",
                      {
                        "expr": [
                          "Add",
                          [
                            [
                              "Attr",
                              [ [ "Id", "count" ], [ "A_string", "index" ] ]
                            ],
                            [ "Int", 1 ]
                          ]
                        ],
                        "strip_before": false,
                        "strip_after": false
                      }
                    ]
                  ]
                ]
              ]
            ]
          ]
        ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "resource",
      "labels": [
        [ "Lit", "aws_security_group" ], [ "Lit", "allow_ssh_and_http" ]
      ],
      "body": [
        [ "Attribute", "name", [ "String", "my_ssh_http" ] ],
        [
          "Attribute",
          "vpc_id",
          [ "Attr", [ [ "Id", "var" ], [ "A_string", "vpc_id" ] ] ]
        ],
        [
          "Block",
          {
            "type_": "ingress",
            "labels": [],
            "body": [
              [ "Attribute", "protocol", [ "String", "tcp" ] ],
              [ "Attribute", "self", [ "Bool", true ] ],
              [ "Attribute", "from_port", [ "Int", 22 ] ],
              [ "Attribute", "to_port", [ "Int", 22 ] ],
              [
                "Attribute",
                "cidr_blocks",
                [ "Tuple", [ [ "String", "0.0.0.0/0" ] ] ]
              ]
            ]
          }
        ],
        [
          "Block",
          {
            "type_": "ingress",
            "labels": [],
            "body": [
              [ "Attribute", "protocol", [ "String", "tcp" ] ],
              [ "Attribute", "from_port", [ "Int", 80 ] ],
              [ "Attribute", "to_port", [ "Int", 80 ] ],
              [
                "Attribute",
                "cidr_blocks",
                [ "Tuple", [ [ "String", "0.0.0.0/0" ] ] ]
              ]
            ]
          }
        ],
        [
          "Block",
          {
            "type_": "egress",
            "labels": [],
            "body": [
              [ "Attribute", "from_port", [ "Int", 0 ] ],
              [ "Attribute", "to_port", [ "Int", 0 ] ],
              [ "Attribute", "protocol", [ "String", "-1" ] ],
              [
                "Attribute",
                "cidr_blocks",
                [ "Tuple", [ [ "String", "0.0.0.0/0" ] ] ]
              ]
            ]
          }
        ],
        [
          "Attribute",
          "tags",
          [
            "Object",
            [
              [ [ "Bare", "Name" ], [ "String", "allow ssh and http only" ] ]
            ]
          ]
        ]
      ]
    }
  ]
]
