              "input": [
                "Attr",
                [ [ "Id", "var" ], [ "A_string", "fluent_bit_forwarders" ] ]
              ],
              "key_output": [ "Id", "forwarder_name" ],
              "value_output": [
                "Cond",
                {
                  "if_": [
                    "Equal",
                    [
                      [
                        "Attr",
                        [
                          [ "Id", "forwarder_config" ], [ "A_string", "os" ]
                        ]
                      ],
                      [ "String", "windows" ]
                    ]
                  ],
                  "then_": [
                    "Attr",
                    [
                      [
                        "Idx",
                        [
                          [
                            "Attr",
                            [
                              [ "Id", "module" ],
                              [ "A_string", "windows_forwarder_package" ]
                            ]
                          ],
                          [ "Id", "forwarder_name" ]
                        ]
                      ],
                      [ "A_string", "ca_loadbalancer_cert" ]
                    ]
                  ],
                  "else_": [
                    "Attr",
                    [
                      [
                        "Idx",
                        [
                          [
                            "Attr",
                            [
                              [ "Id", "module" ],
                              [ "A_string", "linux_forwarder_package" ]
                            ]
                          ],
                          [ "Id", "forwarder_name" ]
                        ]
                      ],
                      [ "A_string", "ca_loadbalancer_cert" ]
                    ]
                  ]
                }
              ],
              "cond": null
            }
          ]
        ]
      ]
    }
  ]
]
