[
  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "region" ] ],
      "body": [
        [ "Attribute", "type", [ "Id", "string" ] ],
        [ "Attribute", "description", [ "String", "AWS region" ] ],
        [
          "Block",
          {
            "type_": "validation",
            "labels": [],
            "body": [
              [
                "Attribute",
                "condition",
                [
                  "Fun_call",
                  [
                    "can",
                    [
                      [
                        "Fun_call",
                        [
                          "regex",
                          [
                            [ "String", "^[a-z]{2}(-[a-z]+)+-\\d+$" ],
                            [
                              "Attr",
                              [ [ "Id", "var" ], [ "A_string", "region" ] ]
                            ]
                          ]
                        ]
                      ]
                    ]
                  ]
                ]
              ],
              [
                "Attribute",
                "error_message",
                [
                  "String",
                  "The region must be a valid AWS region name (e.g., us-east-1, eu-west-1)."
                ]
              ]
            ]
          }
        ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "assume_role_arn" ] ],
      "body": [
        [ "Attribute", "type", [ "Id", "string" ] ],
        [
          "Attribute",
          "description",
          [ "String", "ARN of the IAM role to assume" ]
