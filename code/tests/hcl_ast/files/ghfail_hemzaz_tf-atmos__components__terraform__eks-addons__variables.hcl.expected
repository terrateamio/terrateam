                      ]
                    ],
                    [
                      "Fun_call",
                      [
                        "can",
                        [
                          [
                            "Fun_call",
                            [
                              "regex",
                              [
                                [
                                  "String",
                                  "^arn:aws:iam::[0-9]{12}:role/.+$"
                                ],
                                [
                                  "Attr",
                                  [
                                    [ "Id", "var" ],
                                    [ "A_string", "assume_role_arn" ]
                                  ]
                                ]
                              ]
                            ]
                          ]
                        ]
                      ]
                    ]
                  ]
                ]
              ],
              [
                "Attribute",
                "error_message",
                [
                  "String",
                  "The assume_role_arn must be a valid IAM role ARN or null."
                ]
              ]
            ]
          }
        ]
      ]
    }
  ],
