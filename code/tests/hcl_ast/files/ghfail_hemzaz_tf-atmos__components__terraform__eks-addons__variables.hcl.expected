  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "domain_name" ] ],
      "body": [
        [ "Attribute", "type", [ "Id", "string" ] ],
        [
          "Attribute",
          "description",
          [
            "String",
            "Domain name for certificates and DNS records - DEPRECATED, use clusters[*].cert_manager_config instead"
          ]
        ],
        [ "Attribute", "default", [ "String", "example.com" ] ],
        [
          "Block",
          {
            "type_": "validation",
            "labels": [],
            "body": [
              [
                "Attribute",
                "condition",
                [
