[
  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "resource_group_id" ] ],
      "body": [
        [
          "Attribute",
          "description",
          [
            "String",
            "ID of resource group to create VSI and block storage volumes. If you wish to create the block storage volumes in a different resource group, you can optionally set that directly in the 'block_storage_volumes' variable."
          ]
        ],
        [ "Attribute", "type", [ "Id", "string" ] ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "prefix" ] ],
      "body": [
        [
          "Attribute",
          "description",
          [
            "String",
            "The prefix to add to all resources created by this module."
          ]
        ],
        [ "Attribute", "type", [ "Id", "string" ] ],
        [
          "Block",
          {
            "type_": "validation",
            "labels": [],
            "body": [
              [
                "Attribute",
                "error_message",
                [
                  "String",
                  "Prefix must begin and end with a letter and contain only letters, numbers, and - characters."
                ]
              ],
              [
                "Attribute",
                "condition",
                [
                  "Fun_call",
                  [
                    "can",
                    [
                      [
                        "Fun_call",
                        [
                          "regex",
                          [
                            [ "String", "^([A-z]|[a-z][-a-z0-9]*[a-z0-9])$" ],
                            [
                              "Attr",
                              [ [ "Id", "var" ], [ "A_string", "prefix" ] ]
                            ]
                          ]
                        ]
                      ]
                    ]
                  ]
                ]
              ]
            ]
          }
        ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "tags" ] ],
      "body": [
        [
          "Attribute",
          "description",
          [
            "String",
            "List of tags to apply to resources created by this module."
          ]
        ],
        [
          "Attribute",
          "type",
          [ "Fun_call", [ "list", [ [ "Id", "string" ] ] ] ]
        ],
        [ "Attribute", "default", [ "Tuple", [] ] ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "access_tags" ] ],
      "body": [
        [
          "Attribute",
          "type",
          [ "Fun_call", [ "list", [ [ "Id", "string" ] ] ] ]
        ],
        [
          "Attribute",
          "description",
          [
            "String",
            "A list of access tags to apply to the VSI resources created by the module. For more information, see https://cloud.ibm.com/docs/account?topic=account-access-tags-tutorial."
          ]
        ],
        [ "Attribute", "default", [ "Tuple", [] ] ],
        [
          "Block",
          {
            "type_": "validation",
            "labels": [],
            "body": [
              [
                "Attribute",
                "condition",
                [
                  "Fun_call",
                  [
                    "alltrue",
                    [
                      [
                        "For_tuple",
                        {
                          "identifiers": [ "tag", [] ],
                          "input": [
                            "Attr",
                            [
                              [ "Id", "var" ], [ "A_string", "access_tags" ]
                            ]
                          ],
                          "output": [
                            "Log_and",
                            [
                              [
                                "Fun_call",
                                [
                                  "can",
                                  [
                                    [
                                      "Fun_call",
                                      [
                                        "regex",
                                        [
                                          [
                                            "String",
                                            "[\\w\\-_\\.]+:[\\w\\-_\\.]+"
                                          ],
                                          [ "Id", "tag" ]
                                        ]
                                      ]
                                    ]
                                  ]
                                ]
                              ],
                              [
                                "Lte",
                                [
                                  [
                                    "Fun_call",
                                    [ "length", [ [ "Id", "tag" ] ] ]
                                  ],
                                  [ "Int", 128 ]
                                ]
                              ]
                            ]
                          ],
                          "cond": null
                        }
                      ]
                    ]
                  ]
                ]
              ],
              [
                "Attribute",
                "error_message",
                [
                  "String",
                  "Tags must match the regular expression \"[\\w\\-_\\.]+:[\\w\\-_\\.]+\". For more information, see https://cloud.ibm.com/docs/account?topic=account-tag&interface=ui#limits."
                ]
              ]
            ]
          }
        ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "vpc_id" ] ],
      "body": [
        [ "Attribute", "description", [ "String", "ID of VPC" ] ],
        [ "Attribute", "type", [ "Id", "string" ] ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "subnets" ] ],
      "body": [
        [
          "Attribute",
          "description",
          [ "String", "A list of subnet IDs where VSI will be deployed" ]
        ],
        [
          "Attribute",
          "type",
          [
            "Fun_call",
            [
              "list",
              [
                [
                  "Fun_call",
                  [
                    "object",
                    [
                      [
                        "Object",
                        [
                          [ [ "Bare", "name" ], [ "Id", "string" ] ],
                          [ [ "Bare", "id" ], [ "Id", "string" ] ],
                          [ [ "Bare", "zone" ], [ "Id", "string" ] ],
                          [
                            [ "Bare", "cidr" ],
                            [
                              "Fun_call",
                              [ "optional", [ [ "Id", "string" ] ] ]
                            ]
                          ]
                        ]
                      ]
                    ]
                  ]
                ]
              ]
            ]
          ]
        ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "image_id" ] ],
      "body": [
        [
          "Attribute",
          "description",
          [
            "String",
            "Image ID used for VSI. Run 'ibmcloud is images' to find available images in a region. Required if not passing a value for `catalog_offering`."
          ]
        ],
        [ "Attribute", "type", [ "Id", "string" ] ],
        [ "Attribute", "default", [ "Null" ] ],
        [
          "Block",
          {
            "type_": "validation",
            "labels": [],
            "body": [
              [
                "Attribute",
                "condition",
                [
                  "Equal",
                  [
                    [
                      "Log_and",
                      [
                        [
                          "Not_equal",
                          [
                            [
                              "Attr",
                              [ [ "Id", "var" ], [ "A_string", "image_id" ] ]
                            ],
                            [ "Null" ]
                          ]
                        ],
                        [
                          "Not_equal",
                          [
                            [
                              "Attr",
                              [
                                [ "Id", "var" ],
                                [ "A_string", "catalog_offering" ]
                              ]
                            ],
                            [ "Null" ]
                          ]
                        ]
                      ]
                    ],
                    [ "Bool", false ]
                  ]
                ]
              ],
              [
                "Attribute",
                "error_message",
                [
                  "String",
                  "image_id and catalog_offering are mutually exclusive, you can only use one of these options to specify an image, you must set one of these to `null`."
                ]
              ]
            ]
          }
        ],
        [
          "Block",
          {
            "type_": "validation",
            "labels": [],
            "body": [
              [
                "Attribute",
                "condition",
                [
                  "Cond",
                  {
                    "if_": [
                      "Not_equal",
                      [
                        [
                          "Attr",
                          [
                            [ "Id", "var" ],
                            [ "A_string", "boot_volume_snapshot_crn" ]
                          ]
                        ],
                        [ "Null" ]
                      ]
                    ],
                    "then_": [ "Bool", true ],
                    "else_": [
                      "Equal",
                      [
                        [
                          "Log_and",
                          [
                            [
                              "Equal",
                              [
                                [
                                  "Attr",
                                  [
                                    [ "Id", "var" ],
                                    [ "A_string", "image_id" ]
                                  ]
                                ],
                                [ "Null" ]
                              ]
                            ],
                            [
                              "Equal",
                              [
                                [
                                  "Attr",
                                  [
                                    [ "Id", "var" ],
                                    [ "A_string", "catalog_offering" ]
                                  ]
                                ],
                                [ "Null" ]
                              ]
                            ]
                          ]
                        ],
                        [ "Bool", false ]
                      ]
                    ]
                  }
                ]
              ],
              [
                "Attribute",
                "error_message",
                [
                  "String",
                  "You must specify one (and only one) of either `image_id`, `catalog_offering`, or `boot_volume_snapshot_crn` for your virtual server OS image."
                ]
              ]
            ]
          }
        ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "catalog_offering" ] ],
      "body": [
        [
          "Attribute",
          "description",
          [
            "String",
            "The catalog offering or offering version to use when provisioning this virtual server instance. If an offering is specified, the latest version of that offering will be used."
          ]
        ],
        [
          "Attribute",
          "type",
          [
            "Fun_call",
            [
              "object",
              [
                [
                  "Object",
                  [
                    [
                      [ "Bare", "offering_crn" ],
                      [ "Fun_call", [ "optional", [ [ "Id", "string" ] ] ] ]
                    ],
                    [
                      [ "Bare", "version_crn" ],
                      [ "Fun_call", [ "optional", [ [ "Id", "string" ] ] ] ]
                    ],
                    [
                      [ "Bare", "plan_crn" ],
                      [ "Fun_call", [ "optional", [ [ "Id", "string" ] ] ] ]
                    ]
                  ]
                ]
              ]
            ]
          ]
        ],
        [ "Attribute", "default", [ "Null" ] ],
        [
          "Block",
          {
            "type_": "validation",
            "labels": [],
            "body": [
              [
                "Attribute",
                "condition",
                [
                  "Cond",
                  {
                    "if_": [
                      "Not_equal",
                      [
                        [
                          "Attr",
                          [
                            [ "Id", "var" ],
                            [ "A_string", "catalog_offering" ]
                          ]
                        ],
                        [ "Null" ]
                      ]
                    ],
                    "then_": [
                      "Equal",
                      [
                        [
                          "Log_and",
                          [
                            [
                              "Equal",
                              [
                                [
                                  "Attr",
                                  [
                                    [
                                      "Attr",
                                      [
                                        [ "Id", "var" ],
                                        [ "A_string", "catalog_offering" ]
                                      ]
                                    ],
                                    [ "A_string", "offering_crn" ]
                                  ]
                                ],
                                [ "Null" ]
                              ]
                            ],
                            [
                              "Equal",
                              [
                                [
                                  "Attr",
                                  [
                                    [
                                      "Attr",
                                      [
                                        [ "Id", "var" ],
                                        [ "A_string", "catalog_offering" ]
                                      ]
                                    ],
                                    [ "A_string", "version_crn" ]
                                  ]
                                ],
                                [ "Null" ]
                              ]
                            ]
                          ]
                        ],
                        [ "Bool", false ]
                      ]
                    ],
                    "else_": [ "Bool", true ]
                  }
                ]
              ],
              [
                "Attribute",
                "error_message",
                [
                  "String",
                  "Must supply either an `offering_crn` or `version_crn` for a catalog_offering."
                ]
              ]
            ]
          }
        ],
        [
          "Block",
          {
            "type_": "validation",
            "labels": [],
            "body": [
              [
                "Attribute",
                "condition",
                [
                  "Cond",
                  {
                    "if_": [
                      "Not_equal",
                      [
                        [
                          "Attr",
                          [
                            [ "Id", "var" ],
                            [ "A_string", "catalog_offering" ]
                          ]
                        ],
                        [ "Null" ]
                      ]
                    ],
                    "then_": [
                      "Equal",
                      [
                        [
                          "Log_and",
                          [
                            [
                              "Not_equal",
                              [
                                [
                                  "Attr",
                                  [
                                    [
                                      "Attr",
                                      [
                                        [ "Id", "var" ],
                                        [ "A_string", "catalog_offering" ]
                                      ]
                                    ],
                                    [ "A_string", "offering_crn" ]
                                  ]
                                ],
                                [ "Null" ]
                              ]
                            ],
                            [
                              "Not_equal",
                              [
                                [
                                  "Attr",
                                  [
                                    [
                                      "Attr",
                                      [
                                        [ "Id", "var" ],
                                        [ "A_string", "catalog_offering" ]
                                      ]
                                    ],
                                    [ "A_string", "version_crn" ]
                                  ]
                                ],
                                [ "Null" ]
                              ]
                            ]
                          ]
                        ],
                        [ "Bool", false ]
                      ]
                    ],
                    "else_": [ "Bool", true ]
                  }
                ]
              ],
              [
                "Attribute",
                "error_message",
                [
                  "String",
                  "`catalog_offering.offering_crn` and `catalog_offering.version_crn` of a catalog_offering are mutually exclusive. You must supply only one of these two values."
                ]
              ]
            ]
          }
        ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "ssh_key_ids" ] ],
      "body": [
        [
          "Attribute",
          "description",
          [ "String", "ssh key ids to use in creating vsi" ]
        ],
        [
          "Attribute",
          "type",
          [ "Fun_call", [ "list", [ [ "Id", "string" ] ] ] ]
        ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "machine_type" ] ],
      "body": [
        [
          "Attribute",
          "description",
          [
            "String",
            "VSI machine type. Run 'ibmcloud is instance-profiles' to get a list of regional profiles"
          ]
        ],
        [ "Attribute", "type", [ "Id", "string" ] ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "vsi_per_subnet" ] ],
      "body": [
        [
          "Attribute",
          "description",
          [ "String", "Number of VSI instances for each subnet" ]
        ],
        [ "Attribute", "type", [ "Id", "number" ] ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "user_data" ] ],
      "body": [
        [
          "Attribute",
          "description",
          [ "String", "User data to initialize VSI deployment" ]
        ],
        [ "Attribute", "type", [ "Id", "string" ] ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "use_boot_volume_key_as_default" ] ],
      "body": [
        [
          "Attribute",
          "description",
          [
            "String",
            "Set to true to use the key specified in the `boot_volume_encryption_key` input as default for all volumes, overriding any key value that may be specified in the `encryption_key` option of the `block_storage_volumes` input variable. If set to `false`,  the value passed for the `encryption_key` option of the `block_storage_volumes` will be used instead."
          ]
        ],
        [ "Attribute", "type", [ "Id", "bool" ] ],
        [ "Attribute", "default", [ "Bool", false ] ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "boot_volume_encryption_key" ] ],
      "body": [
        [
          "Attribute",
          "description",
          [ "String", "CRN of boot volume encryption key" ]
        ],
        [ "Attribute", "default", [ "Null" ] ],
        [ "Attribute", "type", [ "Id", "string" ] ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "boot_volume_size" ] ],
      "body": [
        [
          "Attribute",
          "description",
          [
            "String",
            "The capacity of the volume in gigabytes. This defaults to minimum capacity of the image and maximum to 250 GB"
          ]
        ],
        [ "Attribute", "default", [ "Null" ] ],
        [ "Attribute", "type", [ "Id", "number" ] ],
        [
          "Block",
          {
            "type_": "validation",
            "labels": [],
            "body": [
              [
                "Attribute",
                "condition",
                [
                  "Cond",
                  {
                    "if_": [
                      "Not_equal",
                      [
                        [
                          "Attr",
                          [
                            [ "Id", "var" ],
                            [ "A_string", "boot_volume_size" ]
                          ]
                        ],
                        [ "Null" ]
                      ]
                    ],
                    "then_": [
                      "Log_and",
                      [
                        [
                          "Gte",
                          [
                            [
                              "Attr",
                              [
                                [ "Id", "var" ],
                                [ "A_string", "boot_volume_size" ]
                              ]
                            ],
                            [ "Int", 100 ]
                          ]
                        ],
                        [
                          "Lte",
                          [
                            [
                              "Attr",
                              [
                                [ "Id", "var" ],
                                [ "A_string", "boot_volume_size" ]
                              ]
                            ],
                            [ "Int", 250 ]
                          ]
                        ]
                      ]
                    ],
                    "else_": [ "Bool", true ]
                  }
                ]
              ],
              [
                "Attribute",
                "error_message",
                [
                  "String",
                  "Boot Volume size must be a number between 100 and 250"
                ]
              ]
            ]
          }
        ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "boot_volume_profile" ] ],
      "body": [
        [
          "Attribute",
          "description",
          [
            "String",
            "The Block Volume Storage Profile to use for the boot volume of the virtual instance, defaults to `general-purpose`."
          ]
        ],
        [ "Attribute", "type", [ "Id", "string" ] ],
        [ "Attribute", "default", [ "Null" ] ],
        [
          "Block",
          {
            "type_": "validation",
            "labels": [],
            "body": [
              [
                "Attribute",
                "condition",
                [
                  "Cond",
                  {
                    "if_": [
                      "Not_equal",
                      [
                        [
                          "Attr",
                          [
                            [ "Id", "var" ],
                            [ "A_string", "boot_volume_profile" ]
                          ]
                        ],
                        [ "Null" ]
                      ]
                    ],
                    "then_": [
                      "Fun_call",
                      [
                        "contains",
                        [
                          [
                            "Tuple",
                            [
                              [ "String", "general-purpose" ],
                              [ "String", "sdp" ]
                            ]
                          ],
                          [
                            "Attr",
                            [
                              [ "Id", "var" ],
                              [ "A_string", "boot_volume_profile" ]
                            ]
                          ]
                        ]
                      ]
                    ],
                    "else_": [ "Bool", true ]
                  }
                ]
              ],
              [
                "Attribute",
                "error_message",
                [
                  "String",
                  "Boot Volume Profile must be `general-purpose` or `sdp`"
                ]
              ]
            ]
          }
        ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "boot_volume_iops" ] ],
      "body": [
        [
          "Attribute",
          "description",
          [
            "String",
            "NOTE: custom IOPS value only available for `sdp` volume profile! The custom IOPS value, in GB/s, for the `sdp` boot storage profile."
          ]
        ],
        [ "Attribute", "type", [ "Id", "number" ] ],
        [ "Attribute", "default", [ "Null" ] ],
        [
          "Block",
          {
            "type_": "validation",
            "labels": [],
            "body": [
              [
                "Attribute",
                "condition",
                [
                  "Cond",
                  {
                    "if_": [
                      "Not_equal",
                      [
                        [
                          "Attr",
                          [
                            [ "Id", "var" ],
                            [ "A_string", "boot_volume_iops" ]
                          ]
                        ],
                        [ "Null" ]
                      ]
                    ],
                    "then_": [
                      "Equal",
                      [
                        [
                          "Attr",
                          [
                            [ "Id", "var" ],
                            [ "A_string", "boot_volume_profile" ]
                          ]
                        ],
                        [ "String", "sdp" ]
                      ]
                    ],
                    "else_": [ "Bool", true ]
                  }
                ]
              ],
              [
                "Attribute",
                "error_message",
                [
                  "String",
                  "Boot Volume IOPS can only be specified for `boot_volume_profile = sdp`."
                ]
              ]
            ]
          }
        ],
        [
          "Block",
          {
            "type_": "validation",
            "labels": [],
            "body": [
              [
                "Attribute",
                "condition",
                [
                  "Cond",
                  {
                    "if_": [
                      "Not_equal",
                      [
                        [
                          "Attr",
                          [
                            [ "Id", "var" ],
                            [ "A_string", "boot_volume_iops" ]
                          ]
                        ],
                        [ "Null" ]
                      ]
                    ],
                    "then_": [
                      "Log_and",
                      [
                        [
                          "Gte",
                          [
                            [
                              "Attr",
                              [
                                [ "Id", "var" ],
                                [ "A_string", "boot_volume_iops" ]
                              ]
                            ],
                            [ "Int", 100 ]
                          ]
                        ],
                        [
                          "Lte",
                          [
                            [
                              "Attr",
                              [
                                [ "Id", "var" ],
                                [ "A_string", "boot_volume_iops" ]
                              ]
                            ],
                            [ "Int", 64000 ]
                          ]
                        ]
                      ]
                    ],
                    "else_": [ "Bool", true ]
                  }
                ]
              ],
              [
                "Attribute",
                "error_message",
                [
                  "String",
                  "Boot Volume IOPS for sdp profile must be between 100 and 64,000"
                ]
              ]
            ]
          }
        ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "manage_reserved_ips" ] ],
      "body": [
        [
          "Attribute",
          "description",
          [
            "String",
            "Set to `true` if you want this terraform module to manage the reserved IP addresses that are assigned to VSI instances. If this option is enabled, when any VSI is recreated it should retain its original IP."
          ]
        ],
        [ "Attribute", "type", [ "Id", "bool" ] ],
        [ "Attribute", "default", [ "Bool", false ] ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "primary_vni_additional_ip_count" ] ],
      "body": [
        [
          "Attribute",
          "description",
          [
            "String",
            "The number of secondary reversed IPs to attach to a Virtual Network Interface (VNI). Additional IPs are created only if `manage_reserved_ips` is set to true."
          ]
        ],
        [ "Attribute", "type", [ "Id", "number" ] ],
        [ "Attribute", "nullable", [ "Bool", false ] ],
        [ "Attribute", "default", [ "Int", 0 ] ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "use_static_boot_volume_name" ] ],
      "body": [
        [
          "Attribute",
          "description",
          [
            "String",
            "Sets the boot volume name for each VSI to a static name in the format `{hostname}_boot`, instead of a random name. Set this to `true` to have a consistent boot volume name even when VSIs are recreated."
          ]
        ],
        [ "Attribute", "type", [ "Id", "bool" ] ],
        [ "Attribute", "default", [ "Bool", false ] ]
      ]
    }
