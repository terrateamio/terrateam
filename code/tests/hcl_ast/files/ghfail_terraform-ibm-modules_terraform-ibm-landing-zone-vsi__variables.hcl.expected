      "body": [
        [ "Attribute", "type", [ "Id", "bool" ] ],
        [ "Attribute", "default", [ "Bool", false ] ],
        [
          "Attribute",
          "description",
          [
            "String",
            "Set to true to install the IBM Cloud Monitoring agent on the provisioned VSI to gather both metrics and security and compliance data. If set to true, values must be passed for `monitoring_access_key`, `monitoring_collector_endpoint` and `monitoring_collector_port`. Installation logs can be found on the VSI in /run/logging-agent/logs-agent-install.log"
          ]
        ],
        [
          "Block",
          {
            "type_": "validation",
            "labels": [],
            "body": [
              [
                "Attribute",
                "condition",
                [
                  "Cond",
                  {
                    "if_": [
                      "Attr",
                      [
                        [ "Id", "var" ],
                        [ "A_string", "install_monitoring_agent" ]
                      ]
                    ],
                    "then_": [
                      "Not_equal",
                      [
                        [
                          "Attr",
                          [ [ "Id", "var" ], [ "A_string", "image_id" ] ]
                        ],
                        [ "Null" ]
                      ]
                    ],
                    "else_": [ "Bool", true ]
                  }
                ]
              ],
              [
                "Attribute",
                "error_message",
                [
                  "String",
                  "When 'install_monitoring_agent' is true, a value for 'image_id' must be provided. Monitoring agent installations are not supported if provisioning using the 'catalog_offering' option."
                ]
              ]
            ]
          }
        ],
        [
          "Block",
          {
            "type_": "validation",
            "labels": [],
            "body": [
              [
                "Attribute",
                "condition",
                [
                  "Cond",
                  {
                    "if_": [
                      "Attr",
                      [
                        [ "Id", "var" ],
                        [ "A_string", "install_monitoring_agent" ]
                      ]
                    ],
                    "then_": [
                      "Not_equal",
                      [
                        [
                          "Attr",
                          [
                            [ "Id", "local" ],
                            [
                              "A_string",
                              "monitoring_kernel_header_install_cmd"
                            ]
                          ]
                        ],
                        [ "String", "" ]
                      ]
                    ],
                    "else_": [ "Bool", true ]
                  }
                ]
              ],
              [
                "Attribute",
                "error_message",
