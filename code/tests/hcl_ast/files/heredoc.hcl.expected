[
  [
    "Attribute",
    "normal",
    [
      "Object",
      [
        [
          [ "Bare", "basic" ], [ "Heredoc", [ "EOT", "\nFoo\nBar\nBaz\n" ] ]
        ],
        [
          [ "Bare", "indented" ],
          [ "Heredoc", [ "EOT", "\n    Foo\n    Bar\n    Baz\n" ] ]
        ],
        [
          [ "Bare", "indented_more" ],
          [ "Heredoc", [ "EOT", "\n    Foo\n      Bar\n    Baz\n" ] ]
        ],
        [
          [ "Bare", "interp" ],
          [
            "Template_heredoc",
            [
              "EOT",
              [
                [ "Literal", "\n    Foo\n    " ],
                [
                  "Interpolation",
                  {
                    "expr": [ "Id", "bar" ],
                    "strip_before": false,
                    "strip_after": false
                  }
                ],
                [ "Literal", "\n    Baz\n" ]
              ]
            ]
          ]
        ],
        [
          [ "Bare", "newlines_between" ],
          [ "Heredoc", [ "EOT", "\nFoo\n\nBar\n\nBaz\n" ] ]
        ],
        [
          [ "Bare", "indented_newlines_between" ],
          [ "Heredoc", [ "EOT", "\n    Foo\n\n    Bar\n\n    Baz\n" ] ]
        ],
        [
          [ "Bare", "marker_at_suffix" ],
          [ "Heredoc", [ "EOT", "\n    NOT EOT\n" ] ]
        ]
      ]
    ]
  ],
  [
    "Attribute",
    "flush",
    [
      "Object",
      [
        [
          [ "Bare", "basic" ], [ "Heredoc", [ "EOT", "\nFoo\nBar\nBaz\n" ] ]
