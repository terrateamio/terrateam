[
  [
    "Block",
    {
      "type_": "resource",
      "labels": [
        [ "Lit", "aws_secretsmanager_secret" ],
        [ "Lit", "server_database_url" ]
      ],
      "body": [
        [ "Attribute", "name", [ "String", "server-database-url" ] ],
        [ "Attribute", "recovery_window_in_days", [ "Int", 0 ] ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "resource",
      "labels": [
        [ "Lit", "aws_secretsmanager_secret_version" ],
        [ "Lit", "server_database_url" ]
      ],
      "body": [
        [
          "Attribute",
          "secret_id",
          [
            "Attr",
            [
              [
                "Attr",
                [
                  [ "Id", "aws_secretsmanager_secret" ],
                  [ "A_string", "server_database_url" ]
                ]
              ],
              [ "A_string", "id" ]
            ]
          ]
        ],
        [
          "Attribute",
          "secret_string",
          [
            "Template",
            [
              [ "Literal", "postgres://" ],
              [
                "Interpolation",
                {
                  "expr": [
                    "Attr",
                    [ [ "Id", "var" ], [ "A_string", "rds_server_db_user" ] ]
                  ],
                  "strip_before": false,
                  "strip_after": false
                }
              ],
              [ "Literal", ":" ],
              [
                "Interpolation",
                {
                  "expr": [
                    "Attr",
                    [
                      [ "Id", "var" ],
                      [ "A_string", "rds_server_db_password" ]
                    ]
                  ],
                  "strip_before": false,
                  "strip_after": false
                }
              ],
              [ "Literal", "@" ],
              [
                "Interpolation",
                {
                  "expr": [
                    "Attr",
                    [
                      [
                        "Attr",
                        [
                          [ "Id", "aws_rds_cluster" ],
                          [ "A_string", "covidportal_server" ]
                        ]
                      ],
                      [ "A_string", "endpoint" ]
                    ]
                  ],
                  "strip_before": false,
                  "strip_after": false
                }
              ],
              [ "Literal", ":5432/" ],
              [
                "Interpolation",
                {
                  "expr": [
                    "Attr",
                    [ [ "Id", "var" ], [ "A_string", "rds_server_db_name" ] ]
                  ],
                  "strip_before": false,
                  "strip_after": false
                }
              ]
            ]
          ]
        ]
      ]
    }
  ],
