                      [ [ "Id", "var" ], [ "A_string", "default_tags" ] ]
                    ],
                    [
                      "Object",
                      [
                        [ [ "Bare", "Name" ], [ "Id", "name" ] ],
                        [ [ "Bare", "Index" ], [ "Id", "idx" ] ]
                      ]
                    ]
                  ]
                ]
              ],
              "cond": null
            }
          ]
        ],
        [
          "Attribute",
          "enabled_instances",
          [
