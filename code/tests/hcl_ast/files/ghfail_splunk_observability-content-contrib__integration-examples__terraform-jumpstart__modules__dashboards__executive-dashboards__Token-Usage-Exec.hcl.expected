  [
    "Block",
    {
      "type_": "resource",
      "labels": [
        [ "Lit", "signalfx_list_chart" ], [ "Lit", "TOKEN-USAGE-EXEC_1" ]
      ],
      "body": [
        [ "Attribute", "color_by", [ "String", "Scale" ] ],
        [
          "Attribute",
          "description",
          [
            "String",
            "Token Usage Rate (MTS) 4 & 12 Week Comparisons Using  1 Day Sums"
          ]
        ],
        [ "Attribute", "disable_sampling", [ "Bool", false ] ],
        [ "Attribute", "hide_missing_values", [ "Bool", false ] ],
        [ "Attribute", "max_precision", [ "Int", 2 ] ],
        [
          "Attribute",
          "name",
          [ "String", "Token Usage Rate (MTS) (4 & 12 week comparisons)" ]
        ],
        [
          "Attribute",
          "program_text",
          [
            "Heredoc",
            [
              "EOF",
              "\nC = data('sf.org.numBundledMetricsByToken', rollup='sum').sum(over='1d').sum().publish(label='C')\nD = data('sf.org.numBundledMetricsByToken', rollup='sum').sum(over='1d').sum().timeshift('4w').publish(label='D', enable=False)\nE = data('sf.org.numBundledMetricsByToken', rollup='sum').sum(over='1d').sum().timeshift('12w').publish(label='E', enable=False)\nF = (((C-D)/C)*100).publish(label='F')\nG = (((C-E)/C)*100).publish(label='G')\n"
            ]
          ]
        ],
        [ "Attribute", "secondary_visualization", [ "String", "Radial" ] ],
        [ "Attribute", "time_range", [ "Int", 900 ] ],
        [ "Attribute", "timezone", [ "String", "UTC" ] ],
        [ "Attribute", "unit_prefix", [ "String", "Metric" ] ],
        [
          "Block",
          {
            "type_": "color_scale",
            "labels": [],
            "body": [
              [ "Attribute", "color", [ "String", "aquamarine" ] ],
              [ "Attribute", "gt", [ "Float", 3.4028234663852886e+38 ] ],
              [ "Attribute", "gte", [ "Minus", [ "Int", 100 ] ] ],
              [ "Attribute", "lt", [ "Float", 3.4028234663852886e+38 ] ],
              [ "Attribute", "lte", [ "Int", 0 ] ]
            ]
          }
        ],
        [
          "Block",
          {
            "type_": "color_scale",
            "labels": [],
            "body": [
              [ "Attribute", "color", [ "String", "gray" ] ],
              [ "Attribute", "gt", [ "Int", 0 ] ],
              [ "Attribute", "gte", [ "Float", 3.4028234663852886e+38 ] ],
              [ "Attribute", "lt", [ "Float", 3.4028234663852886e+38 ] ],
              [ "Attribute", "lte", [ "Int", 100 ] ]
            ]
          }
