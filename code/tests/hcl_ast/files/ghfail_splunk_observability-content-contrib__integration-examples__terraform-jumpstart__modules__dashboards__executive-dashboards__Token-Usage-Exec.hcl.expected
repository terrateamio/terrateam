      "body": [
        [ "Attribute", "color_by", [ "String", "Scale" ] ],
        [
          "Attribute",
          "description",
          [
            "String",
            "High Resolution Metrics By Token (MTS) 4 Week Comparisons (7 Day Means)"
          ]
        ],
        [ "Attribute", "disable_sampling", [ "Bool", false ] ],
        [ "Attribute", "hide_missing_values", [ "Bool", false ] ],
