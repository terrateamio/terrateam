          [ "String", "Mean MTS usage by Token Name Using 7 Day Means" ]
        ],
        [ "Attribute", "disable_sampling", [ "Bool", false ] ],
        [ "Attribute", "hide_missing_values", [ "Bool", false ] ],
        [ "Attribute", "max_precision", [ "Int", 2 ] ],
        [
          "Attribute",
          "name",
          [ "String", "Mean MTS usage(7d) by Token Name" ]
        ],
        [
          "Attribute",
          "program_text",
          [
            "Heredoc",
            [
              "EOF",
              "\nA = data('sf.org.numBundledMetricsByToken', filter=filter('tokenName', '*')).sum(by=['tokenName']).mean(over='7d').publish(label='A', enable=False)\n        \nAA = data('sf.org.numCustomMetricsByToken', filter=filter('tokenName', '*')).sum(by=['tokenName']).mean(over='7d').publish(label='AA', enable=False)\n        \nAB = data('sf.org.numSyntheticsMetricsByToken', filter=filter('tokenName', '*')).sum(by=['tokenName']).mean(over='7d').publish(label='AB', enable=False)\n        \nAC = data('sf.org.numApmBundledMetricsByToken', filter=filter('tokenName', '*')).sum(by=['tokenName']).mean(over='7d').publish(label='AC', enable=False)\n        \nAD = data('sf.org.numResourceMetricsByToken', filter=filter('tokenName', '*')).sum(by=['tokenName']).mean(over='7d').publish(label='AD', enable=False)\n        \nsyntheticsTotal = (AB.sum() if AB.count() > 0 else 0).publish(label='synthetics', enable=False)\n        \ntotal = (A + AA + syntheticsTotal + AC + AD).publish(label='total', enable=True)\n        \n"
            ]
          ]
        ],
