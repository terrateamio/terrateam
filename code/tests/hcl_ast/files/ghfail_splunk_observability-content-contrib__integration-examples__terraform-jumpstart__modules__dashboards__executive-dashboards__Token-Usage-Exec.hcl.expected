  [
    "Block",
    {
      "type_": "resource",
      "labels": [
        [ "Lit", "signalfx_list_chart" ], [ "Lit", "TOKEN-USAGE-EXEC_0" ]
      ],
      "body": [
        [ "Attribute", "color_by", [ "String", "Metric" ] ],
        [
          "Attribute",
          "description",
          [
            "String",
            "Token Usage Change Top and Bottom 5 (12 Week Comparison of 7 Day Means)"
          ]
        ],
        [ "Attribute", "disable_sampling", [ "Bool", false ] ],
        [ "Attribute", "hide_missing_values", [ "Bool", false ] ],
        [ "Attribute", "max_precision", [ "Int", 2 ] ],
        [
          "Attribute",
          "name",
          [ "String", "Token Usage Rate 12 Week Comparison" ]
        ],
        [
          "Attribute",
          "program_text",
          [
            "Heredoc",
            [
              "EOF",
              "\nA = data('sf.org.numBundledMetricsByToken', filter=filter('tokenName', '*')).sum(by=['tokenName']).mean(over='7d').publish(label='A', enable=False)\nB = data('sf.org.numBundledMetricsByToken', filter=filter('tokenName', '*')).sum(by=['tokenName']).timeshift('12w').mean(over='7d').publish(label='B', enable=False)\n        \nAA = data('sf.org.numCustomMetricsByToken', filter=filter('tokenName', '*')).sum(by=['tokenName']).mean(over='7d').publish(label='AA', enable=False)\nA1 = data('sf.org.numCustomMetricsByToken', filter=filter('tokenName', '*')).sum(by=['tokenName']).timeshift('12w').mean(over='7d').publish(label='A1', enable=False)\n        \nAB = data('sf.org.numSyntheticsMetricsByToken', filter=filter('tokenName', '*')).sum(by=['tokenName']).mean(over='7d').publish(label='AB', enable=False)\nA2 = data('sf.org.numSyntheticsMetricsByToken', filter=filter('tokenName', '*')).sum(by=['tokenName']).timeshift('12w').mean(over='7d').publish(label='A2', enable=False)\n        \nAC = data('sf.org.numApmBundledMetricsByToken', filter=filter('tokenName', '*')).sum(by=['tokenName']).mean(over='7d').publish(label='AC', enable=False)\nA3 = data('sf.org.numApmBundledMetricsByToken', filter=filter('tokenName', '*')).sum(by=['tokenName']).timeshift('12w').mean(over='7d').publish(label='A3', enable=False)\n        \nAD = data('sf.org.numResourceMetricsByToken', filter=filter('tokenName', '*')).sum(by=['tokenName']).mean(over='7d').publish(label='AD', enable=False)\nA4 = data('sf.org.numResourceMetricsByToken', filter=filter('tokenName', '*')).sum(by=['tokenName']).timeshift('12w').mean(over='7d').publish(label='A4', enable=False)\n        \nsyntheticsTotal = (AB.sum() if AB.count() > 0 else 0).publish(label='synthetics', enable=False)\nsyntheticsTotal12w = (A2.sum() if A2.count() > 0 else 0).publish(label='synthetics', enable=False)\n        \ntotal = (A + AA + syntheticsTotal + AC + AD).publish(label='total', enable=False)\ntotal12w = (B + A1 + syntheticsTotal12w + A3 + A4).publish(label='total', enable=False)\n        \n        \ntopChange = (((total-total12w)/total12w)*100).mean(by=['tokenName']).mean(over='7d').top(count=5).publish(label='topChange', enable=True)\nbottomChange = (((total-total12w)/total12w)*100).mean(by=['tokenName']).mean(over='7d').bottom(count=5).publish(label='bottomChange', enable=True)\n"
            ]
          ]
        ],
        [ "Attribute", "refresh_interval", [ "Int", 3600 ] ],
        [ "Attribute", "secondary_visualization", [ "String", "None" ] ],
        [ "Attribute", "sort_by", [ "String", "-value" ] ],
        [ "Attribute", "time_range", [ "Int", 900 ] ],
        [ "Attribute", "timezone", [ "String", "UTC" ] ],
        [ "Attribute", "unit_prefix", [ "String", "Metric" ] ],
        [
          "Block",
          {
            "type_": "legend_options_fields",
            "labels": [],
            "body": [
              [ "Attribute", "enabled", [ "Bool", false ] ],
              [ "Attribute", "property", [ "String", "sf_metric" ] ]
            ]
          }
        ],
        [
          "Block",
