  [
    "Block",
    {
      "type_": "module",
      "labels": [ [ "Lit", "helm_client_tls_certs" ] ],
      "body": [
        [
          "Attribute",
          "source",
          [ "String", "./modules/k8s-helm-client-tls-certs" ]
        ],
        [
          "Attribute",
          "ca_tls_certificate_key_pair_secret_namespace",
