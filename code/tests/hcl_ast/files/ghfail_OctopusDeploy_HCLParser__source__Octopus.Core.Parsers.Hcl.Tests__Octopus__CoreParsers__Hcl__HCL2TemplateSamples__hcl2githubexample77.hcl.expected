              ],
              [ "A_string", "name" ]
            ]
          ]
        ],
        [
          "Attribute",
          "tls_certificate_key_pair_secret_name",
          [
            "Template",
            [
              [ "Literal", "tiller-client-" ],
              [
                "Interpolation",
                {
                  "expr": [
                    "Fun_call",
                    [
                      "md5",
                      [
                        [
                          "Attr",
                          [
                            [ "Id", "local" ],
                            [ "A_string", "rbac_entity_id" ]
                          ]
                        ]
                      ]
                    ]
                  ],
                  "strip_before": false,
                  "strip_after": false
                }
              ],
              [ "Literal", "-certs" ]
            ]
          ]
        ],
        [
          "Attribute",
          "tls_certificate_key_pair_secret_labels",
          [
            "Object",
            [
              [
                [ "Quoted", "gruntwork.io/tiller-namespace" ],
                [
                  "Attr",
                  [
                    [
                      "Attr",
                      [
                        [ "Id", "module" ],
                        [ "A_string", "tiller_namespace" ]
                      ]
                    ],
                    [ "A_string", "name" ]
