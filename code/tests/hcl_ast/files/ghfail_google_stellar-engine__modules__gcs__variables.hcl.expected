[
  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "autoclass" ] ],
      "body": [
        [
          "Attribute",
          "description",
          [
            "String",
            "Enable autoclass to automatically transition objects to appropriate storage classes based on their access pattern. If set to true, storage_class must be set to STANDARD. Defaults to false."
          ]
        ],
        [ "Attribute", "type", [ "Id", "bool" ] ],
        [ "Attribute", "default", [ "Null" ] ]
      ]
    }
  ],
