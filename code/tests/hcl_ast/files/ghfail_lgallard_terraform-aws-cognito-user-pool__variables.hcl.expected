  ],
  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "domain" ] ],
      "body": [
        [
          "Attribute",
          "description",
          [ "String", "Cognito User Pool domain" ]
        ],
        [ "Attribute", "type", [ "Id", "string" ] ],
        [ "Attribute", "default", [ "Null" ] ],
        [
          "Block",
          {
            "type_": "validation",
            "labels": [],
            "body": [
              [
                "Attribute",
                "condition",
                [
                  "Cond",
                  {
                    "if_": [
                      "Equal",
                      [
                        [
                          "Attr",
                          [ [ "Id", "var" ], [ "A_string", "domain" ] ]
                        ],
                        [ "Null" ]
                      ]
                    ],
                    "then_": [ "Bool", true ],
                    "else_": [
                      "Log_and",
                      [
                        [
                          "Log_and",
                          [
                            [
                              "Fun_call",
                              [
                                "can",
                                [
                                  [
                                    "Fun_call",
                                    [
                                      "regex",
                                      [
                                        [
                                          "String",
                                          "^[a-z0-9][.a-z0-9-]*[a-z0-9]$"
                                        ],
                                        [
                                          "Attr",
                                          [
                                            [ "Id", "var" ],
                                            [ "A_string", "domain" ]
                                          ]
                                        ]
                                      ]
                                    ]
                                  ]
                                ]
                              ]
                            ],
                            [
                              "Gte",
                              [
                                [
                                  "Fun_call",
                                  [
                                    "length",
                                    [
                                      [
                                        "Attr",
                                        [
                                          [ "Id", "var" ],
                                          [ "A_string", "domain" ]
                                        ]
                                      ]
                                    ]
                                  ]
                                ],
                                [ "Int", 3 ]
                              ]
                            ]
                          ]
                        ],
                        [
                          "Lte",
                          [
                            [
                              "Fun_call",
                              [
                                "length",
                                [
                                  [
                                    "Attr",
                                    [
                                      [ "Id", "var" ],
                                      [ "A_string", "domain" ]
                                    ]
                                  ]
                                ]
                              ]
                            ],
                            [ "Int", 63 ]
                          ]
                        ]
                      ]
                    ]
                  }
                ]
              ],
              [
                "Attribute",
                "error_message",
                [
                  "String",
                  "Domain must be 3-63 characters, start and end with alphanumeric characters, and contain only lowercase letters, numbers, dots, and hyphens."
                ]
              ]
            ]
          }
        ]
      ]
    }
  ],
