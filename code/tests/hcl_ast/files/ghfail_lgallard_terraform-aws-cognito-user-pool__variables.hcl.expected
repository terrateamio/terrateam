[
  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "enabled" ] ],
      "body": [
        [
          "Attribute",
          "description",
          [ "String", "Change to false to avoid deploying any resources" ]
        ],
        [ "Attribute", "type", [ "Id", "bool" ] ],
        [ "Attribute", "default", [ "Bool", true ] ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "user_pool_name" ] ],
      "body": [
        [
          "Attribute",
          "description",
          [ "String", "The name of the user pool" ]
        ],
        [ "Attribute", "type", [ "Id", "string" ] ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "user_pool_tier" ] ],
      "body": [
        [ "Attribute", "type", [ "Id", "string" ] ],
        [
          "Attribute",
          "description",
          [
            "String",
            "Cognito User Pool tier. Valid values: LITE, ESSENTIALS, PLUS."
          ]
        ],
        [ "Attribute", "default", [ "String", "ESSENTIALS" ] ],
        [
          "Block",
          {
            "type_": "validation",
            "labels": [],
            "body": [
              [
                "Attribute",
                "condition",
                [
                  "Fun_call",
                  [
                    "contains",
                    [
                      [
                        "Tuple",
                        [
                          [ "String", "LITE" ],
                          [ "String", "ESSENTIALS" ],
                          [ "String", "PLUS" ]
                        ]
                      ],
                      [
                        "Attr",
                        [ [ "Id", "var" ], [ "A_string", "user_pool_tier" ] ]
                      ]
                    ]
                  ]
                ]
              ],
              [
                "Attribute",
                "error_message",
                [
                  "String",
                  "user_pool_tier must be one of: LITE, ESSENTIALS, PLUS"
                ]
              ]
            ]
          }
        ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "email_verification_message" ] ],
      "body": [
        [
          "Attribute",
          "description",
          [
            "String", "A string representing the email verification message"
          ]
        ],
        [ "Attribute", "type", [ "Id", "string" ] ],
        [ "Attribute", "default", [ "Null" ] ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "email_verification_subject" ] ],
      "body": [
        [
          "Attribute",
          "description",
          [
            "String", "A string representing the email verification subject"
          ]
        ],
        [ "Attribute", "type", [ "Id", "string" ] ],
        [ "Attribute", "default", [ "Null" ] ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "username_configuration" ] ],
      "body": [
        [
          "Attribute",
          "description",
          [
            "String",
            "The Username Configuration. Setting `case_sensitive` specifies whether username case sensitivity will be applied for all users in the user pool through Cognito APIs"
          ]
        ],
        [
          "Attribute", "type", [ "Fun_call", [ "map", [ [ "Id", "any" ] ] ] ]
        ],
        [ "Attribute", "default", [ "Object", [] ] ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "admin_create_user_config" ] ],
      "body": [
        [
          "Attribute",
          "description",
          [ "String", "The configuration for AdminCreateUser requests" ]
        ],
        [
          "Attribute", "type", [ "Fun_call", [ "map", [ [ "Id", "any" ] ] ] ]
        ],
        [ "Attribute", "default", [ "Object", [] ] ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "variable",
      "labels": [
        [ "Lit", "admin_create_user_config_allow_admin_create_user_only" ]
      ],
      "body": [
        [
          "Attribute",
          "description",
          [
            "String",
            "Set to True if only the administrator is allowed to create user profiles. Set to False if users can sign themselves up via an app"
          ]
        ],
        [ "Attribute", "type", [ "Id", "bool" ] ],
        [ "Attribute", "default", [ "Bool", true ] ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "temporary_password_validity_days" ] ],
      "body": [
        [
          "Attribute",
          "description",
          [
            "String",
            "The user account expiration limit, in days, after which the account is no longer usable"
          ]
        ],
        [ "Attribute", "type", [ "Id", "number" ] ],
        [ "Attribute", "default", [ "Int", 7 ] ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "admin_create_user_config_email_message" ] ],
      "body": [
        [
          "Attribute",
          "description",
          [
            "String",
            "The message template for email messages. Must contain `{username}` and `{####}` placeholders, for username and temporary password, respectively"
          ]
        ],
        [ "Attribute", "type", [ "Id", "string" ] ],
        [
          "Attribute",
          "default",
          [ "String", "{username}, your verification code is `{####}`" ]
        ],
        [
          "Block",
          {
            "type_": "validation",
            "labels": [],
            "body": [
              [
                "Attribute",
                "condition",
                [
                  "Log_and",
                  [
                    [
                      "Fun_call",
                      [
                        "can",
                        [
                          [
                            "Fun_call",
                            [
                              "regex",
                              [
                                [ "String", "\\{username\\}" ],
                                [
                                  "Attr",
                                  [
                                    [ "Id", "var" ],
                                    [
                                      "A_string",
                                      "admin_create_user_config_email_message"
                                    ]
                                  ]
                                ]
                              ]
                            ]
                          ]
                        ]
                      ]
                    ],
                    [
                      "Fun_call",
                      [
                        "can",
                        [
                          [
                            "Fun_call",
                            [
                              "regex",
                              [
                                [ "String", "\\{####\\}" ],
                                [
                                  "Attr",
                                  [
                                    [ "Id", "var" ],
                                    [
                                      "A_string",
                                      "admin_create_user_config_email_message"
                                    ]
                                  ]
                                ]
                              ]
                            ]
                          ]
                        ]
                      ]
                    ]
                  ]
                ]
              ],
              [
                "Attribute",
                "error_message",
                [
                  "String",
                  "Email message template must contain {username} and {####} placeholders and cannot contain potentially malicious content."
                ]
              ]
            ]
          }
        ],
        [
          "Block",
          {
            "type_": "validation",
            "labels": [],
            "body": [
              [
                "Attribute",
                "condition",
                [
                  "Not",
                  [
                    "Fun_call",
                    [
                      "can",
                      [
                        [
                          "Fun_call",
                          [
                            "regex",
                            [
                              [
                                "String",
                                "(?i)(script|javascript|vbscript|onload|onerror|onclick)"
                              ],
                              [
                                "Attr",
                                [
                                  [ "Id", "var" ],
                                  [
                                    "A_string",
                                    "admin_create_user_config_email_message"
                                  ]
                                ]
                              ]
                            ]
                          ]
                        ]
                      ]
                    ]
                  ]
                ]
              ],
              [
                "Attribute",
                "error_message",
                [
                  "String",
                  "Email message template cannot contain potentially malicious script content for security."
                ]
              ]
            ]
          }
        ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "admin_create_user_config_email_subject" ] ],
      "body": [
        [
          "Attribute",
          "description",
          [ "String", "The subject line for email messages" ]
        ],
        [ "Attribute", "type", [ "Id", "string" ] ],
        [ "Attribute", "default", [ "String", "Your verification code" ] ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "admin_create_user_config_sms_message" ] ],
      "body": [
        [
          "Attribute",
          "description",
          [
            "String",
            "- The message template for SMS messages. Must contain `{username}` and `{####}` placeholders, for username and temporary password, respectively"
          ]
        ],
        [ "Attribute", "type", [ "Id", "string" ] ],
        [
          "Attribute",
          "default",
          [
            "String",
            "Your username is {username} and temporary password is `{####}`"
          ]
        ],
        [
          "Block",
          {
            "type_": "validation",
            "labels": [],
            "body": [
              [
                "Attribute",
                "condition",
                [
                  "Log_and",
                  [
                    [
                      "Fun_call",
                      [
                        "can",
                        [
                          [
                            "Fun_call",
                            [
                              "regex",
                              [
                                [ "String", "\\{username\\}" ],
                                [
                                  "Attr",
                                  [
                                    [ "Id", "var" ],
                                    [
                                      "A_string",
                                      "admin_create_user_config_sms_message"
                                    ]
                                  ]
                                ]
                              ]
                            ]
                          ]
                        ]
                      ]
                    ],
                    [
                      "Fun_call",
                      [
                        "can",
                        [
                          [
                            "Fun_call",
                            [
                              "regex",
                              [
                                [ "String", "\\{####\\}" ],
                                [
                                  "Attr",
                                  [
                                    [ "Id", "var" ],
                                    [
                                      "A_string",
                                      "admin_create_user_config_sms_message"
                                    ]
                                  ]
                                ]
                              ]
                            ]
                          ]
                        ]
                      ]
                    ]
                  ]
                ]
              ],
              [
                "Attribute",
                "error_message",
                [
                  "String",
                  "SMS message template must contain {username} and {####} placeholders and cannot contain potentially malicious content."
                ]
              ]
            ]
          }
        ],
        [
          "Block",
          {
            "type_": "validation",
            "labels": [],
            "body": [
              [
                "Attribute",
                "condition",
                [
                  "Lte",
                  [
                    [
                      "Fun_call",
                      [
                        "length",
                        [
                          [
                            "Attr",
                            [
                              [ "Id", "var" ],
                              [
                                "A_string",
                                "admin_create_user_config_sms_message"
                              ]
                            ]
                          ]
                        ]
                      ]
                    ],
                    [ "Int", 140 ]
                  ]
                ]
              ],
              [
                "Attribute",
                "error_message",
                [
                  "String",
                  "SMS message template must not exceed 140 characters for SMS delivery compatibility."
                ]
              ]
            ]
          }
        ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "alias_attributes" ] ],
      "body": [
        [
          "Attribute",
          "description",
          [
            "String",
            "Attributes supported as an alias for this user pool. Possible values: phone_number, email, or preferred_username. Conflicts with `username_attributes`"
          ]
        ],
        [
          "Attribute",
          "type",
          [ "Fun_call", [ "list", [ [ "Id", "string" ] ] ] ]
        ],
        [ "Attribute", "default", [ "Null" ] ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "username_attributes" ] ],
      "body": [
        [
          "Attribute",
          "description",
          [
            "String",
            "Specifies whether email addresses or phone numbers can be specified as usernames when a user signs up. Conflicts with `alias_attributes`"
          ]
        ],
        [
          "Attribute",
          "type",
          [ "Fun_call", [ "list", [ [ "Id", "string" ] ] ] ]
        ],
        [ "Attribute", "default", [ "Null" ] ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "deletion_protection" ] ],
      "body": [
        [
          "Attribute",
          "description",
          [
            "String",
            "When active, DeletionProtection prevents accidental deletion of your user pool. Before you can delete a user pool that you have protected against deletion, you must deactivate this feature. Valid values are `ACTIVE` and `INACTIVE`."
          ]
        ],
        [ "Attribute", "type", [ "Id", "string" ] ],
        [ "Attribute", "default", [ "String", "ACTIVE" ] ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "auto_verified_attributes" ] ],
      "body": [
        [
          "Attribute",
          "description",
          [
            "String",
            "The attributes to be auto-verified. Possible values: email, phone_number"
          ]
        ],
        [
          "Attribute",
          "type",
          [ "Fun_call", [ "list", [ [ "Id", "string" ] ] ] ]
        ],
        [ "Attribute", "default", [ "Tuple", [] ] ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "sms_configuration" ] ],
      "body": [
        [ "Attribute", "description", [ "String", "The SMS Configuration" ] ],
        [
          "Attribute", "type", [ "Fun_call", [ "map", [ [ "Id", "any" ] ] ] ]
        ],
        [ "Attribute", "default", [ "Object", [] ] ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "sms_configuration_external_id" ] ],
      "body": [
        [
          "Attribute",
          "description",
          [
            "String", "The external ID used in IAM role trust relationships"
          ]
        ],
        [ "Attribute", "type", [ "Id", "string" ] ],
        [ "Attribute", "default", [ "String", "" ] ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "sms_configuration_sns_caller_arn" ] ],
      "body": [
        [
          "Attribute",
          "description",
          [
            "String",
            "The ARN of the Amazon SNS caller. This is usually the IAM role that you've given Cognito permission to assume"
          ]
        ],
        [ "Attribute", "type", [ "Id", "string" ] ],
        [ "Attribute", "default", [ "String", "" ] ],
        [
          "Block",
          {
            "type_": "validation",
            "labels": [],
            "body": [
              [
                "Attribute",
                "condition",
                [
                  "Cond",
                  {
                    "if_": [
                      "Equal",
                      [
                        [
                          "Attr",
                          [
                            [ "Id", "var" ],
                            [
                              "A_string", "sms_configuration_sns_caller_arn"
                            ]
                          ]
                        ],
                        [ "String", "" ]
                      ]
                    ],
                    "then_": [ "Bool", true ],
                    "else_": [
                      "Fun_call",
                      [
                        "can",
                        [
                          [
                            "Fun_call",
                            [
                              "regex",
                              [
                                [
                                  "String",
                                  "^arn:aws:iam::[0-9]{12}:role/[a-zA-Z0-9+=,.@_-]+$"
                                ],
                                [
                                  "Attr",
                                  [
                                    [ "Id", "var" ],
                                    [
                                      "A_string",
                                      "sms_configuration_sns_caller_arn"
                                    ]
                                  ]
                                ]
                              ]
                            ]
                          ]
                        ]
                      ]
                    ]
                  }
                ]
              ],
              [
                "Attribute",
                "error_message",
                [
                  "String",
                  "SNS caller ARN must be a valid IAM role ARN format: arn:aws:iam::account:role/role-name."
                ]
              ]
            ]
          }
        ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "device_configuration" ] ],
      "body": [
        [
          "Attribute",
          "description",
          [
            "String", "The configuration for the user pool's device tracking"
          ]
        ],
        [
          "Attribute", "type", [ "Fun_call", [ "map", [ [ "Id", "any" ] ] ] ]
        ],
        [ "Attribute", "default", [ "Object", [] ] ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "variable",
      "labels": [
        [ "Lit", "device_configuration_challenge_required_on_new_device" ]
      ],
      "body": [
        [
          "Attribute",
          "description",
          [
            "String",
            "Indicates whether a challenge is required on a new device. Only applicable to a new device"
          ]
        ],
        [ "Attribute", "type", [ "Id", "bool" ] ],
        [ "Attribute", "default", [ "Null" ] ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "variable",
      "labels": [
        [
          "Lit", "device_configuration_device_only_remembered_on_user_prompt"
        ]
      ],
      "body": [
        [
          "Attribute",
          "description",
          [ "String", "If true, a device is only remembered on user prompt" ]
        ],
        [ "Attribute", "type", [ "Id", "bool" ] ],
        [ "Attribute", "default", [ "Null" ] ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "email_configuration" ] ],
      "body": [
        [
          "Attribute", "description", [ "String", "The Email Configuration" ]
        ],
        [
          "Attribute", "type", [ "Fun_call", [ "map", [ [ "Id", "any" ] ] ] ]
        ],
        [ "Attribute", "default", [ "Object", [] ] ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "email_configuration_configuration_set" ] ],
      "body": [
        [
          "Attribute",
          "description",
          [ "String", "The name of the configuration set" ]
        ],
        [ "Attribute", "type", [ "Id", "string" ] ],
        [ "Attribute", "default", [ "Null" ] ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "email_configuration_reply_to_email_address" ] ],
      "body": [
        [
          "Attribute",
          "description",
          [ "String", "The REPLY-TO email address" ]
        ],
        [ "Attribute", "type", [ "Id", "string" ] ],
        [ "Attribute", "default", [ "String", "" ] ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "email_configuration_source_arn" ] ],
      "body": [
        [
          "Attribute",
          "description",
          [ "String", "The ARN of the email source" ]
        ],
        [ "Attribute", "type", [ "Id", "string" ] ],
        [ "Attribute", "default", [ "String", "" ] ],
        [
          "Block",
          {
            "type_": "validation",
            "labels": [],
            "body": [
              [
                "Attribute",
                "condition",
                [
                  "Cond",
                  {
                    "if_": [
                      "Equal",
                      [
                        [
                          "Attr",
                          [
                            [ "Id", "var" ],
                            [ "A_string", "email_configuration_source_arn" ]
                          ]
                        ],
                        [ "String", "" ]
                      ]
                    ],
                    "then_": [ "Bool", true ],
                    "else_": [
                      "Fun_call",
                      [
                        "can",
                        [
                          [
                            "Fun_call",
                            [
                              "regex",
                              [
                                [
                                  "String",
                                  "^arn:aws:ses:[a-z0-9-]+:[0-9]{12}:identity/.+$"
                                ],
                                [
                                  "Attr",
                                  [
                                    [ "Id", "var" ],
                                    [
                                      "A_string",
                                      "email_configuration_source_arn"
                                    ]
                                  ]
                                ]
                              ]
                            ]
                          ]
                        ]
                      ]
                    ]
                  }
                ]
              ],
              [
                "Attribute",
                "error_message",
                [
                  "String",
                  "Email source ARN must be a valid SES identity ARN format: arn:aws:ses:region:account:identity/domain-or-email."
                ]
              ]
            ]
          }
        ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "email_configuration_email_sending_account" ] ],
      "body": [
        [
          "Attribute",
          "description",
          [
            "String",
            "Instruct Cognito to either use its built-in functional or Amazon SES to send out emails. Allowed values: `COGNITO_DEFAULT` or `DEVELOPER`"
          ]
        ],
        [ "Attribute", "type", [ "Id", "string" ] ],
        [ "Attribute", "default", [ "String", "COGNITO_DEFAULT" ] ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "email_configuration_from_email_address" ] ],
      "body": [
        [
          "Attribute",
          "description",
          [
            "String",
            "Sender's email address or sender's display name with their email address (e.g. `john@example.com`, `John Smith <john@example.com>` or `\"John Smith Ph.D.\" <john@example.com>)`. Escaped double quotes are required around display names that contain certain characters as specified in RFC 5322"
          ]
        ],
        [ "Attribute", "type", [ "Id", "string" ] ],
        [ "Attribute", "default", [ "Null" ] ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "email_mfa_configuration" ] ],
      "body": [
        [
          "Attribute",
          "description",
          [
            "String",
            "Configuration block for configuring email Multi-Factor Authentication (MFA)"
          ]
        ],
        [
          "Attribute",
          "type",
          [
            "Fun_call",
            [
              "object",
              [
                [
                  "Object",
                  [
                    [ [ "Bare", "message" ], [ "Id", "string" ] ],
                    [ [ "Bare", "subject" ], [ "Id", "string" ] ]
                  ]
                ]
              ]
            ]
          ]
        ],
        [ "Attribute", "default", [ "Null" ] ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "lambda_config" ] ],
      "body": [
        [
          "Attribute",
          "description",
          [
            "String",
            "A container for the AWS Lambda triggers associated with the user pool"
          ]
        ],
        [ "Attribute", "type", [ "Id", "any" ] ],
        [ "Attribute", "default", [ "Object", [] ] ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "lambda_config_create_auth_challenge" ] ],
      "body": [
        [
          "Attribute",
          "description",
          [
            "String",
            "The ARN of the lambda creating an authentication challenge."
          ]
        ],
        [ "Attribute", "type", [ "Id", "string" ] ],
        [ "Attribute", "default", [ "Null" ] ],
        [
          "Block",
          {
            "type_": "validation",
            "labels": [],
            "body": [
              [
                "Attribute",
                "condition",
                [
                  "Cond",
                  {
                    "if_": [
                      "Equal",
                      [
                        [
                          "Attr",
                          [
                            [ "Id", "var" ],
                            [
                              "A_string",
                              "lambda_config_create_auth_challenge"
                            ]
                          ]
                        ],
                        [ "Null" ]
