                      "Gte",
                      [
                        [
                          "Attr",
                          [
                            [ "Id", "var" ],
                            [ "A_string", "client_id_token_validity" ]
                          ]
                        ],
                        [ "Int", 5 ]
                      ]
                    ],
                    [
                      "Lte",
                      [
                        [
                          "Attr",
                          [
                            [ "Id", "var" ],
                            [ "A_string", "client_id_token_validity" ]
                          ]
                        ],
                        [ "Int", 1440 ]
                      ]
                    ]
                  ]
                ]
              ],
              [
                "Attribute",
                "error_message",
                [
                  "String",
                  "ID token validity must be between 5 minutes and 1440 minutes (1 day) per AWS limits."
                ]
              ]
            ]
          }
        ]
      ]
    }
  ],
