                              "identifiers": [ "url", [] ],
                              "input": [
                                "Attr",
                                [
                                  [ "Id", "var" ],
                                  [ "A_string", "client_logout_urls" ]
                                ]
                              ],
                              "output": [
                                "Log_or",
                                [
                                  [
                                    "Fun_call",
                                    [
                                      "can",
                                      [
                                        [
                                          "Fun_call",
                                          [
                                            "regex",
                                            [
                                              [
                                                "String",
                                                "^https://[a-zA-Z0-9][a-zA-Z0-9.-]*[a-zA-Z0-9](?::[0-9]+)?(?:/.*)?$"
                                              ],
                                              [ "Id", "url" ]
                                            ]
                                          ]
                                        ]
                                      ]
                                    ]
                                  ],
                                  [
                                    "Fun_call",
                                    [
