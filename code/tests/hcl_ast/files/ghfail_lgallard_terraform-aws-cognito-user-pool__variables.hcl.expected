  ],
  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "client_explicit_auth_flows" ] ],
      "body": [
        [
          "Attribute",
          "description",
          [
            "String",
            "List of authentication flows (ADMIN_NO_SRP_AUTH, CUSTOM_AUTH_FLOW_ONLY, ALLOW_USER_PASSWORD_AUTH, ALLOW_ADMIN_USER_PASSWORD_AUTH)"
          ]
        ],
        [
          "Attribute",
          "type",
          [ "Fun_call", [ "list", [ [ "Id", "string" ] ] ] ]
        ],
        [ "Attribute", "default", [ "Tuple", [] ] ],
        [
          "Block",
          {
            "type_": "validation",
            "labels": [],
            "body": [
              [
                "Attribute",
                "condition",
                [
                  "Fun_call",
                  [
                    "alltrue",
                    [
                      [
                        "For_tuple",
                        {
                          "identifiers": [ "flow", [] ],
                          "input": [
                            "Attr",
                            [
                              [ "Id", "var" ],
                              [ "A_string", "client_explicit_auth_flows" ]
                            ]
                          ],
                          "output": [
                            "Fun_call",
                            [
                              "contains",
                              [
                                [
                                  "Tuple",
                                  [
                                    [ "String", "ADMIN_NO_SRP_AUTH" ],
                                    [ "String", "CUSTOM_AUTH_FLOW_ONLY" ],
                                    [ "String", "USER_SRP_AUTH" ],
                                    [ "String", "ALLOW_CUSTOM_AUTH" ],
                                    [ "String", "ALLOW_USER_SRP_AUTH" ],
                                    [ "String", "ALLOW_REFRESH_TOKEN_AUTH" ],
                                    [
                                      "String",
                                      "ALLOW_ADMIN_USER_PASSWORD_AUTH"
                                    ],
                                    [ "String", "ALLOW_USER_PASSWORD_AUTH" ]
                                  ]
                                ],
                                [ "Id", "flow" ]
                              ]
                            ]
                          ],
                          "cond": null
                        }
                      ]
                    ]
                  ]
                ]
              ],
              [
                "Attribute",
                "error_message",
                [
                  "String",
                  "Authentication flows must be valid values: ADMIN_NO_SRP_AUTH, CUSTOM_AUTH_FLOW_ONLY, USER_SRP_AUTH, ALLOW_CUSTOM_AUTH, ALLOW_USER_SRP_AUTH, ALLOW_REFRESH_TOKEN_AUTH, ALLOW_ADMIN_USER_PASSWORD_AUTH, ALLOW_USER_PASSWORD_AUTH. Avoid password-based flows for security."
                ]
              ]
            ]
          }
        ]
      ]
    }
  ],
