  ],
  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "client_auth_session_validity" ] ],
      "body": [
        [
          "Attribute",
          "description",
          [
            "String",
            "Amazon Cognito creates a session token for each API request in an authentication flow. AuthSessionValidity is the duration, in minutes, of that session token. Your user pool native user must respond to each authentication challenge before the session expires. Valid values between 3 and 15. Default value is 3."
          ]
        ],
        [ "Attribute", "type", [ "Id", "number" ] ],
        [ "Attribute", "default", [ "Int", 3 ] ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "client_callback_urls" ] ],
      "body": [
        [
          "Attribute",
          "description",
          [
            "String",
            "List of allowed callback URLs for the identity providers"
          ]
        ],
        [
          "Attribute",
          "type",
          [ "Fun_call", [ "list", [ [ "Id", "string" ] ] ] ]
        ],
        [ "Attribute", "default", [ "Tuple", [] ] ],
        [
          "Block",
          {
            "type_": "validation",
            "labels": [],
            "body": [
              [
                "Attribute",
                "condition",
                [
                  "Log_or",
                  [
                    [
                      "Equal",
                      [
                        [
                          "Fun_call",
                          [
                            "length",
                            [
                              [
                                "Attr",
                                [
                                  [ "Id", "var" ],
                                  [ "A_string", "client_callback_urls" ]
                                ]
                              ]
                            ]
                          ]
                        ],
                        [ "Int", 0 ]
                      ]
                    ],
                    [
                      "Fun_call",
                      [
                        "alltrue",
                        [
                          [
                            "For_tuple",
                            {
                              "identifiers": [ "url", [] ],
                              "input": [
                                "Attr",
                                [
                                  [ "Id", "var" ],
                                  [ "A_string", "client_callback_urls" ]
                                ]
                              ],
                              "output": [
                                "Log_or",
                                [
                                  [
                                    "Fun_call",
                                    [
                                      "can",
                                      [
                                        [
                                          "Fun_call",
                                          [
                                            "regex",
                                            [
                                              [
                                                "String",
                                                "^https://[a-zA-Z0-9][a-zA-Z0-9.-]*[a-zA-Z0-9](?::[0-9]+)?(?:/.*)?$"
                                              ],
                                              [ "Id", "url" ]
                                            ]
                                          ]
                                        ]
                                      ]
                                    ]
                                  ],
                                  [
                                    "Fun_call",
                                    [
                                      "can",
                                      [
                                        [
                                          "Fun_call",
                                          [
                                            "regex",
                                            [
                                              [
                                                "String",
                                                "^http://localhost(?::[0-9]+)?(?:/.*)?$"
                                              ],
                                              [ "Id", "url" ]
                                            ]
                                          ]
                                        ]
                                      ]
                                    ]
                                  ]
                                ]
                              ],
                              "cond": null
                            }
                          ]
                        ]
                      ]
                    ]
                  ]
                ]
              ],
              [
                "Attribute",
                "error_message",
                [
                  "String",
                  "Callback URLs must be valid HTTPS URLs (or HTTP localhost for development). URLs must start with https:// or http://localhost and have valid domain format."
                ]
              ]
            ]
          }
        ]
      ]
    }
  ],
  [
    "Block",
    {
