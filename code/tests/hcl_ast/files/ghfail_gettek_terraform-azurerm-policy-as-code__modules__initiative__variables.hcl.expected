[
  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "management_group_id" ] ],
      "body": [
        [ "Attribute", "type", [ "Id", "string" ] ],
        [
          "Attribute",
          "description",
          [
            "String",
            "The management group scope at which the initiative will be defined. Defaults to current Subscription if omitted. Changing this forces a new resource to be created. Note: if you are using azurerm_management_group to assign a value to management_group_id, be sure to use name or group_id attribute, but not id."
          ]
        ],
        [ "Attribute", "default", [ "Null" ] ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "initiative_name" ] ],
      "body": [
        [ "Attribute", "type", [ "Id", "string" ] ],
        [
          "Attribute",
          "description",
          [
            "String",
            "Policy initiative name. Changing this forces a new resource to be created"
          ]
        ],
        [
          "Block",
          {
            "type_": "validation",
            "labels": [],
            "body": [
              [
                "Attribute",
                "condition",
                [
                  "Lte",
                  [
                    [
                      "Fun_call",
                      [
                        "length",
                        [
                          [
                            "Attr",
                            [
                              [ "Id", "var" ],
                              [ "A_string", "initiative_name" ]
                            ]
                          ]
                        ]
                      ]
                    ],
                    [ "Int", 64 ]
                  ]
                ]
              ],
              [
                "Attribute",
                "error_message",
                [
                  "String",
                  "Initiative names have a maximum 64 character limit."
                ]
              ]
            ]
          }
        ]
      ]
    }
  ],
  [
