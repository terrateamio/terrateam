[
  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "rds_replica_name" ] ],
      "body": [
        [ "Attribute", "type", [ "Id", "string" ] ],
        [ "Attribute", "default", [ "String", "rds-replica" ] ],
        [ "Attribute", "description", [ "String", "RDS instance name" ] ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "rds_replica_enabled" ] ],
      "body": [
        [ "Attribute", "type", [ "Id", "string" ] ],
        [ "Attribute", "default", [ "String", "false" ] ],
        [
          "Attribute",
          "description",
          [
            "String",
            "Set to false to prevent the module from creating any resources"
          ]
        ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "rds_replica_replicate_source_db" ] ],
      "body": [
        [ "Attribute", "type", [ "Id", "string" ] ],
        [
          "Attribute",
          "description",
          [
            "String",
            "Specifies that this resource is a Replicate database, and to use this value as the source database. This correlates to the identifier of another Amazon RDS Database to replicate. Note that if you are creating a cross-region replica of an encrypted database you will also need to specify a `kms_key_id`."
          ]
        ],
        [ "Attribute", "default", [ "String", "changeme" ] ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "rds_replica_kms_key_id" ] ],
      "body": [
        [ "Attribute", "type", [ "Id", "string" ] ],
        [
          "Attribute",
          "description",
          [
            "String",
            "The ARN for the KMS encryption key. If creating an encrypted replica, set this to the destination KMS ARN."
          ]
        ],
        [ "Attribute", "default", [ "String", "" ] ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "rds_replica_instance_type" ] ],
      "body": [
        [ "Attribute", "type", [ "Id", "string" ] ],
        [ "Attribute", "default", [ "String", "db.t2.micro" ] ],
        [
          "Attribute",
          "description",
          [ "String", "EC2 instance type for RDS DB" ]
        ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "rds_replica_port" ] ],
      "body": [
        [ "Attribute", "type", [ "Id", "string" ] ],
        [ "Attribute", "default", [ "String", "3306" ] ],
        [ "Attribute", "description", [ "String", "RDS DB port" ] ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "rds_replica_snapshot" ] ],
      "body": [
        [ "Attribute", "type", [ "Id", "string" ] ],
        [ "Attribute", "default", [ "String", "" ] ],
        [
          "Attribute",
          "description",
          [ "String", "Set to a snapshot ID to restore from snapshot" ]
        ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "rds_replica_multi_az" ] ],
      "body": [
        [ "Attribute", "type", [ "Id", "string" ] ],
        [ "Attribute", "default", [ "String", "false" ] ],
        [
          "Attribute",
          "description",
          [ "String", "Run instances in multiple az" ]
        ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "rds_replica_storage_type" ] ],
      "body": [
        [ "Attribute", "type", [ "Id", "string" ] ],
        [ "Attribute", "default", [ "String", "gp2" ] ],
        [ "Attribute", "description", [ "String", "Storage type" ] ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "rds_replica_storage_size" ] ],
      "body": [
        [ "Attribute", "type", [ "Id", "string" ] ],
        [ "Attribute", "default", [ "String", "20" ] ],
        [ "Attribute", "description", [ "String", "Storage size in Gb" ] ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "rds_replica_storage_encrypted" ] ],
      "body": [
        [ "Attribute", "type", [ "Id", "string" ] ],
        [ "Attribute", "default", [ "String", "true" ] ],
        [
          "Attribute",
          "description",
          [ "String", "Set to true to encrypt storage" ]
        ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "rds_replica_auto_minor_version_upgrade" ] ],
      "body": [
        [ "Attribute", "type", [ "Id", "string" ] ],
        [ "Attribute", "default", [ "String", "true" ] ],
        [
          "Attribute",
          "description",
          [
            "String",
            "Allow automated minor version upgrade (e.g. from Postgres 9.5.3 to Postgres 9.5.4)"
          ]
        ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "rds_replica_allow_major_version_upgrade" ] ],
      "body": [
        [ "Attribute", "type", [ "Id", "string" ] ],
        [ "Attribute", "default", [ "String", "false" ] ],
        [
          "Attribute",
          "description",
          [ "String", "Allow major version upgrade" ]
        ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "rds_replica_apply_immediately" ] ],
      "body": [
        [ "Attribute", "type", [ "Id", "string" ] ],
        [ "Attribute", "default", [ "String", "true" ] ],
        [
          "Attribute",
          "description",
          [
            "String",
            "Specifies whether any database modifications are applied immediately, or during the next maintenance window"
          ]
        ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "rds_replica_skip_final_snapshot" ] ],
      "body": [
        [ "Attribute", "type", [ "Id", "string" ] ],
        [ "Attribute", "default", [ "String", "false" ] ],
        [
          "Attribute",
          "description",
          [
            "String",
            "If true (default), no snapshot will be made before deleting DB"
          ]
        ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "rds_replica_backup_retention_period" ] ],
      "body": [
        [ "Attribute", "type", [ "Id", "string" ] ],
        [ "Attribute", "default", [ "String", "7" ] ],
        [
          "Attribute",
          "description",
          [
            "String",
            "Backup retention period in days. Must be > 0 to enable backups"
          ]
        ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "rds_replica_backup_window" ] ],
      "body": [
        [ "Attribute", "type", [ "Id", "string" ] ],
        [ "Attribute", "default", [ "String", "22:00-03:00" ] ],
        [
          "Attribute",
          "description",
          [
            "String",
            "When AWS can perform DB snapshots, can't overlap with maintenance window"
          ]
        ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "locals",
      "labels": [],
      "body": [
        [
          "Attribute",
          "rds_replica_enabled",
          [
            "Equal",
            [
              [
                "Attr",
                [ [ "Id", "var" ], [ "A_string", "rds_replica_enabled" ] ]
              ],
              [ "String", "true" ]
            ]
          ]
        ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "module",
      "labels": [ [ "Lit", "rds_replica" ] ],
      "body": [
        [
          "Attribute",
          "source",
          [
            "String",
            "git::https://github.com/cloudposse/terraform-aws-rds-replica.git?ref=tags/0.1.0"
          ]
        ],
        [
          "Attribute",
          "enabled",
          [
            "Attr",
            [ [ "Id", "var" ], [ "A_string", "rds_replica_enabled" ] ]
          ]
        ],
        [
          "Attribute",
          "namespace",
          [ "Attr", [ [ "Id", "var" ], [ "A_string", "namespace" ] ] ]
        ],
        [
          "Attribute",
          "stage",
          [ "Attr", [ [ "Id", "var" ], [ "A_string", "stage" ] ] ]
        ],
        [
          "Attribute",
          "name",
          [ "Attr", [ [ "Id", "var" ], [ "A_string", "rds_replica_name" ] ] ]
        ],
        [
          "Attribute",
          "kms_key_id",
          [
            "Attr",
            [ [ "Id", "var" ], [ "A_string", "rds_replica_kms_key_id" ] ]
          ]
        ],
        [
          "Attribute",
          "replicate_source_db",
          [
            "Attr",
            [
              [ "Id", "var" ],
              [ "A_string", "rds_replica_replicate_source_db" ]
            ]
          ]
        ],
        [
          "Attribute",
          "dns_zone_id",
          [ "Attr", [ [ "Id", "local" ], [ "A_string", "zone_id" ] ] ]
        ],
        [
          "Attribute",
          "host_name",
          [ "Attr", [ [ "Id", "var" ], [ "A_string", "rds_replica_name" ] ] ]
        ],
        [
          "Attribute",
          "security_group_ids",
          [
            "Tuple",
            [
              [
                "Template",
                [
                  [
                    "Interpolation",
                    {
                      "expr": [
                        "Attr",
                        [
                          [
                            "Attr",
                            [
                              [ "Id", "module" ],
                              [ "A_string", "kops_metadata" ]
                            ]
                          ],
                          [ "A_string", "nodes_security_group_id" ]
                        ]
                      ],
                      "strip_before": false,
                      "strip_after": false
                    }
                  ]
                ]
              ]
            ]
          ]
        ],
        [
          "Attribute",
          "database_port",
          [ "Attr", [ [ "Id", "var" ], [ "A_string", "rds_replica_port" ] ] ]
        ],
        [
          "Attribute",
          "multi_az",
          [
            "Attr",
            [ [ "Id", "var" ], [ "A_string", "rds_replica_multi_az" ] ]
          ]
        ],
        [
          "Attribute",
          "storage_type",
          [
            "Attr",
            [ [ "Id", "var" ], [ "A_string", "rds_replica_storage_type" ] ]
          ]
        ],
        [
          "Attribute",
          "storage_encrypted",
          [
            "Attr",
            [
              [ "Id", "var" ],
              [ "A_string", "rds_replica_storage_encrypted" ]
            ]
          ]
        ],
        [
          "Attribute",
          "instance_class",
          [
            "Attr",
            [ [ "Id", "var" ], [ "A_string", "rds_replica_instance_type" ] ]
          ]
        ],
        [ "Attribute", "publicly_accessible", [ "String", "false" ] ],
        [
          "Attribute",
          "subnet_ids",
          [
            "Tuple",
            [
              [
                "Template",
                [
                  [
                    "Interpolation",
                    {
                      "expr": [
                        "Attr",
                        [
                          [
                            "Attr",
                            [ [ "Id", "module" ], [ "A_string", "subnets" ] ]
                          ],
                          [ "A_string", "private_subnet_ids" ]
                        ]
                      ],
                      "strip_before": false,
                      "strip_after": false
                    }
                  ]
                ]
              ]
            ]
          ]
        ],
        [
          "Attribute",
          "vpc_id",
          [
            "Attr",
            [
              [ "Attr", [ [ "Id", "module" ], [ "A_string", "vpc" ] ] ],
              [ "A_string", "vpc_id" ]
            ]
          ]
        ],
        [
          "Attribute",
          "snapshot_identifier",
          [
            "Attr",
            [ [ "Id", "var" ], [ "A_string", "rds_replica_snapshot" ] ]
          ]
        ],
        [
          "Attribute",
          "auto_minor_version_upgrade",
          [
            "Attr",
            [
              [ "Id", "var" ],
              [ "A_string", "rds_replica_auto_minor_version_upgrade" ]
            ]
          ]
        ],
        [
          "Attribute",
          "allow_major_version_upgrade",
          [
            "Attr",
            [
              [ "Id", "var" ],
              [ "A_string", "rds_replica_allow_major_version_upgrade" ]
            ]
          ]
        ],
        [
          "Attribute",
          "apply_immediately",
          [
            "Attr",
            [
              [ "Id", "var" ],
              [ "A_string", "rds_replica_apply_immediately" ]
            ]
          ]
        ],
        [
          "Attribute",
          "skip_final_snapshot",
          [
            "Attr",
            [
              [ "Id", "var" ],
              [ "A_string", "rds_replica_skip_final_snapshot" ]
            ]
          ]
        ],
        [ "Attribute", "copy_tags_to_snapshot", [ "String", "true" ] ],
        [
          "Attribute",
          "backup_retention_period",
          [
            "Attr",
            [
              [ "Id", "var" ],
              [ "A_string", "rds_replica_backup_retention_period" ]
            ]
          ]
        ],
        [
          "Attribute",
          "backup_window",
          [
            "Attr",
            [ [ "Id", "var" ], [ "A_string", "rds_replica_backup_window" ] ]
          ]
        ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "resource",
      "labels": [
        [ "Lit", "aws_ssm_parameter" ], [ "Lit", "rds_replica_hostname" ]
      ],
      "body": [
        [
          "Attribute",
          "count",
          [
            "Cond",
            {
              "if_": [
                "Attr",
                [ [ "Id", "local" ], [ "A_string", "rds_replica_enabled" ] ]
              ],
              "then_": [ "Int", 1 ],
              "else_": [ "Int", 0 ]
            }
          ]
        ],
        [
          "Attribute",
          "name",
          [
            "Fun_call",
            [
              "format",
              [
                [
                  "Attr",
                  [
                    [ "Id", "var" ], [ "A_string", "chamber_parameter_name" ]
                  ]
                ],
                [
                  "Attr",
                  [ [ "Id", "local" ], [ "A_string", "chamber_service" ] ]
                ],
                [ "String", "rds_replica_hostname" ]
              ]
            ]
          ]
        ],
        [
          "Attribute",
          "value",
          [
            "Attr",
            [
              [
                "Attr", [ [ "Id", "module" ], [ "A_string", "rds_replica" ] ]
              ],
              [ "A_string", "hostname" ]
            ]
          ]
        ],
        [ "Attribute", "description", [ "String", "RDS replica hostname" ] ],
        [ "Attribute", "type", [ "String", "String" ] ],
        [ "Attribute", "overwrite", [ "String", "true" ] ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "resource",
      "labels": [
        [ "Lit", "aws_ssm_parameter" ], [ "Lit", "rds_replica_port" ]
      ],
      "body": [
        [
          "Attribute",
          "count",
          [
            "Cond",
            {
              "if_": [
                "Attr",
                [ [ "Id", "local" ], [ "A_string", "rds_replica_enabled" ] ]
              ],
              "then_": [ "Int", 1 ],
              "else_": [ "Int", 0 ]
            }
          ]
        ],
        [
          "Attribute",
          "name",
          [
            "Fun_call",
            [
              "format",
              [
                [
                  "Attr",
                  [
                    [ "Id", "var" ], [ "A_string", "chamber_parameter_name" ]
                  ]
                ],
                [
                  "Attr",
                  [ [ "Id", "local" ], [ "A_string", "chamber_service" ] ]
                ],
                [ "String", "rds_replica_port" ]
              ]
            ]
          ]
        ],
        [
          "Attribute",
          "value",
          [ "Attr", [ [ "Id", "var" ], [ "A_string", "rds_replica_port" ] ] ]
        ],
        [ "Attribute", "description", [ "String", "RDS replica port" ] ],
        [ "Attribute", "type", [ "String", "String" ] ],
        [ "Attribute", "overwrite", [ "String", "true" ] ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "output",
      "labels": [ [ "Lit", "rds_replica_instance_id" ] ],
      "body": [
        [
          "Attribute",
          "value",
          [
            "Attr",
            [
              [
                "Attr", [ [ "Id", "module" ], [ "A_string", "rds_replica" ] ]
              ],
              [ "A_string", "instance_id" ]
            ]
          ]
        ],
        [
          "Attribute",
          "description",
          [ "String", "RDS replica ID of the instance" ]
        ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "output",
      "labels": [ [ "Lit", "rds_replica_instance_address" ] ],
      "body": [
        [
          "Attribute",
          "value",
          [
            "Attr",
            [
              [
                "Attr", [ [ "Id", "module" ], [ "A_string", "rds_replica" ] ]
              ],
              [ "A_string", "instance_address" ]
            ]
          ]
        ],
        [
          "Attribute",
          "description",
          [ "String", "RDS replica address of the instance" ]
        ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "output",
      "labels": [ [ "Lit", "rds_replica_instance_endpoint" ] ],
      "body": [
        [
          "Attribute",
          "value",
          [
            "Attr",
            [
              [
                "Attr", [ [ "Id", "module" ], [ "A_string", "rds_replica" ] ]
              ],
              [ "A_string", "instance_endpoint" ]
            ]
          ]
        ],
        [
          "Attribute",
          "description",
          [ "String", "RDS replica DNS Endpoint of the instance" ]
        ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "output",
      "labels": [ [ "Lit", "rds_replica_port" ] ],
      "body": [
        [
          "Attribute",
          "value",
          [
            "Cond",
            {
              "if_": [
                "Attr",
                [ [ "Id", "local" ], [ "A_string", "rds_replica_enabled" ] ]
              ],
              "then_": [
                "Attr",
                [ [ "Id", "var" ], [ "A_string", "rds_replica_port" ] ]
              ],
              "else_": [
                "Attr", [ [ "Id", "local" ], [ "A_string", "null" ] ]
              ]
            }
          ]
        ],
        [ "Attribute", "description", [ "String", "RDS replica port" ] ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "output",
      "labels": [ [ "Lit", "rds_replica_hostname" ] ],
      "body": [
        [
          "Attribute",
          "value",
          [
            "Attr",
            [
              [
                "Attr", [ [ "Id", "module" ], [ "A_string", "rds_replica" ] ]
              ],
              [ "A_string", "hostname" ]
            ]
          ]
        ],
        [
          "Attribute",
          "description",
          [ "String", "RDS replica host name of the instance" ]
        ]
      ]
    }
  ]
]
