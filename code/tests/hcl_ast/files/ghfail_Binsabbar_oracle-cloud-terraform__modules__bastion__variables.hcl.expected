          "Attribute",
          "description",
          [ "String", "Name for the bastion service" ]
        ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "ssh_public_keys" ] ],
      "body": [
        [
          "Attribute",
          "type",
          [ "Fun_call", [ "map", [ [ "Id", "string" ] ] ] ]
        ],
        [
          "Attribute",
          "description",
          [ "String", "Map of username to SSH public key content" ]
        ],
        [ "Attribute", "sensitive", [ "Bool", true ] ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "bastion_sessions" ] ],
      "body": [
        [
          "Attribute",
          "description",
          [ "String", "Map of bastion sessions configuration" ]
        ],
        [
          "Attribute",
          "type",
          [
            "Fun_call",
            [
              "map",
              [
                [
                  "Fun_call",
                  [
                    "object",
                    [
                      [
                        "Object",
                        [
                          [ [ "Bare", "type" ], [ "Id", "string" ] ],
                          [
                            [ "Bare", "pool_name" ],
                            [
                              "Fun_call",
                              [
                                "optional",
                                [ [ "Id", "string" ], [ "String", "" ] ]
                              ]
                            ]
                          ],
                          [
                            [ "Bare", "instance_names" ],
                            [
                              "Fun_call",
                              [
                                "optional",
                                [
                                  [
                                    "Fun_call",
                                    [ "list", [ [ "Id", "string" ] ] ]
                                  ],
                                  [ "Tuple", [] ]
                                ]
                              ]
                            ]
                          ],
                          [
                            [ "Bare", "compartment_id" ],
                            [
                              "Fun_call",
                              [
                                "optional",
                                [ [ "Id", "string" ], [ "String", "" ] ]
                              ]
                            ]
                          ],
                          [ [ "Bare", "time" ], [ "Id", "number" ] ],
                          [ [ "Bare", "active" ], [ "Id", "bool" ] ],
                          [ [ "Bare", "user" ], [ "Id", "string" ] ],
                          [
                            [ "Bare", "nodes" ],
                            [
                              "Fun_call",
                              [
                                "optional",
                                [
                                  [
                                    "Fun_call",
                                    [ "list", [ [ "Id", "string" ] ] ]
                                  ],
                                  [ "Tuple", [ [ "String", "all" ] ] ]
                                ]
                              ]
                            ]
                          ],
                          [
                            [ "Bare", "os_user" ],
                            [
                              "Fun_call",
                              [
                                "optional",
                                [ [ "Id", "string" ], [ "String", "opc" ] ]
                              ]
                            ]
                          ],
                          [
                            [ "Bare", "port" ],
                            [
                              "Fun_call",
                              [
                                "optional",
                                [ [ "Id", "number" ], [ "Int", 22 ] ]
                              ]
                            ]
                          ]
                        ]
                      ]
                    ]
                  ]
                ]
              ]
            ]
          ]
        ],
        [
          "Block",
          {
            "type_": "validation",
            "labels": [],
            "body": [
              [
                "Attribute",
                "condition",
                [
                  "Fun_call",
                  [
                    "alltrue",
                    [
                      [
                        "For_tuple",
                        {
                          "identifiers": [ "session", [] ],
                          "input": [
                            "Attr",
                            [
                              [ "Id", "var" ],
                              [ "A_string", "bastion_sessions" ]
                            ]
                          ],
                          "output": [
                            "Fun_call",
                            [
                              "contains",
                              [
                                [
                                  "Tuple",
                                  [
                                    [ "String", "oke" ],
                                    [ "String", "compute" ]
                                  ]
                                ],
                                [
                                  "Attr",
                                  [
                                    [ "Id", "session" ],
                                    [ "A_string", "type" ]
                                  ]
                                ]
                              ]
                            ]
                          ],
                          "cond": null
                        }
                      ]
                    ]
                  ]
                ]
              ],
              [
                "Attribute",
                "error_message",
                [
                  "String", "Session type must be either 'oke' or 'compute'."
                ]
              ]
            ]
          }
        ],
        [
          "Block",
          {
            "type_": "validation",
            "labels": [],
            "body": [
              [
                "Attribute",
                "condition",
                [
                  "Fun_call",
                  [
                    "alltrue",
                    [
                      [
                        "For_tuple",
                        {
                          "identifiers": [ "session", [] ],
                          "input": [
                            "Attr",
                            [
                              [ "Id", "var" ],
                              [ "A_string", "bastion_sessions" ]
                            ]
                          ],
                          "output": [
                            "Log_or",
                            [
                              [
                                "Log_and",
                                [
                                  [
                                    "Equal",
                                    [
                                      [
                                        "Attr",
                                        [
                                          [ "Id", "session" ],
                                          [ "A_string", "type" ]
                                        ]
                                      ],
                                      [ "String", "oke" ]
                                    ]
                                  ],
                                  [
                                    "Not_equal",
                                    [
                                      [
                                        "Attr",
                                        [
                                          [ "Id", "session" ],
                                          [ "A_string", "pool_name" ]
                                        ]
                                      ],
                                      [ "String", "" ]
                                    ]
                                  ]
                                ]
                              ],
                              [
                                "Log_and",
                                [
                                  [
                                    "Equal",
                                    [
                                      [
                                        "Attr",
                                        [
                                          [ "Id", "session" ],
                                          [ "A_string", "type" ]
                                        ]
                                      ],
                                      [ "String", "compute" ]
                                    ]
                                  ],
                                  [
                                    "Gt",
                                    [
                                      [
                                        "Fun_call",
                                        [
                                          "length",
                                          [
                                            [
                                              "Attr",
                                              [
                                                [ "Id", "session" ],
                                                [
                                                  "A_string",
                                                  "instance_names"
                                                ]
                                              ]
                                            ]
                                          ]
                                        ]
                                      ],
                                      [ "Int", 0 ]
                                    ]
                                  ]
                                ]
                              ]
                            ]
                          ],
                          "cond": null
                        }
                      ]
                    ]
                  ]
                ]
              ],
              [
                "Attribute",
                "error_message",
                [
                  "String",
                  "For OKE sessions, pool_name must be specified. For compute sessions, instance_names must be provided."
                ]
              ]
            ]
          }
        ],
        [
          "Block",
          {
            "type_": "validation",
            "labels": [],
            "body": [
              [
                "Attribute",
                "condition",
                [
                  "Fun_call",
                  [
                    "alltrue",
                    [
                      [
                        "For_tuple",
                        {
                          "identifiers": [ "session", [] ],
                          "input": [
                            "Attr",
                            [
                              [ "Id", "var" ],
                              [ "A_string", "bastion_sessions" ]
                            ]
                          ],
                          "output": [
                            "Log_and",
                            [
                              [
                                "Gt",
                                [
                                  [
                                    "Attr",
                                    [
                                      [ "Id", "session" ],
                                      [ "A_string", "time" ]
                                    ]
                                  ],
                                  [ "Int", 0 ]
                                ]
                              ],
                              [
                                "Lte",
                                [
                                  [
                                    "Attr",
                                    [
                                      [ "Id", "session" ],
                                      [ "A_string", "time" ]
                                    ]
                                  ],
                                  [ "Int", 180 ]
                                ]
                              ]
                            ]
                          ],
                          "cond": null
                        }
                      ]
                    ]
                  ]
                ]
              ],
              [
                "Attribute",
                "error_message",
                [
                  "String", "Session time must be between 1 and 180 minutes."
                ]
              ]
            ]
          }
        ]
      ]
    }
  ],
