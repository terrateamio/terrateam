  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "allowed_ips" ] ],
      "body": [
        [
          "Attribute",
          "type",
          [ "Fun_call", [ "list", [ [ "Id", "string" ] ] ] ]
        ],
        [
          "Attribute",
          "description",
          [ "String", "List of allowed IP CIDR blocks for bastion access" ]
        ],
        [
          "Attribute",
          "default",
          [
            "Tuple",
            [ [ "String", "10.0.0.0/8" ], [ "String", "172.16.0.0/12" ] ]
          ]
        ],
        [
          "Block",
          {
            "type_": "validation",
            "labels": [],
            "body": [
              [
                "Attribute",
                "condition",
                [
                  "Fun_call",
                  [
                    "alltrue",
                    [
                      [
                        "For_tuple",
                        {
                          "identifiers": [ "ip", [] ],
                          "input": [
                            "Attr",
                            [
                              [ "Id", "var" ], [ "A_string", "allowed_ips" ]
                            ]
                          ],
                          "output": [
                            "Fun_call",
                            [
                              "can",
                              [
                                [
                                  "Fun_call",
                                  [
                                    "cidrhost",
                                    [ [ "Id", "ip" ], [ "Int", 0 ] ]
                                  ]
                                ]
                              ]
                            ]
                          ],
                          "cond": null
                        }
                      ]
                    ]
                  ]
                ]
              ],
              [
                "Attribute",
                "error_message",
                [ "String", "All allowed_ips must be valid CIDR blocks." ]
              ]
            ]
          }
        ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "max_session_ttl_seconds" ] ],
      "body": [
        [ "Attribute", "type", [ "Id", "number" ] ],
        [
          "Attribute",
          "description",
          [ "String", "Maximum session TTL in seconds for the bastion" ]
        ],
        [ "Attribute", "default", [ "Int", 7200 ] ],
        [
          "Block",
          {
            "type_": "validation",
            "labels": [],
            "body": [
              [
                "Attribute",
                "condition",
                [
                  "Log_and",
                  [
                    [
                      "Gte",
                      [
                        [
                          "Attr",
                          [
                            [ "Id", "var" ],
                            [ "A_string", "max_session_ttl_seconds" ]
                          ]
                        ],
                        [ "Int", 1800 ]
                      ]
                    ],
                    [
                      "Lte",
                      [
                        [
                          "Attr",
                          [
                            [ "Id", "var" ],
                            [ "A_string", "max_session_ttl_seconds" ]
                          ]
                        ],
                        [ "Int", 10800 ]
                      ]
                    ]
                  ]
                ]
              ],
              [
                "Attribute",
                "error_message",
                [
                  "String",
                  "max_session_ttl_seconds must be between 1800 (30 min) and 10800 (3 hours)."
                ]
              ]
            ]
          }
        ]
      ]
    }
  ]
