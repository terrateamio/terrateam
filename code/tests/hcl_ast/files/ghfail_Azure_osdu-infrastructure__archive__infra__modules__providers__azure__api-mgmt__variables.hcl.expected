  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "policy" ] ],
      "body": [
        [
          "Attribute",
          "description",
          [
            "String",
            "Service policy xml content and format. Content can be inlined xml or a url"
          ]
        ],
        [
          "Attribute",
          "type",
          [
            "Fun_call",
            [
              "object",
              [
                [
                  "Object",
                  [
                    [ [ "Bare", "content" ], [ "Id", "string" ] ],
                    [ [ "Bare", "format" ], [ "Id", "string" ] ]
                  ]
                ]
              ]
            ]
          ]
        ],
        [
          "Attribute",
          "default",
          [
            "Object",
            [
              [
                [ "Bare", "content" ],
                [
                  "Heredoc",
                  [
                    "XML",
                    "\n<policies>\n    <inbound />\n    <backend />\n    <outbound />\n    <on-error />\n</policies>\n"
                  ]
                ]
              ],
              [ [ "Bare", "format" ], [ "String", "xml" ] ]
            ]
          ]
        ]
      ]
    }
  ],
