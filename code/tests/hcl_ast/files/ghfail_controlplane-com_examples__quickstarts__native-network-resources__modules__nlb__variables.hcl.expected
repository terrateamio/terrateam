[
  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "name-prefix" ] ],
      "body": [
        [ "Attribute", "type", [ "Id", "string" ] ],
        [
          "Attribute",
          "description",
          [
            "String",
            "A name summarizing the resources to be fronted by the NLB / endpoint service"
          ]
        ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "internal" ] ],
      "body": [
        [ "Attribute", "type", [ "Id", "bool" ] ],
        [
          "Attribute",
          "description",
          [
            "String",
            "True if the NLB should be internal only. False if it should be exposed to the internet."
          ]
        ],
        [ "Attribute", "default", [ "Bool", true ] ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "vpc-id" ] ],
      "body": [
        [ "Attribute", "type", [ "Id", "string" ] ],
        [
          "Attribute",
          "description",
          [ "String", "The VPC hosting the network resources" ]
        ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "tags" ] ],
      "body": [
        [
          "Attribute",
          "type",
          [ "Fun_call", [ "map", [ [ "Id", "string" ] ] ] ]
        ],
        [
          "Attribute",
          "description",
          [
            "String",
            "A map containing labels for all taggable resources that are created by this module"
          ]
        ],
        [ "Attribute", "default", [ "Object", [] ] ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "subnet-ids" ] ],
      "body": [
        [
          "Attribute",
          "type",
          [ "Fun_call", [ "list", [ [ "Id", "string" ] ] ] ]
        ],
        [
          "Attribute", "description", [ "String", "The list of subnet ids " ]
        ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "targets" ] ],
      "body": [
        [
          "Attribute",
          "type",
          [
            "Fun_call",
            [
              "map",
              [
                [
                  "Fun_call",
                  [
                    "object",
                    [
                      [
                        "Object",
                        [
                          [ [ "Bare", "ip-address" ], [ "Id", "string" ] ],
                          [ [ "Bare", "internal-port" ], [ "Id", "number" ] ],
                          [ [ "Bare", "external-port" ], [ "Id", "number" ] ]
                        ]
                      ]
                    ]
                  ]
                ]
              ]
            ]
          ]
        ],
        [ "Attribute", "default", [ "Object", [] ] ],
        [
          "Attribute",
          "description",
          [
            "String",
            "A map of objects containing listener ip addresses and port numbers"
          ]
        ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "variable",
      "labels": [
        [ "Lit", "include-all-resources-in-separate-target-groups" ]
      ],
      "body": [
        [ "Attribute", "type", [ "Id", "bool" ] ],
        [ "Attribute", "default", [ "Bool", true ] ],
        [
          "Attribute",
          "description",
          [
            "String",
            "If this is true one listener, target group, and target will be included for every resource"
          ]
        ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "include-all-resources-in-one-target-group" ] ],
      "body": [
        [ "Attribute", "type", [ "Id", "bool" ] ],
        [ "Attribute", "default", [ "Bool", true ] ],
        [
          "Attribute",
          "description",
          [
            "String",
            "If this is true, a listener and target group containing all of the listed targets will be included."
          ]
        ]
      ]
    }
  ]
]
