                      [ "Id", "data" ],
                      [ "A_string", "aws_iam_policy_document" ]
                    ]
                  ],
                  [ "A_string", "allow_automation_invoke" ]
                ]
              ],
              [ "A_string", "json" ]
            ]
          ]
        ],
        [
          "Attribute",
          "role",
          [
            "Attr",
