[
  [
    "Attribute",
    "list",
    [
      "Template",
      [
        [
          "For_directive",
          {
            "vars": [ "item", null ],
            "input": [ "Id", "items" ],
            "body": [
              [
                "Interpolation",
                {
                  "expr": [ "Id", "item" ],
                  "strip_before": false,
                  "strip_after": false
                }
              ],
              [ "Literal", ", " ]
            ],
            "strip_before": false,
            "strip_after": false
          }
        ]
      ]
    ]
  ],
