        [
          "Attribute",
          "description",
          [ "String", "Kinesis Firehose Stream Name" ]
        ],
        [ "Attribute", "default", [ "String", "cxcloud" ] ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "account_id" ] ],
      "body": [
        [ "Attribute", "type", [ "Id", "string" ] ],
        [ "Attribute", "description", [ "String", "AWS account ID" ] ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "region" ] ],
      "body": [
        [ "Attribute", "type", [ "Id", "string" ] ],
        [ "Attribute", "description", [ "String", "AWS region" ] ],
        [ "Attribute", "default", [ "String", "eu-west-1" ] ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "bucket" ] ],
      "body": [
        [ "Attribute", "type", [ "Id", "string" ] ],
        [ "Attribute", "description", [ "String", "S3 bucket for logs" ] ]
      ]
    }
  ],
  [
