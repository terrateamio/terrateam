      "body": [
        [ "Attribute", "type", [ "Id", "string" ] ],
        [ "Attribute", "description", [ "String", "Elasticsearch ARN" ] ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "s3_buffer_size" ] ],
