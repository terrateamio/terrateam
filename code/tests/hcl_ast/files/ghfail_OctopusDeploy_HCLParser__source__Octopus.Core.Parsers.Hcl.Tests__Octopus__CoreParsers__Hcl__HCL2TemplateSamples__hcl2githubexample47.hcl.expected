        [ "Attribute", "type", [ "Id", "string" ] ],
        [ "Attribute", "description", [ "String", "S3 Buffer Size" ] ],
        [ "Attribute", "default", [ "Int", 10 ] ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "s3_buffer_interval" ] ],
      "body": [
        [ "Attribute", "type", [ "Id", "string" ] ],
        [ "Attribute", "description", [ "String", "S3 buffer interval" ] ],
        [ "Attribute", "default", [ "Int", 60 ] ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "s3_compression_format" ] ],
      "body": [
        [ "Attribute", "type", [ "Id", "string" ] ],
        [
          "Attribute",
          "description",
          [ "String", "S3 log compression format" ]
        ],
        [ "Attribute", "default", [ "String", "GZIP" ] ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "es_index_name" ] ],
      "body": [
        [ "Attribute", "type", [ "Id", "string" ] ],
        [
          "Attribute",
          "description",
          [ "String", "Elasticsearch index name" ]
        ],
        [ "Attribute", "default", [ "String", "cxcloud" ] ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "es_type_name" ] ],
      "body": [
        [ "Attribute", "type", [ "Id", "string" ] ],
        [
          "Attribute",
          "description",
          [ "String", "Elasticsearch index type" ]
        ],
        [ "Attribute", "default", [ "String", "logs" ] ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "es_buffering_size" ] ],
      "body": [
        [ "Attribute", "type", [ "Id", "string" ] ],
        [
          "Attribute",
          "description",
          [ "String", "Elasticsearch buffering size" ]
        ],
        [ "Attribute", "default", [ "Int", 10 ] ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "es_buffering_interval" ] ],
      "body": [
        [ "Attribute", "type", [ "Id", "string" ] ],
        [
          "Attribute",
          "description",
          [ "String", "Elasticsearch buffering interval" ]
        ],
        [ "Attribute", "default", [ "Int", 60 ] ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "s3_backup_mode" ] ],
