  ],
  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "whitelisted_aws_account_arns" ] ],
      "body": [
        [
          "Attribute",
          "type",
          [ "Fun_call", [ "list", [ [ "Id", "string" ] ] ] ]
        ],
        [
          "Attribute",
          "description",
          [
            "String",
            "Whitelisted AWS ARNs to assume role for Kinesis Firehose access"
          ]
        ]
