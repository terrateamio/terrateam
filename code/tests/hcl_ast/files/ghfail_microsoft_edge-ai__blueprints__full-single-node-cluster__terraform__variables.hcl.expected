                            [
                              [ "Id", "var" ],
                              [ "A_string", "custom_akri_connectors" ]
                            ]
                          ],
                          "output": [
                            "Fun_call",
                            [
                              "contains",
                              [
                                [
                                  "Tuple",
                                  [
                                    [ "String", "rest" ],
                                    [ "String", "media" ],
                                    [ "String", "onvif" ],
                                    [ "String", "sse" ],
                                    [ "String", "custom" ]
                                  ]
                                ],
                                [
