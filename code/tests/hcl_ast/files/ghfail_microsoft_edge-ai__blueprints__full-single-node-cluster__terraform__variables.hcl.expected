            [
              "EOT",
              "\nList of custom Akri connector templates with user-defined endpoint types and container images.\nSupports built-in types (rest, media, onvif, sse) or custom types with custom_endpoint_type and custom_image_name.\nBuilt-in connectors default to mcr.microsoft.com/azureiotoperations/akri-connectors/connector_type:0.5.1.\n"
            ]
          ]
        ],
        [
          "Block",
          {
            "type_": "validation",
            "labels": [],
            "body": [
              [
