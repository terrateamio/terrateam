[
  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "environment" ] ],
      "body": [
        [ "Attribute", "type", [ "Id", "string" ] ],
        [
          "Attribute",
          "description",
          [
            "String",
            "Environment for all resources in this module: dev, test, or prod"
          ]
        ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "location" ] ],
      "body": [
        [ "Attribute", "type", [ "Id", "string" ] ],
        [
          "Attribute",
          "description",
          [ "String", "Location for all resources in this module" ]
        ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "resource_prefix" ] ],
      "body": [
        [ "Attribute", "type", [ "Id", "string" ] ],
        [
          "Attribute",
          "description",
          [ "String", "Prefix for all resources in this module" ]
        ],
        [
          "Block",
          {
            "type_": "validation",
            "labels": [],
            "body": [
              [
                "Attribute",
                "condition",
                [
                  "Log_and",
                  [
                    [
                      "Gt",
                      [
                        [
                          "Fun_call",
                          [
                            "length",
                            [
                              [
                                "Attr",
                                [
                                  [ "Id", "var" ],
                                  [ "A_string", "resource_prefix" ]
                                ]
                              ]
                            ]
                          ]
                        ],
                        [ "Int", 0 ]
                      ]
                    ],
                    [
                      "Fun_call",
                      [
                        "can",
                        [
                          [
                            "Fun_call",
                            [
                              "regex",
                              [
                                [ "String", "^[a-zA-Z](?:-?[a-zA-Z0-9])*$" ],
                                [
                                  "Attr",
                                  [
                                    [ "Id", "var" ],
                                    [ "A_string", "resource_prefix" ]
                                  ]
                                ]
                              ]
                            ]
                          ]
                        ]
                      ]
                    ]
                  ]
                ]
              ],
              [
                "Attribute",
                "error_message",
                [
                  "String",
                  "Resource prefix must not be empty, must only contain alphanumeric characters and dashes. Must start with an alphabetic character."
                ]
              ]
            ]
          }
        ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "instance" ] ],
      "body": [
        [ "Attribute", "type", [ "Id", "string" ] ],
        [
          "Attribute",
          "description",
          [
            "String",
            "Instance identifier for naming resources: 001, 002, etc"
          ]
        ],
        [ "Attribute", "default", [ "String", "001" ] ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "resource_group_name" ] ],
      "body": [
        [ "Attribute", "type", [ "Id", "string" ] ],
        [
          "Attribute",
          "description",
          [
            "String",
            "Name of the resource group to create or use. Otherwise, 'rg-{resource_prefix}-{environment}-{instance}'"
          ]
        ],
        [ "Attribute", "default", [ "Null" ] ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "use_existing_resource_group" ] ],
      "body": [
        [ "Attribute", "type", [ "Id", "bool" ] ],
        [
          "Attribute",
          "description",
          [
            "String",
            "Whether to use an existing resource group with the provided or computed name instead of creating a new one"
          ]
        ],
        [ "Attribute", "default", [ "Bool", false ] ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "custom_locations_oid" ] ],
      "body": [
        [ "Attribute", "type", [ "Id", "string" ] ],
        [
          "Attribute",
          "description",
          [
            "Heredoc",
            [
              "EOT",
              "\nThe object id of the Custom Locations Entra ID application for your tenant\nIf none is provided, the script attempts to retrieve this value which requires 'Application.Read.All' or 'Directory.Read.All' permissions\n\n```sh\naz ad sp show --id bc313c14-388c-4e7d-a58e-70017303ee3b --query id -o tsv\n```\n"
            ]
          ]
        ],
        [ "Attribute", "default", [ "Null" ] ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "should_add_current_user_cluster_admin" ] ],
      "body": [
        [ "Attribute", "type", [ "Id", "bool" ] ],
        [
          "Attribute",
          "description",
          [
            "String",
            "Whether to give the current signed-in user cluster-admin permissions on the new cluster"
          ]
        ],
        [ "Attribute", "default", [ "Bool", true ] ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "should_get_custom_locations_oid" ] ],
      "body": [
        [ "Attribute", "type", [ "Id", "bool" ] ],
        [
          "Attribute",
          "description",
          [
            "Heredoc",
            [
              "EOT",
              "\nWhether to get the Custom Locations object ID using Terraform's azuread provider\nOtherwise, provide 'custom_locations_oid' or rely on `az connectedk8s enable-features` during cluster setup\n"
            ]
          ]
        ],
        [ "Attribute", "default", [ "Bool", true ] ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "should_deploy_aio" ] ],
      "body": [
        [ "Attribute", "type", [ "Id", "bool" ] ],
        [
          "Attribute",
          "description",
          [
            "String",
            "Whether to deploy Azure IoT Operations and its dependent edge components (assets, edge messaging). When false, deploys Arc-connected cluster with extensions and observability only"
          ]
        ],
        [ "Attribute", "default", [ "Bool", true ] ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "aio_features" ] ],
      "body": [
        [
          "Attribute",
          "description",
          [
            "String",
            "AIO instance features with mode ('Stable', 'Preview', 'Disabled') and settings ('Enabled', 'Disabled')"
          ]
        ],
        [
          "Attribute",
          "type",
          [
            "Fun_call",
            [
              "map",
              [
                [
                  "Fun_call",
                  [
                    "object",
                    [
                      [
                        "Object",
                        [
                          [
                            [ "Bare", "mode" ],
                            [
                              "Fun_call",
                              [ "optional", [ [ "Id", "string" ] ] ]
                            ]
                          ],
                          [
                            [ "Bare", "settings" ],
                            [
                              "Fun_call",
                              [
                                "optional",
                                [
                                  [
                                    "Fun_call",
                                    [ "map", [ [ "Id", "string" ] ] ]
                                  ]
                                ]
                              ]
                            ]
                          ]
                        ]
                      ]
                    ]
                  ]
                ]
              ]
            ]
          ]
        ],
        [ "Attribute", "default", [ "Null" ] ],
        [
          "Block",
          {
            "type_": "validation",
            "labels": [],
            "body": [
              [
                "Attribute",
                "condition",
                [
                  "Cond",
                  {
                    "if_": [
                      "Equal",
                      [
                        [
                          "Attr",
                          [ [ "Id", "var" ], [ "A_string", "aio_features" ] ]
                        ],
                        [ "Null" ]
                      ]
                    ],
                    "then_": [ "Bool", true ],
                    "else_": [
                      "Fun_call",
                      [
                        "alltrue",
                        [
                          [
                            "For_tuple",
                            {
                              "identifiers": [
                                "feature_name", [ "feature" ]
                              ],
                              "input": [
                                "Fun_call",
                                [
                                  "coalesce",
                                  [
                                    [
                                      "Attr",
                                      [
                                        [ "Id", "var" ],
                                        [ "A_string", "aio_features" ]
                                      ]
                                    ],
                                    [ "Object", [] ]
                                  ]
                                ]
                              ],
                              "output": [
                                "Fun_call",
                                [
                                  "try",
                                  [
                                    [
                                      "Cond",
                                      {
                                        "if_": [
                                          "Equal",
                                          [
                                            [
                                              "Attr",
                                              [
                                                [ "Id", "feature" ],
                                                [ "A_string", "mode" ]
                                              ]
                                            ],
                                            [ "Null" ]
                                          ]
                                        ],
                                        "then_": [ "Bool", true ],
                                        "else_": [
                                          "Fun_call",
                                          [
                                            "contains",
                                            [
                                              [
                                                "Tuple",
                                                [
                                                  [ "String", "Stable" ],
                                                  [ "String", "Preview" ],
                                                  [ "String", "Disabled" ]
                                                ]
                                              ],
                                              [
                                                "Attr",
                                                [
                                                  [ "Id", "feature" ],
                                                  [ "A_string", "mode" ]
                                                ]
                                              ]
                                            ]
                                          ]
                                        ]
                                      }
                                    ],
                                    [ "Bool", true ]
                                  ]
                                ]
                              ],
                              "cond": null
                            }
                          ]
                        ]
                      ]
                    ]
                  }
                ]
              ],
              [
                "Attribute",
                "error_message",
                [
                  "String",
                  "Feature mode must be one of: 'Stable', 'Preview', or 'Disabled'."
                ]
              ]
            ]
          }
        ],
        [
          "Block",
          {
            "type_": "validation",
            "labels": [],
            "body": [
              [
                "Attribute",
                "condition",
                [
                  "Cond",
                  {
                    "if_": [
                      "Equal",
                      [
                        [
                          "Attr",
                          [ [ "Id", "var" ], [ "A_string", "aio_features" ] ]
                        ],
                        [ "Null" ]
                      ]
                    ],
                    "then_": [ "Bool", true ],
                    "else_": [
                      "Fun_call",
                      [
                        "alltrue",
                        [
                          [
                            "For_tuple",
                            {
                              "identifiers": [
                                "feature_name", [ "feature" ]
                              ],
                              "input": [
                                "Fun_call",
                                [
                                  "coalesce",
                                  [
                                    [
                                      "Attr",
                                      [
                                        [ "Id", "var" ],
                                        [ "A_string", "aio_features" ]
                                      ]
                                    ],
                                    [ "Object", [] ]
                                  ]
                                ]
                              ],
                              "output": [
                                "Fun_call",
                                [
                                  "try",
                                  [
                                    [
                                      "Cond",
                                      {
                                        "if_": [
                                          "Equal",
                                          [
                                            [
                                              "Attr",
                                              [
                                                [ "Id", "feature" ],
                                                [ "A_string", "settings" ]
                                              ]
                                            ],
                                            [ "Null" ]
                                          ]
                                        ],
                                        "then_": [ "Bool", true ],
                                        "else_": [
                                          "Fun_call",
                                          [
                                            "alltrue",
                                            [
                                              [
                                                "For_tuple",
                                                {
                                                  "identifiers": [
                                                    "setting_name",
                                                    [ "setting_value" ]
                                                  ],
                                                  "input": [
                                                    "Attr",
                                                    [
                                                      [ "Id", "feature" ],
                                                      [
                                                        "A_string",
                                                        "settings"
                                                      ]
                                                    ]
                                                  ],
                                                  "output": [
                                                    "Fun_call",
                                                    [
                                                      "contains",
                                                      [
                                                        [
                                                          "Tuple",
                                                          [
                                                            [
                                                              "String",
                                                              "Enabled"
                                                            ],
                                                            [
                                                              "String",
                                                              "Disabled"
                                                            ]
                                                          ]
                                                        ],
                                                        [
                                                          "Id",
                                                          "setting_value"
                                                        ]
                                                      ]
                                                    ]
                                                  ],
                                                  "cond": null
                                                }
                                              ]
                                            ]
                                          ]
                                        ]
                                      }
                                    ],
                                    [ "Bool", true ]
                                  ]
                                ]
                              ],
                              "cond": null
                            }
                          ]
                        ]
                      ]
                    ]
                  }
                ]
              ],
              [
                "Attribute",
                "error_message",
                [
                  "String",
                  "Feature settings values must be either 'Enabled' or 'Disabled'."
                ]
              ]
            ]
          }
        ]
      ]
    }
  ],
