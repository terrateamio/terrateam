[
  [
    "Block",
    {
      "type_": "resource",
      "labels": [
        [ "Lit", "aws_iam_role" ], [ "Lit", "iam_for_notify_slack" ]
      ],
      "body": [
        [ "Attribute", "name", [ "String", "iam_for_lambda" ] ],
        [
          "Attribute",
          "assume_role_policy",
          [
            "Heredoc",
            [
              "EOF",
              "\n{\n  \"Version\": \"2012-10-17\",\n  \"Statement\": [\n    {\n      \"Action\": \"sts:AssumeRole\",\n      \"Principal\": {\n        \"Service\": \"lambda.amazonaws.com\"\n      },\n      \"Effect\": \"Allow\",\n      \"Sid\": \"\"\n    }\n  ]\n}\n"
            ]
          ]
        ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "data",
      "labels": [ [ "Lit", "archive_file" ], [ "Lit", "notify_slack_sns" ] ],
      "body": [
        [ "Attribute", "type", [ "String", "zip" ] ],
        [
          "Attribute",
          "source_file",
          [ "String", "lambda/lambda_notify_slack.js" ]
        ],
        [
          "Attribute",
          "output_path",
          [ "String", "/tmp/lambda_notify_slack.js.zip" ]
        ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "resource",
      "labels": [
        [ "Lit", "aws_lambda_function" ], [ "Lit", "notify_slack_sns" ]
      ],
      "body": [
        [
          "Attribute",
          "filename",
          [ "String", "/tmp/lambda_notify_slack.js.zip" ]
        ],
        [ "Attribute", "function_name", [ "String", "NotifySlackSNS" ] ],
        [
          "Attribute",
          "role",
          [
            "Attr",
            [
              [
                "Attr",
                [
                  [ "Id", "aws_iam_role" ],
                  [ "A_string", "iam_for_notify_slack" ]
                ]
              ],
              [ "A_string", "arn" ]
            ]
          ]
        ],
        [
          "Attribute", "handler", [ "String", "lambda_notify_slack.handler" ]
        ],
        [
          "Attribute",
          "source_code_hash",
          [
            "Attr",
            [
              [
                "Attr",
                [
                  [
                    "Attr",
                    [ [ "Id", "data" ], [ "A_string", "archive_file" ] ]
                  ],
                  [ "A_string", "notify_slack_sns" ]
                ]
              ],
              [ "A_string", "output_base64sha256" ]
            ]
          ]
        ],
        [ "Attribute", "runtime", [ "String", "nodejs12.x" ] ],
        [
          "Block",
          {
            "type_": "environment",
            "labels": [],
            "body": [
              [
                "Attribute",
                "variables",
                [
                  "Object",
                  [
                    [
                      [ "Bare", "SLACK_WEBHOOK" ],
                      [
                        "Attr",
                        [ [ "Id", "var" ], [ "A_string", "slack_webhook" ] ]
                      ]
                    ]
                  ]
                ]
              ]
            ]
          }
        ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "resource",
      "labels": [
        [ "Lit", "aws_lambda_permission" ], [ "Lit", "notify_slack_warning" ]
      ],
      "body": [
        [
          "Attribute",
          "statement_id",
          [ "String", "AllowExecutionFromSNSWarningAlert" ]
        ],
        [ "Attribute", "action", [ "String", "lambda:InvokeFunction" ] ],
        [
          "Attribute",
          "function_name",
          [
            "Attr",
            [
              [
                "Attr",
                [
                  [ "Id", "aws_lambda_function" ],
                  [ "A_string", "notify_slack_sns" ]
                ]
              ],
              [ "A_string", "function_name" ]
            ]
          ]
        ],
        [ "Attribute", "principal", [ "String", "sns.amazonaws.com" ] ],
        [
          "Attribute",
          "source_arn",
          [
            "Attr",
            [
              [
                "Attr",
                [
                  [ "Id", "aws_sns_topic" ], [ "A_string", "alert_warning" ]
                ]
              ],
              [ "A_string", "arn" ]
            ]
          ]
        ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "resource",
      "labels": [
        [ "Lit", "aws_lambda_permission" ],
        [ "Lit", "notify_slack_critical" ]
      ],
      "body": [
        [
          "Attribute",
          "statement_id",
          [ "String", "AllowExecutionFromSNSCriticalAlert" ]
        ],
        [ "Attribute", "action", [ "String", "lambda:InvokeFunction" ] ],
        [
          "Attribute",
          "function_name",
          [
            "Attr",
            [
              [
                "Attr",
                [
                  [ "Id", "aws_lambda_function" ],
                  [ "A_string", "notify_slack_sns" ]
                ]
              ],
              [ "A_string", "function_name" ]
            ]
          ]
        ],
        [ "Attribute", "principal", [ "String", "sns.amazonaws.com" ] ],
        [
          "Attribute",
          "source_arn",
          [
            "Attr",
            [
              [
                "Attr",
                [
                  [ "Id", "aws_sns_topic" ], [ "A_string", "alert_critical" ]
                ]
              ],
              [ "A_string", "arn" ]
            ]
          ]
        ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "resource",
      "labels": [ [ "Lit", "aws_iam_policy" ], [ "Lit", "lambda_logging" ] ],
      "body": [
        [ "Attribute", "name", [ "String", "lambda_logging" ] ],
        [ "Attribute", "path", [ "String", "/" ] ],
        [
          "Attribute",
          "description",
          [ "String", "IAM policy for logging from a lambda" ]
        ],
        [
          "Attribute",
          "policy",
          [
            "Heredoc",
            [
              "EOF",
              "\n{\n  \"Version\": \"2012-10-17\",\n  \"Statement\": [\n    {\n      \"Action\": [\n        \"logs:CreateLogGroup\",\n        \"logs:CreateLogStream\",\n        \"logs:PutLogEvents\"\n      ],\n      \"Resource\": \"arn:aws:logs:*:*:*\",\n      \"Effect\": \"Allow\"\n    }\n  ]\n}\n"
            ]
          ]
        ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "resource",
      "labels": [
        [ "Lit", "aws_iam_role_policy_attachment" ], [ "Lit", "lambda_logs" ]
      ],
      "body": [
        [
          "Attribute",
          "role",
          [
            "Attr",
            [
              [
                "Attr",
                [
                  [ "Id", "aws_iam_role" ],
                  [ "A_string", "iam_for_notify_slack" ]
                ]
              ],
              [ "A_string", "name" ]
            ]
          ]
        ],
        [
          "Attribute",
          "policy_arn",
          [
            "Attr",
            [
              [
                "Attr",
                [
                  [ "Id", "aws_iam_policy" ],
                  [ "A_string", "lambda_logging" ]
                ]
              ],
              [ "A_string", "arn" ]
            ]
          ]
        ]
      ]
    }
  ]
]
