            [
              "EOF",
              "\nThe chart above shows Bytes downloaded.\n        \nMetric(s):\n<code>synthetics.real_browser.content_bytes</code>\n        \nThe file size in bytes of the response received for the primary URL of the test(s).\n"
            ]
          ]
        ],
        [ "Attribute", "name", [ "String", "Bytes Downloaded - Info" ] ]
      ]
    }
  ],
