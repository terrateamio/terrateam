        [
          "Attribute",
          "markdown",
          [
            "Heredoc",
            [
              "EOF",
              "\nThe chart above shows DNS time.\n        \nMetric(s):\n<code>synthetics.real_browser.first_request_dns_time_ms</code>\n        \nTime required to resolve the domain name into an IP address.\n"
            ]
          ]
        ],
        [ "Attribute", "name", [ "String", "DNS - Info" ] ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "resource",
      "labels": [
        [ "Lit", "signalfx_text_chart" ],
        [ "Lit", "synthetics_with_trends_8" ]
      ],
      "body": [
        [
          "Attribute",
          "markdown",
          [
            "Heredoc",
            [
              "EOF",
              "\nThe chart above shows TCP Connect Time.\n        \nMetric(s):\n<code>synthetics.real_browser.first_request_connect_time_ms</code>\n        \nThe time required to establish the TCP connection with the IP address of the resolved domain name.\n"
            ]
          ]
        ],
        [ "Attribute", "name", [ "String", "TCP Connect Time - Info" ] ]
      ]
    }
  ],
