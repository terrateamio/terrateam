  [
    "Block",
    {
      "type_": "resource",
      "labels": [
        [ "Lit", "signalfx_time_chart" ],
        [ "Lit", "synthetics_with_trends_4" ]
      ],
      "body": [
        [ "Attribute", "axes_include_zero", [ "Bool", false ] ],
        [ "Attribute", "axes_precision", [ "Int", 3 ] ],
        [ "Attribute", "color_by", [ "String", "Dimension" ] ],
        [
          "Attribute",
          "description",
          [ "String", "DNS average (blue), % week-on-week growth (brown)" ]
        ],
        [ "Attribute", "disable_sampling", [ "Bool", false ] ],
        [ "Attribute", "name", [ "String", "DNS - Trend" ] ],
        [ "Attribute", "plot_type", [ "String", "LineChart" ] ],
        [
          "Attribute",
          "program_text",
          [
            "Heredoc",
            [
              "EOF",
              "\nA = data('synthetics.real_browser.first_request_dns_time_ms').mean().publish(label='A')\nB = (A).mean().timeshift('1d').publish(label='B', enable=False)\nC = ((A-B)/B).scale(100).publish(label='C')\n"
            ]
          ]
        ],
        [ "Attribute", "show_data_markers", [ "Bool", false ] ],
        [ "Attribute", "show_event_lines", [ "Bool", false ] ],
        [ "Attribute", "stacked", [ "Bool", false ] ],
        [ "Attribute", "time_range", [ "Int", 604800 ] ],
        [ "Attribute", "timezone", [ "String", "UTC" ] ],
        [ "Attribute", "unit_prefix", [ "String", "Metric" ] ],
        [
          "Block",
          {
            "type_": "axis_left",
            "labels": [],
            "body": [ [ "Attribute", "label", [ "String", "Time" ] ] ]
          }
        ],
        [
          "Block",
          {
            "type_": "axis_right",
            "labels": [],
            "body": [
              [ "Attribute", "label", [ "String", "WoW Growth (%)" ] ]
            ]
