[
  [
    "Block",
    {
      "type_": "resource",
      "labels": [
        [ "Lit", "signalfx_text_chart" ],
        [ "Lit", "synthetics_with_trends_0" ]
      ],
      "body": [
        [
          "Attribute",
          "markdown",
          [
            "Heredoc",
            [
              "EOF",
              "\n<table width=\"100%\" rules=\"none\">\n<tbody><tr>\n<td align=\"left\" bgcolor=\"#ed0080\" height=\"80px\">\n<font size=\"5\" color=\"#ffffff\">Splunk Real Browser Metrics</font>\n</td>\n</tr>\n<tr>\n<td align=\"left\" bgcolor=\"#d53a70\" height=\"40px\">\n<font size=\"3\" color=\"#ffffff\">Metrics from Transactional and Single URL Real Browser Tests (DNS, Connect, SSL, TTFB, Total Time etc.)</font>\n</td>\n</tr>\n</tbody></table>\n"
            ]
          ]
        ],
        [ "Attribute", "name", [ "String", " " ] ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "resource",
      "labels": [
        [ "Lit", "signalfx_single_value_chart" ],
        [ "Lit", "synthetics_with_trends_1" ]
      ],
      "body": [
        [ "Attribute", "color_by", [ "String", "Metric" ] ],
        [
          "Attribute",
          "description",
          [ "String", "Average DNS Response Time" ]
        ],
        [ "Attribute", "is_timestamp_hidden", [ "Bool", false ] ],
        [ "Attribute", "max_delay", [ "Int", 0 ] ],
        [ "Attribute", "max_precision", [ "Int", 3 ] ],
        [ "Attribute", "name", [ "String", "DNS" ] ],
        [
          "Attribute",
          "program_text",
          [
            "String",
            "A = data('synthetics.real_browser.first_request_dns_time_ms', extrapolation='last_value').mean().publish(label='A')"
          ]
        ],
        [ "Attribute", "secondary_visualization", [ "String", "None" ] ],
        [ "Attribute", "show_spark_line", [ "Bool", false ] ],
        [ "Attribute", "unit_prefix", [ "String", "Metric" ] ],
        [
          "Block",
          {
            "type_": "viz_options",
            "labels": [],
            "body": [
              [ "Attribute", "color", [ "String", "green" ] ],
              [ "Attribute", "display_name", [ "String", "A" ] ],
              [ "Attribute", "label", [ "String", "A" ] ],
              [ "Attribute", "value_unit", [ "String", "Millisecond" ] ]
            ]
          }
        ]
      ]
    }
  ],
