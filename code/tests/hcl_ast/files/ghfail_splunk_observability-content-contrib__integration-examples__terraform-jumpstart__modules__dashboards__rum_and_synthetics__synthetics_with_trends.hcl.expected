  [
    "Block",
    {
      "type_": "resource",
      "labels": [
        [ "Lit", "signalfx_text_chart" ],
        [ "Lit", "synthetics_with_trends_16" ]
      ],
      "body": [
        [
          "Attribute",
          "markdown",
          [
            "Heredoc",
            [
              "EOF",
              "\nThe chart above shows TTFB.\n        \nMetric(s):\n<code>synthetics.real_browser.first_byte_time_ms</code>\n        \nThe time it took from the request being issued to receiving the first byte of data from the primary URL for the test(s). This is calculated as DNS + Connect + SSL + Send + Wait. For tests where the primary URL has a redirect chain, TTFB is calculated as the sum of the TTFB for each domain in the redirect chain.\n"
            ]
          ]
        ],
        [ "Attribute", "name", [ "String", "TTFB - Info" ] ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "resource",
      "labels": [
        [ "Lit", "signalfx_text_chart" ],
        [ "Lit", "synthetics_with_trends_17" ]
      ],
      "body": [
        [
          "Attribute",
          "markdown",
          [
            "Heredoc",
            [
              "EOF",
              "\nThe chart above shows Total Time.\n        \nMetric(s):\n<code>synthetics.real_browser.fully_loaded_time_ms</code>\n        \nThe total time it took for the test to complete.\n"
            ]
          ]
        ],
        [ "Attribute", "name", [ "String", "Total Time - Info" ] ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "resource",
      "labels": [
        [ "Lit", "signalfx_text_chart" ],
