      "body": [
        [
          "Attribute",
          "name",
          [ "Attr", [ [ "Id", "var" ], [ "A_string", "name" ] ] ]
        ],
        [
          "Attribute",
          "security_groups",
          [
            "Tuple",
            [ [ "Attr", [ [ "Id", "var" ], [ "A_string", "sg" ] ] ] ]
          ]
        ],
        [
          "Attribute",
          "subnets",
