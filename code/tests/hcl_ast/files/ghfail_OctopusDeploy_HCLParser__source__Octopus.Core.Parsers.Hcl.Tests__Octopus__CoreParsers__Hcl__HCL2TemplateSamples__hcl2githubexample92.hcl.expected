              [ "Attribute", "unhealthy_threshold", [ "Int", 2 ] ],
              [ "Attribute", "timeout", [ "Int", 3 ] ],
              [ "Attribute", "interval", [ "Int", 30 ] ],
              [ "Attribute", "target", [ "String", "http:80/" ] ]
            ]
          }
        ]
      ]
    }
  ]
]
