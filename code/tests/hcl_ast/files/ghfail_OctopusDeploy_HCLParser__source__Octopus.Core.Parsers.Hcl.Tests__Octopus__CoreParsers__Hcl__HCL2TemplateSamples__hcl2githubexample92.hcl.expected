[
  [
    "Block",
    {
      "type_": "data",
      "labels": [ [ "Lit", "template_file" ], [ "Lit", "user_data" ] ],
      "body": [
        [
          "Attribute",
          "template",
          [
            "Fun_call",
            [
              "file",
              [
                [
                  "Template",
                  [
                    [
                      "Interpolation",
                      {
                        "expr": [
                          "Attr",
                          [ [ "Id", "path" ], [ "A_string", "module" ] ]
                        ],
                        "strip_before": false,
                        "strip_after": false
                      }
                    ],
                    [ "Literal", "/userdata.sh" ]
                  ]
                ]
              ]
            ]
          ]
        ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "resource",
