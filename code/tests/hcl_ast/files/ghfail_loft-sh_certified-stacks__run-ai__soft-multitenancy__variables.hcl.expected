[
  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "name" ] ],
      "body": [
        [
          "Attribute",
          "description",
          [ "String", "Name prefix for the deployment (e.g. 'soft-mt')" ]
        ],
        [ "Attribute", "type", [ "Id", "string" ] ],
        [
          "Block",
          {
            "type_": "validation",
            "labels": [],
            "body": [
              [
                "Attribute",
                "condition",
                [
                  "Gt",
                  [
                    [
                      "Fun_call",
                      [
                        "length",
                        [
                          [
                            "Attr",
                            [ [ "Id", "var" ], [ "A_string", "name" ] ]
                          ]
                        ]
                      ]
                    ],
                    [ "Int", 0 ]
                  ]
                ]
              ],
              [
                "Attribute",
                "error_message",
                [ "String", "Name must not be empty." ]
              ]
            ]
          }
        ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "host_kubeconfig_path" ] ],
      "body": [
        [
          "Attribute",
          "description",
          [ "String", "Path to the host cluster kubeconfig" ]
        ],
        [ "Attribute", "type", [ "Id", "string" ] ],
        [ "Attribute", "default", [ "String", "~/.kube/config" ] ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "host_kube_context" ] ],
      "body": [
        [
          "Attribute",
          "description",
          [
            "String",
            "Kubeconfig context to use for the host cluster. If empty, uses the current context."
          ]
        ],
        [ "Attribute", "type", [ "Id", "string" ] ],
        [ "Attribute", "default", [ "String", "" ] ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "kubeconfig_output_dir" ] ],
      "body": [
        [
          "Attribute",
          "description",
          [
            "String",
            "Directory where vCluster kubeconfig files will be written"
          ]
        ],
        [ "Attribute", "type", [ "Id", "string" ] ],
        [ "Attribute", "default", [ "String", "." ] ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "skip_kubeconfig" ] ],
      "body": [
        [
          "Attribute",
          "description",
          [ "String", "Skip writing vCluster kubeconfig files to disk" ]
        ],
        [ "Attribute", "type", [ "Id", "bool" ] ],
        [ "Attribute", "default", [ "Bool", false ] ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "platform_url" ] ],
      "body": [
        [
          "Attribute",
          "description",
          [
            "String",
            "URL of the vCluster Platform (e.g. https://platform.example.com)"
          ]
        ],
        [ "Attribute", "type", [ "Id", "string" ] ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "platform_access_key" ] ],
      "body": [
        [
          "Attribute",
          "description",
          [ "String", "Access key for the vCluster Platform API" ]
        ],
        [ "Attribute", "type", [ "Id", "string" ] ],
        [ "Attribute", "sensitive", [ "Bool", true ] ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "platform_project_name" ] ],
      "body": [
        [
          "Attribute",
          "description",
          [ "String", "vCluster Platform project to deploy into" ]
        ],
        [ "Attribute", "type", [ "Id", "string" ] ],
        [ "Attribute", "default", [ "String", "default" ] ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "platform_insecure" ] ],
      "body": [
        [
          "Attribute",
          "description",
          [ "String", "Skip TLS verification for the vCluster Platform API" ]
        ],
        [ "Attribute", "type", [ "Id", "bool" ] ],
        [ "Attribute", "default", [ "Bool", false ] ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "vcluster_chart_version" ] ],
      "body": [
        [
          "Attribute",
          "description",
          [ "String", "vCluster Helm chart version" ]
        ],
        [ "Attribute", "type", [ "Id", "string" ] ],
        [ "Attribute", "default", [ "String", "0.31.0" ] ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "runai_cp_url" ] ],
      "body": [
        [
          "Attribute",
          "description",
          [
            "String",
            "URL of the external NVIDIA Run:ai control plane (e.g. https://runai.example.com). Used for REST API calls from terraform."
          ]
        ],
        [ "Attribute", "type", [ "Id", "string" ] ],
        [
          "Block",
          {
            "type_": "validation",
            "labels": [],
            "body": [
              [
                "Attribute",
                "condition",
                [
                  "Fun_call",
                  [
                    "can",
                    [
                      [
                        "Fun_call",
                        [
                          "regex",
                          [
                            [ "String", "^https?://" ],
                            [
                              "Attr",
                              [
                                [ "Id", "var" ],
                                [ "A_string", "runai_cp_url" ]
                              ]
                            ]
                          ]
                        ]
                      ]
                    ]
                  ]
                ]
              ],
              [
                "Attribute",
                "error_message",
                [
                  "String",
                  "Control plane URL must start with http:// or https://."
                ]
              ]
            ]
          }
        ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "runai_admin_email" ] ],
      "body": [
        [
          "Attribute",
          "description",
          [ "String", "Admin email for the NVIDIA Run:ai control plane API" ]
        ],
        [ "Attribute", "type", [ "Id", "string" ] ],
        [ "Attribute", "default", [ "String", "admin@run.ai" ] ],
        [
          "Block",
          {
            "type_": "validation",
            "labels": [],
            "body": [
              [
                "Attribute",
                "condition",
                [
                  "Fun_call",
                  [
                    "can",
                    [
                      [
                        "Fun_call",
                        [
                          "regex",
                          [
                            [ "String", "^[^@]+@[^@]+\\.[^@]+$" ],
                            [
                              "Attr",
                              [
                                [ "Id", "var" ],
                                [ "A_string", "runai_admin_email" ]
                              ]
                            ]
                          ]
                        ]
                      ]
                    ]
                  ]
                ]
              ],
              [
                "Attribute",
                "error_message",
                [ "String", "Must be a valid email address." ]
              ]
            ]
          }
        ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "runai_admin_password" ] ],
      "body": [
        [
          "Attribute",
          "description",
          [
            "String",
            "Admin password for the NVIDIA Run:ai control plane API"
          ]
        ],
        [ "Attribute", "type", [ "Id", "string" ] ],
        [ "Attribute", "sensitive", [ "Bool", true ] ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "runai_chart_version" ] ],
      "body": [
        [
          "Attribute",
          "description",
          [ "String", "NVIDIA Run:ai Helm chart version (used for agent)" ]
        ],
        [ "Attribute", "type", [ "Id", "string" ] ],
        [ "Attribute", "default", [ "String", "2.24.18" ] ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "runai_agent_chart_repo" ] ],
      "body": [
        [
          "Attribute",
          "description",
          [
            "String",
            "Helm chart repository for the NVIDIA Run:ai cluster agent"
          ]
        ],
        [ "Attribute", "type", [ "Id", "string" ] ],
        [
          "Attribute",
          "default",
          [
            "String",
            "https://runai.jfrog.io/artifactory/api/helm/run-ai-charts"
          ]
        ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "runai_registry_credentials" ] ],
      "body": [
        [
          "Attribute",
          "description",
          [
            "String",
            "Base64-encoded Docker config JSON for the NVIDIA Run:ai registry"
          ]
        ],
        [ "Attribute", "type", [ "Id", "string" ] ],
        [ "Attribute", "sensitive", [ "Bool", true ] ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "runai_cp_ca_cert" ] ],
      "body": [
        [
          "Attribute",
          "description",
          [
            "String",
            "Base64-encoded PEM CA certificate for the NVIDIA Run:ai control plane (required when using self-signed TLS)"
          ]
        ],
        [ "Attribute", "type", [ "Id", "string" ] ],
        [ "Attribute", "default", [ "String", "" ] ],
        [ "Attribute", "sensitive", [ "Bool", true ] ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "runai_cp_insecure" ] ],
      "body": [
        [
          "Attribute",
          "description",
          [
            "String",
            "Skip TLS verification for the NVIDIA Run:ai control plane API"
          ]
        ],
        [ "Attribute", "type", [ "Id", "bool" ] ],
        [ "Attribute", "default", [ "Bool", false ] ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "agents" ] ],
      "body": [
        [
          "Attribute",
          "description",
          [
            "String",
            "List of cluster agents to register and deploy as vClusters"
          ]
        ],
        [
          "Attribute",
          "type",
          [
            "Fun_call",
            [
              "list",
              [
                [
                  "Fun_call",
                  [
                    "object",
                    [
                      [
                        "Object",
                        [
                          [ [ "Bare", "name" ], [ "Id", "string" ] ],
                          [ [ "Bare", "domain" ], [ "Id", "string" ] ],
                          [
                            [ "Bare", "workload_domain" ],
                            [
                              "Fun_call",
                              [
                                "optional",
                                [ [ "Id", "string" ], [ "String", "" ] ]
                              ]
                            ]
                          ],
                          [
                            [ "Bare", "node_selector_label_value" ],
                            [
                              "Fun_call",
                              [
                                "optional",
                                [ [ "Id", "string" ], [ "String", "" ] ]
                              ]
                            ]
                          ],
                          [
                            [ "Bare", "inference_domain" ],
                            [
                              "Fun_call",
                              [
                                "optional",
                                [ [ "Id", "string" ], [ "String", "" ] ]
                              ]
                            ]
                          ],
                          [
                            [ "Bare", "inference_service_annotations" ],
                            [
                              "Fun_call",
                              [
                                "optional",
                                [
                                  [
                                    "Fun_call",
                                    [ "map", [ [ "Id", "string" ] ] ]
                                  ],
                                  [ "Object", [] ]
                                ]
                              ]
                            ]
                          ],
                          [
                            [ "Bare", "ingress_service_annotations" ],
                            [
                              "Fun_call",
                              [
                                "optional",
                                [
                                  [
                                    "Fun_call",
                                    [ "map", [ [ "Id", "string" ] ] ]
                                  ],
                                  [ "Object", [] ]
                                ]
                              ]
                            ]
                          ],
                          [
                            [ "Bare", "cluster_uid" ],
                            [
                              "Fun_call",
                              [
                                "optional",
                                [ [ "Id", "string" ], [ "String", "" ] ]
                              ]
                            ]
                          ],
                          [
                            [ "Bare", "client_secret" ],
                            [
                              "Fun_call",
                              [
                                "optional",
                                [ [ "Id", "string" ], [ "String", "" ] ]
                              ]
                            ]
                          ]
                        ]
                      ]
                    ]
                  ]
                ]
              ]
            ]
          ]
        ],
        [ "Attribute", "default", [ "Tuple", [] ] ],
        [
          "Block",
          {
            "type_": "validation",
            "labels": [],
            "body": [
              [
                "Attribute",
                "condition",
                [
                  "Fun_call",
                  [
                    "alltrue",
                    [
                      [
                        "For_tuple",
                        {
                          "identifiers": [ "a", [] ],
                          "input": [
                            "Attr",
                            [ [ "Id", "var" ], [ "A_string", "agents" ] ]
                          ],
                          "output": [
                            "Log_or",
                            [
                              [
                                "Log_and",
                                [
                                  [
                                    "Equal",
                                    [
                                      [
                                        "Attr",
                                        [
                                          [ "Id", "a" ],
                                          [ "A_string", "cluster_uid" ]
                                        ]
                                      ],
                                      [ "String", "" ]
                                    ]
                                  ],
                                  [
                                    "Equal",
                                    [
                                      [
                                        "Attr",
                                        [
                                          [ "Id", "a" ],
                                          [ "A_string", "client_secret" ]
                                        ]
                                      ],
                                      [ "String", "" ]
                                    ]
                                  ]
                                ]
                              ],
                              [
                                "Log_and",
                                [
                                  [
                                    "Not_equal",
                                    [
                                      [
                                        "Attr",
                                        [
                                          [ "Id", "a" ],
                                          [ "A_string", "cluster_uid" ]
                                        ]
                                      ],
                                      [ "String", "" ]
                                    ]
                                  ],
                                  [
                                    "Not_equal",
                                    [
                                      [
                                        "Attr",
                                        [
                                          [ "Id", "a" ],
                                          [ "A_string", "client_secret" ]
                                        ]
                                      ],
                                      [ "String", "" ]
                                    ]
                                  ]
                                ]
                              ]
                            ]
                          ],
                          "cond": null
                        }
                      ]
                    ]
                  ]
                ]
              ],
              [
                "Attribute",
                "error_message",
                [
                  "String",
                  "Each agent must provide both cluster_uid and client_secret, or neither."
                ]
              ]
            ]
          }
        ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "node_selector_label_key" ] ],
      "body": [
        [
          "Attribute",
          "description",
          [
            "String",
            "Label key used to assign dedicated host nodes to agent vClusters (e.g. 'tenant')"
          ]
        ],
        [ "Attribute", "type", [ "Id", "string" ] ],
        [ "Attribute", "default", [ "String", "tenant" ] ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "high_availability" ] ],
      "body": [
        [
          "Attribute",
          "description",
          [
            "String",
            "Enable HA for agent vClusters (multiple replicas + embedded etcd)"
          ]
        ],
        [ "Attribute", "type", [ "Id", "bool" ] ],
        [ "Attribute", "default", [ "Bool", false ] ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "ha_replicas" ] ],
      "body": [
        [
          "Attribute",
          "description",
          [
            "String",
            "Number of vCluster control plane replicas when HA is enabled"
          ]
        ],
        [ "Attribute", "type", [ "Id", "number" ] ],
        [ "Attribute", "default", [ "Int", 3 ] ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "raw_chart_version" ] ],
      "body": [
        [
          "Attribute",
          "description",
          [
            "String",
            "Bedag raw Helm chart version (used to deploy Knative Serving CR)"
          ]
        ],
        [ "Attribute", "type", [ "Id", "string" ] ],
        [ "Attribute", "default", [ "String", "2.0.2" ] ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "deploy_gpu_operator" ] ],
      "body": [
        [
          "Attribute",
          "description",
          [ "String", "Deploy NVIDIA GPU Operator inside agent vClusters" ]
        ],
        [ "Attribute", "type", [ "Id", "bool" ] ],
        [ "Attribute", "default", [ "Bool", true ] ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "gpu_operator_version" ] ],
      "body": [
        [
          "Attribute",
          "description",
          [ "String", "NVIDIA GPU Operator Helm chart version" ]
        ],
        [ "Attribute", "type", [ "Id", "string" ] ],
        [ "Attribute", "default", [ "String", "v25.10.1" ] ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "gpu_operator_driver_enabled" ] ],
      "body": [
        [
          "Attribute",
          "description",
          [ "String", "Enable NVIDIA driver installation via GPU Operator" ]
        ],
        [ "Attribute", "type", [ "Id", "bool" ] ],
        [ "Attribute", "default", [ "Bool", false ] ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "gpu_operator_device_plugin_enabled" ] ],
      "body": [
        [
          "Attribute",
          "description",
          [
            "String",
            "Enable the GPU Operator's device plugin. Set to false when the host already provides one (e.g. GKE)"
          ]
        ],
        [ "Attribute", "type", [ "Id", "bool" ] ],
        [ "Attribute", "default", [ "Bool", true ] ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "gpu_operator_driver_install_dir" ] ],
      "body": [
        [
          "Attribute",
          "description",
          [
            "String",
            "Host path where NVIDIA drivers are installed. On GKE with Google-managed drivers use /home/kubernetes/bin/nvidia"
          ]
        ],
        [ "Attribute", "type", [ "Id", "string" ] ],
        [ "Attribute", "default", [ "String", "/run/nvidia/driver" ] ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "deploy_prometheus_operator" ] ],
      "body": [
        [
          "Attribute",
          "description",
          [
            "String",
            "Deploy kube-prometheus-stack CRDs inside agent vClusters"
          ]
        ],
        [ "Attribute", "type", [ "Id", "bool" ] ],
        [ "Attribute", "default", [ "Bool", true ] ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "kube_prometheus_stack_version" ] ],
      "body": [
        [
          "Attribute",
          "description",
          [ "String", "kube-prometheus-stack Helm chart version" ]
        ],
        [ "Attribute", "type", [ "Id", "string" ] ],
        [ "Attribute", "default", [ "String", "72.6.2" ] ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "enable_inference" ] ],
      "body": [
        [
          "Attribute",
          "description",
          [
            "String",
            "Enable Knative Serving for inference workloads in agent vClusters"
          ]
        ],
        [ "Attribute", "type", [ "Id", "bool" ] ],
        [ "Attribute", "default", [ "Bool", true ] ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "knative_operator_version" ] ],
      "body": [
        [
          "Attribute",
          "description",
          [ "String", "Knative Operator Helm chart version" ]
        ],
        [ "Attribute", "type", [ "Id", "string" ] ],
        [ "Attribute", "default", [ "String", "1.18.0" ] ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "knative_serving_version" ] ],
      "body": [
        [
          "Attribute",
          "description",
          [ "String", "Knative Serving version installed by the operator" ]
        ],
        [ "Attribute", "type", [ "Id", "string" ] ],
        [ "Attribute", "default", [ "String", "1.16.3" ] ]
      ]
    }
  ]
]
