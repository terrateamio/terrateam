                "Attribute",
                "error_message",
                [
                  "Heredoc",
                  [
                    "EOF",
                    "\n    if type is \"CIDR_BLOCK\" then `ips` must be set, and `nsg_ids` and `service_cidrs` should not be set,\nif type is \"SERVICE_CIDR_BLOCK\" then `service_cidrs` must be set and `nsg_ids` and `ips` is should not be set,\nif type is \"NETWORK_SECURITY_GROUP\" then `nsg_ids` must be set and `service_cidrs` and `ips` is should not be set\n"
