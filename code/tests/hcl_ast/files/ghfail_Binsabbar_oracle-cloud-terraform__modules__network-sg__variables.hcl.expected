              ],
              [
                "Attribute",
                "error_message",
                [
                  "Heredoc",
                  [
                    "EOF",
                    "\n    The value of direction must be one of the following:\n    - \"INGRESS\"\n    - \"EGRESS\"\n"
                  ]
                ]
              ]
            ]
          }
        ],
        [
          "Attribute",
          "description",
          [
            "Heredoc",
            [
              "EOL",
              "\n    map of network security groups, where the key is used as name of the group, and value is a rule configuration\n    Rule Configuration\n    direction: INGRESS or EGRESS\n    protocol : tcp or udp\n    ports    : port object that contain the port ranege. Set both min and max to the same value if no range is needed\n        min: lower port bound \n        max: upper port bound\n    type (optional)          : the type of the nsg rule, default is `CIDR_BLOCK`\n    ips  (optional)          : list of IP addresses for the rule. Set if type is `CIDR_BLOCK`\n    nsg_ids (optional)       : list of network security group ids for the rule. Set if type is `NETWORK_SECURITY_GROUP`\n    service_cidrs (optional) : list of service cidr blocks for the rule. Set if type is `SERVICE_CIDR_BLOCK`\n"
            ]
          ]
        ]
      ]
    }
