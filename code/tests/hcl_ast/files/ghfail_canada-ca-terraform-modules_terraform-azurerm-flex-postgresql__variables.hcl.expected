  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "pgsql_version" ] ],
      "body": [
        [ "Attribute", "type", [ "Id", "string" ] ],
        [
          "Attribute",
          "description",
          [
            "String",
            "The version of the PostgreSQL Flexible Server. Currently supported versions 13, 14, 15, 16, or 17."
