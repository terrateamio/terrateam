          ]
        ],
        [ "Attribute", "default", [ "Bool", false ] ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "kv_private_endpoints" ] ],
      "body": [
        [
          "Attribute",
          "type",
          [
            "Fun_call",
            [
              "list",
              [
                [
                  "Fun_call",
                  [
                    "object",
                    [
                      [
                        "Object",
                        [
                          [
                            [ "Bare", "sub_resource_name" ],
                            [
                              "Fun_call",
                              [
                                "optional",
                                [ [ "Id", "string" ], [ "String", "vault" ] ]
                              ]
                            ]
                          ],
                          [ [ "Bare", "subnet_id" ], [ "Id", "string" ] ],
                          [
                            [ "Bare", "private_dns_zone_id" ],
                            [ "Id", "string" ]
                          ]
                        ]
                      ]
                    ]
                  ]
                ]
              ]
            ]
          ]
        ],
        [
          "Attribute",
          "description",
          [
            "String",
            "The information required to create a private endpoint for the Key Vault."
          ]
        ],
        [ "Attribute", "default", [ "Tuple", [] ] ],
        [
          "Block",
          {
            "type_": "validation",
            "labels": [],
            "body": [
              [
                "Attribute",
                "condition",
                [
                  "Fun_call",
                  [
                    "alltrue",
                    [
                      [
                        "For_tuple",
                        {
                          "identifiers": [ "entry", [] ],
                          "input": [
                            "Attr",
                            [
                              [ "Id", "var" ],
                              [ "A_string", "kv_private_endpoints" ]
                            ]
                          ],
                          "output": [
                            "Fun_call",
                            [
                              "contains",
                              [
                                [ "Tuple", [ [ "String", "vault" ] ] ],
                                [
                                  "Attr",
                                  [
                                    [ "Id", "entry" ],
                                    [ "A_string", "sub_resource_name" ]
                                  ]
                                ]
                              ]
                            ]
                          ],
                          "cond": null
                        }
                      ]
                    ]
                  ]
                ]
              ],
              [
                "Attribute",
                "error_message",
                [
                  "String",
                  "Invalid sub_resource_name within var.kv_private_endpoints. Expected the name to be 'vault'."
                ]
              ]
            ]
          }
        ],
        [
          "Block",
          {
            "type_": "validation",
            "labels": [],
            "body": [
              [
                "Attribute",
                "condition",
                [
                  "Fun_call",
                  [
                    "alltrue",
                    [
                      [
                        "For_tuple",
                        {
                          "identifiers": [ "entry", [] ],
                          "input": [
                            "Attr",
                            [
                              [ "Id", "var" ],
                              [ "A_string", "kv_private_endpoints" ]
                            ]
                          ],
                          "output": [
                            "Equal",
                            [
                              [
                                "Fun_call",
                                [
                                  "element",
                                  [
                                    [
                                      "Fun_call",
                                      [
                                        "split",
                                        [
                                          [ "String", "/" ],
                                          [
                                            "Attr",
                                            [
                                              [ "Id", "entry" ],
                                              [
                                                "A_string",
                                                "private_dns_zone_id"
                                              ]
                                            ]
                                          ]
                                        ]
                                      ]
                                    ],
                                    [ "Int", 8 ]
                                  ]
                                ]
                              ],
                              [ "String", "privatelink.vaultcore.azure.net" ]
                            ]
                          ],
                          "cond": null
                        }
                      ]
                    ]
                  ]
                ]
              ],
              [
                "Attribute",
                "error_message",
                [
                  "String",
                  "Invalid private_dns_zone_id attribute within var.kv_private_endpoints. Expected a Private DNS Zone with the name 'privatelink.vaultcore.azure.net'"
                ]
              ]
            ]
          }
        ]
      ]
    }
  ],
