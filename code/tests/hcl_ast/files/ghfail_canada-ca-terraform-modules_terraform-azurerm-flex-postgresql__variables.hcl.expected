[
  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "active_directory_administrator" ] ],
      "body": [
        [
          "Attribute",
          "type",
          [
            "Fun_call",
            [
              "list",
              [
                [
                  "Fun_call",
                  [
                    "object",
                    [
                      [
                        "Object",
                        [
                          [
                            [ "Bare", "object_id" ],
                            [
                              "Fun_call",
                              [ "optional", [ [ "Id", "string" ] ] ]
                            ]
                          ],
                          [
                            [ "Bare", "principal_name" ],
                            [
                              "Fun_call",
                              [ "optional", [ [ "Id", "string" ] ] ]
                            ]
                          ],
                          [
                            [ "Bare", "principal_type" ],
                            [
                              "Fun_call",
                              [
                                "optional",
                                [ [ "Id", "string" ], [ "String", "Group" ] ]
                              ]
                            ]
                          ]
                        ]
                      ]
                    ]
                  ]
                ]
              ]
            ]
          ]
        ],
        [ "Attribute", "default", [ "Tuple", [] ] ],
        [
          "Block",
          {
            "type_": "validation",
            "labels": [],
            "body": [
              [
                "Attribute",
                "condition",
                [
                  "Fun_call",
                  [
                    "alltrue",
                    [
                      [
                        "For_tuple",
                        {
                          "identifiers": [ "entry", [] ],
                          "input": [
                            "Attr",
                            [
                              [ "Id", "var" ],
                              [
                                "A_string", "active_directory_administrator"
                              ]
                            ]
                          ],
                          "output": [
                            "Log_and",
                            [
                              [
                                "Log_and",
                                [
                                  [
                                    "Log_and",
                                    [
                                      [
                                        "Not_equal",
                                        [
                                          [
                                            "Attr",
                                            [
                                              [ "Id", "entry" ],
                                              [ "A_string", "object_id" ]
                                            ]
                                          ],
                                          [ "Null" ]
                                        ]
                                      ],
                                      [
                                        "Not_equal",
                                        [
                                          [
                                            "Attr",
                                            [
                                              [ "Id", "entry" ],
                                              [
                                                "A_string", "principal_name"
                                              ]
                                            ]
                                          ],
                                          [ "Null" ]
                                        ]
                                      ]
                                    ]
                                  ],
                                  [
                                    "Not_equal",
                                    [
                                      [
                                        "Attr",
                                        [
                                          [ "Id", "entry" ],
                                          [ "A_string", "principal_type" ]
                                        ]
                                      ],
                                      [ "Null" ]
                                    ]
                                  ]
                                ]
                              ],
                              [
                                "Fun_call",
                                [
                                  "contains",
                                  [
                                    [
                                      "Tuple",
                                      [
                                        [ "String", "Group" ],
                                        [ "String", "User" ],
                                        [ "String", "ServicePrincipal" ]
                                      ]
                                    ],
                                    [
                                      "Attr",
                                      [
                                        [ "Id", "entry" ],
                                        [ "A_string", "principal_type" ]
                                      ]
                                    ]
                                  ]
                                ]
                              ]
                            ]
                          ],
                          "cond": null
                        }
                      ]
                    ]
                  ]
                ]
              ],
              [
                "Attribute",
                "error_message",
                [
                  "String",
                  "Invalid active_directory_administrator configuration. Make sure object_id, principal_name, and principal_type are not null, and principal_type is one of 'Group', 'User', or 'ServicePrincipal'."
                ]
              ]
            ]
          }
        ]
      ]
    }
  ],
