  ],
  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "kv_pointer_rg" ] ],
      "body": [
        [ "Attribute", "type", [ "Id", "string" ] ],
        [
          "Attribute",
          "description",
          [
