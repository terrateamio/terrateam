  ],
  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "kv_pointer_sqladmin_password" ] ],
      "body": [
        [ "Attribute", "type", [ "Id", "string" ] ],
        [
          "Attribute",
          "description",
          [
            "String",
            "The sqladmin password to be looked up in key vault when kv_pointer_enable is set to `true`."
          ]
        ],
        [ "Attribute", "default", [ "Null" ] ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "postgresql_configurations" ] ],
      "body": [
        [
          "Attribute",
          "type",
          [ "Fun_call", [ "map", [ [ "Id", "string" ] ] ] ]
        ],
        [
          "Attribute",
          "default",
          [
            "Object",
            [
              [
                [ "Quoted", "azure.extensions" ],
                [ "String", "POSTGIS,PGCRYPTO" ]
              ],
              [ [ "Quoted", "client_min_messages" ], [ "String", "log" ] ],
              [ [ "Quoted", "debug_pretty_print" ], [ "String", "on" ] ],
              [ [ "Quoted", "debug_print_parse" ], [ "String", "off" ] ],
              [ [ "Quoted", "debug_print_plan" ], [ "String", "off" ] ],
              [ [ "Quoted", "debug_print_rewritten" ], [ "String", "off" ] ],
              [ [ "Quoted", "log_checkpoints" ], [ "String", "on" ] ],
              [ [ "Quoted", "log_duration" ], [ "String", "off" ] ],
              [
                [ "Quoted", "log_error_verbosity" ], [ "String", "verbose" ]
              ],
              [
                [ "Quoted", "log_line_prefix" ],
                [ "String", "%m [%p] %q[user=%u,db=%d,app=%a,client=%h] " ]
              ],
