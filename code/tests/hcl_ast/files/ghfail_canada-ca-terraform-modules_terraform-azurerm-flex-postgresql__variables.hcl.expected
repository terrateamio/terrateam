    }
  ],
  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "storagesize_mb" ] ],
      "body": [
        [ "Attribute", "type", [ "Id", "number" ] ],
        [
          "Attribute",
          "description",
          [
            "String",
            "Specifies the storage size in MB for the PostgreSQL Flexible Server."
          ]
        ],
        [ "Attribute", "default", [ "Int", 262144 ] ],
        [
          "Block",
          {
            "type_": "validation",
            "labels": [],
            "body": [
              [
                "Attribute",
                "condition",
                [
                  "Fun_call",
                  [
                    "contains",
                    [
                      [
                        "Tuple",
                        [
                          [ "Int", 32768 ],
                          [ "Int", 65536 ],
                          [ "Int", 131072 ],
                          [ "Int", 262144 ],
                          [ "Int", 524288 ],
                          [ "Int", 1048576 ],
                          [ "Int", 2097152 ],
                          [ "Int", 4193280 ],
                          [ "Int", 4194304 ],
                          [ "Int", 8388608 ],
                          [ "Int", 16777216 ],
                          [ "Int", 33553408 ]
                        ]
                      ],
                      [
                        "Attr",
                        [ [ "Id", "var" ], [ "A_string", "storagesize_mb" ] ]
                      ]
                    ]
                  ]
                ]
              ],
              [
                "Attribute",
                "error_message",
                [
                  "String",
                  "The storage size must be set to one of the supported values 32768, 65536, 131072, 262144, 524288, 1048576, 2097152, 4193280, 4194304, 8388608, 16777216, or 33553408."
                ]
              ]
            ]
          }
        ]
      ]
    }
  ],
