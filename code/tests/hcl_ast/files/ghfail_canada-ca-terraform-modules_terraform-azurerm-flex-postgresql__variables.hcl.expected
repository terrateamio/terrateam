        ],
        [ "Attribute", "default", [ "String", "17" ] ],
        [
          "Block",
          {
            "type_": "validation",
            "labels": [],
            "body": [
              [
                "Attribute",
                "condition",
                [
                  "Fun_call",
                  [
                    "contains",
                    [
                      [
                        "Tuple",
                        [
                          [ "String", "13" ],
                          [ "String", "14" ],
                          [ "String", "15" ],
                          [ "String", "16" ],
                          [ "String", "17" ]
                        ]
                      ],
                      [
                        "Attr",
                        [ [ "Id", "var" ], [ "A_string", "pgsql_version" ] ]
                      ]
                    ]
                  ]
                ]
              ],
              [
                "Attribute",
                "error_message",
                [
                  "String",
                  "The version of PostgreSQL Flexible Server specified must be one of the currently supported versions 13, 14, 15, 16, or 17."
                ]
              ]
            ]
          }
        ]
      ]
    }
  ],
  [
