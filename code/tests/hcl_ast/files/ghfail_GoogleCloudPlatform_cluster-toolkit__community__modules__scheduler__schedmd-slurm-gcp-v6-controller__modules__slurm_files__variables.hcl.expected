                    [ [ "Bare", "remote_mount" ], [ "Id", "string" ] ],
                    [ [ "Bare", "fs_type" ], [ "Id", "string" ] ],
                    [ [ "Bare", "mount_options" ], [ "Id", "string" ] ]
                  ]
                ]
              ]
            ]
          ]
        ],
        [ "Attribute", "default", [ "Null" ] ]
