  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "enable_hybrid" ] ],
      "body": [
        [
          "Attribute",
          "description",
          [
            "Heredoc",
            [
              "EOD",
              "\nEnables use of hybrid controller mode. When true, controller_hybrid_config will\nbe used instead of controller_instance_config and will disable login instances.\n"
            ]
          ]
        ],
        [ "Attribute", "type", [ "Id", "bool" ] ],
        [ "Attribute", "default", [ "Bool", false ] ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "google_app_cred_path" ] ],
      "body": [
        [ "Attribute", "type", [ "Id", "string" ] ],
        [
          "Attribute",
          "description",
          [ "String", "Path to Google Application Credentials." ]
        ],
        [ "Attribute", "default", [ "Null" ] ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "slurm_bin_dir" ] ],
      "body": [
        [ "Attribute", "type", [ "Id", "string" ] ],
        [
          "Attribute",
          "description",
          [
            "Heredoc",
            [
              "EOD",
              "\nPath to directory of Slurm binary commands (e.g. scontrol, sinfo). If 'null',\nthen it will be assumed that binaries are in $PATH.\n"
            ]
          ]
        ],
        [ "Attribute", "default", [ "Null" ] ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "slurm_log_dir" ] ],
      "body": [
        [ "Attribute", "type", [ "Id", "string" ] ],
        [
          "Attribute",
          "description",
          [ "String", "Directory where Slurm logs to." ]
        ],
        [ "Attribute", "default", [ "String", "/var/log/slurm" ] ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "slurm_control_host" ] ],
      "body": [
        [ "Attribute", "type", [ "Id", "string" ] ],
        [
          "Attribute",
          "description",
          [
            "Heredoc",
            [
              "EOD",
              "\nThe short, or long, hostname of the machine where Slurm control daemon is\nexecuted (i.e. the name returned by the command \"hostname -s\").\n\nThis value is passed to slurm.conf such that:\nSlurmctldHost={var.slurm_control_host}\\({var.slurm_control_addr}\\)\n\nSee https://slurm.schedmd.com/slurm.conf.html#OPT_SlurmctldHost\n"
            ]
          ]
        ],
        [ "Attribute", "default", [ "Null" ] ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "slurm_control_host_port" ] ],
      "body": [
        [ "Attribute", "type", [ "Id", "string" ] ],
        [
          "Attribute",
          "description",
          [
            "Heredoc",
            [
              "EOD",
              "\nThe port number that the Slurm controller, slurmctld, listens to for work.\n\nSee https://slurm.schedmd.com/slurm.conf.html#OPT_SlurmctldPort\n"
            ]
          ]
        ],
        [ "Attribute", "default", [ "String", "6818" ] ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "slurm_control_addr" ] ],
      "body": [
        [ "Attribute", "type", [ "Id", "string" ] ],
        [
          "Attribute",
          "description",
          [
            "Heredoc",
            [
              "EOD",
              "\nThe IP address or a name by which the address can be identified.\n\nThis value is passed to slurm.conf such that:\nSlurmctldHost={var.slurm_control_host}\\({var.slurm_control_addr}\\)\n\nSee https://slurm.schedmd.com/slurm.conf.html#OPT_SlurmctldHost\n"
            ]
          ]
        ],
        [ "Attribute", "default", [ "Null" ] ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "output_dir" ] ],
      "body": [
        [ "Attribute", "type", [ "Id", "string" ] ],
        [
          "Attribute",
          "description",
          [
            "Heredoc",
            [
              "EOD",
              "\nDirectory where this module will write its files to. These files include:\ncloud.conf; cloud_gres.conf; config.yaml; resume.py; suspend.py; and util.py.\n"
            ]
          ]
        ],
        [ "Attribute", "default", [ "Null" ] ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "install_dir" ] ],
      "body": [
        [ "Attribute", "type", [ "Id", "string" ] ],
        [
          "Attribute",
          "description",
          [
            "Heredoc",
            [
              "EOD",
              "\nDirectory where the hybrid configuration directory will be installed on the\non-premise controller (e.g. /etc/slurm/hybrid). This updates the prefix path\nfor the resume and suspend scripts in the generated `cloud.conf` file.\n\nThis variable should be used when the TerraformHost and the SlurmctldHost\nare different.\n\nThis will default to var.output_dir if null.\n"
            ]
          ]
        ],
        [ "Attribute", "default", [ "Null" ] ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "munge_mount" ] ],
      "body": [
        [
          "Attribute",
          "description",
          [
            "Heredoc",
            [
              "EOD",
              "\nRemote munge mount for compute and login nodes to acquire the munge.key.\nBy default, the munge mount server will be assumed to be the\n`var.slurm_control_host` (or `var.slurm_control_addr` if non-null) when\n`server_ip=null`.\n"
            ]
          ]
        ],
        [
          "Attribute",
          "type",
          [
            "Fun_call",
            [
              "object",
              [
                [
                  "Object",
                  [
                    [ [ "Bare", "server_ip" ], [ "Id", "string" ] ],
                    [ [ "Bare", "remote_mount" ], [ "Id", "string" ] ],
                    [ [ "Bare", "fs_type" ], [ "Id", "string" ] ],
                    [ [ "Bare", "mount_options" ], [ "Id", "string" ] ]
                  ]
                ]
              ]
            ]
          ]
        ],
        [
          "Attribute",
          "default",
          [
            "Object",
            [
              [ [ "Bare", "server_ip" ], [ "Null" ] ],
              [ [ "Bare", "remote_mount" ], [ "String", "/etc/munge/" ] ],
              [ [ "Bare", "fs_type" ], [ "String", "nfs" ] ],
              [ [ "Bare", "mount_options" ], [ "String", "" ] ]
            ]
          ]
        ]
      ]
    }
  ],
