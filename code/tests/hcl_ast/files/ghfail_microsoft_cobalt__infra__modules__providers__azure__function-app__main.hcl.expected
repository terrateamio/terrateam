[
  [
    "Block",
    {
      "type_": "data",
      "labels": [ [ "Lit", "azurerm_client_config" ], [ "Lit", "current" ] ],
      "body": []
    }
  ],
  [
    "Block",
    {
      "type_": "locals",
      "labels": [],
      "body": [
        [
          "Attribute",
          "fn_names",
          [
            "Fun_call",
            [
              "keys",
              [
                [
                  "Attr",
                  [ [ "Id", "var" ], [ "A_string", "fn_app_config" ] ]
                ]
              ]
            ]
          ]
        ],
        [
          "Attribute",
          "fn_configs",
          [
            "Fun_call",
            [
              "values",
              [
                [
                  "Attr",
                  [ [ "Id", "var" ], [ "A_string", "fn_app_config" ] ]
                ]
              ]
            ]
          ]
        ],
        [
          "Attribute",
          "access_restriction_name",
          [ "String", "vnet_restriction" ]
        ],
        [
          "Attribute",
          "access_restriction_description",
          [ "String", "blocking public traffic to function app" ]
        ],
        [
          "Attribute",
          "app_linux_fx_versions",
          [
            "For_tuple",
            {
              "identifiers": [ "config", [] ],
              "input": [
                "Attr", [ [ "Id", "local" ], [ "A_string", "fn_configs" ] ]
              ],
              "output": [
                "Cond",
                {
                  "if_": [
                    "Equal",
                    [
                      [
                        "Attr",
                        [ [ "Id", "config" ], [ "A_string", "image" ] ]
                      ],
                      [ "Null" ]
                    ]
                  ],
                  "then_": [ "String", "DOCKER" ],
                  "else_": [
                    "Fun_call",
                    [
                      "format",
                      [
                        [ "String", "DOCKER|%s/%s" ],
                        [
                          "Attr",
                          [
                            [ "Id", "var" ],
                            [ "A_string", "docker_registry_server_url" ]
                          ]
                        ],
                        [
                          "Attr",
                          [ [ "Id", "config" ], [ "A_string", "image" ] ]
                        ]
                      ]
                    ]
                  ]
                }
              ],
              "cond": null
            }
          ]
        ],
        [
          "Attribute",
          "app_deployment_config",
          [
            "For_tuple",
            {
              "identifiers": [ "config", [] ],
              "input": [
                "Attr", [ [ "Id", "local" ], [ "A_string", "fn_configs" ] ]
              ],
              "output": [
                "Cond",
                {
                  "if_": [
                    "Equal",
                    [
                      [
                        "Attr",
                        [ [ "Id", "config" ], [ "A_string", "image" ] ]
                      ],
                      [ "Null" ]
                    ]
                  ],
                  "then_": [
                    "Cond",
                    {
                      "if_": [
                        "Equal",
                        [
                          [
                            "Attr",
                            [ [ "Id", "config" ], [ "A_string", "zip" ] ]
                          ],
                          [ "Null" ]
                        ]
                      ],
                      "then_": [
                        "Fun_call", [ "tomap", [ [ "Object", [] ] ] ]
                      ],
                      "else_": [
                        "Fun_call",
                        [
                          "tomap",
                          [
                            [
                              "Object",
                              [
                                [
                                  [ "Bare", "HASH" ],
                                  [
                                    "Attr",
                                    [
                                      [ "Id", "config" ],
                                      [ "A_string", "hash" ]
                                    ]
                                  ]
                                ],
                                [
                                  [ "Bare", "WEBSITE_RUN_FROM_PACKAGE" ],
                                  [
                                    "Attr",
                                    [
                                      [ "Id", "config" ],
                                      [ "A_string", "zip" ]
                                    ]
                                  ]
                                ]
                              ]
                            ]
                          ]
                        ]
                      ]
                    }
                  ],
                  "else_": [
                    "Fun_call",
                    [
                      "tomap",
                      [
                        [
                          "Object",
                          [
                            [
                              [ "Bare", "DOCKER_CUSTOM_IMAGE_NAME" ],
                              [
                                "Template",
                                [
                                  [
                                    "Interpolation",
                                    {
                                      "expr": [
                                        "Attr",
                                        [
                                          [ "Id", "var" ],
                                          [
                                            "A_string",
                                            "docker_registry_server_url"
                                          ]
                                        ]
                                      ],
                                      "strip_before": false,
                                      "strip_after": false
                                    }
                                  ],
                                  [ "Literal", "/" ],
                                  [
                                    "Interpolation",
                                    {
                                      "expr": [
                                        "Attr",
                                        [
                                          [ "Id", "config" ],
                                          [ "A_string", "image" ]
                                        ]
                                      ],
                                      "strip_before": false,
                                      "strip_after": false
                                    }
                                  ]
                                ]
                              ]
                            ]
                          ]
                        ]
                      ]
                    ]
                  ]
                }
              ],
              "cond": null
            }
          ]
        ],
        [
          "Attribute",
          "static_app_settings",
          [
            "Object",
            [
              [
                [ "Bare", "FUNCTIONS_EXTENSION_VERSION" ],
                [
                  "Attr",
                  [ [ "Id", "var" ], [ "A_string", "runtime_version" ] ]
                ]
              ],
              [
                [ "Bare", "FUNCTIONS_WORKER_RUNTIME" ],
                [
                  "Attr",
                  [ [ "Id", "var" ], [ "A_string", "worker_runtime" ] ]
                ]
              ],
              [
                [ "Bare", "DOCKER_REGISTRY_SERVER_URL" ],
                [
                  "Fun_call",
                  [
                    "format",
                    [
                      [ "String", "https://%s" ],
                      [
                        "Attr",
                        [
                          [ "Id", "var" ],
                          [ "A_string", "docker_registry_server_url" ]
                        ]
                      ]
                    ]
                  ]
                ]
              ],
              [
                [ "Bare", "WEBSITES_ENABLE_APP_SERVICE_STORAGE" ],
                [ "Bool", false ]
              ],
              [
                [ "Bare", "DOCKER_REGISTRY_SERVER_USERNAME" ],
                [
                  "Attr",
                  [
                    [ "Id", "var" ],
                    [ "A_string", "docker_registry_server_username" ]
                  ]
                ]
              ],
              [
                [ "Bare", "DOCKER_REGISTRY_SERVER_PASSWORD" ],
                [
                  "Attr",
                  [
                    [ "Id", "var" ],
                    [ "A_string", "docker_registry_server_password" ]
                  ]
                ]
              ],
              [
                [ "Bare", "APPINSIGHTS_INSTRUMENTATIONKEY" ],
                [
                  "Attr",
                  [
                    [ "Id", "var" ],
                    [ "A_string", "app_insights_instrumentation_key" ]
                  ]
                ]
              ]
            ]
          ]
        ],
        [
          "Attribute",
          "merged_app_settings",
          [
            "Fun_call",
            [
              "merge",
              [
                [
                  "Fun_call",
                  [
                    "tomap",
                    [
                      [
                        "Attr",
                        [
                          [ "Id", "local" ],
                          [ "A_string", "static_app_settings" ]
                        ]
                      ]
                    ]
                  ]
                ],
                [
                  "Fun_call",
                  [
                    "tomap",
                    [
                      [
                        "Attr",
                        [
                          [ "Id", "var" ], [ "A_string", "fn_app_settings" ]
                        ]
                      ]
                    ]
                  ]
                ]
              ]
            ]
          ]
        ]
      ]
    }
  ],
