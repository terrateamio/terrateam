                  ]
                ]
              ],
              [
                "Object",
                [
                  [
                    [ "Bare", "resource_type" ],
                    [ "String", "nvidia-tesla-p4" ]
                  ]
                ]
              ],
              [
                "Object",
                [
                  [
                    [ "Bare", "resource_type" ],
                    [ "String", "nvidia-tesla-p100" ]
                  ]
                ]
              ],
              [
                "Object",
                [
                  [
                    [ "Bare", "resource_type" ],
                    [ "String", "nvidia-tesla-t4" ]
                  ]
                ]
              ],
              [
                "Object",
                [
                  [
                    [ "Bare", "resource_type" ],
                    [ "String", "nvidia-tesla-v100" ]
                  ]
                ]
              ],
              [
                "Object",
                [
                  [
                    [ "Bare", "resource_type" ],
                    [ "String", "tpu-v4-podslice" ]
