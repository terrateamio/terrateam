                  ]
                ]
              ],
              [
                "Object",
                [
                  [ [ "Bare", "resource_type" ], [ "String", "nvidia-l4" ] ]
                ]
              ],
              [
                "Object",
                [
                  [
                    [ "Bare", "resource_type" ],
                    [ "String", "nvidia-tesla-a100" ]
                  ]
                ]
              ],
              [
                "Object",
                [
                  [
                    [ "Bare", "resource_type" ],
