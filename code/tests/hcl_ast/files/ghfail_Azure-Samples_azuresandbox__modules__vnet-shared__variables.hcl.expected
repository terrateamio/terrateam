    }
  ],
  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "log_analytics_workspace_retention_days" ] ],
      "body": [
        [ "Attribute", "type", [ "Id", "string" ] ],
        [
          "Attribute",
          "description",
          [
            "String",
            "The retention period for the new log analytics workspace."
          ]
        ],
        [ "Attribute", "default", [ "String", "30" ] ],
        [
          "Block",
          {
            "type_": "validation",
            "labels": [],
            "body": [
              [
                "Attribute",
                "condition",
                [
                  "Fun_call",
                  [
                    "can",
                    [
                      [
                        "Fun_call",
                        [
                          "regex",
                          [
                            [
                              "String",
                              "^(30|31|60|90|120|180|270|365|550|730)$"
                            ],
                            [
                              "Attr",
                              [
                                [ "Id", "var" ],
                                [
                                  "A_string",
                                  "log_analytics_workspace_retention_days"
                                ]
                              ]
                            ]
                          ]
                        ]
                      ]
                    ]
                  ]
                ]
              ],
              [
                "Attribute",
                "error_message",
                [
                  "String",
                  "Must be one of the valid retention periods: 30, 31, 60, 90, 120, 180, 270, 365, 550, or 730 days."
                ]
              ]
            ]
          }
        ]
      ]
    }
  ],
  [
