      "labels": [ [ "Lit", "runner_schedule_config" ] ],
      "body": [
        [
          "Attribute",
          "description",
          [
            "String",
            "Map containing the configuration of the ASG scale-out and scale-in for the Runner. Will only be used if `runner_schedule_enable` is set to `true`. "
          ]
        ],
        [
          "Attribute", "type", [ "Fun_call", [ "map", [ [ "Id", "any" ] ] ] ]
        ],
        [
          "Attribute",
          "default",
          [
            "Object",
            [
              [
                [ "Bare", "scale_out_recurrence" ],
                [ "String", "0 8 * * 1-5" ]
              ],
              [ [ "Bare", "scale_out_count" ], [ "Int", 1 ] ],
              [ [ "Bare", "scale_out_time_zone" ], [ "String", "Etc/UTC" ] ],
              [
                [ "Bare", "scale_in_recurrence" ],
                [ "String", "0 18 * * 1-5" ]
              ],
              [ [ "Bare", "scale_in_count" ], [ "Int", 0 ] ],
              [ [ "Bare", "scale_in_time_zone" ], [ "String", "Etc/UTC" ] ]
            ]
          ]
        ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "runner_install" ] ],
      "body": [
        [
          "Attribute",
          "description",
          [
            "Heredoc",
            [
              "EOT",
              "\namazon_ecr_credential_helper = Install amazon-ecr-credential-helper inside `userdata_pre_install` script\ndocker_machine_download_url = URL to download docker machine binary. If not set, the docker machine version will be used to download the binary.\ndocker_machine_version = By default docker_machine_download_url is used to set the docker machine version. This version will be ignored once `docker_machine_download_url` is set. The version number is maintained by the CKI project. Check out at https://gitlab.com/cki-project/docker-machine/-/releases\npre_install_script = Script to run before installing the Runner\npost_install_script = Script to run after installing the Runner\nstart_script = Script to run after starting the Runner\nyum_update = Update the yum packages before installing the Runner\n"
            ]
          ]
        ],
        [
          "Attribute",
          "type",
          [
            "Fun_call",
            [
              "object",
              [
                [
                  "Object",
                  [
                    [
                      [ "Bare", "amazon_ecr_credential_helper" ],
                      [
                        "Fun_call",
                        [
                          "optional", [ [ "Id", "bool" ], [ "Bool", false ] ]
                        ]
                      ]
                    ],
                    [
                      [ "Bare", "docker_machine_download_url" ],
                      [
                        "Fun_call",
                        [
                          "optional",
                          [ [ "Id", "string" ], [ "String", "" ] ]
                        ]
                      ]
                    ],
                    [
                      [ "Bare", "docker_machine_version" ],
                      [
                        "Fun_call",
                        [
                          "optional",
                          [
                            [ "Id", "string" ],
                            [ "String", "0.16.2-gitlab.19-cki.5" ]
                          ]
                        ]
                      ]
                    ],
                    [
                      [ "Bare", "pre_install_script" ],
                      [
                        "Fun_call",
                        [
                          "optional",
                          [ [ "Id", "string" ], [ "String", "" ] ]
                        ]
                      ]
                    ],
                    [
                      [ "Bare", "post_install_script" ],
                      [
                        "Fun_call",
                        [
                          "optional",
                          [ [ "Id", "string" ], [ "String", "" ] ]
                        ]
                      ]
                    ],
                    [
                      [ "Bare", "start_script" ],
                      [
                        "Fun_call",
                        [
                          "optional",
                          [ [ "Id", "string" ], [ "String", "" ] ]
                        ]
                      ]
                    ],
                    [
                      [ "Bare", "yum_update" ],
                      [
                        "Fun_call",
                        [
                          "optional", [ [ "Id", "bool" ], [ "Bool", true ] ]
                        ]
                      ]
                    ]
                  ]
                ]
              ]
            ]
          ]
        ],
        [ "Attribute", "default", [ "Object", [] ] ]
      ]
    }
  ],
  [
