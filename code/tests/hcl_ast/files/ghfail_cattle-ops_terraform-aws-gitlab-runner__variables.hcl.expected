  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "runner_worker_docker_machine_fleet" ] ],
      "body": [
        [
          "Attribute",
          "description",
          [
            "Heredoc",
            [
              "EOT",
              "\nenable = Activates the fleet mode on the Runner. https://gitlab.com/cki-project/docker-machine/-/blob/v0.16.2-gitlab.19-cki.2/docs/drivers/aws.md#fleet-mode\nkey_pair_name = The name of the key pair used by the Runner to connect to the docker-machine Runner Workers. This variable is only supported when `enables` is set to `true`.\n"
            ]
          ]
        ],
        [
          "Attribute",
          "type",
          [
            "Fun_call",
            [
              "object",
              [
                [
                  "Object",
                  [
                    [ [ "Bare", "enable" ], [ "Id", "bool" ] ],
                    [
                      [ "Bare", "key_pair_name" ],
                      [
                        "Fun_call",
                        [
                          "optional",
                          [ [ "Id", "string" ], [ "String", "fleet-key" ] ]
                        ]
                      ]
                    ]
                  ]
                ]
              ]
            ]
          ]
        ],
        [
          "Attribute",
          "default",
          [ "Object", [ [ [ "Bare", "enable" ], [ "Bool", false ] ] ] ]
        ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "runner_worker_docker_autoscaler" ] ],
      "body": [
        [
          "Attribute",
          "description",
          [
            "Heredoc",
            [
              "EOT",
              "\nfleeting_plugin_version = The version of aws fleeting plugin.\nconnector_config_user = User to connect to worker machine.\nkey_pair_name = The name of the key pair used by the Runner to connect to the docker-machine Runner Workers. This variable is only supported when `enables` is set to `true`.\ncapacity_per_instance = The number of jobs that can be executed concurrently by a single instance.\nmax_use_count = Max job number that can run on a worker.\nupdate_interval = The interval to check with the fleeting plugin for instance updates.\nupdate_interval_when_expecting = The interval to check with the fleeting plugin for instance updates when expecting a state change.\ninstance_ready_command = Executes this command on each instance provisioned by the autoscaler to ensure that it is ready for use. A failure results in the instance being removed.\n"
            ]
          ]
        ],
        [
          "Attribute",
          "type",
          [
            "Fun_call",
            [
              "object",
              [
                [
                  "Object",
                  [
                    [
                      [ "Bare", "fleeting_plugin_version" ],
                      [
                        "Fun_call",
                        [
                          "optional",
                          [ [ "Id", "string" ], [ "String", "1.0.0" ] ]
                        ]
                      ]
                    ],
                    [
                      [ "Bare", "connector_config_user" ],
                      [
                        "Fun_call",
                        [
                          "optional",
                          [ [ "Id", "string" ], [ "String", "ec2-user" ] ]
                        ]
                      ]
                    ],
                    [
                      [ "Bare", "key_pair_name" ],
                      [
                        "Fun_call",
                        [
                          "optional",
                          [
                            [ "Id", "string" ],
                            [ "String", "runner-worker-key" ]
                          ]
                        ]
                      ]
                    ],
                    [
                      [ "Bare", "capacity_per_instance" ],
                      [
                        "Fun_call",
                        [ "optional", [ [ "Id", "number" ], [ "Int", 1 ] ] ]
                      ]
                    ],
                    [
                      [ "Bare", "max_use_count" ],
                      [
                        "Fun_call",
                        [
                          "optional", [ [ "Id", "number" ], [ "Int", 100 ] ]
                        ]
                      ]
                    ],
                    [
                      [ "Bare", "update_interval" ],
                      [
                        "Fun_call",
                        [
                          "optional",
                          [ [ "Id", "string" ], [ "String", "1m" ] ]
                        ]
                      ]
                    ],
                    [
                      [ "Bare", "update_interval_when_expecting" ],
                      [
                        "Fun_call",
                        [
                          "optional",
                          [ [ "Id", "string" ], [ "String", "2s" ] ]
                        ]
                      ]
                    ],
                    [
                      [ "Bare", "instance_ready_command" ],
                      [
                        "Fun_call",
                        [
                          "optional",
                          [ [ "Id", "string" ], [ "String", "" ] ]
                        ]
                      ]
                    ]
                  ]
                ]
              ]
            ]
          ]
        ],
        [ "Attribute", "default", [ "Object", [] ] ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "runner_worker_docker_autoscaler_instance" ] ],
      "body": [
        [
          "Attribute",
          "description",
          [
            "Heredoc",
            [
              "EOT",
              "\nebs_optimized = Enable EBS optimization for the Runner Worker.\nhttp_tokens = Whether or not the metadata service requires session tokens.\nhttp_put_response_hop_limit = The desired HTTP PUT response hop limit for instance metadata requests. The larger the number, the further instance metadata requests can travel.\nmonitoring = Enable detailed monitoring for the Runner Worker.\nprivate_address_only = Restrict Runner Worker to the use of a private IP address. If `runner_instance.use_private_address_only` is set to `true` (default),\nroot_device_name = The name of the root volume for the Runner Worker.\nroot_size = The size of the root volume for the Runner Worker.\nstart_script = Cloud-init user data that will be passed to the Runner Worker. Should not be base64 encrypted.\nstart_script_compression_algorithm = `gzip` compress the start script to mitigate the ~16 KB user data limit. Use `none` for Windows (EC2Launch does not support gzipped user data).\nvolume_type = The type of volume to use for the Runner Worker. `gp2`, `gp3`, `io1` or `io2` are supported.\nvolume_iops = Guaranteed IOPS for the volume. Only supported when using `gp3`, `io1` or `io2` as `volume_type`.\nvolume_throughput = Throughput in MB/s for the volume. Only supported when using `gp3` as `volume_type`.\n"
            ]
          ]
        ],
        [
          "Attribute",
          "type",
          [
            "Fun_call",
            [
              "object",
              [
                [
                  "Object",
                  [
                    [
                      [ "Bare", "ebs_optimized" ],
                      [
                        "Fun_call",
                        [
                          "optional", [ [ "Id", "bool" ], [ "Bool", true ] ]
                        ]
                      ]
                    ],
                    [
                      [ "Bare", "http_tokens" ],
                      [
                        "Fun_call",
                        [
                          "optional",
                          [ [ "Id", "string" ], [ "String", "required" ] ]
                        ]
                      ]
                    ],
                    [
                      [ "Bare", "http_put_response_hop_limit" ],
                      [
                        "Fun_call",
                        [ "optional", [ [ "Id", "number" ], [ "Int", 2 ] ] ]
                      ]
                    ],
                    [
                      [ "Bare", "monitoring" ],
                      [
                        "Fun_call",
                        [
                          "optional", [ [ "Id", "bool" ], [ "Bool", false ] ]
                        ]
                      ]
                    ],
                    [
                      [ "Bare", "private_address_only" ],
                      [
                        "Fun_call",
                        [
                          "optional", [ [ "Id", "bool" ], [ "Bool", true ] ]
                        ]
                      ]
                    ],
                    [
                      [ "Bare", "root_device_name" ],
                      [
                        "Fun_call",
                        [
                          "optional",
                          [ [ "Id", "string" ], [ "String", "/dev/sda1" ] ]
                        ]
                      ]
                    ],
                    [
                      [ "Bare", "root_size" ],
                      [
                        "Fun_call",
                        [ "optional", [ [ "Id", "number" ], [ "Int", 8 ] ] ]
                      ]
                    ],
                    [
                      [ "Bare", "start_script" ],
                      [
                        "Fun_call",
                        [
                          "optional",
                          [ [ "Id", "string" ], [ "String", "" ] ]
                        ]
                      ]
                    ],
                    [
                      [ "Bare", "start_script_compression_algorithm" ],
                      [
                        "Fun_call",
                        [
                          "optional",
                          [ [ "Id", "string" ], [ "String", "gzip" ] ]
                        ]
                      ]
                    ],
                    [
                      [ "Bare", "volume_type" ],
                      [
                        "Fun_call",
                        [
                          "optional",
                          [ [ "Id", "string" ], [ "String", "gp2" ] ]
                        ]
                      ]
                    ],
                    [
                      [ "Bare", "volume_throughput" ],
                      [
                        "Fun_call",
                        [
                          "optional", [ [ "Id", "number" ], [ "Int", 125 ] ]
                        ]
                      ]
                    ],
                    [
                      [ "Bare", "volume_iops" ],
                      [
                        "Fun_call",
                        [
                          "optional", [ [ "Id", "number" ], [ "Int", 3000 ] ]
                        ]
                      ]
                    ]
                  ]
                ]
              ]
            ]
          ]
        ],
        [ "Attribute", "default", [ "Object", [] ] ],
        [
          "Block",
          {
            "type_": "validation",
            "labels": [],
            "body": [
              [
                "Attribute",
                "condition",
                [
                  "Fun_call",
                  [
                    "contains",
                    [
                      [
                        "Tuple",
                        [ [ "String", "gzip" ], [ "String", "none" ] ]
                      ],
                      [
                        "Attr",
                        [
                          [
                            "Attr",
                            [
                              [ "Id", "var" ],
                              [
                                "A_string",
                                "runner_worker_docker_autoscaler_instance"
                              ]
                            ]
                          ],
                          [
                            "A_string", "start_script_compression_algorithm"
                          ]
                        ]
                      ]
                    ]
                  ]
                ]
              ],
              [
                "Attribute",
                "error_message",
                [
                  "String",
                  "The start_script_compression_algorithm supports `gzip` or `none`"
                ]
              ]
            ]
          }
        ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "runner_worker_docker_autoscaler_asg" ] ],
      "body": [
        [
          "Attribute",
          "description",
          [
            "Heredoc",
            [
              "EOT",
              "\nenabled_metrics = List of metrics to collect.\nenable_mixed_instances_policy = Make use of autoscaling-group mixed_instances_policy capacities to leverage pools and spot instances.\nhealth_check_grace_period = Time (in seconds) after instance comes into service before checking health.\nhealth_check_type = Controls how health checking is done. Values are - EC2 and ELB.\ninstance_refresh_min_healthy_percentage = The amount of capacity in the Auto Scaling group that must remain healthy during an instance refresh to allow the operation to continue, as a percentage of the desired capacity of the Auto Scaling group.\ninstance_refresh_triggers = Set of additional property names that will trigger an Instance Refresh. A refresh will always be triggered by a change in any of launch_configuration, launch_template, or mixed_instances_policy.\non_demand_base_capacity = Absolute minimum amount of desired capacity that must be fulfilled by on-demand instances.\non_demand_percentage_above_base_capacity = Percentage split between on-demand and Spot instances above the base on-demand capacity.\nspot_allocation_strategy = How to allocate capacity across the Spot pools. 'lowest-price' to optimize cost, 'capacity-optimized' to reduce interruptions.\nspot_instance_pools = Number of Spot pools per availability zone to allocate capacity. EC2 Auto Scaling selects the cheapest Spot pools and evenly allocates Spot capacity across the number of Spot pools that you specify.\nsubnet_ids = The list of subnet IDs to use for the Runner Worker when the fleet mode is enabled.\ndefault_instance_type = Default instance type for the launch template\ntypes = The type of instance to use for the Runner Worker. In case of fleet mode, multiple instance types are supported.\nupgrade_strategy = Auto deploy new instances when launch template changes. Can be either 'bluegreen', 'rolling' or 'off'.\ninstance_requirements = Override the instance type in the Launch Template with instance types that satisfy the requirements.\n"
            ]
          ]
