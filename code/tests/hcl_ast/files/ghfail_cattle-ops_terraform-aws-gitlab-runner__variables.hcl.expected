  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "runner_role" ] ],
      "body": [
        [
          "Attribute",
          "description",
          [
            "Heredoc",
            [
              "EOT",
              "\nadditional_tags = Map of tags that will be added to the role created. Useful for tag based authorization.\nallow_iam_service_linked_role_creation = Boolean used to control attaching the policy to the Runner to create service linked roles.\nassume_role_policy_json = The assume role policy for the Runner.\ncreate_role_profile = Whether to create the IAM role/profile for the Runner. If you provide your own role, make sure that it has the required permissions.\npolicy_arns = List of policy ARNs to be added to the instance profile of the Runner.\nrole_profile_name = IAM role/profile name for the Runner. If unspecified then `$${var.iam_object_prefix}-instance` is used.\n"
            ]
          ]
        ],
        [
          "Attribute",
          "type",
          [
            "Fun_call",
            [
              "object",
              [
                [
                  "Object",
                  [
                    [
                      [ "Bare", "additional_tags" ],
                      [
                        "Fun_call",
                        [
                          "optional",
                          [
                            [ "Fun_call", [ "map", [ [ "Id", "string" ] ] ] ]
                          ]
                        ]
                      ]
                    ],
                    [
                      [ "Bare", "allow_iam_service_linked_role_creation" ],
                      [
                        "Fun_call",
                        [
                          "optional", [ [ "Id", "bool" ], [ "Bool", true ] ]
                        ]
                      ]
                    ],
                    [
                      [ "Bare", "assume_role_policy_json" ],
                      [
                        "Fun_call",
                        [
                          "optional",
                          [ [ "Id", "string" ], [ "String", "" ] ]
                        ]
                      ]
                    ],
                    [
                      [ "Bare", "create_role_profile" ],
                      [
                        "Fun_call",
                        [
                          "optional", [ [ "Id", "bool" ], [ "Bool", true ] ]
                        ]
                      ]
                    ],
                    [
                      [ "Bare", "policy_arns" ],
                      [
                        "Fun_call",
                        [
                          "optional",
                          [
                            [
                              "Fun_call", [ "list", [ [ "Id", "string" ] ] ]
                            ],
                            [ "Tuple", [] ]
                          ]
                        ]
                      ]
                    ],
                    [
                      [ "Bare", "role_profile_name" ],
                      [ "Fun_call", [ "optional", [ [ "Id", "string" ] ] ] ]
                    ]
                  ]
                ]
              ]
            ]
          ]
        ],
        [ "Attribute", "default", [ "Object", [] ] ]
      ]
    }
  ],
  [
    "Block",
    {
