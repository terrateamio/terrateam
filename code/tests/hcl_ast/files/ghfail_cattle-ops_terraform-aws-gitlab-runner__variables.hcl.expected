[
  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "vpc_id" ] ],
      "body": [
        [
          "Attribute",
          "description",
          [ "String", "The VPC used for the runner and runner workers." ]
        ],
        [ "Attribute", "type", [ "Id", "string" ] ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "subnet_id" ] ],
      "body": [
        [
          "Attribute",
          "description",
          [
            "Heredoc",
            [
              "EOT",
              "\nSubnet id used for the Runner and Runner Workers. Must belong to the `vpc_id`. In case the fleet mode is used, multiple subnets for\nthe Runner Workers can be provided with runner_worker_docker_machine_instance.subnet_ids.\n"
            ]
          ]
        ],
        [ "Attribute", "type", [ "Id", "string" ] ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "kms_key_id" ] ],
      "body": [
        [
          "Attribute",
          "description",
          [
            "String",
            "KMS key id to encrypt the resources. Ensure that CloudWatch and Runner/Runner Workers have access to the provided KMS key."
          ]
        ],
        [ "Attribute", "type", [ "Id", "string" ] ],
        [ "Attribute", "default", [ "String", "" ] ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "enable_managed_kms_key" ] ],
      "body": [
        [
          "Attribute",
          "description",
          [
            "String",
            "Let the module manage a KMS key. Be-aware of the costs of an custom key. Do not specify a `kms_key_id` when `enable_kms` is set to `true`."
          ]
        ],
        [ "Attribute", "type", [ "Id", "bool" ] ],
        [ "Attribute", "default", [ "Bool", false ] ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "kms_managed_alias_name" ] ],
      "body": [
        [
          "Attribute",
          "description",
          [ "String", "Alias added to the created KMS key." ]
        ],
        [ "Attribute", "type", [ "Id", "string" ] ],
        [ "Attribute", "default", [ "String", "" ] ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "kms_managed_deletion_rotation_window_in_days" ] ],
      "body": [
        [
          "Attribute",
          "description",
          [
            "String",
            "Key deletion/rotation window for the created KMS key. Set to 0 for no rotation/deletion window."
          ]
        ],
        [ "Attribute", "type", [ "Id", "number" ] ],
        [ "Attribute", "default", [ "Int", 7 ] ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "iam_permissions_boundary" ] ],
      "body": [
        [
          "Attribute",
          "description",
          [
            "String",
            "Name of permissions boundary policy to attach to AWS IAM roles"
          ]
        ],
        [ "Attribute", "type", [ "Id", "string" ] ],
        [ "Attribute", "default", [ "String", "" ] ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "environment" ] ],
      "body": [
        [
          "Attribute",
          "description",
          [
            "String",
            "A name that identifies the environment, used as prefix and for tagging."
          ]
        ],
        [ "Attribute", "type", [ "Id", "string" ] ],
        [
          "Block",
          {
            "type_": "validation",
            "labels": [],
            "body": [
              [
                "Attribute",
                "condition",
                [
                  "Not",
                  [
                    "Fun_call",
                    [
                      "startswith",
                      [
                        [
                          "Attr",
                          [ [ "Id", "var" ], [ "A_string", "environment" ] ]
                        ],
                        [ "String", "runner-" ]
                      ]
                    ]
                  ]
                ]
              ],
              [
                "Attribute",
                "error_message",
                [
                  "String",
                  "Environment name cannot begin with 'runner-' because it breaks the naming convention for ssh key pairs within the terminate-agent-hook lambda function."
                ]
              ]
            ]
          }
        ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "tags" ] ],
      "body": [
        [
          "Attribute",
          "description",
          [
            "String",
            "Map of tags that will be added to created resources. By default resources will be tagged with name and environment."
          ]
        ],
        [
          "Attribute",
          "type",
          [ "Fun_call", [ "map", [ [ "Id", "string" ] ] ] ]
        ],
        [ "Attribute", "default", [ "Object", [] ] ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "suppressed_tags" ] ],
      "body": [
        [
          "Attribute",
          "description",
          [
            "String",
            "List of tag keys which are automatically removed and never added as default tag by the module."
          ]
        ],
        [
          "Attribute",
          "type",
          [ "Fun_call", [ "list", [ [ "Id", "string" ] ] ] ]
        ],
        [ "Attribute", "default", [ "Tuple", [] ] ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "security_group_prefix" ] ],
      "body": [
        [
          "Attribute",
          "description",
          [
            "String",
            "Set the name prefix and overwrite the `Name` tag for all security groups."
          ]
        ],
        [ "Attribute", "type", [ "Id", "string" ] ],
        [ "Attribute", "default", [ "String", "" ] ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "iam_object_prefix" ] ],
      "body": [
        [
          "Attribute",
          "description",
          [ "String", "Set the name prefix of all AWS IAM resources." ]
        ],
        [ "Attribute", "type", [ "Id", "string" ] ],
        [ "Attribute", "default", [ "String", "" ] ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "runner_manager" ] ],
      "body": [
        [
          "Attribute",
          "description",
          [
            "Heredoc",
            [
              "EOT",
              "\nFor details check https://docs.gitlab.com/runner/configuration/advanced-configuration.html#the-global-section\n\ngitlab_check_interval = Number of seconds between checking for available jobs (check_interval)\nmaximum_concurrent_jobs = The maximum number of jobs which can be processed by all Runners at the same time (concurrent).\nprometheus_listen_address = Defines an address (<host>:<port>) the Prometheus metrics HTTP server should listen on (listen_address).\nsentry_dsn = Sentry DSN of the project for the Runner Manager to use (uses legacy DSN format) (sentry_dsn)\nconnection_max_age = The maximum age of a connection to the Runner Manager (connection_max_age).\n"
            ]
          ]
        ],
        [
          "Attribute",
          "type",
          [
            "Fun_call",
            [
              "object",
              [
                [
                  "Object",
                  [
                    [
                      [ "Bare", "gitlab_check_interval" ],
                      [
                        "Fun_call",
                        [ "optional", [ [ "Id", "number" ], [ "Int", 3 ] ] ]
                      ]
                    ],
                    [
                      [ "Bare", "maximum_concurrent_jobs" ],
                      [
                        "Fun_call",
                        [ "optional", [ [ "Id", "number" ], [ "Int", 10 ] ] ]
                      ]
                    ],
                    [
                      [ "Bare", "prometheus_listen_address" ],
                      [
                        "Fun_call",
                        [
                          "optional",
                          [ [ "Id", "string" ], [ "String", "" ] ]
                        ]
                      ]
                    ],
                    [
                      [ "Bare", "sentry_dsn" ],
                      [
                        "Fun_call",
                        [
                          "optional",
                          [
                            [ "Id", "string" ],
                            [
                              "String",
                              "__SENTRY_DSN_REPLACED_BY_USER_DATA__"
                            ]
                          ]
                        ]
                      ]
                    ],
                    [
                      [ "Bare", "connection_max_age" ],
                      [
                        "Fun_call",
                        [
                          "optional",
                          [ [ "Id", "string" ], [ "String", "15m" ] ]
                        ]
                      ]
                    ]
                  ]
                ]
              ]
            ]
          ]
        ],
        [ "Attribute", "default", [ "Object", [] ] ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "runner_instance" ] ],
      "body": [
        [
          "Attribute",
          "description",
          [
            "Heredoc",
            [
              "EOT",
              "\nadditional_tags = Map of tags that will be added to the Runner instance.\ncollect_autoscaling_metrics = A list of metrics to collect. The allowed values are GroupDesiredCapacity, GroupInServiceCapacity, GroupPendingCapacity, GroupMinSize, GroupMaxSize, GroupInServiceInstances, GroupPendingInstances, GroupStandbyInstances, GroupStandbyCapacity, GroupTerminatingCapacity, GroupTerminatingInstances, GroupTotalCapacity, GroupTotalInstances.\nebs_optimized = Enable EBS optimization for the Runner instance.\nmax_lifetime_seconds = The maximum time a Runner should live before it is killed.\nmonitoring = Enable the detailed monitoring on the Runner instance.\nname = Name of the Runner instance.\nname_prefix = Set the name prefix and override the `Name` tag for the Runner instance.\nprivate_address_only = Restrict the Runner to use private IP addresses only. If this is set to `true` the Runner will use a private IP address only in case the Runner Workers use private addresses only.\nroot_device_config = The Runner's root block device configuration. Takes the following keys: `device_name`, `delete_on_termination`, `volume_type`, `volume_size`, `encrypted`, `iops`, `throughput`, `kms_key_id`\nspot_price = By setting a spot price bid price the Runner is created via a spot request. Be aware that spot instances can be stopped by AWS. Choose \\\"on-demand-price\\\" to pay up to the current on demand price for the instance type chosen.\nssm_access = Allows to connect to the Runner via SSM.\ntype = EC2 instance type used.\nuse_eip = Assigns an EIP to the Runner.\n"
            ]
          ]
        ],
        [
          "Attribute",
          "type",
          [
            "Fun_call",
            [
              "object",
              [
                [
                  "Object",
                  [
                    [
                      [ "Bare", "additional_tags" ],
                      [
                        "Fun_call",
                        [
                          "optional",
                          [
                            [ "Fun_call", [ "map", [ [ "Id", "string" ] ] ] ]
                          ]
                        ]
                      ]
                    ],
                    [
                      [ "Bare", "collect_autoscaling_metrics" ],
                      [
                        "Fun_call",
                        [
                          "optional",
                          [
                            [
                              "Fun_call", [ "list", [ [ "Id", "string" ] ] ]
                            ],
                            [ "Null" ]
                          ]
                        ]
                      ]
                    ],
                    [
                      [ "Bare", "ebs_optimized" ],
                      [
                        "Fun_call",
                        [
                          "optional", [ [ "Id", "bool" ], [ "Bool", true ] ]
                        ]
                      ]
                    ],
                    [
                      [ "Bare", "max_lifetime_seconds" ],
                      [
                        "Fun_call",
                        [ "optional", [ [ "Id", "number" ], [ "Null" ] ] ]
                      ]
                    ],
                    [
                      [ "Bare", "monitoring" ],
                      [
                        "Fun_call",
                        [
                          "optional", [ [ "Id", "bool" ], [ "Bool", true ] ]
                        ]
                      ]
                    ],
                    [ [ "Bare", "name" ], [ "Id", "string" ] ],
                    [
                      [ "Bare", "name_prefix" ],
                      [ "Fun_call", [ "optional", [ [ "Id", "string" ] ] ] ]
                    ],
                    [
                      [ "Bare", "private_address_only" ],
                      [
                        "Fun_call",
                        [
                          "optional", [ [ "Id", "bool" ], [ "Bool", true ] ]
                        ]
                      ]
                    ],
                    [
                      [ "Bare", "root_device_config" ],
                      [
                        "Fun_call",
                        [
                          "optional",
                          [
                            [ "Fun_call", [ "map", [ [ "Id", "string" ] ] ] ],
                            [ "Object", [] ]
                          ]
                        ]
                      ]
                    ],
                    [
                      [ "Bare", "spot_price" ],
                      [
                        "Fun_call",
                        [ "optional", [ [ "Id", "string" ], [ "Null" ] ] ]
                      ]
                    ],
                    [
                      [ "Bare", "ssm_access" ],
                      [
                        "Fun_call",
                        [
                          "optional", [ [ "Id", "bool" ], [ "Bool", false ] ]
                        ]
                      ]
                    ],
                    [
                      [ "Bare", "type" ],
                      [
                        "Fun_call",
                        [
                          "optional",
                          [ [ "Id", "string" ], [ "String", "t3.micro" ] ]
                        ]
                      ]
                    ],
                    [
                      [ "Bare", "use_eip" ],
                      [
                        "Fun_call",
                        [
                          "optional", [ [ "Id", "bool" ], [ "Bool", false ] ]
                        ]
                      ]
                    ]
                  ]
                ]
              ]
            ]
          ]
        ],
        [
          "Attribute",
          "default",
          [
            "Object",
            [ [ [ "Bare", "name" ], [ "String", "gitlab-runner" ] ] ]
          ]
        ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "runner_ami_filter" ] ],
      "body": [
        [
          "Attribute",
          "description",
          [
            "String",
            "List of maps used to create the AMI filter for the Runner AMI. Must resolve to an Amazon Linux 1, 2 or 2023 image."
          ]
        ],
        [
          "Attribute",
          "type",
          [
            "Fun_call",
            [ "map", [ [ "Fun_call", [ "list", [ [ "Id", "string" ] ] ] ] ] ]
          ]
        ],
        [
          "Attribute",
          "default",
          [
            "Object",
            [
              [
                [ "Bare", "name" ],
                [ "Tuple", [ [ "String", "al2023-ami-2023*-x86_64" ] ] ]
              ]
            ]
          ]
        ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "runner_ami_owners" ] ],
      "body": [
        [
          "Attribute",
          "description",
          [
            "String",
            "The list of owners used to select the AMI of the Runner instance."
          ]
        ],
        [
          "Attribute",
          "type",
          [ "Fun_call", [ "list", [ [ "Id", "string" ] ] ] ]
        ],
        [ "Attribute", "default", [ "Tuple", [ [ "String", "amazon" ] ] ] ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "runner_ami_id" ] ],
      "body": [
        [
          "Attribute",
          "description",
          [ "String", "The AMI ID of the Runner instance." ]
        ],
        [ "Attribute", "type", [ "Id", "string" ] ],
        [ "Attribute", "default", [ "String", "" ] ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "runner_networking" ] ],
      "body": [
        [
          "Attribute",
          "description",
          [
            "Heredoc",
            [
              "EOT",
              "\nallow_incoming_ping = Allow ICMP Ping to the Runner. Specify `allow_incoming_ping_security_group_ids` too!\nallow_incoming_ping_security_group_ids = A list of security group ids that are allowed to ping the Runner.\nsecurity_group_description = A description for the Runner's security group\nsecurity_group_ids = IDs of security groups to add to the Runner.\n"
            ]
          ]
        ],
        [
          "Attribute",
          "type",
          [
            "Fun_call",
            [
              "object",
              [
                [
                  "Object",
                  [
                    [
                      [ "Bare", "allow_incoming_ping" ],
                      [
                        "Fun_call",
                        [
                          "optional", [ [ "Id", "bool" ], [ "Bool", false ] ]
                        ]
                      ]
                    ],
                    [
                      [ "Bare", "allow_incoming_ping_security_group_ids" ],
                      [
                        "Fun_call",
                        [
                          "optional",
                          [
                            [
                              "Fun_call", [ "list", [ [ "Id", "string" ] ] ]
                            ],
                            [ "Tuple", [] ]
                          ]
                        ]
                      ]
                    ],
                    [
                      [ "Bare", "security_group_description" ],
                      [
                        "Fun_call",
                        [
                          "optional",
                          [
                            [ "Id", "string" ],
                            [
                              "String",
                              "A security group containing gitlab-runner agent instances"
                            ]
                          ]
                        ]
                      ]
                    ],
                    [
                      [ "Bare", "security_group_ids" ],
                      [
                        "Fun_call",
                        [
                          "optional",
                          [
                            [
                              "Fun_call", [ "list", [ [ "Id", "string" ] ] ]
                            ],
                            [ "Tuple", [] ]
                          ]
                        ]
                      ]
                    ]
                  ]
                ]
              ]
            ]
          ]
        ],
        [ "Attribute", "default", [ "Object", [] ] ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "runner_ingress_rules" ] ],
      "body": [
        [
          "Attribute",
          "description",
          [
            "String",
            "Map of Ingress rules for the Runner Manager security group."
          ]
        ],
        [
          "Attribute",
          "type",
          [
            "Fun_call",
            [
              "map",
              [
                [
                  "Fun_call",
                  [
                    "object",
                    [
                      [
                        "Object",
                        [
                          [
                            [ "Bare", "from_port" ],
                            [
                              "Fun_call",
                              [
                                "optional",
                                [ [ "Id", "number" ], [ "Null" ] ]
                              ]
                            ]
                          ],
                          [
                            [ "Bare", "to_port" ],
                            [
                              "Fun_call",
                              [
                                "optional",
                                [ [ "Id", "number" ], [ "Null" ] ]
                              ]
                            ]
                          ],
                          [ [ "Bare", "protocol" ], [ "Id", "string" ] ],
                          [ [ "Bare", "description" ], [ "Id", "string" ] ],
                          [
                            [ "Bare", "cidr_block" ],
                            [
                              "Fun_call",
                              [
                                "optional",
                                [ [ "Id", "string" ], [ "Null" ] ]
                              ]
                            ]
                          ],
                          [
                            [ "Bare", "ipv6_cidr_block" ],
                            [
                              "Fun_call",
                              [
                                "optional",
                                [ [ "Id", "string" ], [ "Null" ] ]
                              ]
                            ]
                          ],
                          [
                            [ "Bare", "prefix_list_id" ],
                            [
                              "Fun_call",
                              [
                                "optional",
                                [ [ "Id", "string" ], [ "Null" ] ]
                              ]
                            ]
                          ],
                          [
                            [ "Bare", "security_group" ],
                            [
                              "Fun_call",
                              [
                                "optional",
                                [ [ "Id", "string" ], [ "Null" ] ]
                              ]
                            ]
                          ]
                        ]
                      ]
                    ]
                  ]
                ]
              ]
            ]
          ]
        ],
        [ "Attribute", "default", [ "Object", [] ] ],
        [
          "Block",
          {
            "type_": "validation",
            "labels": [],
            "body": [
              [
                "Attribute",
                "condition",
                [
                  "Fun_call",
                  [
                    "alltrue",
                    [
                      [
                        "For_tuple",
                        {
                          "identifiers": [ "rule", [] ],
                          "input": [
                            "Fun_call",
                            [
                              "values",
                              [
                                [
                                  "Attr",
                                  [
                                    [ "Id", "var" ],
                                    [ "A_string", "runner_ingress_rules" ]
                                  ]
                                ]
                              ]
                            ]
                          ],
                          "output": [
                            "Fun_call",
                            [
                              "contains",
                              [
                                [
                                  "Tuple",
                                  [
                                    [ "String", "-1" ],
                                    [ "String", "tcp" ],
                                    [ "String", "udp" ],
                                    [ "String", "icmp" ],
                                    [ "String", "icmpv6" ]
                                  ]
                                ],
                                [
                                  "Attr",
                                  [
                                    [ "Id", "rule" ],
                                    [ "A_string", "protocol" ]
                                  ]
                                ]
                              ]
                            ]
                          ],
                          "cond": null
                        }
                      ]
                    ]
                  ]
                ]
              ],
              [
                "Attribute",
                "error_message",
                [
                  "String",
                  "Protocol must be '-1', 'tcp', 'udp', 'icmp', or 'icmpv6'."
                ]
              ]
            ]
          }
        ],
        [
          "Block",
          {
            "type_": "validation",
            "labels": [],
            "body": [
              [
                "Attribute",
                "condition",
                [
                  "Fun_call",
                  [
                    "alltrue",
                    [
                      [
                        "For_tuple",
                        {
                          "identifiers": [ "rule", [] ],
                          "input": [
                            "Fun_call",
                            [
                              "values",
                              [
                                [
                                  "Attr",
                                  [
                                    [ "Id", "var" ],
                                    [ "A_string", "runner_ingress_rules" ]
                                  ]
                                ]
                              ]
                            ]
                          ],
                          "output": [
                            "Log_or",
                            [
                              [
                                "Log_or",
                                [
                                  [
                                    "Log_or",
                                    [
                                      [
                                        "Not_equal",
                                        [
                                          [
                                            "Attr",
                                            [
                                              [ "Id", "rule" ],
                                              [ "A_string", "cidr_block" ]
                                            ]
                                          ],
                                          [ "Null" ]
                                        ]
                                      ],
                                      [
                                        "Not_equal",
                                        [
                                          [
                                            "Attr",
                                            [
                                              [ "Id", "rule" ],
                                              [
                                                "A_string", "ipv6_cidr_block"
                                              ]
                                            ]
                                          ],
                                          [ "Null" ]
                                        ]
                                      ]
                                    ]
                                  ],
                                  [
                                    "Not_equal",
                                    [
                                      [
                                        "Attr",
                                        [
                                          [ "Id", "rule" ],
                                          [ "A_string", "prefix_list_id" ]
                                        ]
                                      ],
                                      [ "Null" ]
                                    ]
                                  ]
                                ]
                              ],
                              [
                                "Not_equal",
                                [
                                  [
                                    "Attr",
                                    [
                                      [ "Id", "rule" ],
                                      [ "A_string", "security_group" ]
                                    ]
                                  ],
                                  [ "Null" ]
                                ]
                              ]
                            ]
                          ],
                          "cond": null
                        }
                      ]
                    ]
                  ]
                ]
              ],
              [
                "Attribute",
                "error_message",
                [ "String", "At least one destination must be specified." ]
              ]
            ]
          }
        ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "runner_egress_rules" ] ],
      "body": [
        [
          "Attribute",
          "description",
          [
            "String",
            "Map of Egress rules for the Runner Manager security group."
          ]
        ],
        [
          "Attribute",
          "type",
          [
            "Fun_call",
            [
              "map",
              [
                [
                  "Fun_call",
                  [
                    "object",
                    [
                      [
                        "Object",
                        [
                          [
                            [ "Bare", "from_port" ],
                            [
                              "Fun_call",
                              [
                                "optional",
