  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "runner_worker_docker_machine_instance" ] ],
      "body": [
        [
          "Attribute",
          "description",
          [
            "Heredoc",
            [
              "EOT",
              "\nFor detailed documentation check https://docs.gitlab.com/runner/configuration/advanced-configuration.html#the-runnersmachine-section\n\ndocker_registry_mirror_url = The URL of the Docker registry mirror to use for the Runner Worker.\ndestroy_after_max_builds = Destroy the instance after the maximum number of builds has been reached.\nebs_optimized = Enable EBS optimization for the Runner Worker.\nidle_count = Number of idle Runner Worker instances (not working for the Docker Runner Worker) (IdleCount).\nidle_time = Idle time of the Runner Worker before they are destroyed (not working for the Docker Runner Worker) (IdleTime).\nmax_growth_rate = The maximum number of machines that can be added to the runner in parallel.\nmonitoring = Enable detailed monitoring for the Runner Worker.\nname_prefix = Set the name prefix and override the `Name` tag for the Runner Worker.\nprivate_address_only = Restrict Runner Worker to the use of a private IP address. If `runner_instance.use_private_address_only` is set to `true` (default), `runner_worker_docker_machine_instance.private_address_only` will also apply for the Runner.\nroot_device_name = The name of the root volume for the Runner Worker.\nroot_size = The size of the root volume for the Runner Worker.\nstart_script = Cloud-init user data that will be passed to the Runner Worker. Should not be base64 encrypted.\nsubnet_ids = The list of subnet IDs to use for the Runner Worker when the fleet mode is enabled.\ntypes = The type of instance to use for the Runner Worker. In case of fleet mode, multiple instance types are supported.\nvolume_type = The type of volume to use for the Runner Worker. `gp2`, `gp3`, `io1` or `io2` are supported.\nvolume_throughput = Throughput in MB/s for the volume. Only supported when using `gp3` as `volume_type`.\nvolume_iops = Guaranteed IOPS for the volume. Only supported when using `gp3`, `io1` or `io2` as `volume_type`. Works for fleeting only. See `runner_worker_docker_machine_fleet`.\n"
            ]
          ]
        ],
        [
          "Attribute",
          "type",
          [
            "Fun_call",
            [
              "object",
              [
                [
                  "Object",
                  [
                    [
                      [ "Bare", "destroy_after_max_builds" ],
                      [
                        "Fun_call",
                        [ "optional", [ [ "Id", "number" ], [ "Int", 0 ] ] ]
                      ]
                    ],
                    [
                      [ "Bare", "docker_registry_mirror_url" ],
                      [
                        "Fun_call",
                        [
                          "optional",
                          [ [ "Id", "string" ], [ "String", "" ] ]
                        ]
                      ]
                    ],
                    [
                      [ "Bare", "ebs_optimized" ],
                      [
                        "Fun_call",
                        [
                          "optional", [ [ "Id", "bool" ], [ "Bool", true ] ]
                        ]
                      ]
                    ],
                    [
                      [ "Bare", "idle_count" ],
                      [
                        "Fun_call",
                        [ "optional", [ [ "Id", "number" ], [ "Int", 0 ] ] ]
                      ]
                    ],
                    [
                      [ "Bare", "idle_time" ],
                      [
                        "Fun_call",
                        [
                          "optional", [ [ "Id", "number" ], [ "Int", 600 ] ]
                        ]
                      ]
                    ],
                    [
                      [ "Bare", "max_growth_rate" ],
                      [
                        "Fun_call",
                        [ "optional", [ [ "Id", "number" ], [ "Int", 0 ] ] ]
                      ]
                    ],
                    [
                      [ "Bare", "monitoring" ],
                      [
                        "Fun_call",
                        [
                          "optional", [ [ "Id", "bool" ], [ "Bool", false ] ]
                        ]
                      ]
                    ],
                    [
                      [ "Bare", "name_prefix" ],
                      [
                        "Fun_call",
                        [
                          "optional",
                          [ [ "Id", "string" ], [ "String", "" ] ]
                        ]
                      ]
                    ],
                    [
                      [ "Bare", "private_address_only" ],
                      [
                        "Fun_call",
                        [
                          "optional", [ [ "Id", "bool" ], [ "Bool", true ] ]
                        ]
                      ]
                    ],
                    [
                      [ "Bare", "root_device_name" ],
                      [
                        "Fun_call",
                        [
                          "optional",
                          [ [ "Id", "string" ], [ "String", "/dev/sda1" ] ]
                        ]
                      ]
                    ],
                    [
                      [ "Bare", "root_size" ],
                      [
                        "Fun_call",
                        [ "optional", [ [ "Id", "number" ], [ "Int", 8 ] ] ]
                      ]
                    ],
                    [
                      [ "Bare", "start_script" ],
                      [
                        "Fun_call",
                        [
                          "optional",
                          [ [ "Id", "string" ], [ "String", "" ] ]
                        ]
                      ]
                    ],
                    [
                      [ "Bare", "subnet_ids" ],
                      [
                        "Fun_call",
                        [
                          "optional",
                          [
                            [
                              "Fun_call", [ "list", [ [ "Id", "string" ] ] ]
                            ],
                            [ "Tuple", [] ]
                          ]
                        ]
                      ]
                    ],
                    [
                      [ "Bare", "types" ],
                      [
                        "Fun_call",
                        [
                          "optional",
                          [
                            [
                              "Fun_call", [ "list", [ [ "Id", "string" ] ] ]
                            ],
                            [ "Tuple", [ [ "String", "m5.large" ] ] ]
                          ]
                        ]
                      ]
                    ],
                    [
                      [ "Bare", "volume_type" ],
                      [
                        "Fun_call",
                        [
                          "optional",
                          [ [ "Id", "string" ], [ "String", "gp2" ] ]
                        ]
                      ]
                    ],
                    [
                      [ "Bare", "volume_throughput" ],
                      [
                        "Fun_call",
                        [
                          "optional", [ [ "Id", "number" ], [ "Int", 125 ] ]
                        ]
                      ]
                    ],
                    [
                      [ "Bare", "volume_iops" ],
                      [
                        "Fun_call",
                        [
                          "optional", [ [ "Id", "number" ], [ "Int", 3000 ] ]
                        ]
                      ]
                    ]
                  ]
                ]
              ]
            ]
          ]
        ],
        [ "Attribute", "default", [ "Object", [] ] ],
        [
