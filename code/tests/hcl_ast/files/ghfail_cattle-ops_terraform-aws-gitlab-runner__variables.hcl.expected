      "type_": "variable",
      "labels": [ [ "Lit", "runner_worker_docker_services" ] ],
      "body": [
        [
          "Attribute",
          "description",
          [
            "String",
            "Starts additional services with the Docker container. All fields must be set (examine the Dockerfile of the service image for the entrypoint - see ./examples/runner-default/main.tf)"
          ]
