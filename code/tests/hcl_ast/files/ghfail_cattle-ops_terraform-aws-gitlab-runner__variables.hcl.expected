  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "runner_gitlab" ] ],
      "body": [
        [
          "Attribute",
          "description",
          [
            "Heredoc",
            [
              "EOT",
              "\nca_certificate = Trusted CA certificate bundle (PEM format).\ncertificate = Certificate of the GitLab instance to connect to (PEM format).\nregistration_token = (deprecated, this is replaced by the `preregistered_runner_token_ssm_parameter_name`) Registration token to use to register the Runner.\nrunner_version = Version of the [GitLab Runner](https://gitlab.com/gitlab-org/gitlab-runner/-/releases). Make sure that it is available for your AMI. See https://packages.gitlab.com/app/runner/gitlab-runner/search?dist=amazon%2F2023&filter=rpms&page=1&q=\nurl = URL of the GitLab instance to connect to.\nurl_clone = URL of the GitLab instance to clone from. Use only if the agent can’t connect to the GitLab URL.\naccess_token_secure_parameter_store_name = (deprecated, this is replaced by the `preregistered_runner_token_ssm_parameter_name`) The name of the SSM parameter to read the GitLab access token from. It must have the `api` scope and be pre created.\npreregistered_runner_token_ssm_parameter_name = The name of the SSM parameter to read the preregistered GitLab Runner token from.\n"
            ]
          ]
        ],
        [
          "Attribute",
          "type",
          [
            "Fun_call",
            [
              "object",
              [
                [
                  "Object",
                  [
                    [
                      [ "Bare", "ca_certificate" ],
                      [
                        "Fun_call",
                        [
                          "optional",
                          [ [ "Id", "string" ], [ "String", "" ] ]
                        ]
                      ]
                    ],
                    [
                      [ "Bare", "certificate" ],
                      [
                        "Fun_call",
                        [
                          "optional",
                          [ [ "Id", "string" ], [ "String", "" ] ]
                        ]
                      ]
                    ],
                    [
                      [ "Bare", "registration_token" ],
                      [
                        "Fun_call",
                        [
                          "optional",
                          [
                            [ "Id", "string" ],
                            [ "String", "__REPLACED_BY_USER_DATA__" ]
                          ]
                        ]
                      ]
                    ],
                    [
                      [ "Bare", "runner_version" ],
                      [
                        "Fun_call",
                        [
                          "optional",
                          [ [ "Id", "string" ], [ "String", "16.0.3" ] ]
                        ]
                      ]
                    ],
                    [
                      [ "Bare", "url" ],
                      [
                        "Fun_call",
                        [
                          "optional",
                          [ [ "Id", "string" ], [ "String", "" ] ]
                        ]
                      ]
                    ],
                    [
                      [ "Bare", "url_clone" ],
                      [
                        "Fun_call",
                        [
                          "optional",
                          [ [ "Id", "string" ], [ "String", "" ] ]
                        ]
                      ]
                    ],
                    [
                      [ "Bare", "access_token_secure_parameter_store_name" ],
                      [
                        "Fun_call",
                        [
                          "optional",
                          [
                            [ "Id", "string" ],
                            [ "String", "gitlab-runner-access-token" ]
                          ]
                        ]
                      ]
                    ],
                    [
                      [
                        "Bare",
                        "preregistered_runner_token_ssm_parameter_name"
