  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "runner_worker" ] ],
      "body": [
        [
          "Attribute",
          "description",
          [
            "Heredoc",
            [
              "EOT",
              "\nFor detailed information, check https://docs.gitlab.com/runner/configuration/advanced-configuration.html#the-runners-section.\n\nenvironment_variables = List of environment variables to add to the Runner Worker (environment).\nmax_jobs = Number of jobs which can be processed in parallel by the Runner Worker.\noutput_limit = Sets the maximum build log size in kilobytes. Default is 4MB (output_limit).\nrequest_concurrency = Limit number of concurrent requests for new jobs from GitLab (default 1) (request_concurrency).\nssm_access = Allows to connect to the Runner Worker via SSM.\ntype = The Runner Worker type to use. Currently supports `docker+machine` or `docker` or `docker-autoscaler`.\nuse_private_key = Use a private key to connect the Runner Manager to the Runner Workers. Ignored when fleeting is enabled (defaults to `true`).\n"
            ]
          ]
        ],
        [
          "Attribute",
          "type",
          [
            "Fun_call",
            [
              "object",
              [
                [
                  "Object",
                  [
                    [
                      [ "Bare", "environment_variables" ],
                      [
                        "Fun_call",
                        [
                          "optional",
                          [
                            [
                              "Fun_call", [ "list", [ [ "Id", "string" ] ] ]
                            ],
                            [ "Tuple", [] ]
                          ]
                        ]
                      ]
                    ],
                    [
                      [ "Bare", "max_jobs" ],
                      [
                        "Fun_call",
                        [ "optional", [ [ "Id", "number" ], [ "Int", 0 ] ] ]
                      ]
                    ],
                    [
                      [ "Bare", "output_limit" ],
                      [
                        "Fun_call",
                        [
                          "optional", [ [ "Id", "number" ], [ "Int", 4096 ] ]
                        ]
                      ]
                    ],
                    [
                      [ "Bare", "request_concurrency" ],
                      [
                        "Fun_call",
                        [ "optional", [ [ "Id", "number" ], [ "Int", 1 ] ] ]
                      ]
                    ],
                    [
                      [ "Bare", "ssm_access" ],
                      [
                        "Fun_call",
                        [
                          "optional", [ [ "Id", "bool" ], [ "Bool", false ] ]
                        ]
                      ]
                    ],
                    [
                      [ "Bare", "type" ],
                      [
                        "Fun_call",
                        [
                          "optional",
                          [
                            [ "Id", "string" ],
                            [ "String", "docker+machine" ]
                          ]
                        ]
                      ]
                    ],
                    [
                      [ "Bare", "use_private_key" ],
                      [
                        "Fun_call",
                        [
                          "optional", [ [ "Id", "bool" ], [ "Bool", false ] ]
                        ]
                      ]
                    ]
                  ]
                ]
              ]
            ]
          ]
        ],
        [ "Attribute", "default", [ "Object", [] ] ],
        [
          "Block",
          {
            "type_": "validation",
            "labels": [],
            "body": [
              [
                "Attribute",
                "condition",
                [
                  "Fun_call",
                  [
                    "contains",
                    [
                      [
                        "Tuple",
                        [
                          [ "String", "docker+machine" ],
                          [ "String", "docker" ],
                          [ "String", "docker-autoscaler" ]
                        ]
                      ],
                      [
                        "Attr",
                        [
                          [
                            "Attr",
                            [
                              [ "Id", "var" ],
                              [ "A_string", "runner_worker" ]
                            ]
                          ],
                          [ "A_string", "type" ]
                        ]
                      ]
                    ]
                  ]
                ]
              ],
              [
                "Attribute",
                "error_message",
                [
                  "String",
                  "The executor currently supports `docker+machine` and `docker`."
                ]
              ]
            ]
          }
        ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "runner_worker_cache" ] ],
      "body": [
        [
          "Attribute",
          "description",
          [
            "Heredoc",
            [
              "EOT",
              "\nConfiguration to control the creation of the cache bucket. By default the bucket will be created and used as shared\ncache. To use the same cache across multiple Runner Worker disable the creation of the cache and provide a policy and\nbucket name. See the public runner example for more details.\"\n\nFor detailed documentation check https://docs.gitlab.com/runner/configuration/advanced-configuration.html#the-runnerscaches3-section.\n\naccess_log_bucker_id = The ID of the bucket where the access logs are stored.\naccess_log_bucket_prefix = The bucket prefix for the access logs.\nauthentication_type = A string that declares the AuthenticationType for [runners.cache.s3]. Can either be 'iam' or 'credentials'.\nbucket = Name of the cache bucket. Requires `create = false`.\nbucket_prefix = Prefix for s3 cache bucket name. Requires `create = true`.\ncreate = Boolean used to enable or disable the creation of the cache bucket.\ncreate_aws_s3_bucket_public_access_block = Boolean used to enable or disable the creation of the public access block for the cache bucket. Useful when organizations do not allow the creation of public access blocks on individual buckets (e.g. public access is blocked on all buckets at the organization level).\nexpiration_days = Number of days before cache objects expire. Requires `create = true`.\ninclude_account_id = Boolean used to include the account id in the cache bucket name. Requires `create = true`.\npolicy = Policy to use for the cache bucket. Requires `create = false`.\nrandom_suffix = Boolean used to enable or disable the use of a random string suffix on the cache bucket name. Requires `create = true`.\nshared = Boolean used to enable or disable the use of the cache bucket as shared cache.\nversioning = Boolean used to enable versioning on the cache bucket. Requires `create = true`.\n"
            ]
          ]
        ],
        [
          "Attribute",
          "type",
          [
            "Fun_call",
            [
              "object",
              [
                [
                  "Object",
                  [
                    [
                      [ "Bare", "access_log_bucket_id" ],
                      [
                        "Fun_call",
                        [ "optional", [ [ "Id", "string" ], [ "Null" ] ] ]
                      ]
                    ],
                    [
                      [ "Bare", "access_log_bucket_prefix" ],
                      [
                        "Fun_call",
                        [ "optional", [ [ "Id", "string" ], [ "Null" ] ] ]
                      ]
                    ],
                    [
                      [ "Bare", "authentication_type" ],
                      [
                        "Fun_call",
                        [
                          "optional",
                          [ [ "Id", "string" ], [ "String", "iam" ] ]
                        ]
                      ]
                    ],
                    [
                      [ "Bare", "bucket" ],
                      [
                        "Fun_call",
                        [
                          "optional",
                          [ [ "Id", "string" ], [ "String", "" ] ]
                        ]
                      ]
                    ],
                    [
                      [ "Bare", "bucket_prefix" ],
                      [
                        "Fun_call",
                        [
                          "optional",
                          [ [ "Id", "string" ], [ "String", "" ] ]
                        ]
                      ]
                    ],
                    [
                      [ "Bare", "create" ],
                      [
                        "Fun_call",
                        [
                          "optional", [ [ "Id", "bool" ], [ "Bool", true ] ]
                        ]
                      ]
                    ],
                    [
                      [ "Bare", "create_aws_s3_bucket_public_access_block" ],
                      [
                        "Fun_call",
                        [
                          "optional", [ [ "Id", "bool" ], [ "Bool", true ] ]
                        ]
                      ]
                    ],
                    [
                      [ "Bare", "expiration_days" ],
                      [
                        "Fun_call",
                        [ "optional", [ [ "Id", "number" ], [ "Int", 1 ] ] ]
                      ]
                    ],
                    [
                      [ "Bare", "include_account_id" ],
                      [
                        "Fun_call",
                        [
                          "optional", [ [ "Id", "bool" ], [ "Bool", true ] ]
                        ]
                      ]
                    ],
                    [
                      [ "Bare", "policy" ],
                      [
                        "Fun_call",
                        [
                          "optional",
                          [ [ "Id", "string" ], [ "String", "" ] ]
                        ]
                      ]
                    ],
                    [
                      [ "Bare", "random_suffix" ],
                      [
                        "Fun_call",
                        [
                          "optional", [ [ "Id", "bool" ], [ "Bool", false ] ]
                        ]
                      ]
                    ],
                    [
                      [ "Bare", "shared" ],
                      [
                        "Fun_call",
                        [
                          "optional", [ [ "Id", "bool" ], [ "Bool", false ] ]
                        ]
                      ]
                    ],
                    [
                      [ "Bare", "versioning" ],
                      [
                        "Fun_call",
                        [
                          "optional", [ [ "Id", "bool" ], [ "Bool", false ] ]
                        ]
                      ]
                    ]
                  ]
                ]
              ]
            ]
          ]
        ],
        [ "Attribute", "default", [ "Object", [] ] ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "runner_worker_gitlab_pipeline" ] ],
      "body": [
        [
          "Attribute",
          "description",
          [
            "Heredoc",
            [
              "EOT",
              "\npost_build_script = Script to execute in the pipeline just after the build, but before executing after_script.\npre_build_script = Script to execute in the pipeline just before the build.\npre_clone_script = Script to execute in the pipeline before cloning the Git repository. this can be used to adjust the Git client configuration first, for example.\n"
            ]
          ]
        ],
        [
          "Attribute",
          "type",
          [
            "Fun_call",
            [
              "object",
              [
                [
                  "Object",
                  [
                    [
                      [ "Bare", "post_build_script" ],
                      [
                        "Fun_call",
                        [
                          "optional",
                          [ [ "Id", "string" ], [ "String", "\"\"" ] ]
                        ]
                      ]
                    ],
                    [
                      [ "Bare", "pre_build_script" ],
                      [
                        "Fun_call",
                        [
                          "optional",
                          [ [ "Id", "string" ], [ "String", "\"\"" ] ]
                        ]
                      ]
                    ],
                    [
                      [ "Bare", "pre_clone_script" ],
                      [
                        "Fun_call",
                        [
                          "optional",
                          [ [ "Id", "string" ], [ "String", "\"\"" ] ]
                        ]
                      ]
                    ]
                  ]
                ]
              ]
            ]
          ]
        ],
        [ "Attribute", "default", [ "Object", [] ] ]
      ]
    }
  ],
