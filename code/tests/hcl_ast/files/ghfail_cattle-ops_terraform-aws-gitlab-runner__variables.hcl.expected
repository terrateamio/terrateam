          [
            "Fun_call",
            [
              "object",
              [
                [
                  "Object",
                  [
                    [ [ "Bare", "http_endpoint" ], [ "Id", "string" ] ],
                    [ [ "Bare", "http_tokens" ], [ "Id", "string" ] ],
                    [
                      [ "Bare", "http_put_response_hop_limit" ],
                      [ "Id", "number" ]
                    ],
                    [
                      [ "Bare", "instance_metadata_tags" ],
                      [ "Id", "string" ]
                    ]
                  ]
                ]
              ]
            ]
          ]
        ],
        [
          "Attribute",
          "default",
          [
            "Object",
            [
              [ [ "Bare", "http_endpoint" ], [ "String", "enabled" ] ],
              [ [ "Bare", "http_tokens" ], [ "String", "required" ] ],
              [ [ "Bare", "http_put_response_hop_limit" ], [ "Int", 2 ] ],
              [
                [ "Bare", "instance_metadata_tags" ],
                [ "String", "disabled" ]
              ]
            ]
          ]
        ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "runner_schedule_enable" ] ],
      "body": [
        [
          "Attribute",
          "description",
          [
            "String",
