                            [
                              "Fun_call",
                              [
                                "optional",
                                [
                                  [
                                    "Fun_call",
                                    [ "list", [ [ "Id", "string" ] ] ]
                                  ],
                                  [ "Tuple", [ [ "String", "/*" ] ] ]
                                ]
                              ]
                            ]
                          ],
                          [
                            [ "Bare", "custom_domain_names" ],
                            [
                              "Fun_call",
                              [
                                "optional",
                                [
                                  [
                                    "Fun_call",
                                    [ "list", [ [ "Id", "string" ] ] ]
                                  ],
                                  [ "Tuple", [] ]
                                ]
                              ]
                            ]
                          ],
                          [
                            [ "Bare", "endpoint_names" ],
                            [
                              "Fun_call",
                              [
                                "optional",
                                [
                                  [
                                    "Fun_call",
                                    [ "list", [ [ "Id", "string" ] ] ]
                                  ],
                                  [ "Tuple", [] ]
                                ]
                              ]
                            ]
                          ]
                        ]
                      ]
                    ]
                  ]
                ]
              ]
            ]
          ]
        ],
        [ "Attribute", "default", [ "Tuple", [] ] ],
        [
          "Block",
          {
            "type_": "validation",
            "labels": [],
            "body": [
              [
                "Attribute",
                "condition",
                [
                  "Fun_call",
                  [
                    "alltrue",
                    [
                      [
                        "For_tuple",
                        {
                          "identifiers": [ "security_policy", [] ],
                          "input": [
                            "Attr",
                            [
                              [ "Id", "var" ],
                              [ "A_string", "security_policies" ]
                            ]
                          ],
                          "output": [
                            "Log_or",
                            [
                              [
                                "Not_equal",
                                [
                                  [
                                    "Attr",
                                    [
                                      [ "Id", "security_policy" ],
                                      [ "A_string", "custom_domain_names" ]
                                    ]
                                  ],
                                  [ "Null" ]
                                ]
                              ],
                              [
                                "Not_equal",
                                [
                                  [
                                    "Attr",
                                    [
                                      [ "Id", "security_policy" ],
                                      [ "A_string", "endpoint_names" ]
                                    ]
                                  ],
                                  [ "Null" ]
                                ]
                              ]
                            ]
                          ],
                          "cond": null
                        }
                      ]
                    ]
                  ]
                ]
              ],
              [
                "Attribute",
                "error_message",
                [
                  "String",
                  "At least one custom domain name or endpoint name must be provided for all the security policies."
                ]
              ]
            ]
          }
        ]
      ]
    }
