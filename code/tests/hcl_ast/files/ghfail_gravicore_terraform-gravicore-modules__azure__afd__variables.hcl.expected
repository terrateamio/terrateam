    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "security_policies" ] ],
      "body": [
        [
          "Attribute",
          "description",
          [ "String", "CDN FrontDoor Security policies configurations." ]
        ],
        [
          "Attribute",
          "type",
          [
            "Fun_call",
            [
              "list",
              [
                [
                  "Fun_call",
                  [
