[
  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "name" ] ],
      "body": [
        [ "Attribute", "type", [ "Id", "string" ] ],
        [
          "Attribute",
          "description",
          [
            "String",
            "The name of the native network resource configuration. Associated resources will use this name as a prefix"
          ]
        ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "aws-region" ] ],
      "body": [
        [ "Attribute", "type", [ "Id", "string" ] ],
        [
          "Attribute",
          "description",
          [
            "String",
            "The name of the AWS region containing the network resources you wish to expose."
          ]
        ],
        [ "Attribute", "default", [ "String", "us-east-1" ] ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "tags" ] ],
      "body": [
        [
          "Attribute",
          "type",
          [ "Fun_call", [ "map", [ [ "Id", "string" ] ] ] ]
        ],
        [
          "Attribute",
          "description",
          [
            "String",
            "A map containing labels for all taggable resources that are created by this module"
          ]
        ],
        [ "Attribute", "default", [ "Object", [] ] ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "vpc-cidr" ] ],
      "body": [
        [ "Attribute", "type", [ "Id", "string" ] ],
        [ "Attribute", "default", [ "String", "11.0.0.0/16" ] ],
        [
          "Attribute",
          "description",
          [
            "String", "The CIDR for the VPC containing the network resources"
          ]
        ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "subnet-cidr-list" ] ],
      "body": [
        [
          "Attribute",
          "type",
          [ "Fun_call", [ "list", [ [ "Id", "string" ] ] ] ]
        ],
        [
          "Attribute",
          "default",
          [
            "Tuple",
            [
              [ "String", "11.0.0.0/24" ],
              [ "String", "11.0.1.0/24" ],
              [ "String", "11.0.2.0/24" ]
            ]
          ]
        ],
        [
          "Attribute",
          "description",
          [
            "String",
            "The CIDRs for the subnets containing the network resources."
          ]
        ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "broker-instance-type" ] ],
      "body": [
        [ "Attribute", "type", [ "Id", "string" ] ],
        [ "Attribute", "default", [ "String", "kafka.m5.large" ] ],
        [
          "Attribute",
          "description",
          [ "String", "Instance type for any MSK brokers" ]
        ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "broker-storage-capacity" ] ],
      "body": [
        [ "Attribute", "type", [ "Id", "number" ] ],
        [ "Attribute", "default", [ "Int", 1000 ] ],
        [
          "Attribute",
          "description",
          [ "String", "Storage capacity on broker instances in GB" ]
        ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "broker-count" ] ],
      "body": [
        [ "Attribute", "type", [ "Id", "number" ] ],
        [ "Attribute", "default", [ "Int", 3 ] ],
        [
          "Attribute",
          "description",
          [
            "String",
            "The desired total number of broker nodes in the kafka cluster. It must be a multiple of 3."
          ]
        ]
      ]
    }
  ]
]
