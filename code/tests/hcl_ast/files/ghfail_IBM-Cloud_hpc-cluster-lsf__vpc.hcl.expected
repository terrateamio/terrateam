            "type_": "provisioner",
            "labels": [ [ "Lit", "remote-exec" ] ],
            "body": [
              [
                "Attribute",
                "inline",
                [
                  "Tuple",
                  [
                    [
                      "Template",
                      [
                        [ "Literal", "if openssl s_client -connect '" ],
                        [
                          "Interpolation",
                          {
                            "expr": [
                              "Attr",
                              [
                                [ "Id", "var" ],
                                [ "A_string", "ldap_server" ]
                              ]
                            ],
                            "strip_before": false,
                            "strip_after": false
                          }
                        ],
                        [
                          "Literal",
                          ":389' </dev/null 2>/dev/null | grep -q 'CONNECTED'; then echo 'The connection to the existing LDAP server "
                        ],
                        [
                          "Interpolation",
                          {
                            "expr": [
                              "Attr",
                              [
                                [ "Id", "var" ],
                                [ "A_string", "ldap_server" ]
                              ]
                            ],
                            "strip_before": false,
                            "strip_after": false
                          }
                        ],
                        [
                          "Literal",
                          " was successfully established.'; else echo 'The connection to the existing LDAP server "
                        ],
                        [
                          "Interpolation",
                          {
                            "expr": [
                              "Attr",
                              [
                                [ "Id", "var" ],
                                [ "A_string", "ldap_server" ]
                              ]
                            ],
                            "strip_before": false,
                            "strip_after": false
                          }
                        ],
                        [
                          "Literal",
                          " failed, please establish it.'; exit 1; fi"
                        ]
                      ]
                    ]
                  ]
                ]
              ]
            ]
          }
        ],
        [
          "Attribute",
          "depends_on",
          [
            "Tuple",
            [
              [ "Attr", [ [ "Id", "module" ], [ "A_string", "login_vsi" ] ] ]
            ]
          ]
        ]
      ]
