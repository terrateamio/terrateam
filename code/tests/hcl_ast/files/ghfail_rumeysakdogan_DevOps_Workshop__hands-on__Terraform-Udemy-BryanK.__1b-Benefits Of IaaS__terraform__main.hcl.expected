[
  [
    "Block",
    {
      "type_": "provider",
      "labels": [ [ "Lit", "aws" ] ],
      "body": [ [ "Attribute", "region", [ "String", "us-east-1" ] ] ]
    }
  ],
  [
    "Block",
    {
      "type_": "data",
      "labels": [
        [ "Lit", "aws_availability_zones" ], [ "Lit", "available" ]
      ],
      "body": []
    }
  ],
  [
    "Block",
    {
      "type_": "data",
      "labels": [ [ "Lit", "aws_region" ], [ "Lit", "current" ] ],
      "body": []
    }
  ],
  [
    "Block",
    {
      "type_": "resource",
      "labels": [ [ "Lit", "aws_vpc" ], [ "Lit", "vpc" ] ],
      "body": [
        [
          "Attribute",
          "cidr_block",
          [ "Attr", [ [ "Id", "var" ], [ "A_string", "vpc_cidr" ] ] ]
        ],
        [
          "Attribute",
          "tags",
          [
            "Object",
            [
              [
                [ "Bare", "Name" ],
                [ "Attr", [ [ "Id", "var" ], [ "A_string", "vpc_name" ] ] ]
              ],
              [ [ "Bare", "Environment" ], [ "String", "demo_environment" ] ],
              [ [ "Bare", "Terraform" ], [ "String", "true" ] ]
            ]
          ]
        ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "resource",
      "labels": [ [ "Lit", "aws_subnet" ], [ "Lit", "private_subnets" ] ],
      "body": [
        [
          "Attribute",
          "for_each",
          [ "Attr", [ [ "Id", "var" ], [ "A_string", "private_subnets" ] ] ]
        ],
        [
          "Attribute",
          "vpc_id",
          [
            "Attr",
            [
              [ "Attr", [ [ "Id", "aws_vpc" ], [ "A_string", "vpc" ] ] ],
              [ "A_string", "id" ]
            ]
          ]
        ],
        [
          "Attribute",
          "cidr_block",
          [
            "Fun_call",
            [
              "cidrsubnet",
              [
                [ "Attr", [ [ "Id", "var" ], [ "A_string", "vpc_cidr" ] ] ],
                [ "Int", 8 ],
                [ "Attr", [ [ "Id", "each" ], [ "A_string", "value" ] ] ]
              ]
            ]
          ]
        ],
        [
          "Attribute",
          "availability_zone",
          [
            "Idx",
            [
              [
                "Fun_call",
                [
                  "tolist",
                  [
                    [
                      "Attr",
                      [
                        [
                          "Attr",
                          [
                            [
                              "Attr",
                              [
                                [ "Id", "data" ],
                                [ "A_string", "aws_availability_zones" ]
                              ]
                            ],
                            [ "A_string", "available" ]
                          ]
                        ],
                        [ "A_string", "names" ]
                      ]
                    ]
                  ]
                ]
              ],
              [ "Attr", [ [ "Id", "each" ], [ "A_string", "value" ] ] ]
            ]
          ]
        ],
        [
          "Attribute",
          "tags",
          [
            "Object",
            [
              [
                [ "Bare", "Name" ],
                [ "Attr", [ [ "Id", "each" ], [ "A_string", "key" ] ] ]
              ],
              [ [ "Bare", "Terraform" ], [ "String", "true" ] ]
            ]
          ]
        ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "resource",
      "labels": [ [ "Lit", "aws_subnet" ], [ "Lit", "public_subnets" ] ],
      "body": [
        [
          "Attribute",
          "for_each",
          [ "Attr", [ [ "Id", "var" ], [ "A_string", "public_subnets" ] ] ]
        ],
        [
          "Attribute",
          "vpc_id",
          [
            "Attr",
            [
              [ "Attr", [ [ "Id", "aws_vpc" ], [ "A_string", "vpc" ] ] ],
              [ "A_string", "id" ]
            ]
          ]
        ],
        [
          "Attribute",
          "cidr_block",
          [
            "Fun_call",
            [
              "cidrsubnet",
              [
                [ "Attr", [ [ "Id", "var" ], [ "A_string", "vpc_cidr" ] ] ],
                [ "Int", 8 ],
                [
                  "Add",
                  [
                    [ "Attr", [ [ "Id", "each" ], [ "A_string", "value" ] ] ],
                    [ "Int", 100 ]
                  ]
                ]
              ]
            ]
          ]
        ],
        [
          "Attribute",
          "availability_zone",
          [
            "Idx",
            [
              [
                "Fun_call",
                [
                  "tolist",
                  [
                    [
                      "Attr",
                      [
                        [
                          "Attr",
                          [
                            [
                              "Attr",
                              [
                                [ "Id", "data" ],
                                [ "A_string", "aws_availability_zones" ]
                              ]
                            ],
                            [ "A_string", "available" ]
                          ]
                        ],
                        [ "A_string", "names" ]
                      ]
                    ]
                  ]
                ]
              ],
              [ "Attr", [ [ "Id", "each" ], [ "A_string", "value" ] ] ]
            ]
          ]
        ],
        [ "Attribute", "map_public_ip_on_launch", [ "Bool", true ] ],
        [
          "Attribute",
          "tags",
          [
            "Object",
            [
              [
                [ "Bare", "Name" ],
                [ "Attr", [ [ "Id", "each" ], [ "A_string", "key" ] ] ]
              ],
              [ [ "Bare", "Terraform" ], [ "String", "true" ] ]
            ]
          ]
        ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "resource",
