            "type_": "provisioner",
            "labels": [ [ "Lit", "local-exec" ] ],
            "body": [
              [
                "Attribute",
                "command",
                [
                  "Template_heredoc",
                  [
                    "EOT",
                    [
                      [
                        "Literal",
                        "\nsed --expression='/- path: patch\\/gke-managed-components-toleration.yaml$/,+4d' --in-place "
                      ],
                      [
                        "Interpolation",
                        {
                          "expr": [
                            "Attr",
                            [
                              [
                                "Attr",
                                [ [ "Id", "self" ], [ "A_string", "input" ] ]
                              ],
                              [ "A_string", "version_manifests_dir" ]
                            ]
                          ],
                          "strip_before": false,
                          "strip_after": false
                        }
                      ],
                      [
                        "Literal",
                        "/kustomization.yaml && \\\nsed --expression='/- path: patch\\/gke-managed-components-toleration.yaml$/,+4d' --in-place "
                      ],
                      [
                        "Interpolation",
                        {
                          "expr": [
                            "Attr",
                            [
                              [
                                "Attr",
                                [ [ "Id", "self" ], [ "A_string", "input" ] ]
