                    [ "Id", "local" ], [ "A_string", "manifests_directory" ]
                  ]
                ]
              ],
              [
                [ "Bare", "version" ],
                [
                  "Attr",
                  [ [ "Id", "var" ], [ "A_string", "kueue_version" ] ]
