  [
    "Block",
    {
      "type_": "resource",
      "labels": [ [ "Lit", "terraform_data" ], [ "Lit", "manifests_ap" ] ],
      "body": [
        [
          "Attribute",
          "depends_on",
          [
            "Tuple",
            [
              [
                "Attr",
                [ [ "Id", "terraform_data" ], [ "A_string", "manifests" ] ]
              ]
            ]
          ]
        ],
        [
          "Attribute",
          "for_each",
          [
            "Fun_call",
            [
              "toset",
              [
                [
                  "Cond",
                  {
                    "if_": [
                      "Attr",
                      [
                        [ "Id", "var" ],
                        [ "A_string", "cluster_autopilot_enabled" ]
