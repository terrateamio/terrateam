        [ "Attribute", "default", [ "Tuple", [] ] ],
        [ "Attribute", "nullable", [ "Bool", false ] ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "locals",
      "labels": [],
      "body": [
        [
          "Attribute",
          "ssh_defined",
          [
            "Fun_call",
            [
              "anytrue",
              [
                [
                  "For_tuple",
                  {
                    "identifiers": [ "port", [] ],
                    "input": [
                      "Attr", [ [ "Id", "var" ], [ "A_string", "ports" ] ]
                    ],
                    "output": [
                      "Equal",
                      [
                        [
                          "Attr",
                          [ [ "Id", "port" ], [ "A_string", "port" ] ]
                        ],
                        [
                          "Attr",
                          [
                            [
                              "Attr",
                              [ [ "Id", "var" ], [ "A_string", "machine" ] ]
                            ],
                            [ "A_string", "ssh_port" ]
                          ]
                        ]
                      ]
                    ],
                    "cond": null
                  }
                ]
              ]
            ]
          ]
        ],
        [
          "Attribute",
          "machine_ports",
          [
            "Fun_call",
            [
              "concat",
              [
                [ "Attr", [ [ "Id", "var" ], [ "A_string", "ports" ] ] ],
                [
                  "Cond",
                  {
                    "if_": [
                      "Log_or",
                      [
                        [
                          "Not",
                          [
                            "Attr",
                            [
                              [ "Id", "var" ],
                              [ "A_string", "force_ssh_access" ]
                            ]
                          ]
                        ],
                        [
                          "Attr",
                          [
                            [ "Id", "local" ], [ "A_string", "ssh_defined" ]
                          ]
                        ]
                      ]
                    ],
                    "then_": [ "Tuple", [] ],
                    "else_": [
                      "Tuple",
                      [
                        [
                          "Object",
                          [
                            [ [ "Quoted", "access" ], [ "String", "allow" ] ],
                            [ [ "Quoted", "type" ], [ "String", "ingress" ] ],
                            [
                              [ "Quoted", "defaults" ],
                              [ "String", "service" ]
                            ],
                            [ [ "Quoted", "cidrs" ], [ "Tuple", [] ] ],
                            [ [ "Quoted", "protocol" ], [ "String", "tcp" ] ],
                            [
                              [ "Quoted", "port" ],
                              [
                                "Attr",
                                [
                                  [
                                    "Attr",
                                    [
                                      [ "Id", "var" ],
                                      [ "A_string", "machine" ]
                                    ]
                                  ],
                                  [ "A_string", "ssh_port" ]
                                ]
                              ]
                            ],
                            [
                              [ "Quoted", "to_port" ],
                              [
                                "Attr",
                                [
                                  [
                                    "Attr",
                                    [
                                      [ "Id", "var" ],
                                      [ "A_string", "machine" ]
                                    ]
                                  ],
                                  [ "A_string", "ssh_port" ]
                                ]
                              ]
                            ],
                            [
                              [ "Quoted", "description" ],
                              [ "String", "Force SSH Access" ]
                            ]
                          ]
                        ],
                        [
                          "Object",
                          [
                            [ [ "Quoted", "access" ], [ "String", "allow" ] ],
                            [ [ "Quoted", "type" ], [ "String", "egress" ] ],
                            [
                              [ "Quoted", "defaults" ],
                              [ "String", "service" ]
                            ],
                            [ [ "Quoted", "cidrs" ], [ "Tuple", [] ] ],
                            [ [ "Quoted", "protocol" ], [ "String", "tcp" ] ],
                            [
                              [ "Quoted", "port" ],
                              [
                                "Attr",
                                [
                                  [
                                    "Attr",
                                    [
                                      [ "Id", "var" ],
                                      [ "A_string", "machine" ]
                                    ]
                                  ],
                                  [ "A_string", "ssh_port" ]
                                ]
                              ]
                            ],
                            [
                              [ "Quoted", "to_port" ],
                              [
                                "Attr",
                                [
                                  [
                                    "Attr",
                                    [
                                      [ "Id", "var" ],
                                      [ "A_string", "machine" ]
                                    ]
                                  ],
                                  [ "A_string", "ssh_port" ]
                                ]
                              ]
                            ],
                            [
                              [ "Quoted", "description" ],
                              [ "String", "Force SSH Access" ]
                            ]
                          ]
                        ]
                      ]
                    ]
                  }
                ]
              ]
            ]
          ]
        ]
      ]
    }
