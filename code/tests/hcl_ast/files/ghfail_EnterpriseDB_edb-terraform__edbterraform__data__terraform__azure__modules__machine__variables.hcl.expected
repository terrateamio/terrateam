  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "additional_volumes" ] ],
      "body": [
        [
          "Attribute",
          "type",
          [
            "Fun_call",
            [
              "list",
              [
                [
                  "Fun_call",
                  [
                    "object",
                    [
                      [
                        "Object",
                        [
                          [ [ "Bare", "mount_point" ], [ "Id", "string" ] ],
                          [ [ "Bare", "size_gb" ], [ "Id", "number" ] ],
                          [ [ "Bare", "type" ], [ "Id", "string" ] ],
                          [
                            [ "Bare", "caching" ],
                            [
                              "Fun_call",
                              [
                                "optional",
                                [ [ "Id", "string" ], [ "String", "None" ] ]
                              ]
                            ]
                          ],
                          [
                            [ "Bare", "iops" ],
                            [
                              "Fun_call",
                              [ "optional", [ [ "Id", "number" ] ] ]
                            ]
                          ],
                          [
                            [ "Bare", "filesystem" ],
                            [
                              "Fun_call",
                              [ "optional", [ [ "Id", "string" ] ] ]
                            ]
                          ],
                          [
                            [ "Bare", "mount_options" ],
                            [
                              "Fun_call",
                              [
                                "optional",
                                [
                                  [
                                    "Fun_call",
                                    [ "list", [ [ "Id", "string" ] ] ]
                                  ]
                                ]
                              ]
                            ]
                          ]
                        ]
                      ]
                    ]
                  ]
                ]
              ]
            ]
          ]
        ],
        [
          "Block",
          {
            "type_": "validation",
            "labels": [],
            "body": [
              [
                "Attribute",
                "condition",
                [
                  "Fun_call",
                  [
                    "alltrue",
                    [
                      [
                        "For_tuple",
                        {
                          "identifiers": [ "volume", [] ],
                          "input": [
                            "Attr",
                            [
                              [ "Id", "var" ],
                              [ "A_string", "additional_volumes" ]
                            ]
                          ],
                          "output": [
                            "Log_or",
                            [
                              [
                                "Equal",
                                [
                                  [
                                    "Attr",
                                    [
                                      [ "Id", "volume" ],
                                      [ "A_string", "iops" ]
                                    ]
                                  ],
                                  [ "Null" ]
                                ]
                              ],
                              [
                                "Fun_call",
                                [
                                  "contains",
                                  [
                                    [
                                      "Tuple",
                                      [
                                        [ "String", "UltraSSD_LRS" ],
                                        [ "String", "PremiumV2_LRS" ]
                                      ]
                                    ],
                                    [
                                      "Attr",
                                      [
                                        [ "Id", "volume" ],
                                        [ "A_string", "type" ]
                                      ]
                                    ]
                                  ]
                                ]
                              ]
                            ]
                          ],
                          "cond": null
                        }
                      ]
                    ]
                  ]
                ]
              ],
              [
                "Attribute",
                "error_message",
                [
                  "Heredoc",
                  [
                    "EOT",
                    "\nIOPs is only configurable with the following disk types:\nUltraSSD PremiumV2\n"
                  ]
                ]
              ]
            ]
          }
        ],
        [
          "Block",
          {
            "type_": "validation",
            "labels": [],
            "body": [
              [
                "Attribute",
                "condition",
                [
                  "Fun_call",
                  [
                    "alltrue",
                    [
                      [
                        "For_tuple",
                        {
                          "identifiers": [ "volume", [] ],
                          "input": [
                            "Attr",
                            [
                              [ "Id", "var" ],
                              [ "A_string", "additional_volumes" ]
                            ]
                          ],
                          "output": [
                            "Log_or",
                            [
                              [
                                "Equal",
                                [
                                  [
                                    "Attr",
                                    [
                                      [ "Id", "volume" ],
                                      [ "A_string", "caching" ]
                                    ]
                                  ],
                                  [ "String", "None" ]
                                ]
                              ],
                              [
                                "Not_equal",
                                [
                                  [
                                    "Attr",
                                    [
                                      [ "Id", "volume" ],
                                      [ "A_string", "type" ]
                                    ]
                                  ],
                                  [ "String", "UltraSSD_LRS" ]
                                ]
                              ]
                            ]
                          ],
                          "cond": null
                        }
                      ]
                    ]
                  ]
                ]
              ],
              [
                "Attribute",
                "error_message",
                [
                  "Heredoc",
                  [
                    "EOT",
                    "\nCaching must be set to \"None\" when using UltraSSD_LRS\n"
                  ]
                ]
              ]
            ]
          }
        ],
        [ "Attribute", "default", [ "Tuple", [] ] ],
        [ "Attribute", "nullable", [ "Bool", false ] ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "locals",
      "labels": [],
      "body": [
        [
          "Attribute",
          "additional_volumes_length",
          [
            "Fun_call",
            [
              "length",
              [
                [
                  "Attr",
                  [ [ "Id", "var" ], [ "A_string", "additional_volumes" ] ]
                ]
              ]
            ]
          ]
        ],
        [
          "Attribute",
          "additional_volumes_count",
          [
            "Cond",
            {
              "if_": [
                "Gt",
                [
                  [
                    "Attr",
                    [
                      [ "Id", "local" ],
                      [ "A_string", "additional_volumes_length" ]
                    ]
                  ],
                  [ "Int", 0 ]
                ]
              ],
              "then_": [ "Int", 1 ],
              "else_": [ "Int", 0 ]
            }
          ]
        ],
        [
          "Attribute",
          "additional_volumes_map",
          [
            "For_object",
            {
              "identifiers": [ "i", [ "v" ] ],
              "input": [
                "Attr",
                [ [ "Id", "var" ], [ "A_string", "additional_volumes" ] ]
              ],
              "key_output": [ "Id", "i" ],
              "value_output": [ "Id", "v" ],
              "cond": null
            }
          ]
        ],
        [
          "Attribute",
          "premium_ssd",
          [
            "Object",
            [
              [
                [ "Bare", "regions" ],
                [
                  "Tuple",
                  [ [ "String", "eastus" ], [ "String", "westeurope" ] ]
                ]
              ],
              [ [ "Bare", "value" ], [ "String", "PremiumV2_LRS" ] ]
            ]
          ]
        ],
        [
          "Attribute",
          "ultra_ssd_enabled",
          [
            "Fun_call",
            [
              "anytrue",
              [
                [
                  "For_tuple",
                  {
                    "identifiers": [ "volume", [] ],
                    "input": [
                      "Attr",
                      [
                        [ "Id", "var" ], [ "A_string", "additional_volumes" ]
                      ]
                    ],
                    "output": [
                      "Equal",
                      [
                        [
                          "Attr",
                          [ [ "Id", "volume" ], [ "A_string", "type" ] ]
                        ],
                        [ "String", "UltraSSD_LRS" ]
                      ]
                    ],
                    "cond": null
                  }
                ]
              ]
            ]
          ]
        ],
        [ "Attribute", "prefix", [ "String", "/dev/" ] ],
        [ "Attribute", "base", [ "Tuple", [ [ "String", "sd" ] ] ] ],
        [
          "Attribute",
          "letters",
          [
            "Tuple",
            [
              [ "String", "c" ],
              [ "String", "d" ],
              [ "String", "e" ],
              [ "String", "f" ],
              [ "String", "g" ],
              [ "String", "h" ],
              [ "String", "i" ],
              [ "String", "j" ],
              [ "String", "k" ],
              [ "String", "l" ],
              [ "String", "m" ],
              [ "String", "n" ],
              [ "String", "o" ],
              [ "String", "p" ],
              [ "String", "q" ],
              [ "String", "r" ]
            ]
          ]
        ],
        [
          "Attribute",
          "linux_device_names",
          [
            "For_tuple",
            {
              "identifiers": [ "letter", [] ],
              "input": [
                "Attr", [ [ "Id", "local" ], [ "A_string", "letters" ] ]
              ],
              "output": [
                "Fun_call",
                [
                  "formatlist",
                  [
                    [
                      "Template",
                      [
                        [
                          "Interpolation",
                          {
                            "expr": [
                              "Attr",
                              [ [ "Id", "local" ], [ "A_string", "prefix" ] ]
                            ],
                            "strip_before": false,
                            "strip_after": false
                          }
                        ],
                        [ "Literal", "%s" ],
                        [
                          "Interpolation",
                          {
                            "expr": [ "Id", "letter" ],
                            "strip_before": false,
                            "strip_after": false
                          }
                        ]
                      ]
                    ],
                    [ "Attr", [ [ "Id", "local" ], [ "A_string", "base" ] ] ]
                  ]
                ]
              ],
              "cond": null
            }
          ]
        ],
        [ "Attribute", "filesystem", [ "String", "xfs" ] ],
        [
          "Attribute",
          "mount_options",
          [
            "Tuple",
            [
              [ "String", "noatime" ],
              [ "String", "nodiratime" ],
              [ "String", "logbsize=256k" ],
              [ "String", "allocsize=1m" ]
            ]
          ]
        ]
      ]
    }
  ]
