                          [ "String", "cache.r7g.2xlarge" ],
                          [ "String", "cache.r6g.large" ],
                          [ "String", "cache.r6g.xlarge" ],
                          [ "String", "cache.r6g.2xlarge" ]
                        ]
                      ],
                      [
                        "Attr",
                        [
                          [ "Id", "var" ], [ "A_string", "redis_node_type" ]
