        [
          "Attribute",
          "description",
          [ "String", "Enable disaster recovery setup" ]
        ],
        [ "Attribute", "default", [ "Bool", false ] ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "dr_region" ] ],
      "body": [
        [ "Attribute", "type", [ "Id", "string" ] ],
        [
          "Attribute",
          "description",
          [ "String", "Disaster recovery region" ]
        ],
        [ "Attribute", "default", [ "String", "us-west-2" ] ],
        [
          "Block",
          {
            "type_": "validation",
            "labels": [],
            "body": [
              [
                "Attribute",
                "condition",
                [
                  "Fun_call",
                  [
                    "contains",
                    [
                      [
                        "Tuple",
                        [
                          [ "String", "us-east-1" ],
                          [ "String", "us-east-2" ],
                          [ "String", "us-west-1" ],
                          [ "String", "us-west-2" ],
                          [ "String", "eu-west-1" ],
                          [ "String", "eu-west-2" ],
                          [ "String", "eu-west-3" ],
                          [ "String", "eu-central-1" ],
                          [ "String", "ap-northeast-1" ],
                          [ "String", "ap-northeast-2" ],
                          [ "String", "ap-southeast-1" ],
                          [ "String", "ap-southeast-2" ]
                        ]
                      ],
                      [
