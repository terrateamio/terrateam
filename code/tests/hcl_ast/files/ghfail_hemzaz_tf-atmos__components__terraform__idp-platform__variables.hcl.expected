    }
  ],
  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "allowed_cidr_blocks" ] ],
      "body": [
        [
          "Attribute",
          "type",
          [ "Fun_call", [ "list", [ [ "Id", "string" ] ] ] ]
        ],
        [
          "Attribute",
          "description",
          [ "String", "CIDR blocks allowed to access the platform" ]
        ],
        [
          "Attribute",
          "default",
          [
            "Tuple",
            [
              [ "String", "10.0.0.0/8" ],
              [ "String", "172.16.0.0/12" ],
              [ "String", "192.168.0.0/16" ]
            ]
          ]
        ],
        [
          "Block",
          {
            "type_": "validation",
            "labels": [],
            "body": [
              [
                "Attribute",
                "condition",
                [
                  "Fun_call",
                  [
                    "alltrue",
                    [
                      [
                        "For_tuple",
                        {
                          "identifiers": [ "cidr", [] ],
                          "input": [
                            "Attr",
                            [
                              [ "Id", "var" ],
                              [ "A_string", "allowed_cidr_blocks" ]
                            ]
                          ],
                          "output": [
                            "Fun_call",
                            [
                              "can",
                              [
                                [
                                  "Fun_call",
                                  [
                                    "cidrhost",
                                    [ [ "Id", "cidr" ], [ "Int", 0 ] ]
                                  ]
                                ]
                              ]
                            ]
                          ],
                          "cond": null
                        }
                      ]
                    ]
                  ]
                ]
              ],
              [
                "Attribute",
                "error_message",
                [ "String", "All values must be valid CIDR blocks." ]
              ]
            ]
          }
        ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "notification_endpoints" ] ],
      "body": [
        [
          "Attribute",
          "type",
          [
            "Fun_call",
            [
              "object",
              [
                [
                  "Object",
                  [
                    [
                      [ "Bare", "email" ],
                      [
                        "Fun_call",
                        [
                          "optional",
                          [
                            [
                              "Fun_call", [ "list", [ [ "Id", "string" ] ] ]
                            ],
                            [ "Tuple", [] ]
                          ]
                        ]
                      ]
                    ],
                    [
                      [ "Bare", "slack" ],
                      [
                        "Fun_call",
                        [
                          "optional",
                          [ [ "Id", "string" ], [ "String", "" ] ]
                        ]
                      ]
                    ],
                    [
                      [ "Bare", "teams" ],
                      [
                        "Fun_call",
                        [
                          "optional",
                          [ [ "Id", "string" ], [ "String", "" ] ]
                        ]
                      ]
                    ]
                  ]
                ]
              ]
            ]
          ]
        ],
        [
          "Attribute",
          "description",
          [ "String", "Notification endpoints for alerts and events" ]
        ],
        [
          "Attribute",
          "default",
          [
            "Object",
            [
              [ [ "Bare", "email" ], [ "Tuple", [] ] ],
              [ [ "Bare", "slack" ], [ "String", "" ] ],
              [ [ "Bare", "teams" ], [ "String", "" ] ]
            ]
          ]
        ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "feature_flags" ] ],
      "body": [
        [
          "Attribute",
          "type",
          [
            "Fun_call",
            [
              "object",
              [
                [
                  "Object",
                  [
                    [
                      [ "Bare", "enable_argocd_integration" ],
                      [
                        "Fun_call",
                        [
                          "optional", [ [ "Id", "bool" ], [ "Bool", true ] ]
                        ]
                      ]
                    ],
                    [
                      [ "Bare", "enable_cost_analysis" ],
                      [
                        "Fun_call",
                        [
                          "optional", [ [ "Id", "bool" ], [ "Bool", true ] ]
                        ]
                      ]
                    ],
                    [
                      [ "Bare", "enable_compliance_checking" ],
                      [
                        "Fun_call",
                        [
                          "optional", [ [ "Id", "bool" ], [ "Bool", true ] ]
                        ]
                      ]
                    ],
                    [
                      [ "Bare", "enable_drift_detection" ],
                      [
                        "Fun_call",
                        [
                          "optional", [ [ "Id", "bool" ], [ "Bool", true ] ]
                        ]
                      ]
                    ],
                    [
                      [ "Bare", "enable_auto_scaling" ],
                      [
                        "Fun_call",
                        [
                          "optional", [ [ "Id", "bool" ], [ "Bool", true ] ]
                        ]
                      ]
                    ],
                    [
                      [ "Bare", "enable_blue_green_deployment" ],
                      [
                        "Fun_call",
                        [
                          "optional", [ [ "Id", "bool" ], [ "Bool", false ] ]
                        ]
                      ]
                    ],
                    [
                      [ "Bare", "enable_canary_deployment" ],
                      [
                        "Fun_call",
                        [
                          "optional", [ [ "Id", "bool" ], [ "Bool", false ] ]
                        ]
                      ]
                    ]
                  ]
                ]
              ]
            ]
          ]
        ],
        [
          "Attribute",
          "description",
          [
            "String", "Feature flags to enable/disable platform capabilities"
          ]
        ],
        [
          "Attribute",
          "default",
          [
            "Object",
            [
              [ [ "Bare", "enable_argocd_integration" ], [ "Bool", true ] ],
              [ [ "Bare", "enable_cost_analysis" ], [ "Bool", true ] ],
              [ [ "Bare", "enable_compliance_checking" ], [ "Bool", true ] ],
              [ [ "Bare", "enable_drift_detection" ], [ "Bool", true ] ],
              [ [ "Bare", "enable_auto_scaling" ], [ "Bool", true ] ],
              [
                [ "Bare", "enable_blue_green_deployment" ], [ "Bool", false ]
              ],
              [ [ "Bare", "enable_canary_deployment" ], [ "Bool", false ] ]
            ]
          ]
        ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "resource_tags" ] ],
      "body": [
        [
          "Attribute",
          "type",
          [ "Fun_call", [ "map", [ [ "Id", "string" ] ] ] ]
        ],
        [
          "Attribute",
          "description",
          [ "String", "Additional resource tags" ]
        ],
        [ "Attribute", "default", [ "Object", [] ] ],
        [
          "Block",
          {
            "type_": "validation",
            "labels": [],
            "body": [
              [
                "Attribute",
                "condition",
                [
                  "Fun_call",
                  [
                    "alltrue",
                    [
                      [
                        "For_tuple",
                        {
                          "identifiers": [ "tag_key", [ "tag_value" ] ],
                          "input": [
                            "Attr",
                            [
                              [ "Id", "var" ],
                              [ "A_string", "resource_tags" ]
                            ]
                          ],
                          "output": [
                            "Log_and",
                            [
                              [
                                "Fun_call",
                                [
                                  "can",
                                  [
                                    [
                                      "Fun_call",
                                      [
                                        "regex",
                                        [
                                          [
                                            "String",
                                            "^[a-zA-Z0-9+\\-=._:/@]{1,128}$"
                                          ],
                                          [ "Id", "tag_key" ]
                                        ]
                                      ]
                                    ]
                                  ]
                                ]
                              ],
                              [
                                "Fun_call",
                                [
                                  "can",
                                  [
                                    [
                                      "Fun_call",
                                      [
                                        "regex",
                                        [
                                          [
                                            "String",
                                            "^[a-zA-Z0-9+\\-=._:/@\\s]{0,256}$"
                                          ],
                                          [ "Id", "tag_value" ]
                                        ]
                                      ]
                                    ]
                                  ]
                                ]
                              ]
                            ]
                          ],
                          "cond": null
                        }
                      ]
                    ]
                  ]
                ]
              ],
              [
                "Attribute",
                "error_message",
                [
                  "String",
                  "Tag keys and values must comply with AWS tagging requirements."
                ]
              ]
            ]
          }
        ]
      ]
    }
  ],
