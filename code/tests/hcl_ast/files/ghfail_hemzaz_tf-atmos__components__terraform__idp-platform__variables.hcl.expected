  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "maintenance_window" ] ],
      "body": [
        [
          "Attribute",
          "type",
          [
            "Fun_call",
            [
              "object",
              [
                [
                  "Object",
                  [
                    [
                      [ "Bare", "database" ],
                      [
                        "Fun_call",
                        [
                          "optional",
                          [
                            [ "Id", "string" ],
                            [ "String", "sun:04:00-sun:05:00" ]
                          ]
                        ]
                      ]
                    ],
                    [
                      [ "Bare", "redis" ],
                      [
                        "Fun_call",
                        [
                          "optional",
                          [
                            [ "Id", "string" ],
                            [ "String", "sun:05:00-sun:07:00" ]
                          ]
                        ]
                      ]
                    ],
                    [
                      [ "Bare", "eks" ],
                      [
                        "Fun_call",
                        [
                          "optional",
                          [
                            [ "Id", "string" ],
                            [ "String", "sun:02:00-sun:03:00" ]
                          ]
                        ]
                      ]
                    ]
                  ]
                ]
              ]
            ]
          ]
        ],
        [
          "Attribute",
          "description",
          [ "String", "Maintenance windows for different services" ]
        ],
        [
          "Attribute",
          "default",
          [
            "Object",
            [
              [ [ "Bare", "database" ], [ "String", "sun:04:00-sun:05:00" ] ],
              [ [ "Bare", "redis" ], [ "String", "sun:05:00-sun:07:00" ] ],
              [ [ "Bare", "eks" ], [ "String", "sun:02:00-sun:03:00" ] ]
            ]
          ]
        ],
        [
          "Block",
          {
            "type_": "validation",
            "labels": [],
            "body": [
              [
                "Attribute",
                "condition",
                [
                  "Fun_call",
                  [
                    "alltrue",
                    [
                      [
                        "For_tuple",
                        {
                          "identifiers": [ "window", [] ],
                          "input": [
                            "Fun_call",
                            [
                              "values",
                              [
                                [
                                  "Attr",
                                  [
                                    [ "Id", "var" ],
                                    [ "A_string", "maintenance_window" ]
                                  ]
                                ]
                              ]
                            ]
                          ],
                          "output": [
                            "Fun_call",
                            [
                              "can",
                              [
                                [
                                  "Fun_call",
                                  [
                                    "regex",
                                    [
                                      [
                                        "String",
                                        "^(mon|tue|wed|thu|fri|sat|sun):[0-2][0-9]:[0-5][0-9]-(mon|tue|wed|thu|fri|sat|sun):[0-2][0-9]:[0-5][0-9]$"
                                      ],
                                      [ "Id", "window" ]
                                    ]
                                  ]
                                ]
                              ]
                            ]
                          ],
                          "cond": null
                        }
                      ]
                    ]
                  ]
                ]
              ],
              [
                "Attribute",
                "error_message",
                [
                  "String",
                  "Maintenance windows must be in the format 'ddd:hh:mm-ddd:hh:mm'."
                ]
              ]
            ]
          }
        ]
      ]
    }
  ],
