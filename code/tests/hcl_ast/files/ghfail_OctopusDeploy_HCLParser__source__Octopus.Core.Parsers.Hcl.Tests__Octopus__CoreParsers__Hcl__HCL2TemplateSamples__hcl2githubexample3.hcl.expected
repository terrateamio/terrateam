            [
              [
                "Attr",
                [
                  [ "Id", "aws_sns_topic" ], [ "A_string", "alert_warning" ]
                ]
              ],
              [ "A_string", "arn" ]
            ]
          ]
        ],
        [
          "Block",
          {
            "type_": "input_transformer",
            "labels": [],
            "body": [
              [
                "Attribute",
                "input_paths",
                [
