        ],
        [
          "Attribute",
          "kms_key_id",
          [
            "Attr",
            [
              [ "Attr", [ [ "Id", "aws_kms_key" ], [ "A_string", "cw" ] ] ],
              [ "A_string", "arn" ]
            ]
          ]
        ],
        [
          "Attribute",
          "tags",
          [
            "Object",
            [
              [
                [
                  "Computed",
                  [
                    "Attr",
                    [ [ "Id", "var" ], [ "A_string", "billing_tag_key" ] ]
                  ]
                ],
                [
                  "Attr",
                  [ [ "Id", "var" ], [ "A_string", "billing_tag_value" ] ]
                ]
              ]
            ]
          ]
        ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "resource",
      "labels": [
        [ "Lit", "aws_cloudwatch_metric_alarm" ],
        [ "Lit", "portal_cpu_utilization_high" ]
      ],
      "body": [
        [
          "Attribute",
          "alarm_name",
          [ "String", "portal-cpu-utilization-high-warn" ]
        ],
        [
          "Attribute",
          "comparison_operator",
          [ "String", "GreaterThanThreshold" ]
        ],
        [ "Attribute", "evaluation_periods", [ "String", "2" ] ],
        [ "Attribute", "metric_name", [ "String", "CPUUtilization" ] ],
        [ "Attribute", "namespace", [ "String", "AWS/ECS" ] ],
        [ "Attribute", "period", [ "String", "120" ] ],
        [ "Attribute", "statistic", [ "String", "Average" ] ],
        [ "Attribute", "threshold", [ "String", "50" ] ],
        [
          "Attribute",
          "alarm_description",
          [
            "String",
            "COVID Alert Portal Warning - CPU usage has been over 50% for 4 minutes."
          ]
        ],
        [
          "Attribute",
          "alarm_actions",
          [
            "Tuple",
            [
              [
                "Attr",
                [
                  [
                    "Attr",
                    [
                      [ "Id", "aws_sns_topic" ],
                      [ "A_string", "alert_warning" ]
                    ]
                  ],
                  [ "A_string", "arn" ]
                ]
              ]
            ]
          ]
        ],
        [
          "Attribute",
          "dimensions",
          [
            "Object",
            [
              [
                [ "Bare", "ClusterName" ],
                [
                  "Attr",
                  [
                    [
                      "Attr",
                      [
                        [ "Id", "aws_ecs_cluster" ],
                        [ "A_string", "covidportal" ]
                      ]
                    ],
                    [ "A_string", "name" ]
                  ]
                ]
              ],
              [
                [ "Bare", "ServiceName" ],
                [
                  "Attr",
                  [
                    [
                      "Attr",
                      [
                        [ "Id", "aws_ecs_service" ],
                        [ "A_string", "covidportal" ]
                      ]
                    ],
                    [ "A_string", "name" ]
                  ]
                ]
              ]
            ]
          ]
        ]
      ]
    }
  ],
