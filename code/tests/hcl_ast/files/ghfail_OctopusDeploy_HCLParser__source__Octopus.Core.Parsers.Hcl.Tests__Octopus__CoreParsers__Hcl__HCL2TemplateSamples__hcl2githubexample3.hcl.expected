  [
    "Block",
    {
      "type_": "resource",
      "labels": [
        [ "Lit", "aws_cloudwatch_event_rule" ], [ "Lit", "codedeploy_sns" ]
      ],
      "body": [
        [ "Attribute", "name", [ "String", "alert-on-codedeploy-status" ] ],
        [
          "Attribute",
          "description",
          [ "String", "Alert if CodeDeploy Fails during deployment" ]
        ],
        [
          "Attribute",
          "event_pattern",
          [
            "Heredoc",
            [
              "PATTERN",
              "\n  {\n    \"source\": [\n      \"aws.codedeploy\"\n    ],\n    \"detail-type\": [\n      \"CodeDeploy Deployment State-change Notification\"\n    ],\n    \"detail\": {\n      \"state\": [\n        \"FAILURE\"\n      ]\n    }\n  }\n"
            ]
          ]
        ]
      ]
    }
  ]
