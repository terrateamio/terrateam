              [
                "Attr",
                [
                  [ "Id", "aws_cloudwatch_event_rule" ],
                  [ "A_string", "codedeploy_sns" ]
                ]
              ],
              [ "A_string", "name" ]
            ]
          ]
        ],
        [
          "Attribute",
          "arn",
