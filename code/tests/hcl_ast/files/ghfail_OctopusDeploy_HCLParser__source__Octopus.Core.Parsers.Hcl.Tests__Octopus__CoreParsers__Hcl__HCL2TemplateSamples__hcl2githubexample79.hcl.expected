            ]
          ]
        ],
        [
          "Block",
          {
            "type_": "route",
            "labels": [],
            "body": [
              [ "Attribute", "cidr_block", [ "String", "0.0.0.0/0" ] ],
              [
                "Attribute",
                "gateway_id",
                [
                  "Attr",
                  [
                    [
                      "Attr",
                      [
