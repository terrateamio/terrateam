[
  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "prefix" ] ],
      "body": [
        [
          "Attribute",
          "description",
          [
            "String",
            "An identifier used to construct the names of all resources in this template."
          ]
        ],
        [ "Attribute", "type", [ "Id", "string" ] ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "randomization_level" ] ],
      "body": [
        [
          "Attribute",
          "description",
          [
            "String",
            "Number of additional random characters to include in resource names to insulate against unexpected resource name collisions."
          ]
        ],
        [ "Attribute", "type", [ "Id", "number" ] ],
        [ "Attribute", "default", [ "Int", 8 ] ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "resource_group_location" ] ],
      "body": [
        [
          "Attribute",
          "description",
          [
            "String",
            "The Azure region where all resources in this template should be created."
          ]
        ],
        [ "Attribute", "type", [ "Id", "string" ] ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "app_services" ] ],
      "body": [
        [
          "Attribute",
          "description",
          [
            "String",
            "Descriptions of the app services to be deployed. Service level config settings can be provided with the required attribute app_settings"
          ]
        ],
        [
          "Attribute",
          "type",
          [
            "Fun_call",
            [
              "list",
              [
                [
                  "Fun_call",
                  [
                    "object",
                    [
                      [
                        "Object",
                        [
                          [ [ "Bare", "app_name" ], [ "Id", "string" ] ],
                          [ [ "Bare", "image" ], [ "Id", "string" ] ],
                          [
                            [ "Bare", "linux_fx_version" ],
                            [ "Id", "string" ]
                          ],
                          [
                            [ "Bare", "app_command_line" ],
                            [ "Id", "string" ]
                          ],
                          [
                            [ "Bare", "app_settings" ],
                            [ "Fun_call", [ "map", [ [ "Id", "string" ] ] ] ]
                          ]
                        ]
                      ]
                    ]
                  ]
                ]
              ]
            ]
          ]
        ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "function_apps" ] ],
      "body": [
        [
          "Attribute",
          "description",
          [
            "String",
            "Descriptions of the function apps to be deployed. This template supports function app containers when the image attribute for a configuration entry is provided."
          ]
        ],
        [
          "Attribute",
          "type",
          [
            "Fun_call",
            [
              "list",
              [
                [
                  "Fun_call",
                  [
                    "object",
                    [
                      [
                        "Object",
                        [
                          [ [ "Bare", "function_name" ], [ "Id", "string" ] ],
                          [
                            [ "Bare", "app_settings" ],
                            [ "Fun_call", [ "map", [ [ "Id", "string" ] ] ] ]
                          ]
                        ]
                      ]
                    ]
                  ]
                ]
              ]
            ]
          ]
        ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "app_service_settings" ] ],
      "body": [
        [
          "Attribute",
          "description",
          [
            "String",
            "Map of app settings that will be applied across all provisioned app services."
          ]
        ],
        [
          "Attribute",
          "type",
          [ "Fun_call", [ "map", [ [ "Id", "string" ] ] ] ]
        ],
        [ "Attribute", "default", [ "Object", [] ] ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "scaling_rules" ] ],
      "body": [
        [
          "Attribute",
          "description",
          [
            "String",
            "The scaling rules for the app service plan. Schema defined here: https://www.terraform.io/docs/providers/azurerm/r/monitor_autoscale_setting.html#rule. Note, the appropriate resource ID will be auto-inflated by the template"
          ]
        ],
        [
          "Attribute",
          "type",
          [
            "Fun_call",
            [
              "list",
              [
                [
                  "Fun_call",
                  [
                    "object",
                    [
                      [
                        "Object",
                        [
                          [
                            [ "Bare", "metric_trigger" ],
                            [
                              "Fun_call",
                              [
                                "object",
                                [
                                  [
                                    "Object",
                                    [
                                      [
                                        [ "Bare", "metric_name" ],
                                        [ "Id", "string" ]
                                      ],
                                      [
                                        [ "Bare", "time_grain" ],
                                        [ "Id", "string" ]
                                      ],
                                      [
                                        [ "Bare", "statistic" ],
                                        [ "Id", "string" ]
                                      ],
                                      [
                                        [ "Bare", "time_window" ],
                                        [ "Id", "string" ]
                                      ],
                                      [
                                        [ "Bare", "time_aggregation" ],
                                        [ "Id", "string" ]
                                      ],
                                      [
                                        [ "Bare", "operator" ],
                                        [ "Id", "string" ]
                                      ],
                                      [
                                        [ "Bare", "threshold" ],
                                        [ "Id", "number" ]
                                      ]
                                    ]
                                  ]
                                ]
                              ]
                            ]
                          ],
                          [
                            [ "Bare", "scale_action" ],
                            [
                              "Fun_call",
                              [
                                "object",
                                [
                                  [
                                    "Object",
                                    [
                                      [
                                        [ "Bare", "direction" ],
                                        [ "Id", "string" ]
                                      ],
                                      [
                                        [ "Bare", "type" ],
                                        [ "Id", "string" ]
                                      ],
                                      [
                                        [ "Bare", "cooldown" ],
                                        [ "Id", "string" ]
                                      ],
                                      [
                                        [ "Bare", "value" ],
                                        [ "Id", "number" ]
                                      ]
                                    ]
                                  ]
                                ]
                              ]
                            ]
                          ]
                        ]
                      ]
                    ]
                  ]
                ]
              ]
            ]
          ]
        ],
        [
          "Attribute",
          "default",
          [
            "Tuple",
            [
              [
                "Object",
                [
                  [
                    [ "Bare", "metric_trigger" ],
                    [
                      "Object",
                      [
                        [
                          [ "Bare", "metric_name" ],
                          [ "String", "CpuPercentage" ]
                        ],
                        [ [ "Bare", "time_grain" ], [ "String", "PT1M" ] ],
                        [ [ "Bare", "statistic" ], [ "String", "Average" ] ],
                        [ [ "Bare", "time_window" ], [ "String", "PT5M" ] ],
                        [
                          [ "Bare", "time_aggregation" ],
                          [ "String", "Average" ]
                        ],
                        [
                          [ "Bare", "operator" ], [ "String", "GreaterThan" ]
                        ],
                        [ [ "Bare", "threshold" ], [ "Int", 70 ] ]
                      ]
                    ]
                  ],
                  [
                    [ "Bare", "scale_action" ],
                    [
                      "Object",
                      [
                        [ [ "Bare", "direction" ], [ "String", "Increase" ] ],
                        [ [ "Bare", "type" ], [ "String", "ChangeCount" ] ],
                        [ [ "Bare", "value" ], [ "Int", 1 ] ],
                        [ [ "Bare", "cooldown" ], [ "String", "PT10M" ] ]
                      ]
                    ]
                  ]
                ]
              ],
              [
                "Object",
                [
                  [
                    [ "Bare", "metric_trigger" ],
                    [
                      "Object",
                      [
                        [
                          [ "Bare", "metric_name" ],
                          [ "String", "CpuPercentage" ]
                        ],
                        [ [ "Bare", "time_grain" ], [ "String", "PT1M" ] ],
                        [ [ "Bare", "statistic" ], [ "String", "Average" ] ],
                        [ [ "Bare", "time_window" ], [ "String", "PT5M" ] ],
                        [
                          [ "Bare", "time_aggregation" ],
                          [ "String", "Average" ]
                        ],
                        [ [ "Bare", "operator" ], [ "String", "LessThan" ] ],
                        [ [ "Bare", "threshold" ], [ "Int", 25 ] ]
                      ]
                    ]
                  ],
                  [
                    [ "Bare", "scale_action" ],
                    [
                      "Object",
                      [
                        [ [ "Bare", "direction" ], [ "String", "Decrease" ] ],
                        [ [ "Bare", "type" ], [ "String", "ChangeCount" ] ],
                        [ [ "Bare", "value" ], [ "Int", 1 ] ],
                        [ [ "Bare", "cooldown" ], [ "String", "PT1M" ] ]
                      ]
                    ]
                  ]
                ]
              ]
            ]
          ]
        ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "service_plan_size" ] ],
      "body": [
        [
          "Attribute",
          "description",
          [ "String", "The size of the service plan instance." ]
        ],
        [ "Attribute", "type", [ "Id", "string" ] ],
        [ "Attribute", "default", [ "String", "P3v2" ] ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "service_plan_tier" ] ],
      "body": [
        [
          "Attribute",
          "description",
          [ "String", "The tier under which the service plan is created." ]
        ],
        [ "Attribute", "type", [ "Id", "string" ] ],
        [ "Attribute", "default", [ "String", "PremiumV2" ] ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "auth_suffix" ] ],
