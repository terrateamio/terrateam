    {
      "type_": "variable",
      "labels": [ [ "Lit", "cosmos_databases" ] ],
      "body": [
        [
          "Attribute",
          "description",
          [ "String", "The list of Cosmos DB SQL Databases." ]
        ],
        [
          "Attribute",
          "type",
          [
            "Fun_call",
            [
              "list",
              [
                [
                  "Fun_call",
                  [
                    "object",
                    [
                      [
                        "Object",
                        [
                          [ [ "Bare", "name" ], [ "Id", "string" ] ],
                          [ [ "Bare", "throughput" ], [ "Id", "number" ] ]
