        ],
        [
          "Attribute",
          "type",
          [ "Fun_call", [ "list", [ [ "Id", "string" ] ] ] ]
        ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "cosmosdb_replica_location" ] ],
      "body": [
        [
          "Attribute",
          "description",
          [
            "String",
            "The name of the Azure region to host replicated data. i.e. 'East US' 'East US 2'. More locations can be found at https://azure.microsoft.com/en-us/global-infrastructure/locations/"
          ]
        ],
        [ "Attribute", "type", [ "Id", "string" ] ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "cosmosdb_automatic_failover" ] ],
