          "Attribute",
          "description",
          [ "String", "A name to be appended to all azure ad applications." ]
        ],
        [ "Attribute", "type", [ "Id", "string" ] ],
        [ "Attribute", "default", [ "String", "easy-auth" ] ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "container_registry_sku" ] ],
