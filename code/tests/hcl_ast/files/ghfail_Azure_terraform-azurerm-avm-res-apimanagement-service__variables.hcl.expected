  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "api_version_sets" ] ],
      "body": [
        [
          "Attribute",
          "type",
          [
            "Fun_call",
            [
              "map",
              [
                [
                  "Fun_call",
                  [
                    "object",
                    [
                      [
                        "Object",
                        [
                          [ [ "Bare", "display_name" ], [ "Id", "string" ] ],
                          [
                            [ "Bare", "versioning_scheme" ],
                            [ "Id", "string" ]
                          ],
                          [
                            [ "Bare", "description" ],
                            [
                              "Fun_call",
                              [ "optional", [ [ "Id", "string" ] ] ]
                            ]
                          ],
                          [
                            [ "Bare", "version_header_name" ],
                            [
                              "Fun_call",
                              [ "optional", [ [ "Id", "string" ] ] ]
                            ]
                          ],
                          [
                            [ "Bare", "version_query_name" ],
                            [
                              "Fun_call",
                              [ "optional", [ [ "Id", "string" ] ] ]
                            ]
                          ]
                        ]
                      ]
                    ]
                  ]
                ]
              ]
            ]
          ]
        ],
        [ "Attribute", "default", [ "Object", [] ] ],
        [
          "Attribute",
          "description",
          [
            "Heredoc",
            [
              "DESCRIPTION",
              "\nAPI Version Sets for the API Management service. Version sets enable API versioning using Header, Query, or Segment-based schemes.\n\n- `display_name` - (Required) The display name of the API version set.\n- `versioning_scheme` - (Required) The versioning scheme. Valid values: `Header`, `Query`, `Segment`.\n- `description` - (Optional) Description of the API version set.\n- `version_header_name` - (Optional) Name of the HTTP header parameter for the `Header` versioning scheme. Required when `versioning_scheme` is `Header`.\n- `version_query_name` - (Optional) Name of the query string parameter for the `Query` versioning scheme. Required when `versioning_scheme` is `Query`.\n\nExample:\n```terraform\napi_version_sets = {\n  \"my-api-versions\" = {\n    display_name        = \"My API Versions\"\n    versioning_scheme   = \"Header\"\n    version_header_name = \"api-version\"\n    description         = \"Version set for My API\"\n  }\n}\n```\n"
            ]
          ]
        ],
        [ "Attribute", "nullable", [ "Bool", false ] ],
        [
          "Block",
          {
            "type_": "validation",
            "labels": [],
            "body": [
              [
                "Attribute",
                "condition",
                [
                  "Fun_call",
                  [
                    "alltrue",
                    [
                      [
                        "For_tuple",
                        {
                          "identifiers": [ "k", [ "v" ] ],
                          "input": [
                            "Attr",
                            [
                              [ "Id", "var" ],
                              [ "A_string", "api_version_sets" ]
                            ]
                          ],
                          "output": [
                            "Fun_call",
                            [
                              "contains",
                              [
                                [
                                  "Tuple",
                                  [
                                    [ "String", "Header" ],
                                    [ "String", "Query" ],
                                    [ "String", "Segment" ]
                                  ]
                                ],
                                [
                                  "Attr",
                                  [
                                    [ "Id", "v" ],
                                    [ "A_string", "versioning_scheme" ]
                                  ]
                                ]
                              ]
                            ]
                          ],
                          "cond": null
                        }
                      ]
                    ]
                  ]
                ]
              ],
              [
                "Attribute",
                "error_message",
                [
                  "String",
                  "versioning_scheme must be one of: Header, Query, Segment."
                ]
              ]
            ]
          }
        ],
        [
          "Block",
          {
            "type_": "validation",
            "labels": [],
            "body": [
              [
                "Attribute",
                "condition",
                [
                  "Fun_call",
                  [
                    "alltrue",
                    [
                      [
                        "For_tuple",
                        {
                          "identifiers": [ "k", [ "v" ] ],
                          "input": [
                            "Attr",
                            [
                              [ "Id", "var" ],
                              [ "A_string", "api_version_sets" ]
                            ]
                          ],
                          "output": [
                            "Log_or",
                            [
                              [
                                "Not_equal",
                                [
                                  [
                                    "Attr",
                                    [
                                      [ "Id", "v" ],
                                      [ "A_string", "versioning_scheme" ]
                                    ]
                                  ],
                                  [ "String", "Header" ]
                                ]
                              ],
                              [
                                "Not_equal",
                                [
                                  [
                                    "Attr",
                                    [
                                      [ "Id", "v" ],
                                      [ "A_string", "version_header_name" ]
                                    ]
                                  ],
                                  [ "Null" ]
                                ]
                              ]
                            ]
                          ],
                          "cond": null
                        }
                      ]
                    ]
                  ]
                ]
              ],
              [
                "Attribute",
                "error_message",
                [
                  "String",
                  "version_header_name is required when versioning_scheme is 'Header'."
                ]
              ]
            ]
          }
        ],
        [
          "Block",
          {
            "type_": "validation",
            "labels": [],
            "body": [
              [
                "Attribute",
                "condition",
                [
                  "Fun_call",
                  [
                    "alltrue",
                    [
                      [
                        "For_tuple",
                        {
                          "identifiers": [ "k", [ "v" ] ],
                          "input": [
                            "Attr",
                            [
                              [ "Id", "var" ],
                              [ "A_string", "api_version_sets" ]
                            ]
                          ],
                          "output": [
                            "Log_or",
                            [
                              [
                                "Not_equal",
                                [
                                  [
                                    "Attr",
                                    [
                                      [ "Id", "v" ],
                                      [ "A_string", "versioning_scheme" ]
                                    ]
                                  ],
                                  [ "String", "Query" ]
                                ]
                              ],
                              [
                                "Not_equal",
                                [
                                  [
                                    "Attr",
                                    [
                                      [ "Id", "v" ],
                                      [ "A_string", "version_query_name" ]
                                    ]
                                  ],
                                  [ "Null" ]
                                ]
                              ]
                            ]
                          ],
                          "cond": null
                        }
                      ]
                    ]
                  ]
                ]
              ],
              [
                "Attribute",
                "error_message",
                [
                  "String",
                  "version_query_name is required when versioning_scheme is 'Query'."
                ]
              ]
            ]
          }
        ]
      ]
    }
  ],
