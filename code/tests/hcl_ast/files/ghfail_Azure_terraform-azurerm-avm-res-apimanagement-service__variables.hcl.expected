                              ]
                            ]
                          ],
                          [
                            [ "Bare", "log_categories" ],
                            [
                              "Fun_call",
                              [
                                "optional",
                                [
                                  [
                                    "Fun_call",
                                    [ "set", [ [ "Id", "string" ] ] ]
                                  ],
                                  [ "Tuple", [] ]
                                ]
                              ]
                            ]
                          ],
                          [
                            [ "Bare", "log_groups" ],
                            [
                              "Fun_call",
                              [
                                "optional",
                                [
                                  [
                                    "Fun_call",
                                    [ "set", [ [ "Id", "string" ] ] ]
                                  ],
                                  [ "Tuple", [ [ "String", "allLogs" ] ] ]
                                ]
                              ]
                            ]
                          ],
                          [
                            [ "Bare", "metric_categories" ],
                            [
                              "Fun_call",
                              [
                                "optional",
                                [
                                  [
                                    "Fun_call",
                                    [ "set", [ [ "Id", "string" ] ] ]
                                  ],
                                  [ "Tuple", [ [ "String", "AllMetrics" ] ] ]
                                ]
                              ]
                            ]
                          ],
                          [
                            [ "Bare", "log_analytics_destination_type" ],
                            [
                              "Fun_call",
                              [
                                "optional",
                                [
                                  [ "Id", "string" ],
                                  [ "String", "Dedicated" ]
                                ]
                              ]
                            ]
                          ],
                          [
                            [ "Bare", "workspace_resource_id" ],
                            [
                              "Fun_call",
                              [
                                "optional",
                                [ [ "Id", "string" ], [ "Null" ] ]
                              ]
                            ]
                          ],
                          [
