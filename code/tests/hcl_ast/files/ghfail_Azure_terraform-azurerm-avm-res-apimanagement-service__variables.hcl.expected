                                [ [ "Id", "bool" ], [ "Bool", false ] ]
                              ]
                            ]
                          ],
                          [
                            [ "Bare", "approval_required" ],
                            [
                              "Fun_call",
                              [
                                "optional",
                                [ [ "Id", "bool" ], [ "Bool", false ] ]
                              ]
                            ]
                          ],
                          [
                            [ "Bare", "subscriptions_limit" ],
                            [
                              "Fun_call",
                              [ "optional", [ [ "Id", "number" ] ] ]
                            ]
                          ],
                          [
                            [ "Bare", "state" ],
                            [
                              "Fun_call",
                              [
                                "optional",
                                [
                                  [ "Id", "string" ],
                                  [ "String", "published" ]
                                ]
                              ]
                            ]
                          ],
                          [
                            [ "Bare", "api_names" ],
                            [
                              "Fun_call",
                              [
                                "optional",
                                [
                                  [
                                    "Fun_call",
                                    [ "list", [ [ "Id", "string" ] ] ]
                                  ],
                                  [ "Tuple", [] ]
                                ]
                              ]
                            ]
                          ],
                          [
                            [ "Bare", "group_names" ],
                            [
                              "Fun_call",
                              [
                                "optional",
                                [
                                  [
                                    "Fun_call",
                                    [ "list", [ [ "Id", "string" ] ] ]
                                  ],
                                  [ "Tuple", [] ]
                                ]
                              ]
                            ]
                          ]
                        ]
                      ]
                    ]
                  ]
                ]
              ]
            ]
          ]
        ],
        [ "Attribute", "default", [ "Object", [] ] ],
        [
          "Attribute",
          "description",
          [
            "Heredoc",
            [
              "DESCRIPTION",
              "\nProducts for the API Management service. The map key is the product identifier.\n\n- `display_name` - (Required) The display name of the product.\n- `description` - (Optional) Description of the product.\n- `terms` - (Optional) Terms of use for the product.\n- `subscription_required` - (Optional) Whether a subscription is required to access APIs in this product. Default is `false`.\n- `approval_required` - (Optional) Whether subscription approval is required. Default is `false`.\n- `subscriptions_limit` - (Optional) Maximum number of subscriptions allowed for this product.\n- `state` - (Optional) Publication state of the product. Valid values: `published`, `notPublished`. Default is `published`.\n- `api_names` - (Optional) List of API names to associate with this product.\n- `group_names` - (Optional) List of group names to associate with this product (e.g., \"developers\", \"administrators\", \"guests\").\n\nExample:\n```terraform\nproducts = {\n  \"starter\" = {\n    display_name          = \"Starter\"\n    description           = \"Starter product for new developers\"\n    subscription_required = true\n    approval_required     = false\n    state                 = \"published\"\n    api_names             = [\"petstore-api\", \"weather-api\"]\n    group_names           = [\"developers\"]\n  }\n}\n```\n"
            ]
          ]
        ],
        [ "Attribute", "nullable", [ "Bool", false ] ],
        [
          "Block",
          {
            "type_": "validation",
            "labels": [],
            "body": [
              [
                "Attribute",
                "condition",
                [
                  "Fun_call",
                  [
                    "alltrue",
                    [
                      [
                        "For_tuple",
                        {
                          "identifiers": [ "k", [ "v" ] ],
                          "input": [
                            "Attr",
                            [ [ "Id", "var" ], [ "A_string", "products" ] ]
                          ],
                          "output": [
                            "Fun_call",
                            [
                              "contains",
                              [
                                [
                                  "Tuple",
                                  [
                                    [ "String", "published" ],
                                    [ "String", "notPublished" ]
                                  ]
                                ],
                                [
                                  "Attr",
                                  [ [ "Id", "v" ], [ "A_string", "state" ] ]
                                ]
                              ]
                            ]
                          ],
                          "cond": null
                        }
                      ]
                    ]
                  ]
                ]
              ],
              [
                "Attribute",
                "error_message",
                [
                  "String",
                  "Product state must be either 'published' or 'notPublished'."
                ]
              ]
            ]
          }
        ]
      ]
    }
  ],
