          ]
        ],
        [ "Attribute", "nullable", [ "Bool", false ] ],
        [
          "Block",
          {
            "type_": "validation",
            "labels": [],
            "body": [
              [
                "Attribute",
                "condition",
                [
                  "Cond",
                  {
                    "if_": [
                      "Fun_call",
                      [
                        "startswith",
                        [
                          [
                            "Attr",
                            [ [ "Id", "var" ], [ "A_string", "sku_name" ] ]
                          ],
                          [ "String", "Consumption" ]
                        ]
                      ]
                    ],
                    "then_": [ "Bool", true ],
                    "else_": [
                      "Not",
                      [
                        "Attr",
                        [
                          [ "Id", "var" ],
                          [ "A_string", "client_certificate_enabled" ]
                        ]
                      ]
                    ]
                  }
                ]
              ],
              [
                "Attribute",
                "error_message",
                [
