          ]
        ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "named_values" ] ],
      "body": [
        [
          "Attribute",
          "type",
          [
            "Fun_call",
            [
              "map",
              [
                [
                  "Fun_call",
                  [
                    "object",
                    [
                      [
                        "Object",
                        [
                          [ [ "Bare", "display_name" ], [ "Id", "string" ] ],
                          [
                            [ "Bare", "value" ],
                            [
                              "Fun_call",
                              [ "optional", [ [ "Id", "string" ] ] ]
                            ]
                          ],
                          [
                            [ "Bare", "secret" ],
                            [
                              "Fun_call",
                              [
                                "optional",
                                [ [ "Id", "bool" ], [ "Bool", false ] ]
                              ]
                            ]
                          ],
                          [
                            [ "Bare", "tags" ],
                            [
                              "Fun_call",
                              [
                                "optional",
                                [
                                  [
                                    "Fun_call",
                                    [ "list", [ [ "Id", "string" ] ] ]
                                  ],
                                  [ "Tuple", [] ]
                                ]
                              ]
                            ]
                          ],
                          [
                            [ "Bare", "value_from_key_vault" ],
                            [
                              "Fun_call",
                              [
                                "optional",
                                [
                                  [
                                    "Fun_call",
                                    [
                                      "object",
                                      [
                                        [
                                          "Object",
                                          [
                                            [
                                              [ "Bare", "secret_id" ],
                                              [ "Id", "string" ]
                                            ],
                                            [
                                              [
                                                "Bare", "identity_client_id"
                                              ],
                                              [
                                                "Fun_call",
                                                [
                                                  "optional",
                                                  [ [ "Id", "string" ] ]
                                                ]
                                              ]
                                            ]
                                          ]
                                        ]
                                      ]
                                    ]
                                  ]
                                ]
                              ]
                            ]
                          ]
                        ]
                      ]
                    ]
                  ]
                ]
              ]
            ]
          ]
        ],
        [ "Attribute", "default", [ "Object", [] ] ],
        [
          "Attribute",
          "description",
          [
            "Heredoc",
            [
              "DESCRIPTION",
              "\nNamed values for the API Management service. Named values are a collection of key/value pairs that can be referenced in policies and API configurations.\n\n- `display_name` - (Required) The display name of the named value. Must be unique within the API Management service.\n- `value` - (Optional) The value of the named value. Conflicts with `value_from_key_vault`. If neither is specified, the named value must be set through other means.\n- `secret` - (Optional) Whether the value is a secret and should be encrypted. Defaults to `false`.\n- `tags` - (Optional) A list of tags that can be used to filter the named values list.\n- `value_from_key_vault` - (Optional) A Key Vault configuration for secret values. Conflicts with `value`.\n  - `secret_id` - (Required) The versioned secret ID from Key Vault (e.g., `https://myvault.vault.azure.net/secrets/mysecret/version`).\n  - `identity_client_id` - (Optional) The client ID of a user-assigned managed identity to use for Key Vault access. If not specified, the system-assigned identity will be used.\n\nExample:\n```terraform\nnamed_values = {\n  \"api-key\" = {\n    display_name = \"API Key\"\n    value        = \"my-secret-key\"\n    secret       = true\n    tags         = [\"production\", \"api\"]\n  }\n  \"keyvault-secret\" = {\n    display_name = \"Database Connection String\"\n    secret       = true\n    value_from_key_vault = {\n      secret_id = \"https://myvault.vault.azure.net/secrets/db-conn/abc123\"\n    }\n  }\n}\n```\n"
            ]
          ]
        ],
        [ "Attribute", "nullable", [ "Bool", false ] ],
        [
          "Block",
          {
            "type_": "validation",
            "labels": [],
            "body": [
              [
                "Attribute",
                "condition",
                [
                  "Fun_call",
                  [
                    "alltrue",
                    [
                      [
                        "For_tuple",
                        {
                          "identifiers": [ "k", [ "v" ] ],
                          "input": [
                            "Attr",
                            [
                              [ "Id", "var" ], [ "A_string", "named_values" ]
                            ]
                          ],
                          "output": [
                            "Log_and",
                            [
                              [
                                "Not_equal",
                                [
                                  [
                                    "Attr",
                                    [
                                      [ "Id", "v" ],
                                      [ "A_string", "display_name" ]
                                    ]
                                  ],
                                  [ "Null" ]
                                ]
                              ],
                              [
                                "Not_equal",
                                [
                                  [
                                    "Attr",
                                    [
                                      [ "Id", "v" ],
                                      [ "A_string", "display_name" ]
                                    ]
                                  ],
                                  [ "String", "" ]
                                ]
                              ]
                            ]
                          ],
                          "cond": null
                        }
                      ]
                    ]
                  ]
                ]
              ],
              [
                "Attribute",
                "error_message",
                [
                  "String",
                  "All named values must have a non-empty display_name."
                ]
              ]
            ]
          }
        ],
        [
          "Block",
          {
            "type_": "validation",
            "labels": [],
            "body": [
              [
                "Attribute",
                "condition",
                [
                  "Fun_call",
                  [
                    "alltrue",
                    [
                      [
                        "For_tuple",
                        {
                          "identifiers": [ "k", [ "v" ] ],
                          "input": [
                            "Attr",
                            [
                              [ "Id", "var" ], [ "A_string", "named_values" ]
                            ]
                          ],
                          "output": [
                            "Log_or",
                            [
                              [
                                "Log_or",
                                [
                                  [
                                    "Log_and",
                                    [
                                      [
                                        "Not_equal",
                                        [
                                          [
                                            "Attr",
                                            [
                                              [ "Id", "v" ],
                                              [ "A_string", "value" ]
                                            ]
                                          ],
                                          [ "Null" ]
                                        ]
                                      ],
                                      [
                                        "Equal",
                                        [
                                          [
                                            "Attr",
                                            [
                                              [ "Id", "v" ],
                                              [
                                                "A_string",
                                                "value_from_key_vault"
                                              ]
                                            ]
                                          ],
                                          [ "Null" ]
                                        ]
                                      ]
                                    ]
                                  ],
                                  [
                                    "Log_and",
                                    [
                                      [
                                        "Equal",
                                        [
                                          [
                                            "Attr",
                                            [
                                              [ "Id", "v" ],
                                              [ "A_string", "value" ]
                                            ]
                                          ],
                                          [ "Null" ]
                                        ]
                                      ],
                                      [
                                        "Not_equal",
                                        [
                                          [
                                            "Attr",
                                            [
                                              [ "Id", "v" ],
                                              [
                                                "A_string",
                                                "value_from_key_vault"
                                              ]
                                            ]
                                          ],
                                          [ "Null" ]
                                        ]
                                      ]
                                    ]
                                  ]
                                ]
                              ],
                              [
                                "Log_and",
                                [
                                  [
                                    "Equal",
                                    [
                                      [
                                        "Attr",
                                        [
                                          [ "Id", "v" ],
                                          [ "A_string", "value" ]
                                        ]
                                      ],
                                      [ "Null" ]
                                    ]
                                  ],
                                  [
                                    "Equal",
                                    [
                                      [
                                        "Attr",
                                        [
                                          [ "Id", "v" ],
                                          [
                                            "A_string",
                                            "value_from_key_vault"
                                          ]
                                        ]
                                      ],
                                      [ "Null" ]
                                    ]
                                  ]
                                ]
                              ]
                            ]
                          ],
                          "cond": null
                        }
                      ]
                    ]
                  ]
                ]
              ],
              [
                "Attribute",
                "error_message",
                [
                  "String",
                  "Each named value must specify either 'value' or 'value_from_key_vault', but not both."
                ]
              ]
            ]
          }
        ],
        [
          "Block",
          {
            "type_": "validation",
            "labels": [],
            "body": [
              [
                "Attribute",
                "condition",
                [
                  "Fun_call",
                  [
                    "alltrue",
                    [
                      [
                        "For_tuple",
                        {
                          "identifiers": [ "k", [ "v" ] ],
                          "input": [
                            "Attr",
                            [
                              [ "Id", "var" ], [ "A_string", "named_values" ]
                            ]
                          ],
                          "output": [
                            "Fun_call",
                            [
                              "can",
                              [
                                [
                                  "Fun_call",
                                  [
                                    "regex",
                                    [
                                      [ "String", "^[a-zA-Z0-9-._]+$" ],
                                      [ "Id", "k" ]
                                    ]
                                  ]
                                ]
                              ]
                            ]
                          ],
                          "cond": null
                        }
                      ]
                    ]
                  ]
                ]
              ],
              [
                "Attribute",
                "error_message",
                [
                  "String",
                  "Named value keys can only contain letters, numbers, hyphens, periods, and underscores."
                ]
              ]
            ]
          }
        ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "notification_sender_email" ] ],
      "body": [
        [ "Attribute", "type", [ "Id", "string" ] ],
        [ "Attribute", "default", [ "Null" ] ],
        [
          "Attribute",
          "description",
          [
            "String",
            "Email address from which the notification will be sent."
          ]
        ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "policy" ] ],
      "body": [
        [
          "Attribute",
          "type",
          [
            "Fun_call",
            [
              "object",
              [
                [
                  "Object",
                  [ [ [ "Bare", "xml_content" ], [ "Id", "string" ] ] ]
                ]
              ]
            ]
          ]
        ],
        [ "Attribute", "default", [ "Null" ] ],
        [
          "Attribute",
          "description",
          [
            "Heredoc",
            [
              "DESCRIPTION",
              "\nService-level (global) policy for the API Management service. This policy applies to all APIs.\n\n- `xml_content` - (Required) The XML content of the policy.\n\nExample:\n```terraform\npolicy = {\n  xml_content = <<XML\n<policies>\n  <inbound>\n    <base />\n    <cors allow-credentials=\"true\">\n      <allowed-origins>\n        <origin>https://example.com</origin>\n      </allowed-origins>\n      <allowed-methods>\n        <method>GET</method>\n        <method>POST</method>\n      </allowed-methods>\n    </cors>\n    <rate-limit-by-key calls=\"100\" renewal-period=\"60\" counter-key=\"@(context.Subscription.Id)\" />\n  </inbound>\n  <backend>\n    <base />\n  </backend>\n  <outbound>\n    <base />\n    <set-header name=\"X-Powered-By\" exists-action=\"delete\" />\n  </outbound>\n  <on-error>\n    <base />\n  </on-error>\n</policies>\nXML\n}\n```\n"
            ]
          ]
        ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "variable",
