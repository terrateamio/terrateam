          [ "Fun_call", [ "map", [ [ "Id", "string" ] ] ] ]
        ],
        [ "Attribute", "default", [ "Null" ] ],
        [
          "Attribute",
          "description",
          [ "String", "(Optional) Tags of the resource." ]
        ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "tenant_access" ] ],
      "body": [
        [
          "Attribute",
          "type",
          [
            "Fun_call",
            [
              "object",
              [
                [ "Object", [ [ [ "Bare", "enabled" ], [ "Id", "bool" ] ] ] ]
              ]
            ]
          ]
        ],
        [ "Attribute", "default", [ "Null" ] ],
        [
          "Attribute",
          "description",
          [
            "String",
            "Controls whether access to the management API is enabled. When enabled, the primary/secondary keys provide access to this API."
          ]
        ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "virtual_network_subnet_id" ] ],
      "body": [
        [ "Attribute", "type", [ "Id", "string" ] ],
        [ "Attribute", "default", [ "Null" ] ],
        [
          "Attribute",
          "description",
          [
            "String",
            "The ID of the subnet in the virtual network where the API Management service will be deployed."
          ]
        ],
        [
          "Block",
          {
            "type_": "validation",
            "labels": [],
            "body": [
              [
                "Attribute",
                "condition",
                [
                  "Cond",
                  {
                    "if_": [
                      "Equal",
                      [
                        [
                          "Attr",
                          [
                            [ "Id", "var" ],
                            [ "A_string", "virtual_network_type" ]
                          ]
                        ],
                        [ "String", "None" ]
                      ]
                    ],
                    "then_": [
                      "Equal",
                      [
                        [
                          "Attr",
                          [
                            [ "Id", "var" ],
                            [ "A_string", "virtual_network_subnet_id" ]
                          ]
                        ],
                        [ "Null" ]
                      ]
                    ],
                    "else_": [ "Bool", true ]
                  }
                ]
              ],
              [
                "Attribute",
                "error_message",
                [
                  "String",
                  "The virtual_network_subnet_id must not be set when virtual_network_type is None."
                ]
              ]
            ]
          }
        ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "virtual_network_type" ] ],
      "body": [
        [ "Attribute", "type", [ "Id", "string" ] ],
        [ "Attribute", "default", [ "String", "None" ] ],
        [
          "Attribute",
          "description",
          [
            "String",
            "The type of virtual network configuration for the API Management service."
          ]
        ],
        [
          "Block",
          {
            "type_": "validation",
            "labels": [],
            "body": [
              [
                "Attribute",
                "condition",
                [
                  "Fun_call",
                  [
                    "contains",
                    [
                      [
                        "Tuple",
                        [
                          [ "String", "None" ],
                          [ "String", "External" ],
                          [ "String", "Internal" ]
                        ]
                      ],
                      [
                        "Attr",
                        [
                          [ "Id", "var" ],
                          [ "A_string", "virtual_network_type" ]
                        ]
                      ]
                    ]
                  ]
                ]
              ],
              [
                "Attribute",
                "error_message",
                [
                  "String",
                  "The virtual_network_type must be one of: None, External, or Internal."
                ]
              ]
            ]
          }
        ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "zones" ] ],
      "body": [
        [
          "Attribute",
          "type",
          [ "Fun_call", [ "list", [ [ "Id", "string" ] ] ] ]
        ],
        [ "Attribute", "default", [ "Null" ] ],
        [
          "Attribute",
          "description",
          [
            "String",
            "Specifies a list of Availability Zones in which this API Management service should be located. Only supported in the Premium tier."
          ]
        ],
        [
          "Block",
          {
            "type_": "validation",
            "labels": [],
            "body": [
              [
                "Attribute",
                "condition",
                [
                  "Log_or",
                  [
                    [
                      "Equal",
                      [
                        [
                          "Attr",
                          [ [ "Id", "var" ], [ "A_string", "zones" ] ]
                        ],
                        [ "Null" ]
                      ]
                    ],
                    [
                      "Fun_call",
                      [
                        "startswith",
                        [
                          [
                            "Attr",
                            [ [ "Id", "var" ], [ "A_string", "sku_name" ] ]
                          ],
                          [ "String", "Premium" ]
                        ]
                      ]
                    ]
                  ]
                ]
              ],
              [
                "Attribute",
                "error_message",
                [
                  "String",
                  "Availability Zones are only supported in the Premium tier."
                ]
              ]
            ]
          }
        ]
      ]
    }
  ]
]
