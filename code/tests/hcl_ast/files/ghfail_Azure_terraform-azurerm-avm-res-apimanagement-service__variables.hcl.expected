  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "sign_in" ] ],
      "body": [
        [
          "Attribute",
          "type",
          [
            "Fun_call",
            [
              "object",
              [
                [ "Object", [ [ [ "Bare", "enabled" ], [ "Id", "bool" ] ] ] ]
              ]
            ]
          ]
        ],
        [ "Attribute", "default", [ "Null" ] ],
        [
          "Attribute",
          "description",
          [
            "String",
            "Sign-in settings for the API Management service. When enabled, anonymous users will be redirected to the sign-in page."
          ]
        ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "sign_up" ] ],
      "body": [
        [
          "Attribute",
          "type",
          [
            "Fun_call",
            [
              "object",
              [
                [
                  "Object",
                  [
                    [ [ "Bare", "enabled" ], [ "Id", "bool" ] ],
                    [
                      [ "Bare", "terms_of_service" ],
                      [
                        "Fun_call",
                        [
                          "object",
                          [
                            [
                              "Object",
                              [
                                [
                                  [ "Bare", "consent_required" ],
                                  [ "Id", "bool" ]
                                ],
                                [ [ "Bare", "enabled" ], [ "Id", "bool" ] ],
                                [
                                  [ "Bare", "text" ],
                                  [
                                    "Fun_call",
                                    [
                                      "optional",
                                      [ [ "Id", "string" ], [ "Null" ] ]
                                    ]
                                  ]
                                ]
                              ]
                            ]
                          ]
                        ]
                      ]
                    ]
                  ]
                ]
              ]
            ]
          ]
        ],
        [ "Attribute", "default", [ "Null" ] ],
        [
          "Attribute",
          "description",
          [ "String", "Sign-up settings for the API Management service." ]
        ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "sku_name" ] ],
      "body": [
        [ "Attribute", "type", [ "Id", "string" ] ],
        [ "Attribute", "default", [ "String", "Developer_1" ] ],
        [
          "Attribute",
          "description",
          [ "String", "The SKU name of the API Management service." ]
        ],
        [
          "Block",
          {
            "type_": "validation",
            "labels": [],
            "body": [
              [
                "Attribute",
                "condition",
                [
                  "Fun_call",
                  [
                    "can",
                    [
                      [
                        "Fun_call",
                        [
                          "regex",
                          [
                            [
                              "String",
                              "^Consumption_0$|^Basic_(1|2)$|^BasicV2_([1-9]|10)|^Developer_1$|^Premium_([1-9][0-9]{0,1})$|^PremiumV2_([1-9]|1[0-9]|2[0-9]|30)$|^Standard_[1-4]$|^StandardV2_([1-9]|10)$"
                            ],
                            [
                              "Attr",
                              [ [ "Id", "var" ], [ "A_string", "sku_name" ] ]
                            ]
                          ]
                        ]
                      ]
                    ]
                  ]
                ]
              ],
              [
                "Attribute",
                "error_message",
                [
                  "String",
                  "The sku_name must be one of: Consumption_0, Basic_1, Basic_2, BasicV2_1 through BasicV2_10, Developer_1, Premium_1 through Premium_99, PremiumV2_1 through PremiumV2_30, Standard_1 through Standard_4, or StandardV2_1 through StandardV2_10."
                ]
              ]
            ]
          }
        ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "subscriptions" ] ],
      "body": [
        [
          "Attribute",
          "type",
          [
            "Fun_call",
            [
              "map",
              [
                [
                  "Fun_call",
                  [
                    "object",
                    [
                      [
                        "Object",
                        [
                          [ [ "Bare", "display_name" ], [ "Id", "string" ] ],
                          [ [ "Bare", "scope_type" ], [ "Id", "string" ] ],
                          [
                            [ "Bare", "scope_identifier" ],
                            [
                              "Fun_call",
                              [ "optional", [ [ "Id", "string" ] ] ]
                            ]
                          ],
                          [
                            [ "Bare", "user_id" ],
                            [
                              "Fun_call",
                              [ "optional", [ [ "Id", "string" ] ] ]
                            ]
                          ],
                          [
                            [ "Bare", "primary_key" ],
                            [
                              "Fun_call",
                              [ "optional", [ [ "Id", "string" ] ] ]
                            ]
                          ],
                          [
                            [ "Bare", "secondary_key" ],
                            [
                              "Fun_call",
                              [ "optional", [ [ "Id", "string" ] ] ]
                            ]
                          ],
                          [
                            [ "Bare", "state" ],
                            [
                              "Fun_call",
                              [
                                "optional",
                                [
                                  [ "Id", "string" ], [ "String", "active" ]
                                ]
                              ]
                            ]
                          ],
                          [
                            [ "Bare", "allow_tracing" ],
                            [
                              "Fun_call",
                              [
                                "optional",
                                [ [ "Id", "bool" ], [ "Bool", false ] ]
                              ]
                            ]
                          ]
                        ]
                      ]
                    ]
                  ]
                ]
              ]
            ]
          ]
        ],
        [ "Attribute", "default", [ "Object", [] ] ],
        [
          "Attribute",
          "description",
          [
            "Heredoc",
            [
              "DESCRIPTION",
              "\nSubscriptions for the API Management service. The map key is the subscription identifier.\n\n- `display_name` - (Required) The display name of the subscription.\n- `scope_type` - (Required) The scope type. Valid values: `product`, `api`, `all_apis`.\n- `scope_identifier` - (Optional) The product ID or API name. Required for `product` and `api` scope types. Not needed for `all_apis`.\n- `user_id` - (Optional) The user ID for this subscription (format: /users/{userId}).\n- `primary_key` - (Optional) Custom primary subscription key.\n- `secondary_key` - (Optional) Custom secondary subscription key.\n- `state` - (Optional) The state of the subscription. Valid values: `active`, `suspended`, `submitted`, `rejected`, `cancelled`. Default is `active`.\n- `allow_tracing` - (Optional) Whether tracing is allowed. Default is `false`.\n\nExample:\n```terraform\nsubscriptions = {\n  \"developer-sub\" = {\n    display_name     = \"Developer Subscription\"\n    scope_type       = \"product\"\n    scope_identifier = \"starter\"\n    state            = \"active\"\n    allow_tracing    = true\n  }\n  \"api-specific-sub\" = {\n    display_name     = \"Petstore API Subscription\"\n    scope_type       = \"api\"\n    scope_identifier = \"petstore-api\"\n    state            = \"active\"\n  }\n}\n```\n"
            ]
          ]
        ],
        [ "Attribute", "nullable", [ "Bool", false ] ],
        [
          "Block",
          {
            "type_": "validation",
            "labels": [],
            "body": [
              [
                "Attribute",
                "condition",
                [
                  "Fun_call",
                  [
                    "alltrue",
                    [
                      [
                        "For_tuple",
                        {
                          "identifiers": [ "k", [ "v" ] ],
                          "input": [
                            "Attr",
                            [
                              [ "Id", "var" ],
                              [ "A_string", "subscriptions" ]
                            ]
                          ],
                          "output": [
                            "Fun_call",
                            [
                              "contains",
                              [
                                [
                                  "Tuple",
                                  [
                                    [ "String", "product" ],
                                    [ "String", "api" ],
                                    [ "String", "all_apis" ]
                                  ]
                                ],
                                [
                                  "Attr",
                                  [
                                    [ "Id", "v" ],
                                    [ "A_string", "scope_type" ]
                                  ]
                                ]
                              ]
                            ]
                          ],
                          "cond": null
                        }
                      ]
                    ]
                  ]
                ]
              ],
              [
                "Attribute",
                "error_message",
                [
                  "String",
                  "Subscription scope_type must be one of: product, api, all_apis."
                ]
              ]
            ]
          }
        ],
        [
          "Block",
          {
            "type_": "validation",
            "labels": [],
            "body": [
              [
                "Attribute",
                "condition",
                [
                  "Fun_call",
                  [
                    "alltrue",
                    [
                      [
                        "For_tuple",
                        {
                          "identifiers": [ "k", [ "v" ] ],
                          "input": [
                            "Attr",
                            [
                              [ "Id", "var" ],
                              [ "A_string", "subscriptions" ]
                            ]
                          ],
                          "output": [
                            "Log_or",
                            [
                              [
                                "Equal",
                                [
                                  [
                                    "Attr",
                                    [
                                      [ "Id", "v" ],
                                      [ "A_string", "scope_type" ]
                                    ]
                                  ],
                                  [ "String", "all_apis" ]
                                ]
                              ],
                              [
                                "Not_equal",
                                [
                                  [
                                    "Attr",
                                    [
                                      [ "Id", "v" ],
                                      [ "A_string", "scope_identifier" ]
                                    ]
                                  ],
                                  [ "Null" ]
                                ]
                              ]
                            ]
                          ],
                          "cond": null
                        }
                      ]
                    ]
                  ]
                ]
              ],
              [
                "Attribute",
                "error_message",
                [
                  "String",
                  "Subscription scope_identifier is required when scope_type is 'product' or 'api'."
                ]
              ]
            ]
          }
        ],
        [
          "Block",
          {
            "type_": "validation",
            "labels": [],
            "body": [
              [
                "Attribute",
                "condition",
                [
                  "Fun_call",
                  [
                    "alltrue",
                    [
                      [
                        "For_tuple",
                        {
                          "identifiers": [ "k", [ "v" ] ],
                          "input": [
                            "Attr",
                            [
                              [ "Id", "var" ],
                              [ "A_string", "subscriptions" ]
                            ]
                          ],
                          "output": [
                            "Fun_call",
                            [
                              "contains",
                              [
                                [
                                  "Tuple",
                                  [
                                    [ "String", "active" ],
                                    [ "String", "suspended" ],
                                    [ "String", "submitted" ],
                                    [ "String", "rejected" ],
                                    [ "String", "cancelled" ]
                                  ]
                                ],
                                [
                                  "Attr",
                                  [ [ "Id", "v" ], [ "A_string", "state" ] ]
                                ]
                              ]
                            ]
                          ],
                          "cond": null
                        }
                      ]
                    ]
                  ]
                ]
              ],
              [
                "Attribute",
                "error_message",
                [
                  "String",
                  "Subscription state must be one of: active, suspended, submitted, rejected, cancelled."
                ]
              ]
            ]
          }
        ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "tags" ] ],
      "body": [
