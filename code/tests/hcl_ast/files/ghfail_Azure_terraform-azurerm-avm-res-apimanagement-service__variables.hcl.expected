  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "lock" ] ],
      "body": [
        [
          "Attribute",
          "type",
          [
            "Fun_call",
            [
              "object",
              [
                [
                  "Object",
                  [
                    [ [ "Bare", "kind" ], [ "Id", "string" ] ],
                    [
                      [ "Bare", "name" ],
                      [
                        "Fun_call",
                        [ "optional", [ [ "Id", "string" ], [ "Null" ] ] ]
                      ]
                    ]
                  ]
                ]
              ]
            ]
          ]
        ],
        [ "Attribute", "default", [ "Null" ] ],
        [
          "Attribute",
          "description",
          [
            "Heredoc",
            [
              "DESCRIPTION",
              "\nControls the Resource Lock configuration for this resource. The following properties can be specified:\n\n- `kind` - (Required) The type of lock. Possible values are `\\\"CanNotDelete\\\"` and `\\\"ReadOnly\\\"`.\n- `name` - (Optional) The name of the lock. If not specified, a name will be generated based on the `kind` value. Changing this forces the creation of a new resource.\n"
            ]
          ]
        ],
        [
          "Block",
          {
            "type_": "validation",
            "labels": [],
            "body": [
              [
                "Attribute",
                "condition",
                [
                  "Cond",
                  {
                    "if_": [
                      "Not_equal",
                      [
                        [
                          "Attr", [ [ "Id", "var" ], [ "A_string", "lock" ] ]
                        ],
                        [ "Null" ]
                      ]
                    ],
                    "then_": [
                      "Fun_call",
                      [
                        "contains",
                        [
                          [
                            "Tuple",
                            [
                              [ "String", "CanNotDelete" ],
                              [ "String", "ReadOnly" ]
                            ]
                          ],
                          [
                            "Attr",
                            [
                              [
                                "Attr",
                                [ [ "Id", "var" ], [ "A_string", "lock" ] ]
                              ],
                              [ "A_string", "kind" ]
                            ]
                          ]
                        ]
                      ]
                    ],
                    "else_": [ "Bool", true ]
                  }
                ]
              ],
              [
                "Attribute",
                "error_message",
                [
                  "String",
                  "The lock level must be one of: 'None', 'CanNotDelete', or 'ReadOnly'."
                ]
              ]
            ]
          }
        ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "managed_identities" ] ],
      "body": [
        [
          "Attribute",
          "type",
          [
            "Fun_call",
            [
              "object",
              [
                [
                  "Object",
                  [
                    [
                      [ "Bare", "system_assigned" ],
                      [
                        "Fun_call",
                        [
                          "optional", [ [ "Id", "bool" ], [ "Bool", false ] ]
                        ]
                      ]
                    ],
                    [
                      [ "Bare", "user_assigned_resource_ids" ],
                      [
                        "Fun_call",
                        [
                          "optional",
                          [
                            [ "Fun_call", [ "set", [ [ "Id", "string" ] ] ] ],
                            [ "Tuple", [] ]
                          ]
                        ]
                      ]
                    ]
                  ]
                ]
              ]
            ]
          ]
        ],
        [ "Attribute", "default", [ "Object", [] ] ],
        [
          "Attribute",
          "description",
          [
            "Heredoc",
            [
              "DESCRIPTION",
              "\nControls the Managed Identity configuration on this resource. The following properties can be specified:\n\n- `system_assigned` - (Optional) Specifies if the System Assigned Managed Identity should be enabled.\n- `user_assigned_resource_ids` - (Optional) Specifies a list of User Assigned Managed Identity resource IDs to be assigned to this resource.\n"
            ]
          ]
        ],
        [ "Attribute", "nullable", [ "Bool", false ] ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "min_api_version" ] ],
      "body": [
