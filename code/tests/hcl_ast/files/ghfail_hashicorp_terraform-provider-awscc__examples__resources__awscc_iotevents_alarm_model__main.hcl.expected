          ]
        ],
        [
          "Attribute",
          "policies",
          [
            "Tuple",
            [
              [
                "Object",
                [
                  [
                    [ "Bare", "policy_name" ],
                    [ "String", "IoTEventsPublishToSNS" ]
                  ],
                  [
                    [ "Bare", "policy_document" ],
                    [
                      "Attr",
                      [
                        [
                          "Attr",
                          [
                            [
                              "Attr",
                              [
                                [ "Id", "data" ],
                                [ "A_string", "aws_iam_policy_document" ]
                              ]
