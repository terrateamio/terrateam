          [
            "Attr",
            [
              [
                "Attr",
                [
                  [
                    "Attr",
                    [
                      [ "Id", "data" ],
                      [ "A_string", "aws_iam_policy_document" ]
                    ]
                  ],
                  [ "A_string", "assume_role" ]
                ]
              ],
