            {
              "if_": [
                "Attr",
                [
                  [ "Id", "var" ],
                  [ "A_string", "transit_encryption_enabled" ]
                ]
              ],
              "then_": [
                "Attr", [ [ "Id", "var" ], [ "A_string", "auth_token" ] ]
              ],
              "else_": [ "Null" ]
            }
          ]
        ],
        [
          "Attribute",
          "replication_group_id",
          [
            "Cond",
            {
              "if_": [
                "Equal",
                [
                  [
                    "Attr",
                    [
                      [ "Id", "var" ], [ "A_string", "replication_group_id" ]
                    ]
                  ],
                  [ "String", "" ]
                ]
              ],
              "then_": [
                "Attr",
                [
                  [ "Attr", [ [ "Id", "module" ], [ "A_string", "label" ] ] ],
                  [ "A_string", "id" ]
                ]
              ],
              "else_": [
                "Attr",
                [ [ "Id", "var" ], [ "A_string", "replication_group_id" ] ]
              ]
            }
          ]
        ],
        [
