          [ "Attr", [ [ "Id", "var" ], [ "A_string", "instance_type" ] ] ]
        ],
        [
          "Attribute",
          "number_cache_clusters",
          [
            "Cond",
            {
              "if_": [
                "Attr",
                [ [ "Id", "var" ], [ "A_string", "cluster_mode_enabled" ] ]
              ],
              "then_": [
                "Mult",
                [
                  [
                    "Add",
                    [
                      [ "Int", 1 ],
                      [
                        "Attr",
                        [
                          [ "Id", "var" ],
                          [
                            "A_string",
                            "cluster_mode_replicas_per_node_group"
                          ]
                        ]
                      ]
                    ]
                  ],
                  [
                    "Attr",
                    [
                      [ "Id", "var" ],
                      [ "A_string", "cluster_mode_num_node_groups" ]
                    ]
                  ]
                ]
              ],
              "else_": [
                "Attr", [ [ "Id", "var" ], [ "A_string", "cluster_size" ] ]
              ]
            }
          ]
        ],
        [
          "Attribute",
          "port",
          [ "Attr", [ [ "Id", "var" ], [ "A_string", "port" ] ] ]
        ],
        [
          "Attribute",
          "parameter_group_name",
          [
            "Fun_call",
            [
              "join",
              [
                [ "String", "" ],
                [
                  "Attr",
                  [
                    [
                      "Attr",
                      [
                        [
                          "Attr",
                          [
                            [ "Id", "aws_elasticache_parameter_group" ],
                            [ "A_string", "default" ]
                          ]
                        ],
                        [ "A_splat" ]
                      ]
                    ],
                    [ "A_string", "name" ]
                  ]
                ]
              ]
            ]
          ]
        ],
        [
          "Attribute",
          "availability_zones",
          [
            "Fun_call",
            [
              "slice",
              [
                [
                  "Attr",
                  [ [ "Id", "var" ], [ "A_string", "availability_zones" ] ]
                ],
                [ "Int", 0 ],
                [
                  "Attr", [ [ "Id", "var" ], [ "A_string", "cluster_size" ] ]
                ]
              ]
            ]
          ]
        ],
        [
          "Attribute",
          "automatic_failover_enabled",
          [
            "Attr",
            [ [ "Id", "var" ], [ "A_string", "automatic_failover_enabled" ] ]
          ]
        ],
        [
          "Attribute",
          "subnet_group_name",
          [
            "Attr",
            [
              [ "Id", "local" ],
              [ "A_string", "elasticache_subnet_group_name" ]
            ]
          ]
        ],
        [
          "Attribute",
