          [
            "Cond",
            {
              "if_": [
                "Attr",
                [
                  [ "Id", "var" ],
                  [ "A_string", "use_existing_security_groups" ]
                ]
              ],
              "then_": [
                "Attr",
                [
                  [ "Id", "var" ], [ "A_string", "existing_security_groups" ]
                ]
              ],
              "else_": [
                "Tuple",
                [
                  [
                    "Fun_call",
                    [
                      "join",
                      [
                        [ "String", "" ],
                        [
                          "Attr",
                          [
                            [
                              "Attr",
                              [
                                [
                                  "Attr",
                                  [
                                    [ "Id", "aws_security_group" ],
                                    [ "A_string", "default" ]
                                  ]
                                ],
                                [ "A_splat" ]
                              ]
                            ],
                            [ "A_string", "id" ]
                          ]
                        ]
                      ]
                    ]
                  ]
                ]
              ]
            }
          ]
        ],
        [
          "Attribute",
