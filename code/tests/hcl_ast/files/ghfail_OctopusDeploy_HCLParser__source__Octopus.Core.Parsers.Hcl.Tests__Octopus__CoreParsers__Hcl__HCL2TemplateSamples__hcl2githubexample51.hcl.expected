[
  [
    "Block",
    {
      "type_": "resource",
      "labels": [
        [ "Lit", "aws_elasticache_replication_group" ], [ "Lit", "default" ]
      ],
      "body": [
        [
          "Attribute",
          "count",
          [
            "Cond",
            {
              "if_": [
                "Attr", [ [ "Id", "var" ], [ "A_string", "enabled" ] ]
              ],
              "then_": [ "Int", 1 ],
              "else_": [ "Int", 0 ]
            }
          ]
        ],
        [
          "Attribute",
