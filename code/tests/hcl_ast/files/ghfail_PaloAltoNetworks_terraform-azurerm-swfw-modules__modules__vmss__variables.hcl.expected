  ],
  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "autoscaling_configuration" ] ],
      "body": [
        [
          "Attribute",
          "description",
          [
            "Heredoc",
            [
              "EOF",
              "\nAutoscaling configuration common to all policies.\n\nFollowing properties are available:\n\n- `application_insights_id` - (`string`, optional, defaults to `null`) an ID of Application Insights instance that should\n                              be used to provide metrics for autoscaling; to **avoid false positives** this should be an\n                              instance **dedicated to this Scale Set**.\n- `default_count`           - (`number`, optional, defaults to `2`) minimum number of instances that should be present\n                              in the scale set when the autoscaling engine cannot read the metrics or is otherwise unable\n                              to compare the metrics to the thresholds.\n- `scale_in_policy`         - (`string`, optional, defaults to Azure default) controls which VMs are chosen for removal\n                              during a scale-in, can be one of: `Default`, `NewestVM`, `OldestVM`.\n- `scale_in_force_deletion` - (`bool`, optional, defaults to `false`) when `true` will **force delete** machines during a \n                              scale-in operation.\n- `notification_emails`     - (`list`, optional, defaults to `[]`) list of email addresses to notify about autoscaling\n                              events.\n- `webhooks_uris`           - (`map`, optional, defaults to `{}`) the URIs that receive autoscaling events; a map where keys\n                              are just arbitrary identifiers and the values are the webhook URIs.\n"
            ]
          ]
        ],
        [ "Attribute", "default", [ "Object", [] ] ],
        [ "Attribute", "nullable", [ "Bool", false ] ],
        [
          "Attribute",
          "type",
          [
            "Fun_call",
            [
              "object",
              [
                [
                  "Object",
                  [
                    [
                      [ "Bare", "application_insights_id" ],
                      [ "Fun_call", [ "optional", [ [ "Id", "string" ] ] ] ]
                    ],
                    [
                      [ "Bare", "default_count" ],
                      [
                        "Fun_call",
                        [ "optional", [ [ "Id", "number" ], [ "Int", 2 ] ] ]
                      ]
                    ],
                    [
                      [ "Bare", "scale_in_policy" ],
                      [ "Fun_call", [ "optional", [ [ "Id", "string" ] ] ] ]
                    ],
                    [
                      [ "Bare", "scale_in_force_deletion" ],
                      [
                        "Fun_call",
                        [
                          "optional", [ [ "Id", "bool" ], [ "Bool", false ] ]
                        ]
                      ]
                    ],
                    [
                      [ "Bare", "notification_emails" ],
                      [
                        "Fun_call",
                        [
                          "optional",
                          [
                            [
                              "Fun_call", [ "list", [ [ "Id", "string" ] ] ]
                            ],
                            [ "Tuple", [] ]
                          ]
                        ]
                      ]
                    ],
                    [
                      [ "Bare", "webhooks_uris" ],
                      [
                        "Fun_call",
                        [
                          "optional",
                          [
                            [ "Fun_call", [ "map", [ [ "Id", "string" ] ] ] ],
                            [ "Object", [] ]
                          ]
                        ]
                      ]
                    ]
                  ]
                ]
              ]
            ]
          ]
        ],
        [
          "Block",
          {
            "type_": "validation",
            "labels": [],
            "body": [
              [
                "Attribute",
                "condition",
                [
                  "Cond",
                  {
                    "if_": [
                      "Not_equal",
                      [
                        [
                          "Attr",
                          [
                            [
                              "Attr",
                              [
                                [ "Id", "var" ],
                                [ "A_string", "autoscaling_configuration" ]
                              ]
                            ],
                            [ "A_string", "scale_in_policy" ]
                          ]
                        ],
                        [ "Null" ]
                      ]
                    ],
                    "then_": [
                      "Fun_call",
                      [
                        "contains",
                        [
                          [
                            "Tuple",
                            [
                              [ "String", "Default" ],
                              [ "String", "NewestVM" ],
                              [ "String", "OldestVM" ]
                            ]
                          ],
                          [
                            "Attr",
                            [
                              [
                                "Attr",
                                [
                                  [ "Id", "var" ],
                                  [ "A_string", "autoscaling_configuration" ]
                                ]
                              ],
                              [ "A_string", "scale_in_policy" ]
                            ]
                          ]
                        ]
                      ]
                    ],
                    "else_": [ "Bool", true ]
                  }
                ]
              ],
              [
                "Attribute",
                "error_message",
                [
                  "Heredoc",
                  [
                    "EOF",
                    "\nThe `scale_in_policy` property can be one of: `Default`, `NewestVM`, `OldestVM`.\n"
                  ]
                ]
              ]
            ]
          }
        ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "autoscaling_profiles" ] ],
      "body": [
        [
          "Attribute",
          "description",
          [
            "Heredoc",
            [
              "EOF",
              "\nA list defining autoscaling profiles.\n\n**Note!** \\\nThe order does matter. The 1<sup>st</sup> profile becomes the default one.\n\nThere are some considerations when creating autoscaling configuration:\n\n1. the 1<sup>st</sup> profile created will become the default one, it cannot contain any schedule.\n2. all other profiles should contain schedules.\n3. the scaling rules are optional, if you skip them you will create a profile with a set number of VM instances \n  (in such case the `minimum_count` and `maximum_count` properties are skipped).\n\nFollowing properties are available:\n\n- `name`          - (`string`, required) the name of the profile.\n- `default_count` - (`number`, required) the default number of VMs.\n- `minimum_count` - (`number`, optional, defaults to `default_count`) minimum number of VMs when scaling in.\n- `maximum_count` - (`number`, optional, defaults to `default_count`) maximum number of VMs when you scale out.\n- `recurrence`    - (`map`, required for rules beside the 1st one) a map defining time schedule for the profile to apply:\n  - `timezone`   - (`string`, optional, defaults to Azure default (UTC)) timezone for the time schedule, supported list can\n                   be found [here](https://learn.microsoft.com/en-us/rest/api/monitor/autoscale-settings/create-or-update?view=rest-monitor-2022-10-01&tabs=HTTP#:~:text=takes%20effect%20at.-,timeZone,-string).\n  - `days`       - (`list`, required) list of days of the week during which the profile is applicable, case sensitive, possible\n                   values are \"Monday\", \"Tuesday\", \"Wednesday\", \"Thursday\", \"Friday\", \"Saturday\" and \"Sunday\".\n  - `start_time` - (`string`, required) profile start time in RFC3339 format.\n  - `end_time`   - (`string`, required) profile end time in RFC3339 format.\n- `scale_rules`   - (`list`, optional, defaults to `[]`) a list of maps defining metrics and rules for autoscaling. \n\n    **Note!** \\\n    By default all VMSS built-in metrics are available. These do not differentiate between management and data planes.\n    For more accuracy please use NGFW metrics.\n\n    Each metric definition is a map with 3 properties:\n\n    - `name`             - (`string`, required) name of the rule.\n    - `scale_out_config` - (`map`, required) definition of the rule used to scale-out.\n    - `scale_in_config`  - (`map`, required) definition of the rule used to scale-in.\n\n        Both `scale_out_config` and `scale_in_config` maps contain the same properties. The ones that are required for\n        scale-out but optional for scale-in, when skipped in the latter configuration, default to scale-out values:\n          \n        - `threshold`                  - (`number`, required) the threshold of a metric that triggers the scale action.\n        - `operator`                   - (`string`, optional, defaults to `>=` or `<=` for scale-out and scale-in respectively)\n                                         the metric vs. threshold comparison operator, can be one of: `>`, `>=`, `<`, `<=`,\n                                         `==` or `!=`.\n        - `grain_window_minutes`       - (`number`, required for scale-out, optional for scale-in) granularity of metrics that\n                                         the rule monitors, between 1 minute and 12 hours (specified in minutes).\n        - `grain_aggregation_type`     - (`string`, optional, defaults to \"Average\") method used to combine data from \n                                         `grain_window`, can be one of `Average`, `Max`, `Min` or `Sum`.\n        - `aggregation_window_minutes` - (`number`, required for scale-out, optional for scale-in) time window used to analyze\n                                         metrics, between 5 minutes and 12 hours (specified in minutes), must be greater than\n                                         `grain_window_minutes`.\n        - `aggregation_window_type`    - (`string`, optional, defaults to \"Average\") method used to combine data from\n                                         `aggregation_window`, can be one of `Average`, `Maximum`, `Minimum`, `Count`, `Last`\n                                         or `Total`.\n        - `cooldown_window_minutes`    - (`number`, required) the amount of time to wait after a scale action, between 1 minute\n                                         and 1 week (specified in minutes).\n        - `change_count_by`            - (`number`, optional, default to `1`) a number of VM instances by which the total count\n                                         of instances in a Scale Set will be changed during a scale action.\n\nExample:\n\n```hcl\n# defining one profile\nautoscaling_profiles = [\n  {\n    name          = \"default_profile\"\n    default_count = 2\n    minimum_count = 2\n    maximum_count = 4\n    scale_rules = [\n      {\n        name = \"DataPlaneCPUUtilizationPct\"\n        scale_out_config = {\n          threshold                  = 85\n          grain_window_minutes       = 1\n          aggregation_window_minutes = 25\n          cooldown_window_minutes    = 60\n        }\n        scale_in_config = {\n          threshold               = 60\n          cooldown_window_minutes = 120\n        }\n      }\n    ]\n  }\n]\n\n# defining a profile with a rule scaling to 1 NGFW, used when no other rule is applicable\n# and a second rule used for autoscaling during 'office hours'\nautoscaling_profiles = [\n  {\n    name          = \"default_profile\"\n    default_count = 1\n  },\n  {\n    name          = \"weekday_profile\"\n    default_count = 2\n    minimum_count = 2\n    maximum_count = 10\n    recurrence = {\n      days       = [\"Monday\", \"Tuesday\", \"Wednesday\", \"Thursday\", \"Friday\"]\n      start_time = \"07:30\"\n      end_time   = \"17:00\"\n    }\n    scale_rules = [\n      {\n        name = \"Percentage CPU\"\n        scale_out_config = {\n          threshold                  = 70\n          grain_window_minutes       = 5\n          aggregation_window_minutes = 30\n          cooldown_window_minutes    = 60\n        }\n        scale_in_config = {\n          threshold               = 40\n          cooldown_window_minutes = 120\n        }\n      },\n      {\n        name = \"Outbound Flows\"\n        scale_out_config = {\n          threshold                  = 500\n          grain_window_minutes       = 5\n          aggregation_window_minutes = 30\n          cooldown_window_minutes    = 60\n        }\n        scale_in_config = {\n          threshold               = 400\n          cooldown_window_minutes = 60\n        }\n      }\n    ]\n  },\n]\n```\n"
            ]
          ]
        ],
        [ "Attribute", "default", [ "Tuple", [] ] ],
        [ "Attribute", "nullable", [ "Bool", false ] ],
