                            "length",
                            [
                              [
                                "Attr",
                                [
                                  [
                                    "Idx",
                                    [
                                      [
                                        "Attr",
                                        [
                                          [ "Id", "var" ],
                                          [ "A_string", "interfaces" ]
                                        ]
                                      ],
                                      [ "Int", 0 ]
                                    ]
                                  ],
                                  [ "A_string", "lb_backend_pool_ids" ]
                                ]
                              ]
                            ]
                          ]
                        ],
                        [ "Int", 0 ]
                      ]
                    ],
                    [
                      "Equal",
                      [
                        [
                          "Fun_call",
                          [
                            "length",
                            [
                              [
                                "Attr",
                                [
                                  [
                                    "Idx",
                                    [
                                      [
                                        "Attr",
                                        [
                                          [ "Id", "var" ],
                                          [ "A_string", "interfaces" ]
                                        ]
                                      ],
                                      [ "Int", 0 ]
                                    ]
                                  ],
                                  [ "A_string", "appgw_backend_pool_ids" ]
                                ]
