          }
        ],
        [
          "Block",
          {
            "type_": "validation",
            "labels": [],
            "body": [
              [
                "Attribute",
                "condition",
                [
                  "Fun_call",
                  [
                    "alltrue",
                    [
                      [
                        "Fun_call",
                        [
                          "flatten",
                          [
                            [
                              "For_tuple",
                              {
                                "identifiers": [ "interface", [] ],
                                "input": [
                                  "Attr",
                                  [
                                    [ "Id", "var" ],
                                    [ "A_string", "interfaces" ]
                                  ]
                                ],
                                "output": [
                                  "Tuple",
                                  [
                                    [
