  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "authentication" ] ],
      "body": [
        [
          "Attribute",
          "description",
          [
            "Heredoc",
            [
              "EOF",
              "\nA map defining authentication settings (including username and password).\n\nFollowing properties are available:\n\n- `username`                        - (`string`, optional, defaults to `panadmin`) the initial administrative VM-Series\n                                      username.\n- `password`                        - (`string`, optional, defaults to `null`) the initial administrative VM-Series password.\n- `disable_password_authentication` - (`bool`, optional, defaults to `true`) disables password-based authentication.\n- `ssh_keys`                        - (`list`, optional, defaults to `[]`) a list of initial administrative SSH public keys.\n\n**Important!** \\\nThe `password` property is required when `ssh_keys` is not specified. You can have both, password and key authentication.\n\n**Important!** \\\n`ssh_keys` property is a list of strings, so each item should be the actual public key value.\nIf you would like to load them from files use the `file` function, for example: `[ file(\"/path/to/public/keys/key_1.pub\") ]`.\n"
            ]
          ]
        ],
        [
          "Attribute",
          "type",
          [
            "Fun_call",
            [
              "object",
              [
                [
                  "Object",
                  [
                    [
                      [ "Bare", "username" ],
                      [
                        "Fun_call",
                        [
                          "optional",
                          [ [ "Id", "string" ], [ "String", "panadmin" ] ]
                        ]
                      ]
                    ],
                    [
                      [ "Bare", "password" ],
                      [ "Fun_call", [ "optional", [ [ "Id", "string" ] ] ] ]
                    ],
                    [
                      [ "Bare", "disable_password_authentication" ],
                      [
                        "Fun_call",
                        [
                          "optional", [ [ "Id", "bool" ], [ "Bool", true ] ]
                        ]
                      ]
                    ],
                    [
                      [ "Bare", "ssh_keys" ],
                      [
                        "Fun_call",
                        [
                          "optional",
                          [
                            [
                              "Fun_call", [ "list", [ [ "Id", "string" ] ] ]
                            ],
                            [ "Tuple", [] ]
                          ]
                        ]
                      ]
                    ]
                  ]
                ]
              ]
            ]
          ]
        ],
        [
          "Block",
          {
            "type_": "validation",
            "labels": [],
            "body": [
              [
                "Attribute",
                "condition",
                [
                  "Not",
                  [
                    "Log_and",
                    [
                      [
                        "Log_and",
                        [
                          [
                            "Equal",
                            [
                              [
                                "Attr",
                                [
                                  [
                                    "Attr",
                                    [
                                      [ "Id", "var" ],
                                      [ "A_string", "authentication" ]
                                    ]
                                  ],
                                  [ "A_string", "password" ]
                                ]
                              ],
                              [ "Null" ]
                            ]
                          ],
                          [
                            "Not",
                            [
                              "Attr",
                              [
                                [
                                  "Attr",
                                  [
                                    [ "Id", "var" ],
                                    [ "A_string", "authentication" ]
                                  ]
                                ],
                                [
                                  "A_string",
                                  "disable_password_authentication"
                                ]
                              ]
                            ]
                          ]
                        ]
                      ],
                      [
                        "Equal",
                        [
                          [
                            "Fun_call",
                            [
                              "length",
                              [
                                [
                                  "Attr",
                                  [
                                    [
                                      "Attr",
                                      [
                                        [ "Id", "var" ],
                                        [ "A_string", "authentication" ]
                                      ]
                                    ],
                                    [ "A_string", "ssh_keys" ]
                                  ]
                                ]
                              ]
                            ]
                          ],
                          [ "Int", 0 ]
                        ]
                      ]
                    ]
                  ]
                ]
              ],
              [
                "Attribute",
                "error_message",
                [
                  "Heredoc",
                  [
                    "EOF",
                    "\nAt least `password` or `ssh_keys` property has to be set when `disable_password_authentication` is `false`.\n"
                  ]
                ]
              ]
            ]
          }
        ],
        [
          "Block",
          {
            "type_": "validation",
            "labels": [],
            "body": [
              [
                "Attribute",
                "condition",
                [
                  "Not",
                  [
                    "Log_and",
                    [
                      [
                        "Attr",
                        [
                          [
                            "Attr",
                            [
                              [ "Id", "var" ],
                              [ "A_string", "authentication" ]
                            ]
                          ],
                          [ "A_string", "disable_password_authentication" ]
                        ]
                      ],
                      [
                        "Equal",
                        [
                          [
                            "Fun_call",
                            [
                              "length",
                              [
                                [
                                  "Attr",
                                  [
                                    [
                                      "Attr",
                                      [
                                        [ "Id", "var" ],
                                        [ "A_string", "authentication" ]
                                      ]
                                    ],
                                    [ "A_string", "ssh_keys" ]
                                  ]
                                ]
                              ]
                            ]
                          ],
                          [ "Int", 0 ]
                        ]
                      ]
                    ]
                  ]
                ]
              ],
              [
                "Attribute",
                "error_message",
                [
                  "Heredoc",
                  [
                    "EOF",
                    "\nThe `ssh_keys` property has to be set when `disable_password_authentication` is `true`.\n"
                  ]
                ]
              ]
            ]
          }
        ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "image" ] ],
      "body": [
        [
          "Attribute",
          "description",
          [
            "Heredoc",
            [
              "EOF",
              "\nBasic Azure VM configuration.\n\nFollowing properties are available:\n\n- `use_airs`                - (`bool`, optional, defaults to `false`) when set to `true`, the AI Runtime Security VM image is\n                              used instead of the one passed to the module and version for `airs-flex` offer must be provided.\n- `version`                 - (`string`, optional, defaults to `null`) VM-Series PAN-OS version; list available with \n                              `az vm image list -o table --publisher paloaltonetworks --offer vmseries-flex --all`.\n- `publisher`               - (`string`, optional, defaults to `paloaltonetworks`) the Azure Publisher identifier for an image\n                              which should be deployed.\n- `offer`                   - (`string`, optional, defaults to `vmseries-flex`) the Azure Offer identifier corresponding to a\n                              published image.\n- `sku`                     - (`string`, optional, defaults to `byol`) VM-Series SKU, list available with\n                              `az vm image list -o table --all --publisher paloaltonetworks`.\n- `enable_marketplace_plan` - (`bool`, optional, defaults to `true`) when set to `true` accepts the license for an offer/plan\n                              on Azure Market Place.\n- `custom_id`               - (`string`, optional, defaults to `null`) absolute ID of your own custom PAN-OS image to be used\n                              for creating new Virtual Machines.\n\n**Important!** \\\n`custom_id` and `version` properties are mutually exclusive.\n"
            ]
          ]
        ],
        [
          "Attribute",
          "type",
          [
            "Fun_call",
            [
              "object",
              [
                [
                  "Object",
                  [
                    [
                      [ "Bare", "use_airs" ],
                      [
                        "Fun_call",
                        [
                          "optional", [ [ "Id", "bool" ], [ "Bool", false ] ]
                        ]
                      ]
                    ],
                    [
                      [ "Bare", "version" ],
                      [ "Fun_call", [ "optional", [ [ "Id", "string" ] ] ] ]
                    ],
                    [
                      [ "Bare", "publisher" ],
                      [
                        "Fun_call",
                        [
                          "optional",
                          [
                            [ "Id", "string" ],
                            [ "String", "paloaltonetworks" ]
                          ]
                        ]
                      ]
                    ],
                    [
                      [ "Bare", "offer" ],
                      [
                        "Fun_call",
                        [
                          "optional",
                          [
                            [ "Id", "string" ], [ "String", "vmseries-flex" ]
                          ]
                        ]
                      ]
                    ],
                    [
                      [ "Bare", "sku" ],
                      [
                        "Fun_call",
                        [
                          "optional",
                          [ [ "Id", "string" ], [ "String", "byol" ] ]
                        ]
                      ]
                    ],
                    [
                      [ "Bare", "enable_marketplace_plan" ],
                      [
                        "Fun_call",
                        [
                          "optional", [ [ "Id", "bool" ], [ "Bool", true ] ]
                        ]
                      ]
                    ],
                    [
                      [ "Bare", "custom_id" ],
                      [ "Fun_call", [ "optional", [ [ "Id", "string" ] ] ] ]
                    ]
                  ]
                ]
              ]
            ]
          ]
        ],
        [
          "Block",
          {
            "type_": "validation",
            "labels": [],
            "body": [
              [
                "Attribute",
                "condition",
                [
                  "Log_or",
                  [
                    [
                      "Log_and",
                      [
                        [
                          "Not_equal",
                          [
                            [
                              "Attr",
                              [
                                [
                                  "Attr",
                                  [
                                    [ "Id", "var" ], [ "A_string", "image" ]
                                  ]
                                ],
                                [ "A_string", "custom_id" ]
                              ]
                            ],
                            [ "Null" ]
                          ]
                        ],
                        [
                          "Equal",
                          [
                            [
                              "Attr",
                              [
                                [
                                  "Attr",
                                  [
                                    [ "Id", "var" ], [ "A_string", "image" ]
                                  ]
                                ],
                                [ "A_string", "version" ]
                              ]
                            ],
                            [ "Null" ]
                          ]
                        ]
                      ]
                    ],
                    [
                      "Log_and",
                      [
                        [
                          "Equal",
                          [
                            [
                              "Attr",
                              [
                                [
                                  "Attr",
                                  [
                                    [ "Id", "var" ], [ "A_string", "image" ]
                                  ]
                                ],
                                [ "A_string", "custom_id" ]
                              ]
                            ],
                            [ "Null" ]
                          ]
                        ],
                        [
                          "Not_equal",
                          [
                            [
                              "Attr",
                              [
                                [
                                  "Attr",
                                  [
                                    [ "Id", "var" ], [ "A_string", "image" ]
                                  ]
                                ],
                                [ "A_string", "version" ]
                              ]
                            ],
                            [ "Null" ]
                          ]
                        ]
                      ]
                    ]
                  ]
                ]
              ],
              [
                "Attribute",
                "error_message",
                [
                  "Heredoc",
                  [
                    "EOF",
                    "\nEither `custom_id` or `version` has to be defined.\n"
                  ]
                ]
              ]
            ]
          }
        ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "virtual_machine_scale_set" ] ],
      "body": [
        [
          "Attribute",
          "description",
          [
            "Heredoc",
            [
              "EOF",
              "\nScale set parameters configuration.\n\nThis map contains basic, as well as some optional Virtual Machine Scale Set parameters. Both types contain sane defaults.\nNevertheless they should be at least reviewed to meet deployment requirements.\n\nList of either required or important properties: \n\n- `orchestration_type` - (`string`, optional, defaults to `Uniform`) this variable is used to select between the Uniform or\n                         Flexible Scale Set orchestration modes. Possible values are `Uniform` and `Flexible`.\n- `size`               - (`string`, optional, defaults to `Standard_D3_v2`) Azure VM size (type). Consult the *VM-Series\n                         Deployment Guide* as only few selected sizes are supported. The default one is a VM-300 equivalent.\n- `zones`              - (`list`, optional, defaults to `null`) a list of Availability Zones in which VMs from this Scale Set\n                         will be created. Zone balance is available from at least 2 zones.\n- `disk_type`          - (`string`, optional, defaults to `StandardSSD_LRS`) type of Managed Disk which should be created,\n                         possible values are `Standard_LRS`, `StandardSSD_LRS` or `Premium_LRS` (works only for selected `size`\n                         values).\n- `bootstrap_options`  - (`string`, optional) bootstrap options to pass to VM-Series instance.\n\n    Proper syntax is a string of semicolon separated properties, for example:\n\n    ```hcl\n    bootstrap_options = \"type=dhcp-client;panorama-server=1.2.3.4\"\n    ```\n\n    For more details on bootstrapping [see documentation](https://docs.paloaltonetworks.com/vm-series/10-2/vm-series-deployment/bootstrap-the-vm-series-firewall/create-the-init-cfgtxt-file/init-cfgtxt-file-components).\n\nList of other, optional properties:\n\n- `accelerated_networking`        - (`bool`, optional, defaults to `true`) when set to `true` enables Azure accelerated\n                                    networking (SR-IOV) for all dataplane network interfaces, this does not affect the\n                                    management interface (always disabled).\n- `allow_extension_operations`    - (`bool`, optional, defaults to `false`) should Extension Operations be allowed on this VM.\n- `disk_encryption_set_id`        - (`string`, optional, defaults to `null`) the ID of the Disk Encryption Set which should be\n                                    used to encrypt this VM's disk.\n- `encryption_at_host_enabled`    - (`bool`, optional, defaults to Azure defaults) should all of disks be encrypted by enabling\n                                    Encryption at Host.\n- `overprovision`                 - (`bool`, optional, defaults to `true`) controls whether Azure should over-provision Virtual\n                                    Machines in the Scale Set for improved deployment time and provisioning success rate.\n- `platform_fault_domain_count`   - (`number`, optional, defaults to `5`) specifies the number of fault domains that are used\n                                    by this Virtual Machine Scale Set. The Flexible orchestration mode requires this parameter\n                                    to be set.\n- `single_placement_group`        - (`bool`, optional, defaults to Azure defaults) when `true` this Virtual Machine Scale Set\n                                    will be limited to a Single Placement Group, which means the number of instances will be\n                                    capped at 100 Virtual Machines.\n- `capacity_reservation_group_id` - (`string`, optional, defaults to `null`) specifies the ID of the Capacity Reservation Group\n                                    which the Virtual Machine Scale Set should be allocated to.\n- `enable_boot_diagnostics`       - (`bool`, optional, defaults to `false`) enables boot diagnostics for a VM.\n- `boot_diagnostics_storage_uri`  - (`string`, optional, defaults to `null`) Storage Account's Blob endpoint to hold diagnostic\n                                    files, when skipped a managed Storage Account will be used (preferred).\n- `identity_type`                 - (`string`, optional, defaults to `SystemAssigned`) type of Managed Service Identity that\n                                    should be configured on this VM. Can be one of \"SystemAssigned\", \"UserAssigned\" or\n                                    \"SystemAssigned, UserAssigned\". For the Flexible orchestration mode this parameter must be\n                                    configured to \"UserAssigned\".\n- `identity_ids`                  - (`list`, optional, defaults to `[]`) a list of User Assigned Managed Identity IDs to be \n                                    assigned to this VM. Required only if `identity_type` is not \"SystemAssigned\".\n"
            ]
          ]
        ],
        [ "Attribute", "default", [ "Object", [] ] ],
        [ "Attribute", "nullable", [ "Bool", false ] ],
        [
          "Attribute",
          "type",
          [
            "Fun_call",
            [
              "object",
              [
                [
                  "Object",
                  [
                    [
                      [ "Bare", "orchestration_type" ],
                      [
                        "Fun_call",
                        [
                          "optional",
                          [ [ "Id", "string" ], [ "String", "Uniform" ] ]
                        ]
                      ]
                    ],
                    [
                      [ "Bare", "size" ],
                      [
                        "Fun_call",
                        [
                          "optional",
                          [
                            [ "Id", "string" ],
                            [ "String", "Standard_D3_v2" ]
                          ]
                        ]
                      ]
                    ],
                    [
                      [ "Bare", "bootstrap_options" ],
                      [ "Fun_call", [ "optional", [ [ "Id", "string" ] ] ] ]
                    ],
                    [
                      [ "Bare", "zones" ],
                      [
                        "Fun_call",
                        [
                          "optional",
                          [
                            [
                              "Fun_call", [ "list", [ [ "Id", "string" ] ] ]
                            ]
                          ]
                        ]
                      ]
                    ],
                    [
                      [ "Bare", "disk_type" ],
                      [
                        "Fun_call",
                        [
                          "optional",
                          [
                            [ "Id", "string" ],
                            [ "String", "StandardSSD_LRS" ]
                          ]
                        ]
                      ]
                    ],
                    [
                      [ "Bare", "accelerated_networking" ],
                      [
                        "Fun_call",
                        [
                          "optional", [ [ "Id", "bool" ], [ "Bool", true ] ]
                        ]
                      ]
                    ],
                    [
                      [ "Bare", "allow_extension_operations" ],
                      [
                        "Fun_call",
                        [
                          "optional", [ [ "Id", "bool" ], [ "Bool", false ] ]
                        ]
                      ]
                    ],
                    [
                      [ "Bare", "encryption_at_host_enabled" ],
                      [ "Fun_call", [ "optional", [ [ "Id", "bool" ] ] ] ]
                    ],
                    [
                      [ "Bare", "overprovision" ],
                      [
                        "Fun_call",
                        [
                          "optional", [ [ "Id", "bool" ], [ "Bool", true ] ]
                        ]
                      ]
                    ],
                    [
                      [ "Bare", "platform_fault_domain_count" ],
                      [
                        "Fun_call",
                        [ "optional", [ [ "Id", "number" ], [ "Int", 5 ] ] ]
                      ]
                    ],
                    [
                      [ "Bare", "single_placement_group" ],
                      [ "Fun_call", [ "optional", [ [ "Id", "bool" ] ] ] ]
                    ],
                    [
                      [ "Bare", "capacity_reservation_group_id" ],
                      [ "Fun_call", [ "optional", [ [ "Id", "string" ] ] ] ]
                    ],
                    [
                      [ "Bare", "disk_encryption_set_id" ],
                      [ "Fun_call", [ "optional", [ [ "Id", "string" ] ] ] ]
                    ],
                    [
                      [ "Bare", "enable_boot_diagnostics" ],
                      [
                        "Fun_call",
                        [
                          "optional", [ [ "Id", "bool" ], [ "Bool", false ] ]
                        ]
                      ]
                    ],
                    [
                      [ "Bare", "boot_diagnostics_storage_uri" ],
                      [ "Fun_call", [ "optional", [ [ "Id", "string" ] ] ] ]
                    ],
                    [
                      [ "Bare", "identity_type" ],
                      [
                        "Fun_call",
                        [
                          "optional",
                          [
                            [ "Id", "string" ],
                            [ "String", "SystemAssigned" ]
                          ]
                        ]
                      ]
                    ],
                    [
                      [ "Bare", "identity_ids" ],
                      [
                        "Fun_call",
                        [
                          "optional",
                          [
                            [
                              "Fun_call", [ "list", [ [ "Id", "string" ] ] ]
                            ],
                            [ "Tuple", [] ]
                          ]
                        ]
                      ]
                    ]
                  ]
                ]
              ]
            ]
          ]
        ],
        [
          "Block",
          {
            "type_": "validation",
            "labels": [],
            "body": [
              [
                "Attribute",
                "condition",
                [
                  "Fun_call",
                  [
                    "contains",
                    [
                      [
                        "Tuple",
                        [ [ "String", "Flexible" ], [ "String", "Uniform" ] ]
                      ],
                      [
                        "Attr",
                        [
                          [
                            "Attr",
                            [
                              [ "Id", "var" ],
                              [ "A_string", "virtual_machine_scale_set" ]
                            ]
                          ],
                          [ "A_string", "orchestration_type" ]
                        ]
                      ]
                    ]
                  ]
                ]
              ],
              [
                "Attribute",
                "error_message",
                [
                  "Heredoc",
                  [
                    "EOF",
                    "\nThe orchestration type must be Flexible or Uniform, it can't have any other value assigned\n"
                  ]
                ]
              ]
            ]
          }
        ],
        [
          "Block",
          {
            "type_": "validation",
            "labels": [],
            "body": [
              [
                "Attribute",
                "condition",
                [
                  "Fun_call",
                  [
                    "contains",
                    [
                      [
                        "Tuple",
                        [
                          [ "String", "Standard_LRS" ],
                          [ "String", "StandardSSD_LRS" ],
                          [ "String", "Premium_LRS" ]
                        ]
                      ],
                      [
                        "Attr",
                        [
                          [
                            "Attr",
                            [
                              [ "Id", "var" ],
                              [ "A_string", "virtual_machine_scale_set" ]
                            ]
                          ],
                          [ "A_string", "disk_type" ]
                        ]
                      ]
                    ]
                  ]
                ]
              ],
              [
                "Attribute",
                "error_message",
                [
                  "Heredoc",
                  [
                    "EOF",
                    "\nThe `disk_type` property can be one of: `Standard_LRS`, `StandardSSD_LRS` or `Premium_LRS`.\n"
                  ]
                ]
              ]
            ]
          }
        ],
        [
          "Block",
          {
            "type_": "validation",
            "labels": [],
            "body": [
              [
                "Attribute",
                "condition",
                [
                  "Cond",
                  {
                    "if_": [
                      "Not_equal",
                      [
                        [
                          "Attr",
                          [
                            [
                              "Attr",
                              [
                                [ "Id", "var" ],
                                [ "A_string", "virtual_machine_scale_set" ]
                              ]
                            ],
                            [ "A_string", "capacity_reservation_group_id" ]
                          ]
                        ],
                        [ "Null" ]
                      ]
                    ],
                    "then_": [
                      "Equal",
                      [
                        [
                          "Attr",
                          [
                            [
                              "Attr",
                              [
                                [ "Id", "var" ],
                                [ "A_string", "virtual_machine_scale_set" ]
                              ]
                            ],
                            [ "A_string", "single_placement_group" ]
                          ]
                        ],
                        [ "Bool", false ]
                      ]
                    ],
                    "else_": [ "Bool", true ]
                  }
                ]
              ],
              [
                "Attribute",
                "error_message",
                [
                  "Heredoc",
                  [
                    "EOF",
                    "\nWhen `capacity_reservation_group_id` value is set, the `single_placement_group` value must equal to false.\n"
                  ]
                ]
              ]
            ]
          }
        ],
        [
          "Block",
          {
            "type_": "validation",
            "labels": [],
            "body": [
              [
                "Attribute",
                "condition",
                [
                  "Fun_call",
                  [
                    "contains",
                    [
                      [
                        "Tuple",
                        [
                          [ "String", "SystemAssigned" ],
                          [ "String", "UserAssigned" ],
                          [ "String", "SystemAssigned, UserAssigned" ]
                        ]
                      ],
                      [
                        "Attr",
                        [
                          [
                            "Attr",
                            [
                              [ "Id", "var" ],
                              [ "A_string", "virtual_machine_scale_set" ]
                            ]
                          ],
                          [ "A_string", "identity_type" ]
                        ]
                      ]
                    ]
                  ]
                ]
              ],
              [
                "Attribute",
                "error_message",
                [
                  "Heredoc",
                  [
                    "EOF",
                    "\nThe `identity_type` property can be one of \\\"SystemAssigned\\\", \\\"UserAssigned\\\" or \\\"SystemAssigned, UserAssigned\\\".\n"
                  ]
                ]
              ]
            ]
          }
        ],
        [
          "Block",
          {
            "type_": "validation",
            "labels": [],
            "body": [
              [
                "Attribute",
