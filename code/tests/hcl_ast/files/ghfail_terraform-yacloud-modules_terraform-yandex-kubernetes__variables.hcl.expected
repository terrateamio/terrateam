[
  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "name" ] ],
      "body": [
        [ "Attribute", "description", [ "String", "K8S cluster name" ] ],
        [ "Attribute", "type", [ "Id", "string" ] ],
        [
          "Block",
          {
            "type_": "validation",
            "labels": [],
            "body": [
              [
                "Attribute",
                "condition",
                [
                  "Log_and",
                  [
                    [
                      "Gt",
                      [
                        [
                          "Fun_call",
                          [
                            "length",
                            [
                              [
                                "Attr",
                                [ [ "Id", "var" ], [ "A_string", "name" ] ]
                              ]
                            ]
                          ]
                        ],
                        [ "Int", 0 ]
                      ]
                    ],
                    [
                      "Fun_call",
                      [
                        "can",
                        [
                          [
                            "Fun_call",
                            [
                              "regex",
                              [
                                [ "String", "^[a-zA-Z][a-zA-Z0-9-]*$" ],
                                [
                                  "Attr",
                                  [ [ "Id", "var" ], [ "A_string", "name" ] ]
                                ]
                              ]
                            ]
                          ]
                        ]
                      ]
                    ]
                  ]
                ]
              ],
              [
                "Attribute",
                "error_message",
                [
                  "String",
                  "Cluster name must be non-empty and can only contain alphanumeric characters and hyphens"
                ]
              ]
            ]
          }
        ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "description" ] ],
      "body": [
        [
          "Attribute", "description", [ "String", "K8S cluster description" ]
        ],
        [ "Attribute", "type", [ "Id", "string" ] ],
        [ "Attribute", "default", [ "String", "" ] ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "labels" ] ],
      "body": [
        [
          "Attribute",
          "description",
          [ "String", "A set of labels to assign to the K8S cluster" ]
        ],
        [
          "Attribute",
          "type",
          [ "Fun_call", [ "map", [ [ "Id", "string" ] ] ] ]
        ],
        [ "Attribute", "default", [ "Object", [] ] ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "network_id" ] ],
      "body": [
        [
          "Attribute",
          "description",
          [ "String", "The ID of the cluster network" ]
        ],
        [ "Attribute", "type", [ "Id", "string" ] ],
        [ "Attribute", "default", [ "Null" ] ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "cluster_ipv4_range" ] ],
      "body": [
        [
          "Attribute",
          "description",
          [
            "Heredoc",
            [
              "EOF",
              "\nCIDR block. IP range for allocating pod addresses. It should not overlap with\nany subnet in the network the K8S cluster located in. Static routes will\nbe set up for this CIDR blocks in node subnets\n"
            ]
          ]
        ],
        [ "Attribute", "type", [ "Id", "string" ] ],
        [ "Attribute", "default", [ "Null" ] ],
        [
          "Block",
          {
            "type_": "validation",
            "labels": [],
            "body": [
              [
                "Attribute",
                "condition",
                [
                  "Cond",
                  {
                    "if_": [
                      "Equal",
                      [
                        [
                          "Attr",
                          [
                            [ "Id", "var" ],
                            [ "A_string", "cluster_ipv4_range" ]
                          ]
                        ],
                        [ "Null" ]
                      ]
                    ],
                    "then_": [ "Bool", true ],
                    "else_": [
                      "Log_and",
                      [
                        [
                          "Fun_call",
                          [
                            "can",
                            [
                              [
                                "Fun_call",
                                [
                                  "regex",
                                  [
                                    [
                                      "String",
                                      "^([0-9]{1,3}\\.){3}[0-9]{1,3}/[0-9]{1,2}$"
                                    ],
                                    [
                                      "Attr",
                                      [
                                        [ "Id", "var" ],
                                        [ "A_string", "cluster_ipv4_range" ]
                                      ]
                                    ]
                                  ]
                                ]
                              ]
                            ]
                          ]
                        ],
                        [
                          "Not_equal",
                          [
                            [
                              "Fun_call",
                              [
                                "cidrsubnet",
                                [
                                  [
                                    "Attr",
                                    [
                                      [ "Id", "var" ],
                                      [ "A_string", "cluster_ipv4_range" ]
                                    ]
                                  ],
                                  [ "Int", 0 ],
                                  [ "Int", 0 ]
                                ]
                              ]
                            ],
                            [ "Null" ]
                          ]
                        ]
                      ]
                    ]
                  }
                ]
              ],
              [
                "Attribute",
                "error_message",
                [
                  "String",
                  "cluster_ipv4_range must be a valid CIDR format (e.g., 10.112.0.0/16) and valid subnet"
                ]
              ]
            ]
          }
        ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "cluster_ipv6_range" ] ],
      "body": [
        [
          "Attribute",
          "description",
          [
            "String", "Identical to cluster_ipv4_range but for IPv6 protocol"
          ]
        ],
        [ "Attribute", "type", [ "Id", "string" ] ],
        [ "Attribute", "default", [ "Null" ] ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "node_ipv4_cidr_mask_size" ] ],
      "body": [
        [
          "Attribute",
          "description",
          [
            "Heredoc",
            [
              "EOF",
              "\nSize of the masks that are assigned to each node in the cluster. Effectively\nlimits maximum number of pods for each node\n"
            ]
          ]
        ],
        [ "Attribute", "type", [ "Id", "number" ] ],
        [ "Attribute", "default", [ "Null" ] ],
        [
          "Block",
          {
            "type_": "validation",
            "labels": [],
            "body": [
              [
                "Attribute",
                "condition",
                [
                  "Cond",
                  {
                    "if_": [
                      "Equal",
                      [
                        [
                          "Attr",
                          [
                            [ "Id", "var" ],
                            [ "A_string", "node_ipv4_cidr_mask_size" ]
                          ]
                        ],
                        [ "Null" ]
                      ]
                    ],
                    "then_": [ "Bool", true ],
                    "else_": [
                      "Fun_call",
                      [
                        "contains",
                        [
                          [
                            "Tuple",
                            [
                              [ "Int", 0 ],
                              [ "Int", 24 ],
                              [ "Int", 25 ],
                              [ "Int", 26 ],
                              [ "Int", 27 ],
                              [ "Int", 28 ]
                            ]
                          ],
                          [
                            "Attr",
                            [
                              [ "Id", "var" ],
                              [ "A_string", "node_ipv4_cidr_mask_size" ]
                            ]
                          ]
                        ]
                      ]
                    ]
                  }
                ]
              ],
              [
                "Attribute",
                "error_message",
                [
                  "String",
                  "node_ipv4_cidr_mask_size must be one of: 0, 24, 25, 26, 27, 28"
                ]
              ]
            ]
          }
        ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "service_ipv4_range" ] ],
      "body": [
        [
          "Attribute",
          "description",
          [
            "Heredoc",
            [
              "EOF",
              "\nCIDR block. IP range K8S service K8S cluster IP addresses\nwill be allocated from. It should not overlap with any subnet in the network\nthe K8S cluster located in\n"
            ]
          ]
        ],
        [ "Attribute", "type", [ "Id", "string" ] ],
        [ "Attribute", "default", [ "Null" ] ],
        [
          "Block",
          {
            "type_": "validation",
            "labels": [],
            "body": [
              [
                "Attribute",
                "condition",
                [
                  "Cond",
                  {
                    "if_": [
                      "Equal",
                      [
                        [
                          "Attr",
                          [
                            [ "Id", "var" ],
                            [ "A_string", "service_ipv4_range" ]
                          ]
                        ],
                        [ "Null" ]
                      ]
                    ],
                    "then_": [ "Bool", true ],
                    "else_": [
                      "Fun_call",
                      [
                        "can",
                        [
                          [
                            "Fun_call",
                            [
                              "regex",
                              [
                                [
                                  "String",
                                  "^([0-9]{1,3}\\.){3}[0-9]{1,3}/[0-9]{1,2}$"
                                ],
                                [
                                  "Attr",
                                  [
                                    [ "Id", "var" ],
                                    [ "A_string", "service_ipv4_range" ]
                                  ]
                                ]
                              ]
                            ]
                          ]
                        ]
                      ]
                    ]
                  }
                ]
              ],
              [
                "Attribute",
                "error_message",
                [
                  "String",
                  "service_ipv4_range must be a valid CIDR format (e.g., 10.113.0.0/16)"
                ]
              ]
            ]
          }
        ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "service_ipv6_range" ] ],
      "body": [
        [
          "Attribute",
          "description",
          [
            "String", "Identical to service_ipv4_range but for IPv6 protocol"
          ]
        ],
        [ "Attribute", "type", [ "Id", "string" ] ],
        [ "Attribute", "default", [ "Null" ] ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "cni_type" ] ],
      "body": [
        [
          "Attribute",
          "description",
          [ "String", "Type of K8S CNI which will be used for the cluster" ]
        ],
        [ "Attribute", "type", [ "Id", "string" ] ],
        [ "Attribute", "default", [ "String", "calico" ] ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "service_account_id" ] ],
      "body": [
        [
          "Attribute",
          "description",
          [
            "Heredoc",
            [
              "EOF",
              "\nID of existing service account to be used for provisioning Compute Cloud\nand VPC resources for K8S cluster. Selected service account should have\nedit role on the folder where the K8S cluster will be located and on the\nfolder where selected network resides\n"
            ]
          ]
        ],
        [ "Attribute", "type", [ "Id", "string" ] ],
        [ "Attribute", "default", [ "Null" ] ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "node_service_account_id" ] ],
      "body": [
        [
          "Attribute",
          "description",
          [
            "Heredoc",
            [
              "EOF",
              "\nID of service account to be used by the worker nodes of the K8S\ncluster to access Container Registry or to push node logs and metrics.\n\nIf omitted or equal to `service_account_id`, service account will be used\nas node service account.\n"
            ]
          ]
        ],
        [ "Attribute", "type", [ "Id", "string" ] ],
        [ "Attribute", "default", [ "Null" ] ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "release_channel" ] ],
      "body": [
        [
          "Attribute",
          "description",
          [ "String", "K8S cluster release channel" ]
        ],
        [ "Attribute", "type", [ "Id", "string" ] ],
        [ "Attribute", "default", [ "String", "STABLE" ] ],
        [
          "Block",
          {
            "type_": "validation",
            "labels": [],
            "body": [
              [
                "Attribute",
                "condition",
                [
                  "Fun_call",
                  [
                    "contains",
                    [
                      [
                        "Tuple",
                        [
                          [ "String", "RAPID" ],
                          [ "String", "REGULAR" ],
                          [ "String", "STABLE" ],
                          [ "String", "RELEASE_CHANNEL_UNSPECIFIED" ]
                        ]
                      ],
                      [
                        "Attr",
                        [
                          [ "Id", "var" ], [ "A_string", "release_channel" ]
                        ]
                      ]
                    ]
                  ]
                ]
              ],
              [
                "Attribute",
                "error_message",
                [
                  "String",
                  "release_channel must be one of: RAPID, REGULAR, STABLE, RELEASE_CHANNEL_UNSPECIFIED"
                ]
              ]
            ]
          }
        ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "kms_provider_key_id" ] ],
      "body": [
        [
          "Attribute", "description", [ "String", "K8S cluster KMS key ID" ]
        ],
        [ "Attribute", "type", [ "Id", "string" ] ],
        [ "Attribute", "default", [ "Null" ] ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "workload_identity_federation" ] ],
      "body": [
        [
          "Attribute",
          "description",
          [ "String", "Workload Identity Federation configuration" ]
        ],
        [
          "Attribute",
          "type",
          [
            "Fun_call",
            [
              "object",
              [
                [
                  "Object",
                  [
                    [
                      [ "Bare", "enabled" ],
                      [
                        "Fun_call",
                        [
                          "optional", [ [ "Id", "bool" ], [ "Bool", false ] ]
                        ]
                      ]
                    ]
                  ]
                ]
              ]
            ]
          ]
        ],
        [
          "Attribute",
          "default",
          [ "Object", [ [ [ "Bare", "enabled" ], [ "Bool", false ] ] ] ]
        ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "master_version" ] ],
      "body": [
        [
          "Attribute",
          "description",
          [ "String", "Version of K8S that will be used for master" ]
        ],
        [ "Attribute", "type", [ "Id", "string" ] ],
        [ "Attribute", "default", [ "String", "1.31" ] ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "master_public_ip" ] ],
      "body": [
        [
          "Attribute",
          "description",
          [
            "String",
            "Boolean flag. When true, K8S master will have visible ipv4 address"
          ]
        ],
        [ "Attribute", "type", [ "Id", "bool" ] ],
        [ "Attribute", "default", [ "Bool", true ] ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "master_security_group_ids" ] ],
      "body": [
        [
          "Attribute",
          "description",
          [
            "String",
            "List of security group IDs to which the K8S cluster belongs"
          ]
        ],
        [
          "Attribute",
          "type",
          [ "Fun_call", [ "set", [ [ "Id", "string" ] ] ] ]
        ],
        [ "Attribute", "default", [ "Null" ] ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "master_region" ] ],
      "body": [
        [
          "Attribute",
          "description",
          [
            "Heredoc",
            [
              "EOF",
              "\nName of region where cluster will be created. Required for regional cluster,\nnot used for zonal cluster\n"
            ]
          ]
        ],
        [ "Attribute", "type", [ "Id", "string" ] ],
        [ "Attribute", "default", [ "Null" ] ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "master_locations" ] ],
      "body": [
        [
          "Attribute",
          "description",
          [
            "Heredoc",
            [
              "EOF",
              "\nList of locations where cluster will be created. If list contains only one\nlocation, will be created zonal cluster, if more than one -- regional\n"
            ]
          ]
        ],
        [
          "Attribute",
          "type",
          [
            "Fun_call",
            [
              "list",
              [
                [
                  "Fun_call",
                  [
                    "object",
                    [
                      [
                        "Object",
                        [
                          [ [ "Bare", "subnet_id" ], [ "Id", "string" ] ],
                          [ [ "Bare", "zone" ], [ "Id", "string" ] ]
                        ]
                      ]
                    ]
                  ]
                ]
              ]
            ]
          ]
        ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "master_auto_upgrade" ] ],
      "body": [
        [
          "Attribute",
          "description",
          [
            "String",
            "Boolean flag that specifies if master can be upgraded automatically"
          ]
        ],
        [ "Attribute", "type", [ "Id", "bool" ] ],
        [ "Attribute", "default", [ "Bool", false ] ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "master_maintenance_windows" ] ],
      "body": [
        [
          "Attribute",
          "description",
          [
            "Heredoc",
            [
              "EOF",
              "\n  List of structures that specifies maintenance windows,\n  when auto update for master is allowed\n\n  E.g:\n  ```\n  master_maintenance_windows = [\n    {\n      start_time = \"10:00\"\n      duration   = \"5h\"\n    }\n  ]\n  ```\n"
            ]
          ]
        ],
        [
          "Attribute",
          "type",
          [
            "Fun_call",
            [ "list", [ [ "Fun_call", [ "map", [ [ "Id", "string" ] ] ] ] ] ]
          ]
        ],
        [
          "Attribute",
          "default",
          [
            "Tuple",
            [
              [
                "Object",
                [
                  [ [ "Bare", "start_time" ], [ "String", "23:00" ] ],
                  [ [ "Bare", "duration" ], [ "String", "3h" ] ]
                ]
              ]
            ]
          ]
        ],
        [
          "Block",
          {
            "type_": "validation",
            "labels": [],
            "body": [
              [
                "Attribute",
                "condition",
                [
                  "Fun_call",
                  [
                    "alltrue",
                    [
                      [
                        "For_tuple",
                        {
                          "identifiers": [ "window", [] ],
                          "input": [
                            "Attr",
                            [
                              [ "Id", "var" ],
                              [ "A_string", "master_maintenance_windows" ]
                            ]
                          ],
                          "output": [
                            "Log_and",
                            [
                              [
                                "Fun_call",
                                [
                                  "can",
                                  [
                                    [
                                      "Fun_call",
                                      [
                                        "regex",
                                        [
                                          [
                                            "String",
                                            "^([0-1][0-9]|2[0-3]):[0-5][0-9]$"
                                          ],
                                          [
                                            "Idx",
                                            [
                                              [ "Id", "window" ],
                                              [ "String", "start_time" ]
                                            ]
                                          ]
                                        ]
                                      ]
                                    ]
                                  ]
                                ]
                              ],
                              [
                                "Fun_call",
                                [
                                  "can",
                                  [
                                    [
                                      "Fun_call",
                                      [
                                        "regex",
                                        [
                                          [ "String", "^[0-9]+(h|m)$" ],
                                          [
                                            "Idx",
                                            [
                                              [ "Id", "window" ],
                                              [ "String", "duration" ]
                                            ]
                                          ]
                                        ]
                                      ]
                                    ]
                                  ]
                                ]
                              ]
                            ]
                          ],
                          "cond": null
                        }
                      ]
                    ]
                  ]
                ]
              ],
              [
                "Attribute",
                "error_message",
                [
                  "String",
                  "Each maintenance window must have valid start_time (HH:MM) and duration (e.g., 3h, 30m)"
                ]
              ]
            ]
          }
        ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "master_logging" ] ],
      "body": [
        [
          "Attribute",
          "description",
          [
            "Heredoc",
            [
              "EOF",
              "\nMaster logging. Only one of log_group_id or folder_id may be set.\nIf log_group_id is set, logs go to that group. If folder_id is set, logs go to folder's default log group.\nIf neither is set (and enabled=true), logs go to the cluster folder's default log group.\n"
            ]
          ]
        ],
        [
          "Attribute",
          "type",
          [
            "Fun_call",
            [
              "object",
              [
                [
                  "Object",
                  [
                    [ [ "Bare", "enabled" ], [ "Id", "bool" ] ],
                    [
                      [ "Bare", "create_log_group" ],
                      [
                        "Fun_call",
                        [
                          "optional", [ [ "Id", "bool" ], [ "Bool", true ] ]
                        ]
                      ]
                    ],
                    [
                      [ "Bare", "log_group_retention_period" ],
                      [
                        "Fun_call",
                        [
                          "optional",
                          [ [ "Id", "string" ], [ "String", "168h" ] ]
                        ]
                      ]
                    ],
                    [
                      [ "Bare", "log_group_id" ],
                      [
                        "Fun_call",
                        [
                          "optional",
                          [ [ "Id", "string" ], [ "String", "" ] ]
                        ]
                      ]
                    ],
                    [
                      [ "Bare", "folder_id" ],
                      [
                        "Fun_call",
                        [
                          "optional",
                          [ [ "Id", "string" ], [ "String", "" ] ]
                        ]
                      ]
                    ],
                    [
                      [ "Bare", "audit_enabled" ],
                      [
                        "Fun_call",
                        [
                          "optional", [ [ "Id", "bool" ], [ "Bool", true ] ]
                        ]
                      ]
                    ],
                    [
                      [ "Bare", "kube_apiserver_enabled" ],
                      [
                        "Fun_call",
                        [
                          "optional", [ [ "Id", "bool" ], [ "Bool", true ] ]
                        ]
                      ]
                    ],
                    [
                      [ "Bare", "cluster_autoscaler_enabled" ],
                      [
                        "Fun_call",
                        [
                          "optional", [ [ "Id", "bool" ], [ "Bool", true ] ]
                        ]
                      ]
                    ],
                    [
                      [ "Bare", "events_enabled" ],
                      [
                        "Fun_call",
                        [
                          "optional", [ [ "Id", "bool" ], [ "Bool", true ] ]
                        ]
                      ]
                    ]
                  ]
                ]
              ]
            ]
          ]
        ],
        [
          "Attribute",
          "default",
          [ "Object", [ [ [ "Bare", "enabled" ], [ "Bool", false ] ] ] ]
        ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "node_name_prefix" ] ],
      "body": [
        [
          "Attribute",
          "description",
          [ "String", "The prefix for node group name" ]
        ],
        [ "Attribute", "type", [ "Id", "string" ] ],
        [ "Attribute", "default", [ "String", "" ] ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "node_groups" ] ],
