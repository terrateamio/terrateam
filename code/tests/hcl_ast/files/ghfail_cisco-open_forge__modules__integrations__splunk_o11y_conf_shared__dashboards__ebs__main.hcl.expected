[
  [
    "Block",
    {
      "type_": "resource",
      "labels": [
        [ "Lit", "signalfx_time_chart" ], [ "Lit", "byte_utilization_pct" ]
      ],
      "body": [
        [ "Attribute", "name", [ "String", "Byte utilization %" ] ],
        [
          "Attribute",
          "description",
          [
            "String",
            "Compares delivered bytes to maximum allowed for Nitro volumes"
          ]
        ],
        [
          "Attribute",
          "program_text",
          [
            "Heredoc",
            [
              "EOF",
              "\nA = data('EBSByteBalance%').mean(by=['AWSUniqueId']).publish(label='A')\n"
            ]
          ]
        ],
        [ "Attribute", "plot_type", [ "String", "LineChart" ] ],
        [ "Attribute", "color_by", [ "String", "Dimension" ] ],
        [ "Attribute", "unit_prefix", [ "String", "Metric" ] ],
        [ "Attribute", "axes_precision", [ "Int", 4 ] ],
        [ "Attribute", "time_range", [ "Int", 900 ] ],
        [
          "Block",
          {
            "type_": "axis_left",
            "labels": [],
            "body": [
              [
                "Attribute",
                "high_watermark",
                [ "Float", 1.7976931348623157e+308 ]
              ],
              [ "Attribute", "label", [ "String", "Percent" ] ],
              [
                "Attribute",
                "low_watermark",
                [ "Minus", [ "Float", 1.7976931348623157e+308 ] ]
              ],
              [
                "Attribute",
                "max_value",
                [ "Float", 1.7976931348623157e+308 ]
              ],
              [
                "Attribute",
                "min_value",
                [ "Minus", [ "Float", 1.7976931348623157e+308 ] ]
              ]
            ]
          }
        ],
        [
          "Block",
          {
            "type_": "histogram_options",
            "labels": [],
            "body": [ [ "Attribute", "color_theme", [ "String", "gold" ] ] ]
          }
        ],
        [
          "Block",
          {
            "type_": "viz_options",
            "labels": [],
            "body": [
              [ "Attribute", "axis", [ "String", "left" ] ],
              [
                "Attribute",
                "display_name",
                [ "String", "Byte utilization percentage" ]
              ],
              [ "Attribute", "label", [ "String", "A" ] ],
              [ "Attribute", "value_suffix", [ "String", "%" ] ]
            ]
          }
        ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "resource",
      "labels": [
        [ "Lit", "signalfx_time_chart" ], [ "Lit", "write_latency" ]
      ],
      "body": [
        [ "Attribute", "name", [ "String", "Write latency (ms/op)" ] ],
        [
          "Attribute",
          "description",
          [
            "String",
            "Estimates average latency per write operation for troubleshooting"
          ]
        ],
        [
          "Attribute",
          "program_text",
          [
            "Heredoc",
            [
              "EOF",
              "\nA = data('VolumeTotalWriteTime').sum(by=['VolumeId']).publish(label='A', enable=False)\nB = data('VolumeWriteOps').sum(by=['VolumeId']).publish(label='B', enable=False)\nC = (A/B * 1000).publish(label='C', enable=True)\n"
            ]
          ]
        ],
        [ "Attribute", "plot_type", [ "String", "LineChart" ] ],
        [ "Attribute", "color_by", [ "String", "Dimension" ] ],
        [ "Attribute", "axes_precision", [ "Int", 4 ] ],
        [ "Attribute", "time_range", [ "Int", 900 ] ],
        [
          "Block",
          {
            "type_": "axis_left",
            "labels": [],
            "body": [
              [
                "Attribute",
                "high_watermark",
                [ "Float", 1.7976931348623157e+308 ]
              ],
              [ "Attribute", "label", [ "String", "Ms/Op" ] ],
              [
                "Attribute",
                "low_watermark",
                [ "Minus", [ "Float", 1.7976931348623157e+308 ] ]
              ],
              [
                "Attribute",
                "max_value",
                [ "Float", 1.7976931348623157e+308 ]
              ],
              [
                "Attribute",
                "min_value",
                [ "Minus", [ "Float", 1.7976931348623157e+308 ] ]
              ]
            ]
          }
        ],
        [
          "Block",
          {
            "type_": "viz_options",
            "labels": [],
            "body": [
              [ "Attribute", "axis", [ "String", "left" ] ],
              [ "Attribute", "color", [ "String", "blue" ] ],
              [
                "Attribute",
                "display_name",
                [ "String", "Intermediate: Write operations count" ]
              ],
              [ "Attribute", "label", [ "String", "B" ] ],
              [ "Attribute", "value_suffix", [ "String", "No of ops" ] ]
            ]
          }
        ],
        [
          "Block",
          {
            "type_": "viz_options",
            "labels": [],
            "body": [
              [ "Attribute", "axis", [ "String", "left" ] ],
              [ "Attribute", "color", [ "String", "emerald" ] ],
              [
                "Attribute",
                "display_name",
