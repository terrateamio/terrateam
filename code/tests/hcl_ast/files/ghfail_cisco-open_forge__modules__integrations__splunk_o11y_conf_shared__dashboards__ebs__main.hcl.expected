  [
    "Block",
    {
      "type_": "resource",
      "labels": [ [ "Lit", "signalfx_time_chart" ], [ "Lit", "latency_op" ] ],
      "body": [
        [ "Attribute", "name", [ "String", "Latency/op (ms)" ] ],
        [ "Attribute", "description", [ "String", "" ] ],
        [
          "Attribute",
          "program_text",
          [
            "Heredoc",
            [
              "EOF",
              "\nA = data('VolumeWriteOps', filter=filter('namespace', 'AWS/EBS') and filter('VolumeId', 'vol-46dcc55f') and filter('stat', 'sum'), extrapolation='zero', rollup='rate').scale(60).publish(label='A')\nB = data('VolumeTotalWriteTime', filter=filter('namespace', 'AWS/EBS') and filter('VolumeId', 'vol-46dcc55f') and filter('stat', 'sum'), extrapolation='zero', rollup='rate').scale(60).publish(label='B', enable=False)\nC = data('VolumeReadOps', filter=filter('namespace', 'AWS/EBS') and filter('VolumeId', 'vol-46dcc55f') and filter('stat', 'sum'), extrapolation='zero', rollup='rate').scale(60).publish(label='C')\nD = data('VolumeTotalReadTime', filter=filter('namespace', 'AWS/EBS') and filter('VolumeId', 'vol-46dcc55f') and filter('stat', 'sum'), extrapolation='zero', rollup='rate').scale(60).publish(label='D', enable=False)\nE = (B/A).scale(1000).publish(label='E')\nF = (D/C).scale(1000).publish(label='F')\n"
            ]
          ]
        ],
        [ "Attribute", "plot_type", [ "String", "ColumnChart" ] ],
        [ "Attribute", "color_by", [ "String", "Dimension" ] ],
        [ "Attribute", "axes_precision", [ "Int", 0 ] ],
        [ "Attribute", "time_range", [ "Int", 7200 ] ],
        [
          "Block",
          {
            "type_": "axis_left",
            "labels": [],
            "body": [
              [
                "Attribute",
                "high_watermark",
                [ "Float", 1.7976931348623157e+308 ]
              ],
              [ "Attribute", "label", [ "String", "Ms/write - BLUE" ] ],
              [
                "Attribute",
                "low_watermark",
                [ "Minus", [ "Float", 1.7976931348623157e+308 ] ]
              ],
              [
