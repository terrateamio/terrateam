          ]
        ],
        [
          "Attribute",
          "type",
          [ "Fun_call", [ "list", [ [ "Id", "string" ] ] ] ]
        ],
        [ "Attribute", "default", [ "Tuple", [] ] ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "environment" ] ],
      "body": [
        [
          "Attribute",
          "description",
          [ "String", "Deployment environment of the Kafka cluster" ]
        ],
        [ "Attribute", "type", [ "Id", "string" ] ],
        [ "Attribute", "default", [ "String", "PRODUCTION" ] ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "kafka_version" ] ],
      "body": [
        [
          "Attribute",
          "description",
          [ "String", "Version of the Kafka server" ]
        ],
        [ "Attribute", "type", [ "Id", "string" ] ],
        [
          "Block",
          {
            "type_": "validation",
            "labels": [],
            "body": [
              [
                "Attribute",
                "condition",
                [
                  "Fun_call",
                  [
                    "contains",
                    [
                      [
                        "Tuple",
                        [
                          [ "String", "3.7" ],
                          [ "String", "3.8" ],
                          [ "String", "3.9" ],
                          [ "String", "4.0" ]
                        ]
                      ],
                      [
                        "Attr",
                        [ [ "Id", "var" ], [ "A_string", "kafka_version" ] ]
                      ]
                    ]
                  ]
                ]
              ],
              [
                "Attribute",
                "error_message",
                [
                  "String",
                  "The Kafka server version must be one of: 3.7, 3.8, 3.9, 4.0"
                ]
              ]
            ]
          }
        ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "brokers_count" ] ],
      "body": [
        [
          "Attribute",
          "description",
          [ "String", "Count of brokers per availability zone" ]
        ],
        [ "Attribute", "type", [ "Id", "number" ] ],
        [ "Attribute", "default", [ "Int", 1 ] ],
        [
          "Block",
          {
            "type_": "validation",
            "labels": [],
            "body": [
              [
                "Attribute",
                "condition",
                [
                  "Log_and",
                  [
                    [
                      "Gte",
                      [
                        [
                          "Attr",
                          [
                            [ "Id", "var" ], [ "A_string", "brokers_count" ]
                          ]
                        ],
                        [ "Int", 1 ]
                      ]
                    ],
                    [
                      "Lte",
                      [
                        [
                          "Attr",
                          [
                            [ "Id", "var" ], [ "A_string", "brokers_count" ]
                          ]
                        ],
                        [ "Int", 10 ]
                      ]
                    ]
                  ]
                ]
              ],
              [
                "Attribute",
                "error_message",
                [
                  "String", "Brokers count must be between 1 and 10 per zone"
                ]
              ]
            ]
          }
        ]
      ]
    }
  ],
  [
