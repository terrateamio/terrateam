  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "maintenance_window_day" ] ],
      "body": [
        [
          "Attribute",
          "description",
          [ "String", "Day of the week for maintenance window" ]
        ],
        [ "Attribute", "type", [ "Id", "string" ] ],
        [ "Attribute", "default", [ "Null" ] ],
        [
          "Block",
          {
            "type_": "validation",
            "labels": [],
            "body": [
              [
                "Attribute",
                "condition",
                [
                  "Cond",
                  {
                    "if_": [
                      "Equal",
                      [
                        [
                          "Attr",
                          [
                            [ "Id", "var" ],
                            [ "A_string", "maintenance_window_day" ]
                          ]
                        ],
                        [ "Null" ]
                      ]
                    ],
                    "then_": [ "Bool", true ],
                    "else_": [
                      "Fun_call",
                      [
                        "contains",
                        [
                          [
                            "Tuple",
                            [
                              [ "String", "MON" ],
                              [ "String", "TUE" ],
                              [ "String", "WED" ],
                              [ "String", "THU" ],
                              [ "String", "FRI" ],
                              [ "String", "SAT" ],
                              [ "String", "SUN" ]
                            ]
                          ],
                          [
                            "Attr",
                            [
                              [ "Id", "var" ],
                              [ "A_string", "maintenance_window_day" ]
                            ]
                          ]
                        ]
                      ]
                    ]
                  }
                ]
              ],
              [
                "Attribute",
                "error_message",
                [
                  "String",
                  "Maintenance window day must be one of: MON, TUE, WED, THU, FRI, SAT, SUN"
                ]
              ]
            ]
          }
        ]
      ]
    }
  ],
