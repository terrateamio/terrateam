                              ]
                            ],
                            "then_": [ "Bool", true ],
                            "else_": [
                              "Log_and",
                              [
                                [
                                  "Gte",
                                  [
                                    [
                                      "Attr",
                                      [
                                        [
                                          "Attr",
                                          [
                                            [ "Id", "var" ],
                                            [
