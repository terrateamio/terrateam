        ],
        [
          "Attribute",
          "type",
          [
            "Fun_call",
            [
              "object",
              [
                [
                  "Object",
                  [
                    [ [ "Bare", "disk_size_limit" ], [ "Id", "number" ] ],
                    [
                      [ "Bare", "planned_usage_threshold" ],
                      [ "Fun_call", [ "optional", [ [ "Id", "number" ] ] ] ]
                    ],
                    [
                      [ "Bare", "emergency_usage_threshold" ],
                      [ "Fun_call", [ "optional", [ [ "Id", "number" ] ] ] ]
                    ]
                  ]
                ]
              ]
            ]
          ]
        ],
        [ "Attribute", "default", [ "Null" ] ],
        [
          "Block",
          {
            "type_": "validation",
            "labels": [],
            "body": [
              [
                "Attribute",
                "condition",
                [
                  "Cond",
                  {
                    "if_": [
                      "Equal",
                      [
                        [
                          "Attr",
                          [
                            [ "Id", "var" ],
                            [ "A_string", "disk_size_autoscaling" ]
                          ]
                        ],
                        [ "Null" ]
                      ]
                    ],
                    "then_": [ "Bool", true ],
                    "else_": [
                      "Log_and",
                      [
                        [
                          "Log_and",
                          [
                            [
                              "Gte",
                              [
                                [
                                  "Attr",
                                  [
                                    [
                                      "Attr",
                                      [
                                        [ "Id", "var" ],
                                        [
                                          "A_string", "disk_size_autoscaling"
                                        ]
                                      ]
                                    ],
                                    [ "A_string", "disk_size_limit" ]
                                  ]
                                ],
                                [ "Int", 10 ]
                              ]
                            ],
                            [
                              "Cond",
                              {
                                "if_": [
                                  "Equal",
                                  [
                                    [
                                      "Attr",
                                      [
                                        [
                                          "Attr",
                                          [
                                            [ "Id", "var" ],
                                            [
                                              "A_string",
                                              "disk_size_autoscaling"
                                            ]
                                          ]
                                        ],
                                        [
                                          "A_string",
                                          "planned_usage_threshold"
                                        ]
                                      ]
                                    ],
                                    [ "Null" ]
                                  ]
                                ],
                                "then_": [ "Bool", true ],
                                "else_": [
                                  "Log_and",
                                  [
                                    [
                                      "Gte",
                                      [
                                        [
                                          "Attr",
                                          [
                                            [
                                              "Attr",
                                              [
                                                [ "Id", "var" ],
                                                [
                                                  "A_string",
                                                  "disk_size_autoscaling"
                                                ]
                                              ]
                                            ],
                                            [
                                              "A_string",
                                              "planned_usage_threshold"
                                            ]
                                          ]
                                        ],
                                        [ "Int", 0 ]
                                      ]
                                    ],
                                    [
                                      "Lte",
                                      [
                                        [
                                          "Attr",
                                          [
                                            [
                                              "Attr",
                                              [
                                                [ "Id", "var" ],
                                                [
                                                  "A_string",
                                                  "disk_size_autoscaling"
                                                ]
                                              ]
                                            ],
                                            [
                                              "A_string",
                                              "planned_usage_threshold"
                                            ]
                                          ]
                                        ],
                                        [ "Int", 100 ]
                                      ]
                                    ]
                                  ]
                                ]
                              }
                            ]
                          ]
                        ],
                        [
                          "Cond",
                          {
                            "if_": [
                              "Equal",
                              [
                                [
                                  "Attr",
                                  [
                                    [
                                      "Attr",
                                      [
                                        [ "Id", "var" ],
                                        [
                                          "A_string", "disk_size_autoscaling"
                                        ]
                                      ]
                                    ],
                                    [
                                      "A_string", "emergency_usage_threshold"
                                    ]
                                  ]
                                ],
