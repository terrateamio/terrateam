  ],
  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "topics" ] ],
      "body": [
        [
          "Attribute",
          "description",
          [
            "Heredoc",
            [
              "EOF",
              "\n    (Required) This is a list of Kafka topics to create.\n\n    Required values:\n      - name               - The name of the topic.\n      - partitions         - The number of partitions for the topic.\n      - replication_factor - The replication factor for the topic.\n\n    Optional values:\n      - config             - Configuration settings for the topic. The list is documented below.\n        - cleanup_policy        - (Optional) The cleanup policy for the topic. Allowed values: `CLEANUP_POLICY_DELETE`, `CLEANUP_POLICY_COMPACT`, `CLEANUP_POLICY_COMPACT_AND_DELETE`.\n        - compression_type      - (Optional) The compression type for the topic. Allowed values: `COMPRESSION_TYPE_SNAPPY`, `COMPRESSION_TYPE_GZIP`, `COMPRESSION_TYPE_PRODUCER`, `COMPRESSION_TYPE_UNCOMPRESSED`, `COMPRESSION_TYPE_ZSTD`, `COMPRESSION_TYPE_LZ4`.\n        - delete_retention_ms   - (Optional) The time to retain delete tombstone markers for log compacted topics.\n        - file_delete_delay_ms  - (Optional) The time to wait before deleting a file from the filesystem.\n        - flush_messages        - (Optional) The number of messages accumulated on a log partition before messages are flushed to disk.\n        - flush_ms              - (Optional) The maximum time in milliseconds that a message in any topic is kept in memory before flushed to disk.\n        - min_compaction_lag_ms - (Optional) The minimum time a message will remain uncompacted in the log.\n        - retention_bytes       - (Optional) The maximum size a partition can grow to before Kafka will discard old log segments to free up space.\n        - retention_ms          - (Optional) The maximum time Kafka will retain messages in a topic.\n        - max_message_bytes     - (Optional) The largest record batch size allowed by Kafka.\n        - min_insync_replicas   - (Optional) The minimum number of replicas that must acknowledge a write for the write to be considered successful.\n        - segment_bytes         - (Optional) The maximum size of a single log file.\n        - preallocate           - (Optional) Whether to preallocate the file on disk.\n        - message_timestamp_type - (Optional) Timestamp type. Allowed values: `MESSAGE_TIMESTAMP_TYPE_CREATE_TIME`, `MESSAGE_TIMESTAMP_TYPE_LOG_APPEND_TIME`.\n"
            ]
          ]
        ],
        [
          "Attribute",
          "type",
          [
            "Fun_call",
            [
              "list",
              [
                [
                  "Fun_call",
                  [
                    "object",
                    [
                      [
                        "Object",
                        [
                          [ [ "Bare", "name" ], [ "Id", "string" ] ],
                          [ [ "Bare", "partitions" ], [ "Id", "number" ] ],
                          [
                            [ "Bare", "replication_factor" ],
                            [ "Id", "number" ]
                          ],
                          [
                            [ "Bare", "config" ],
                            [
                              "Fun_call",
                              [
                                "optional",
                                [
                                  [
                                    "Fun_call",
                                    [
                                      "object",
                                      [
                                        [
                                          "Object",
                                          [
                                            [
                                              [ "Bare", "cleanup_policy" ],
                                              [
                                                "Fun_call",
                                                [
                                                  "optional",
                                                  [
                                                    [ "Id", "string" ],
                                                    [
                                                      "String",
                                                      "CLEANUP_POLICY_DELETE"
                                                    ]
                                                  ]
                                                ]
                                              ]
                                            ],
                                            [
                                              [ "Bare", "compression_type" ],
                                              [
                                                "Fun_call",
                                                [
                                                  "optional",
                                                  [
                                                    [ "Id", "string" ],
                                                    [
                                                      "String",
                                                      "COMPRESSION_TYPE_PRODUCER"
                                                    ]
                                                  ]
                                                ]
                                              ]
                                            ],
                                            [
                                              [
                                                "Bare", "delete_retention_ms"
                                              ],
                                              [
                                                "Fun_call",
                                                [
                                                  "optional",
                                                  [
                                                    [ "Id", "number" ],
                                                    [ "Int", 86400000 ]
                                                  ]
                                                ]
                                              ]
                                            ],
                                            [
                                              [
                                                "Bare",
                                                "file_delete_delay_ms"
                                              ],
                                              [
                                                "Fun_call",
                                                [
                                                  "optional",
                                                  [
                                                    [ "Id", "number" ],
                                                    [ "Int", 60000 ]
                                                  ]
                                                ]
                                              ]
                                            ],
                                            [
                                              [ "Bare", "flush_messages" ],
                                              [
                                                "Fun_call",
                                                [
                                                  "optional",
                                                  [
                                                    [ "Id", "number" ],
                                                    [
                                                      "Float",
                                                      9.223372036854776e+18
                                                    ]
                                                  ]
                                                ]
                                              ]
                                            ],
                                            [
                                              [ "Bare", "flush_ms" ],
                                              [
                                                "Fun_call",
                                                [
                                                  "optional",
                                                  [
                                                    [ "Id", "number" ],
                                                    [
                                                      "Float",
                                                      9.223372036854776e+18
                                                    ]
                                                  ]
                                                ]
                                              ]
                                            ],
                                            [
                                              [
                                                "Bare",
                                                "min_compaction_lag_ms"
                                              ],
                                              [
                                                "Fun_call",
                                                [
                                                  "optional",
                                                  [
                                                    [ "Id", "number" ],
                                                    [ "Int", 0 ]
                                                  ]
                                                ]
                                              ]
                                            ],
                                            [
                                              [ "Bare", "retention_bytes" ],
                                              [
                                                "Fun_call",
                                                [
                                                  "optional",
                                                  [
                                                    [ "Id", "number" ],
                                                    [ "Minus", [ "Int", 1 ] ]
                                                  ]
                                                ]
                                              ]
                                            ],
                                            [
                                              [ "Bare", "retention_ms" ],
                                              [
                                                "Fun_call",
                                                [
                                                  "optional",
                                                  [
                                                    [ "Id", "number" ],
                                                    [ "Int", 604800000 ]
                                                  ]
                                                ]
                                              ]
                                            ],
                                            [
                                              [ "Bare", "max_message_bytes" ],
                                              [
                                                "Fun_call",
                                                [
                                                  "optional",
                                                  [
                                                    [ "Id", "number" ],
                                                    [ "Int", 1048588 ]
                                                  ]
                                                ]
                                              ]
                                            ],
                                            [
                                              [
                                                "Bare", "min_insync_replicas"
                                              ],
                                              [
                                                "Fun_call",
                                                [
                                                  "optional",
                                                  [
                                                    [ "Id", "number" ],
                                                    [ "Int", 1 ]
                                                  ]
                                                ]
                                              ]
                                            ],
                                            [
                                              [ "Bare", "segment_bytes" ],
                                              [
                                                "Fun_call",
                                                [
                                                  "optional",
                                                  [
                                                    [ "Id", "number" ],
                                                    [ "Int", 1073741824 ]
                                                  ]
                                                ]
                                              ]
                                            ],
                                            [
                                              [ "Bare", "preallocate" ],
                                              [
                                                "Fun_call",
                                                [
                                                  "optional",
                                                  [
                                                    [ "Id", "bool" ],
                                                    [ "Bool", false ]
                                                  ]
                                                ]
                                              ]
                                            ],
                                            [
                                              [
                                                "Bare",
                                                "message_timestamp_type"
                                              ],
                                              [
                                                "Fun_call",
                                                [
                                                  "optional",
                                                  [
                                                    [ "Id", "string" ],
                                                    [
                                                      "String",
                                                      "MESSAGE_TIMESTAMP_TYPE_CREATE_TIME"
                                                    ]
                                                  ]
                                                ]
                                              ]
                                            ]
                                          ]
                                        ]
                                      ]
                                    ]
                                  ],
                                  [ "Null" ]
                                ]
                              ]
                            ]
                          ]
                        ]
                      ]
                    ]
                  ]
                ]
              ]
            ]
          ]
        ],
        [ "Attribute", "default", [ "Tuple", [] ] ]
      ]
    }
  ],
