            ]
          ]
        ],
        [
          "Block",
          {
            "type_": "validation",
            "labels": [],
            "body": [
              [
                "Attribute",
                "condition",
                [
                  "Fun_call",
                  [
                    "alltrue",
                    [
                      [
                        "For_tuple",
                        {
                          "identifiers": [ "group_name", [ "group" ] ],
                          "input": [
                            "Attr",
                            [
                              [ "Id", "var" ],
                              [ "A_string", "dashboard_nodes" ]
                            ]
                          ],
                          "output": [
                            "Log_and",
                            [
                              [
                                "Log_and",
                                [
                                  [
                                    "Log_and",
                                    [
                                      [
                                        "Log_and",
                                        [
                                          [
                                            "Log_and",
                                            [
