                          [ "String", "TUE" ],
                          [ "String", "WED" ],
                          [ "String", "THU" ],
                          [ "String", "FRI" ],
                          [ "String", "SAT" ],
                          [ "String", "SUN" ]
                        ]
                      ],
                      [
                        "Attr",
                        [
                          [ "Id", "var" ],
                          [ "A_string", "maintenance_window_day" ]
                        ]
                      ]
                    ]
                  ]
                ]
