  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "disk_encryption_key_id" ] ],
      "body": [
        [
          "Attribute",
          "description",
          [
            "String",
            "ID of the KMS key for cluster disk encryption. If not specified, encryption will be disabled."
          ]
        ],
        [ "Attribute", "type", [ "Id", "string" ] ],
        [ "Attribute", "default", [ "Null" ] ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "maintenance_window_type" ] ],
      "body": [
        [
          "Attribute",
          "description",
          [
            "String",
            "The type of maintenance window for the OpenSearch cluster. ANYTIME allows maintenance at any time, WEEKLY requires specifying a specific day and hour."
          ]
        ],
        [ "Attribute", "type", [ "Id", "string" ] ],
        [
          "Block",
          {
            "type_": "validation",
            "labels": [],
            "body": [
              [
                "Attribute",
                "condition",
                [
                  "Fun_call",
                  [
                    "contains",
                    [
                      [
                        "Tuple",
                        [ [ "String", "ANYTIME" ], [ "String", "WEEKLY" ] ]
                      ],
                      [
                        "Attr",
                        [
                          [ "Id", "var" ],
                          [ "A_string", "maintenance_window_type" ]
                        ]
                      ]
                    ]
                  ]
                ]
              ],
              [
                "Attribute",
                "error_message",
                [
                  "String",
                  "Available values are \"ANYTIME\", \"WEEKLY\" (case sensitive)."
                ]
              ]
            ]
          }
        ],
        [ "Attribute", "default", [ "String", "ANYTIME" ] ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "maintenance_window_hour" ] ],
      "body": [
        [
          "Attribute",
          "description",
          [
            "String",
            "The hour of day in UTC time zone (0-24) for the weekly maintenance window. Only used when maintenance_window_type is WEEKLY."
          ]
        ],
        [ "Attribute", "type", [ "Id", "number" ] ],
        [
          "Block",
          {
            "type_": "validation",
            "labels": [],
            "body": [
              [
                "Attribute",
                "condition",
                [
                  "Log_and",
                  [
                    [
                      "Gte",
                      [
                        [
                          "Attr",
                          [
                            [ "Id", "var" ],
                            [ "A_string", "maintenance_window_hour" ]
                          ]
                        ],
                        [ "Int", 0 ]
                      ]
                    ],
                    [
                      "Lte",
                      [
                        [
                          "Attr",
                          [
                            [ "Id", "var" ],
                            [ "A_string", "maintenance_window_hour" ]
                          ]
                        ],
                        [ "Int", 24 ]
                      ]
                    ]
                  ]
                ]
              ],
              [
                "Attribute",
                "error_message",
                [
                  "String",
                  "The variable must be a number between 0 and 24 (inclusive)."
                ]
              ]
            ]
          }
        ],
        [ "Attribute", "default", [ "Null" ] ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "maintenance_window_day" ] ],
      "body": [
        [
          "Attribute",
          "description",
          [
            "String",
            "The day of the week for the weekly maintenance window. Only used when maintenance_window_type is WEEKLY."
          ]
        ],
        [ "Attribute", "type", [ "Id", "string" ] ],
        [
          "Block",
          {
            "type_": "validation",
            "labels": [],
            "body": [
