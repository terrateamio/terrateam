                          [ [ "Bare", "hosts_count" ], [ "Id", "number" ] ],
                          [
                            [ "Bare", "zones_ids" ],
                            [
                              "Fun_call",
                              [
                                "optional",
                                [
                                  [
                                    "Fun_call",
                                    [ "list", [ [ "Id", "string" ] ] ]
                                  ],
                                  [
                                    "Tuple",
                                    [
                                      [ "String", "ru-central1-a" ],
                                      [ "String", "ru-central1-b" ],
                                      [ "String", "ru-central1-d" ]
                                    ]
                                  ]
                                ]
                              ]
