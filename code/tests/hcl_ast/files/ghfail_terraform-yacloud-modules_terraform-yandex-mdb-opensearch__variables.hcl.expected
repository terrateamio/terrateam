                "Attribute",
                "error_message",
                [
                  "String",
                  "Available values are \"MON\", \"TUE\", \"WED\", \"THU\", \"FRI\", \"SAT\", \"SUN\" (case sensitive)."
                ]
              ]
            ]
          }
        ],
        [ "Attribute", "default", [ "Null" ] ]
      ]
    }
  ],
