[
  [
    "Block",
    {
      "type_": "resource",
      "labels": [ [ "Lit", "aws_route53_zone" ], [ "Lit", "covidportal" ] ],
      "body": [
        [
          "Attribute",
          "name",
          [
            "Attr", [ [ "Id", "var" ], [ "A_string", "route53_zone_name" ] ]
          ]
        ],
        [
          "Attribute",
          "tags",
          [
            "Object",
            [
              [
                [
                  "Computed",
                  [
                    "Attr",
                    [ [ "Id", "var" ], [ "A_string", "billing_tag_key" ] ]
                  ]
                ],
                [
                  "Attr",
                  [ [ "Id", "var" ], [ "A_string", "billing_tag_value" ] ]
                ]
              ]
            ]
          ]
        ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "resource",
      "labels": [ [ "Lit", "aws_route53_record" ], [ "Lit", "covidportal" ] ],
      "body": [
        [
          "Attribute",
          "zone_id",
          [
            "Attr",
            [
              [
                "Attr",
                [
                  [ "Id", "aws_route53_zone" ], [ "A_string", "covidportal" ]
                ]
              ],
              [ "A_string", "zone_id" ]
            ]
          ]
        ],
        [
          "Attribute",
          "name",
          [
            "Template",
            [
              [ "Literal", "staging." ],
              [
                "Interpolation",
                {
                  "expr": [
                    "Attr",
                    [
                      [
                        "Attr",
                        [
                          [ "Id", "aws_route53_zone" ],
                          [ "A_string", "covidportal" ]
                        ]
                      ],
                      [ "A_string", "name" ]
                    ]
                  ],
                  "strip_before": false,
                  "strip_after": false
                }
              ]
            ]
          ]
        ],
        [ "Attribute", "type", [ "String", "CNAME" ] ],
        [ "Attribute", "ttl", [ "Int", 300 ] ],
        [
          "Attribute",
          "records",
          [
            "Tuple",
            [
              [
                "Template",
                [
                  [
                    "Interpolation",
                    {
                      "expr": [
                        "Attr",
                        [
                          [
                            "Attr",
                            [
                              [ "Id", "aws_lb" ],
                              [ "A_string", "covidportal" ]
                            ]
                          ],
                          [ "A_string", "dns_name" ]
                        ]
                      ],
                      "strip_before": false,
