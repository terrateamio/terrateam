                                      [
                                        [
                                          "Object",
                                          [
                                            [
                                              [ "Bare", "enabled" ],
                                              [
                                                "Fun_call",
                                                [
                                                  "optional",
                                                  [
                                                    [ "Id", "bool" ],
                                                    [ "Bool", false ]
                                                  ]
