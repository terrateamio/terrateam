[
  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "name" ] ],
      "body": [
        [
          "Attribute",
          "description",
          [
            "String",
            "(Required) The name of the SNS topic. Topic names must be made up of only uppercase and lowercase ASCII letters, numbers, underscores, and hyphens, and must be between 1 and 256 characters long."
          ]
        ],
        [ "Attribute", "type", [ "Id", "string" ] ],
        [ "Attribute", "nullable", [ "Bool", false ] ],
        [
          "Block",
          {
            "type_": "validation",
            "labels": [],
            "body": [
              [
                "Attribute",
                "condition",
                [
                  "Not",
                  [
                    "Fun_call",
                    [
                      "endswith",
                      [
                        [
                          "Attr", [ [ "Id", "var" ], [ "A_string", "name" ] ]
                        ],
                        [ "String", ".fifo" ]
                      ]
                    ]
                  ]
                ]
              ],
              [
                "Attribute",
                "error_message",
                [
                  "String",
                  "For a FIFO topic, the name must end with the `.fifo` suffix."
                ]
              ]
            ]
          }
        ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "display_name" ] ],
      "body": [
        [
          "Attribute",
          "description",
          [
            "String",
            "(Optional) The display name to use for a topic with SMS subscriptions."
          ]
        ],
        [ "Attribute", "type", [ "Id", "string" ] ],
        [ "Attribute", "default", [ "String", "" ] ],
        [ "Attribute", "nullable", [ "Bool", false ] ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "policy" ] ],
      "body": [
        [
          "Attribute",
          "description",
          [
            "String",
            "(Optional) A valid policy JSON document. The resource-based policy defines who can publish or subscribe to the SNS topic."
          ]
        ],
        [ "Attribute", "type", [ "Id", "string" ] ],
        [ "Attribute", "default", [ "Null" ] ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "data_protection_policy" ] ],
      "body": [
        [
          "Attribute",
          "description",
          [
            "String",
            "(Optional) A valid policy JSON document. The data protection policy defines your own rules and policies to audit and control the content for data in motion, as opposed to data at rest."
          ]
        ],
        [ "Attribute", "type", [ "Id", "string" ] ],
        [ "Attribute", "default", [ "Null" ] ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "delivery_policy" ] ],
      "body": [
        [
          "Attribute",
          "description",
          [ "String", "(Optional) The SNS delivery policy." ]
        ],
        [ "Attribute", "type", [ "Id", "string" ] ],
        [ "Attribute", "default", [ "Null" ] ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "subscriptions_by_email" ] ],
      "body": [
        [
          "Attribute",
          "description",
          [
            "Heredoc",
            [
              "EOF",
              "\n  (Optional) A configuration for email subscriptions to the SNS topic. Deliver messages to the subscriber via SMTP. Until the subscription is confirmed, AWS does not allow Terraform to delete / unsubscribe the subscription. If you destroy an unconfirmed subscription, Terraform will remove the subscription from its state but the subscription will still exist in AWS. Each block of `subscriptions_by_email` as defined below.\n    (Required) `email` - An email address that can receive notifications from the SNS topic.\n    (Optional) `filter_policy` - The configuration to filter the messages that a subscriber receives. Additions or changes to the filter policy require up to 15 minutes to fully take effect. `filter_policy` as defined below.\n      (Optional) `enabled` - Whether to enable the filter policy. Defaults to `false`.\n      (Optional) `scope` - Determine how the filter policy will be applied to the message.\n  Valid values are `ATTRIBUTES` and `BODY`. Defaults to `ATTRIBUTES`.\n        `ATTRIBUTES` - The filter policy will be applied to the message attributes.\n        `BODY` - The filter policy will be applied to the message body.\n    (Optional) `redrive_policy` - The configuration to send undeliverable messages to a dead-letter queue. `redrive_policy` as defined below.\n      (Optional) `dead_letter_sqs_queue` - The ARN of the SQS queue to which Amazon SNS can send undeliverable messages.\n"
            ]
          ]
        ],
        [
          "Attribute",
          "type",
          [
            "Fun_call",
            [
              "list",
              [
                [
                  "Fun_call",
                  [
                    "object",
                    [
                      [
                        "Object",
                        [
                          [ [ "Bare", "email" ], [ "Id", "string" ] ],
                          [
                            [ "Bare", "filter_policy" ],
                            [
                              "Fun_call",
                              [
                                "optional",
                                [
                                  [
                                    "Fun_call",
                                    [
                                      "object",
                                      [
                                        [
                                          "Object",
                                          [
                                            [
                                              [ "Bare", "enabled" ],
                                              [
                                                "Fun_call",
                                                [
                                                  "optional",
                                                  [
                                                    [ "Id", "bool" ],
                                                    [ "Bool", false ]
                                                  ]
                                                ]
                                              ]
                                            ],
                                            [
                                              [ "Bare", "scope" ],
                                              [
                                                "Fun_call",
                                                [
                                                  "optional",
                                                  [
                                                    [ "Id", "string" ],
                                                    [
                                                      "String", "ATTRIBUTES"
                                                    ]
                                                  ]
                                                ]
                                              ]
                                            ],
                                            [
                                              [ "Bare", "policy" ],
                                              [
                                                "Fun_call",
                                                [
                                                  "optional",
                                                  [ [ "Id", "string" ] ]
                                                ]
                                              ]
                                            ]
                                          ]
                                        ]
                                      ]
                                    ]
                                  ],
                                  [ "Object", [] ]
                                ]
                              ]
                            ]
                          ],
                          [
                            [ "Bare", "redrive_policy" ],
                            [
                              "Fun_call",
                              [
                                "optional",
                                [
                                  [
                                    "Fun_call",
                                    [
                                      "object",
                                      [
                                        [
                                          "Object",
                                          [
                                            [
                                              [
                                                "Bare",
                                                "dead_letter_sqs_queue"
                                              ],
                                              [
                                                "Fun_call",
                                                [
                                                  "optional",
                                                  [ [ "Id", "string" ] ]
                                                ]
                                              ]
                                            ]
                                          ]
                                        ]
                                      ]
                                    ]
                                  ],
                                  [ "Object", [] ]
                                ]
                              ]
                            ]
                          ]
                        ]
                      ]
                    ]
                  ]
                ]
              ]
            ]
          ]
        ],
        [ "Attribute", "default", [ "Tuple", [] ] ],
        [ "Attribute", "nullable", [ "Bool", false ] ],
        [
          "Block",
          {
            "type_": "validation",
            "labels": [],
            "body": [
              [
                "Attribute",
                "condition",
                [
                  "Fun_call",
                  [
                    "alltrue",
                    [
                      [
                        "For_tuple",
                        {
                          "identifiers": [ "subscription", [] ],
                          "input": [
                            "Attr",
                            [
                              [ "Id", "var" ],
                              [ "A_string", "subscriptions_by_email" ]
                            ]
                          ],
                          "output": [
                            "Fun_call",
                            [
                              "contains",
                              [
                                [
                                  "Tuple",
                                  [
                                    [ "String", "ATTRIBUTES" ],
                                    [ "String", "BODY" ]
                                  ]
                                ],
                                [
                                  "Attr",
                                  [
                                    [
                                      "Attr",
                                      [
                                        [ "Id", "subscription" ],
                                        [ "A_string", "filter_policy" ]
                                      ]
                                    ],
                                    [ "A_string", "scope" ]
                                  ]
                                ]
                              ]
                            ]
                          ],
                          "cond": [
                            "Attr",
                            [
                              [
                                "Attr",
                                [
                                  [ "Id", "subscription" ],
                                  [ "A_string", "filter_policy" ]
                                ]
                              ],
                              [ "A_string", "enabled" ]
                            ]
                          ]
                        }
                      ]
                    ]
                  ]
                ]
              ],
              [
                "Attribute",
                "error_message",
                [
                  "String",
                  "Valid values for `filter_policy.scope` are `ATTRIBUTES` and `BODY`."
                ]
              ]
            ]
          }
        ],
        [
          "Block",
          {
            "type_": "validation",
            "labels": [],
            "body": [
              [
                "Attribute",
                "condition",
                [
                  "Fun_call",
                  [
                    "alltrue",
                    [
                      [
                        "For_tuple",
                        {
                          "identifiers": [ "subscription", [] ],
                          "input": [
                            "Attr",
                            [
                              [ "Id", "var" ],
                              [ "A_string", "subscriptions_by_email" ]
                            ]
                          ],
                          "output": [
                            "Log_or",
                            [
                              [
                                "Equal",
                                [
                                  [
                                    "Attr",
                                    [
                                      [
                                        "Attr",
                                        [
                                          [ "Id", "subscription" ],
                                          [ "A_string", "filter_policy" ]
                                        ]
                                      ],
                                      [ "A_string", "policy" ]
                                    ]
                                  ],
                                  [ "Null" ]
                                ]
                              ],
                              [
                                "Fun_call",
                                [
                                  "can",
                                  [
                                    [
                                      "Fun_call",
                                      [
                                        "jsondecode",
                                        [
                                          [
                                            "Attr",
                                            [
                                              [
                                                "Attr",
                                                [
                                                  [ "Id", "subscription" ],
                                                  [
                                                    "A_string",
                                                    "filter_policy"
                                                  ]
                                                ]
                                              ],
                                              [ "A_string", "policy" ]
                                            ]
                                          ]
                                        ]
                                      ]
                                    ]
                                  ]
                                ]
                              ]
                            ]
                          ],
                          "cond": [
                            "Attr",
                            [
                              [
                                "Attr",
                                [
                                  [ "Id", "subscription" ],
                                  [ "A_string", "filter_policy" ]
                                ]
                              ],
                              [ "A_string", "enabled" ]
                            ]
                          ]
                        }
                      ]
                    ]
                  ]
                ]
              ],
              [
                "Attribute",
                "error_message",
                [ "String", "`filter_policy.policy` must be JSON string." ]
              ]
            ]
          }
        ]
      ]
    }
  ],
