  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "subscriptions_by_sqs" ] ],
      "body": [
        [
          "Attribute",
          "description",
          [
            "Heredoc",
            [
              "EOF",
              "\n  (Optional) A configuration for SQS Queue subscriptions to the SNS topic. Deliver JSON-encoded messages to the SQS queue. Each block of `subscriptions_by_sqs` as defined below.\n    (Required) `name` - The name of the subscription to the SNS topic. This value is only used internally within Terraform code.\n    (Required) `queue` - The ARN of the AWS SQS queue that can receive notifications from the SNS topic.\n    (Optional) `raw_message_delivery_enabled` - Whether to enable raw message delivery. Raw messages are free of JSON formatting. Defaults to `false`.\n    (Optional) `filter_policy` - The configuration to filter the messages that a subscriber receives. Additions or changes to the filter policy require up to 15 minutes to fully take effect. `filter_policy` as defined below.\n      (Optional) `enabled` - Whether to enable the filter policy. Defaults to `false`.\n      (Optional) `scope` - Determine how the filter policy will be applied to the message.\n  Valid values are `ATTRIBUTES` and `BODY`. Defaults to `ATTRIBUTES`.\n        `ATTRIBUTES` - The filter policy will be applied to the message attributes.\n        `BODY` - The filter policy will be applied to the message body.\n    (Optional) `redrive_policy` - The configuration to send undeliverable messages to a dead-letter queue. `redrive_policy` as defined below.\n      (Optional) `dead_letter_sqs_queue` - The ARN of the SQS queue to which Amazon SNS can send undeliverable messages.\n"
            ]
          ]
        ],
        [
          "Attribute",
          "type",
          [
            "Fun_call",
            [
              "list",
              [
                [
                  "Fun_call",
                  [
                    "object",
                    [
                      [
                        "Object",
                        [
                          [ [ "Bare", "name" ], [ "Id", "string" ] ],
                          [ [ "Bare", "queue" ], [ "Id", "string" ] ],
                          [
                            [ "Bare", "raw_message_delivery_enabled" ],
                            [
                              "Fun_call",
                              [
                                "optional",
                                [ [ "Id", "bool" ], [ "Bool", false ] ]
                              ]
                            ]
                          ],
                          [
                            [ "Bare", "filter_policy" ],
                            [
