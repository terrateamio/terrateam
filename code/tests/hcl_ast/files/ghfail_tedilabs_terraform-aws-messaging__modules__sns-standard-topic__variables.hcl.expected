  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "xray_tracing_enabled" ] ],
      "body": [
        [
          "Attribute",
          "description",
          [
            "String",
            "(Optional) Whether to activate AWS X-Ray Active Tracing mode for the SNS topic. If set to Active, Amazon SNS will vend X-Ray segment data to topic owner account if the sampled flag in the tracing header is true. Defaults to `false`, and the topic passes through the tracing header it receives from an Amazon SNS publisher to its subscriptions."
          ]
        ],
        [ "Attribute", "type", [ "Id", "bool" ] ],
        [ "Attribute", "default", [ "Bool", false ] ],
        [ "Attribute", "nullable", [ "Bool", false ] ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "signature_version" ] ],
      "body": [
        [
          "Attribute",
          "description",
          [
            "String",
            "(Optional) The signature version corresponds to the hashing algorithm used while creating the signature of the notifications, subscription confirmations, or unsubscribe confirmation messages sent by Amazon SNS. Defaults to `1`."
          ]
        ],
        [ "Attribute", "type", [ "Id", "number" ] ],
        [ "Attribute", "default", [ "Int", 1 ] ],
        [ "Attribute", "nullable", [ "Bool", false ] ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "encryption_at_rest" ] ],
      "body": [
        [
          "Attribute",
          "description",
          [
            "Heredoc",
            [
              "EOF",
              "\n  (Optional) A configuration to encrypt at rest in the SNS topic. Amazon SNS provides in-transit encryption by default. Enabling server-side encryption adds at-rest encryption to your topic. Amazon SNS encrypts your message as soon as it is received. The message is decrypted immediately prior to delivery. `encryption_at_rest` as defined below.\n    (Optional) `enabled` - Whether to enable encryption at rest. Defaults to `false`.\n    (Optional) `kms_key` - The ID of AWS KMS CMK (Customer Master Key) used for the encryption.\n"
            ]
          ]
        ],
        [
          "Attribute",
          "type",
          [
            "Fun_call",
            [
              "object",
              [
                [
                  "Object",
                  [
                    [
                      [ "Bare", "enabled" ],
                      [
                        "Fun_call",
                        [
                          "optional", [ [ "Id", "bool" ], [ "Bool", false ] ]
                        ]
                      ]
                    ],
                    [
                      [ "Bare", "kms_key" ],
                      [ "Fun_call", [ "optional", [ [ "Id", "string" ] ] ] ]
                    ]
                  ]
                ]
              ]
            ]
          ]
        ],
        [ "Attribute", "default", [ "Object", [] ] ],
        [ "Attribute", "nullable", [ "Bool", false ] ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "tags" ] ],
      "body": [
        [
          "Attribute",
          "description",
          [ "String", "(Optional) A map of tags to add to all resources." ]
        ],
        [
          "Attribute",
          "type",
          [ "Fun_call", [ "map", [ [ "Id", "string" ] ] ] ]
        ],
        [ "Attribute", "default", [ "Object", [] ] ],
        [ "Attribute", "nullable", [ "Bool", false ] ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "module_tags_enabled" ] ],
      "body": [
        [
          "Attribute",
          "description",
          [
            "String",
            "(Optional) Whether to create AWS Resource Tags for the module informations."
          ]
        ],
        [ "Attribute", "type", [ "Id", "bool" ] ],
        [ "Attribute", "default", [ "Bool", true ] ],
        [ "Attribute", "nullable", [ "Bool", false ] ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "resource_group" ] ],
      "body": [
        [
          "Attribute",
          "description",
          [
            "Heredoc",
            [
              "EOF",
              "\n  (Optional) A configurations of Resource Group for this module. `resource_group` as defined below.\n    (Optional) `enabled` - Whether to create Resource Group to find and group AWS resources which are created by this module. Defaults to `true`.\n    (Optional) `name` - The name of Resource Group. A Resource Group name can have a maximum of 127 characters, including letters, numbers, hyphens, dots, and underscores. The name cannot start with `AWS` or `aws`. If not provided, a name will be generated using the module name and instance name.\n    (Optional) `description` - The description of Resource Group. Defaults to `Managed by Terraform.`.\n"
            ]
          ]
        ],
        [
          "Attribute",
          "type",
          [
            "Fun_call",
            [
              "object",
              [
                [
                  "Object",
                  [
                    [
                      [ "Bare", "enabled" ],
                      [
                        "Fun_call",
                        [
                          "optional", [ [ "Id", "bool" ], [ "Bool", true ] ]
                        ]
                      ]
                    ],
                    [
                      [ "Bare", "name" ],
                      [
                        "Fun_call",
                        [
                          "optional",
                          [ [ "Id", "string" ], [ "String", "" ] ]
                        ]
                      ]
                    ],
                    [
                      [ "Bare", "description" ],
                      [
                        "Fun_call",
                        [
                          "optional",
                          [
                            [ "Id", "string" ],
                            [ "String", "Managed by Terraform." ]
                          ]
                        ]
                      ]
                    ]
                  ]
                ]
              ]
            ]
          ]
        ],
        [ "Attribute", "default", [ "Object", [] ] ],
        [ "Attribute", "nullable", [ "Bool", false ] ]
      ]
    }
  ]
]
