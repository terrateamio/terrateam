                              ]
                            ],
                            [ "A_string", "service" ]
                          ]
                        ],
                        [ "A_string", "prefix" ]
                      ]
                    ],
                    [
                      "Attr", [ [ "Id", "host" ], [ "A_string", "netnum" ] ]
                    ]
                  ]
                ]
              ],
              "cond": null
            }
          ]
        ],
        [
          "Attribute",
          "apiserver_ip",
          [
            "Attr",
            [
              [
                "Attr",
                [
                  [
