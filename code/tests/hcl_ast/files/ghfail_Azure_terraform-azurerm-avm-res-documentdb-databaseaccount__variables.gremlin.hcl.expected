          }
        ],
        [
          "Block",
          {
            "type_": "validation",
            "labels": [],
            "body": [
              [
                "Attribute",
                "condition",
                [
                  "Fun_call",
                  [
                    "alltrue",
                    [
                      [
                        "For_tuple",
                        {
                          "identifiers": [ "key", [ "value" ] ],
                          "input": [
                            "Attr",
                            [
                              [ "Id", "var" ],
                              [ "A_string", "gremlin_databases" ]
                            ]
                          ],
                          "output": [
                            "Cond",
                            {
                              "if_": [
                                "Not_equal",
                                [
