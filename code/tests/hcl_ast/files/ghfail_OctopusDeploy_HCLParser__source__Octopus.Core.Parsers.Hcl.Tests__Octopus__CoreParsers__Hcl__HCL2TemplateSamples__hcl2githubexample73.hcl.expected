            "labels": [ [ "Lit", "s3" ] ],
            "body": [
              [
                "Attribute",
                "key",
                [ "String", "common/lambda/cloudwatch-log-destination" ]
              ],
              [ "Attribute", "encrypt", [ "Bool", true ] ]
            ]
          }
        ]
      ]
    }
  ],
  [
    "Block",
    {
