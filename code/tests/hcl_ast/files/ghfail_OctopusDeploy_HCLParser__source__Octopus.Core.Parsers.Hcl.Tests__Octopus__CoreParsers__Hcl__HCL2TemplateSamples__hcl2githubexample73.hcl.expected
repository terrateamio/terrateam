  ],
  [
    "Block",
    {
      "type_": "resource",
      "labels": [
        [ "Lit", "aws_cloudwatch_event_rule" ],
        [ "Lit", "subscription_filter" ]
      ],
      "body": [
        [
          "Attribute",
          "name",
          [ "String", "LogSubscriptionFilterModifications" ]
        ],
        [
          "Attribute",
          "description",
          [
            "String",
            "Captures when log groups are created or the subscription filters are modified"
          ]
        ],
        [
          "Attribute",
          "tags",
          [
            "Fun_call",
            [
              "merge",
              [
                [
                  "Attr",
                  [ [ "Id", "local" ], [ "A_string", "common_tags" ] ]
                ],
                [ "Attr", [ [ "Id", "var" ], [ "A_string", "tags" ] ] ]
              ]
            ]
          ]
        ],
        [
          "Attribute",
          "event_pattern",
          [
            "Heredoc",
            [
              "PATTERN",
              "\n{\n  \"source\": [\n    \"aws.logs\"\n  ],\n  \"detail-type\": [\n    \"AWS API Call via CloudTrail\"\n  ],\n  \"detail\": {\n    \"eventSource\": [\n      \"logs.amazonaws.com\"\n    ],\n    \"eventName\": [\n      \"CreateLogGroup\",\n      \"PutSubscriptionFilter\",\n      \"DeleteSubscriptionFilter\"\n    ]\n  }\n}\n"
            ]
          ]
        ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "resource",
      "labels": [
        [ "Lit", "aws_cloudwatch_event_target" ],
        [ "Lit", "subscription_lambda" ]
      ],
      "body": [
        [
          "Attribute",
          "rule",
          [
            "Attr",
            [
              [
                "Attr",
                [
                  [ "Id", "aws_cloudwatch_event_rule" ],
                  [ "A_string", "subscription_filter" ]
                ]
              ],
              [ "A_string", "name" ]
            ]
          ]
        ],
        [
          "Attribute",
          "arn",
          [
            "Attr",
            [
              [
                "Attr",
                [ [ "Id", "aws_lambda_function" ], [ "A_string", "lambda" ] ]
              ],
              [ "A_string", "arn" ]
            ]
          ]
        ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "resource",
      "labels": [
        [ "Lit", "aws_lambda_permission" ], [ "Lit", "allow_cloudwatch" ]
      ],
      "body": [
        [
          "Attribute",
          "statement_id",
          [
            "String", "AllowSubscriptionFilterLambdaExecutionFromCloudWatch"
