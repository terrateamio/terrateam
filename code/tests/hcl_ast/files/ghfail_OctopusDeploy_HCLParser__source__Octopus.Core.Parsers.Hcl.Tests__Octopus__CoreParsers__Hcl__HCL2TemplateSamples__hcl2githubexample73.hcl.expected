            "Template",
            [
              [ "Literal", "cloudwatch-log-destination" ],
              [
                "Interpolation",
                {
                  "expr": [
                    "Attr",
                    [ [ "Id", "var" ], [ "A_string", "lambda_version" ] ]
                  ],
                  "strip_before": false,
                  "strip_after": false
                }
              ],
              [ "Literal", ".zip" ]
            ]
          ]
        ],
        [ "Attribute", "publish", [ "Bool", true ] ],
        [
          "Attribute",
          "source_code_hash",
          [
            "Fun_call",
            [
              "filebase64sha256",
              [
                [
                  "Fun_call",
                  [
                    "format",
                    [
                      [ "String", "cloudwatch-log-destination%s.zip" ],
                      [
                        "Attr",
                        [ [ "Id", "var" ], [ "A_string", "lambda_version" ] ]
                      ]
                    ]
                  ]
                ]
              ]
            ]
          ]
        ],
        [
          "Block",
          {
            "type_": "environment",
            "labels": [],
            "body": [
              [
                "Attribute",
                "variables",
                [
                  "Object",
                  [
                    [
                      [ "Bare", "DESTINATION_ARN" ],
                      [
                        "Attr",
                        [
                          [
                            "Attr",
                            [
                              [
                                "Attr",
                                [
                                  [
                                    "Attr",
                                    [
                                      [ "Id", "data" ],
                                      [
                                        "A_string", "terraform_remote_state"
                                      ]
                                    ]
                                  ],
                                  [ "A_string", "master" ]
                                ]
                              ],
                              [ "A_string", "outputs" ]
                            ]
                          ],
                          [ "A_string", "log_destination_arn" ]
                        ]
                      ]
                    ]
                  ]
                ]
              ]
            ]
          }
        ],
        [
          "Attribute",
          "tags",
          [
            "Fun_call",
            [
              "merge",
              [
                [
