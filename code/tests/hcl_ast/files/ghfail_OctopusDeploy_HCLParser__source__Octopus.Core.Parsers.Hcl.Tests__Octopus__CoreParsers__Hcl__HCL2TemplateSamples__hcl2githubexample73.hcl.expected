        [
          "Attribute",
          "config",
          [
            "Object",
            [
              [ [ "Bare", "bucket" ], [ "String", "terraform.bhavik.io" ] ],
              [ [ "Bare", "key" ], [ "String", "common/master" ] ],
              [
                [ "Bare", "region" ],
                [
                  "Attr",
                  [ [ "Id", "var" ], [ "A_string", "aws_default_region" ] ]
                ]
              ],
              [
                [ "Bare", "profile" ],
                [ "Attr", [ [ "Id", "var" ], [ "A_string", "profile" ] ] ]
              ],
              [
                [ "Bare", "role_arn" ],
                [
                  "Template",
                  [
                    [ "Literal", "arn:aws:iam::" ],
                    [
                      "Interpolation",
                      {
                        "expr": [
                          "Attr",
                          [
                            [ "Id", "var" ],
                            [ "A_string", "operations_account_id" ]
                          ]
                        ],
                        "strip_before": false,
                        "strip_after": false
                      }
                    ],
                    [ "Literal", ":role/" ],
                    [
                      "Interpolation",
                      {
                        "expr": [
                          "Attr",
                          [ [ "Id", "var" ], [ "A_string", "role_name" ] ]
                        ],
                        "strip_before": false,
                        "strip_after": false
                      }
                    ]
                  ]
                ]
              ]
            ]
          ]
        ]
      ]
    }
  ],
  [
    "Block",
