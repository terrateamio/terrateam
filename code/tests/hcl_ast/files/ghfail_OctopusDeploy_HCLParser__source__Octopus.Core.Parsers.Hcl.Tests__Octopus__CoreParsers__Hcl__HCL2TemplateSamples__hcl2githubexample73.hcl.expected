                        ],
                        "strip_before": false,
                        "strip_after": false
                      }
                    ]
                  ]
                ]
              ],
              [ "Attribute", "session_name", [ "String", "terraform" ] ]
            ]
          }
        ]
      ]
    }
  ],
  [
    "Block",
    {
      "type_": "data",
      "labels": [
        [ "Lit", "aws_iam_policy_document" ], [ "Lit", "lambda_assume_role" ]
      ],
      "body": [
        [
          "Block",
          {
            "type_": "statement",
            "labels": [],
            "body": [
              [ "Attribute", "effect", [ "String", "Allow" ] ],
              [
                "Attribute",
                "actions",
                [ "Tuple", [ [ "String", "sts:AssumeRole" ] ] ]
              ],
              [
                "Block",
                {
                  "type_": "principals",
                  "labels": [],
                  "body": [
                    [ "Attribute", "type", [ "String", "Service" ] ],
                    [
                      "Attribute",
                      "identifiers",
                      [ "Tuple", [ [ "String", "lambda.amazonaws.com" ] ] ]
                    ]
                  ]
                }
              ]
            ]
          }
        ]
      ]
    }
  ],
  [
    "Block",
    {
