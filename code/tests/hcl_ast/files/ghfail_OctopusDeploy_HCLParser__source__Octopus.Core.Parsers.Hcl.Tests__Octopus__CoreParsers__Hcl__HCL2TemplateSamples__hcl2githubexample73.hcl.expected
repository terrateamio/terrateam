  ],
  [
    "Block",
    {
      "type_": "resource",
      "labels": [ [ "Lit", "aws_lambda_function" ], [ "Lit", "lambda" ] ],
      "body": [
        [
          "Attribute",
          "function_name",
          [ "String", "CloudWatchLogDestination" ]
        ],
        [
          "Attribute",
          "description",
          [ "String", "Sets the default cloudwatch log subscription filter" ]
        ],
        [
          "Attribute",
          "role",
          [
            "Attr",
            [
              [
                "Attr",
                [ [ "Id", "aws_iam_role" ], [ "A_string", "lambda" ] ]
              ],
              [ "A_string", "arn" ]
            ]
          ]
        ],
        [ "Attribute", "handler", [ "String", "main" ] ],
        [ "Attribute", "runtime", [ "String", "go1.x" ] ],
        [ "Attribute", "memory_size", [ "Int", 128 ] ],
        [
          "Attribute",
          "kms_key_arn",
          [
            "Attr",
            [
              [
                "Attr",
                [
                  [
                    "Attr",
                    [
                      [
                        "Attr",
                        [
                          [ "Id", "data" ],
                          [ "A_string", "terraform_remote_state" ]
                        ]
                      ],
                      [ "A_string", "master" ]
                    ]
                  ],
                  [ "A_string", "outputs" ]
                ]
              ],
              [ "A_string", "default_kms_key_arn" ]
            ]
          ]
        ],
        [
          "Attribute",
