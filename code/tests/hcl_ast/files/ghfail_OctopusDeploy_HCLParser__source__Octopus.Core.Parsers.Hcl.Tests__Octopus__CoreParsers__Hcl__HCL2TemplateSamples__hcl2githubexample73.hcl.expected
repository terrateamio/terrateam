        ],
        [
          "Attribute",
          "role",
          [
            "Attr",
            [
              [
                "Attr",
                [ [ "Id", "aws_iam_role" ], [ "A_string", "lambda" ] ]
              ],
              [ "A_string", "name" ]
            ]
          ]
        ],
        [
          "Attribute",
