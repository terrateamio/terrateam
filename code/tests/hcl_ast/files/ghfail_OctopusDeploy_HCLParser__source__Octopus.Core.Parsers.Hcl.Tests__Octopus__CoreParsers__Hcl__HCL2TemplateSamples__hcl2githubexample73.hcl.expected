          [
            "Attr",
            [ [ "Id", "var" ], [ "A_string", "log_retention_period" ] ]
          ]
        ],
        [
          "Attribute",
          "kms_key_id",
          [
            "Attr",
            [
              [
                "Attr",
                [
                  [
                    "Attr",
                    [
                      [
                        "Attr",
                        [
                          [ "Id", "data" ],
                          [ "A_string", "terraform_remote_state" ]
                        ]
                      ],
                      [ "A_string", "master" ]
                    ]
                  ],
                  [ "A_string", "outputs" ]
