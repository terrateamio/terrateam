        [
          "Attribute",
          "function_name",
          [
            "Attr",
            [
              [
                "Attr",
                [ [ "Id", "aws_lambda_function" ], [ "A_string", "lambda" ] ]
              ],
              [ "A_string", "function_name" ]
            ]
          ]
        ],
        [ "Attribute", "principal", [ "String", "events.amazonaws.com" ] ],
        [
          "Attribute",
