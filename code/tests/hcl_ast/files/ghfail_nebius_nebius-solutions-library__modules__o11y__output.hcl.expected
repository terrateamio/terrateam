                              "Idx",
                              [
                                [
                                  "Attr",
                                  [
                                    [ "Id", "nebius_iam_v2_access_key" ],
                                    [ "A_string", "grafana_key" ]
                                  ]
                                ],
                                [ "Int", 0 ]
                              ]
                            ],
                            [ "A_string", "status" ]
                          ]
                        ],
                        [ "A_string", "aws_access_key_id" ]
                      ]
                    ]
                  ],
                  [
                    [ "Bare", "secret_access_key" ],
                    [
                      "Attr",
                      [
                        [
                          "Attr",
                          [
                            [
                              "Idx",
                              [
                                [
                                  "Attr",
                                  [
                                    [ "Id", "nebius_iam_v2_access_key" ],
                                    [ "A_string", "grafana_key" ]
                                  ]
                                ],
                                [ "Int", 0 ]
                              ]
                            ],
