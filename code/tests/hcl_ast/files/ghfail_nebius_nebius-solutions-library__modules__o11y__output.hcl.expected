                          ],
                          [ "A_string", "grafana" ]
                        ]
                      ],
                      [ "A_string", "enabled" ]
                    ]
                  ],
                  [
                    "Attr",
                    [
                      [ "Id", "var" ],
                      [ "A_string", "k8s_node_group_sa_enabled" ]
                    ]
                  ]
                ]
              ],
              "then_": [
                "Object",
                [
                  [
                    [ "Bare", "id" ],
                    [
                      "Attr",
                      [
                        [ "Id", "var" ],
                        [ "A_string", "k8s_node_group_sa_id" ]
                      ]
                    ]
                  ],
                  [
