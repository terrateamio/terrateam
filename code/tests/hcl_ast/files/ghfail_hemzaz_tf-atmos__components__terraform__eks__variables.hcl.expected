      "body": [
        [ "Attribute", "type", [ "Id", "number" ] ],
        [
          "Attribute",
          "description",
          [ "String", "Number of days to retain cluster logs" ]
        ],
        [ "Attribute", "default", [ "Int", 90 ] ],
        [
          "Block",
          {
            "type_": "validation",
            "labels": [],
            "body": [
