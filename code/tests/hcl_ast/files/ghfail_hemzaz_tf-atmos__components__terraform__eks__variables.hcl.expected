                            ]
                          ]
                        ]
                      ]
                    ],
                    [
                      "Fun_call",
                      [
                        "contains",
                        [
                          [
                            "Tuple",
                            [
                              [ "Int", 365 ],
                              [ "Int", 400 ],
                              [ "Int", 545 ],
                              [ "Int", 731 ],
                              [ "Int", 1827 ],
                              [ "Int", 3653 ]
                            ]
                          ],
                          [
                            "Attr",
                            [
                              [ "Id", "var" ],
                              [
                                "A_string",
                                "default_cluster_log_retention_days"
