              "input": [
                "Attr",
                [ [ "Id", "var" ], [ "A_string", "components_custom" ] ]
              ],
              "key_output": [
                "Attr", [ [ "Id", "component" ], [ "A_string", "path" ] ]
              ],
              "value_output": [
                "Cond",
                {
                  "if_": [
                    "Gt",
                    [
                      [
                        "Fun_call",
                        [
                          "length",
                          [
                            [
