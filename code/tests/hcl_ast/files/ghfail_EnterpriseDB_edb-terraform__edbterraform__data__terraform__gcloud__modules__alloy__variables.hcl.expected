  [
    "Block",
    {
      "type_": "variable",
      "labels": [ [ "Lit", "settings" ] ],
      "body": [
        [
          "Attribute",
          "type",
          [
            "Fun_call",
            [
              "list",
              [
                [
                  "Fun_call",
                  [
                    "object",
                    [
                      [
                        "Object",
                        [
                          [ [ "Bare", "name" ], [ "Id", "string" ] ],
                          [ [ "Bare", "value" ], [ "Id", "string" ] ]
                        ]
                      ]
                    ]
                  ]
                ]
              ]
            ]
          ]
        ],
        [
          "Block",
          {
            "type_": "validation",
            "labels": [],
            "body": [
              [
                "Attribute",
                "condition",
                [
                  "Fun_call",
                  [
                    "alltrue",
                    [
                      [
                        "For_tuple",
                        {
                          "identifiers": [ "setting", [] ],
                          "input": [
                            "Attr",
                            [ [ "Id", "var" ], [ "A_string", "settings" ] ]
                          ],
                          "output": [
                            "Log_or",
                            [
                              [
                                "Not_equal",
                                [
                                  [
                                    "Attr",
                                    [
                                      [ "Id", "setting" ],
                                      [ "A_string", "name" ]
                                    ]
                                  ],
                                  [ "String", "max_connections" ]
                                ]
                              ],
                              [
                                "Gte",
                                [
                                  [
                                    "Fun_call",
                                    [
                                      "tonumber",
                                      [
                                        [
                                          "Attr",
                                          [
                                            [ "Id", "setting" ],
                                            [ "A_string", "value" ]
                                          ]
                                        ]
                                      ]
                                    ]
                                  ],
                                  [ "Int", 1000 ]
                                ]
                              ]
                            ]
                          ],
                          "cond": null
                        }
                      ]
                    ]
                  ]
                ]
              ],
              [
                "Attribute",
                "error_message",
                [ "String", "max_connections minimum allowed value: 1000" ]
              ]
            ]
          }
        ]
      ]
    }
  ],
