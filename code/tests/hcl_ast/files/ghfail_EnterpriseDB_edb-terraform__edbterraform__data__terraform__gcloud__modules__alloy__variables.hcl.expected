                            [
                              "Attr",
                              [
                                [ "Id", "var" ], [ "A_string", "cpu_count" ]
                              ]
                            ]
                          ]
                        ],
                        [ "Int", 0 ]
                      ]
                    ],
                    [
                      "Gte",
                      [
                        [
                          "Attr",
                          [ [ "Id", "var" ], [ "A_string", "cpu_count" ] ]
                        ],
                        [ "Int", 2 ]
                      ]
                    ]
                  ]
                ]
              ],
              [
