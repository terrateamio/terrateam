                ]
              ],
              "then_": [
                "Fun_call",
                [ "toset", [ [ "Tuple", [ [ "String", "1" ] ] ] ] ]
              ],
              "else_": [ "Fun_call", [ "toset", [ [ "Tuple", [] ] ] ] ]
            }
          ]
        ],
        [ "Attribute", "name", [ "String", "node" ] ],
        [
          "Attribute",
          "location",
          [
            "Attr",
            [
              [
                "Attr",
                [
                  [ "Id", "azurerm_resource_group" ],
                  [ "A_string", "shared" ]
                ]
              ],
              [ "A_string", "location" ]
            ]
          ]
        ],
        [
          "Attribute",
          "resource_group_name",
          [
            "Attr",
            [
              [
                "Attr",
                [
                  [ "Id", "azurerm_resource_group" ],
                  [ "A_string", "shared" ]
                ]
              ],
              [ "A_string", "name" ]
            ]
          ]
        ],
        [ "Attribute", "rule_group_enabled", [ "Bool", true ] ],
        [ "Attribute", "interval", [ "String", "PT1M" ] ],
        [
          "Attribute",
          "scopes",
          [
            "Tuple",
            [
              [
                "Attr",
                [
                  [
                    "Idx",
                    [
                      [
                        "Attr",
                        [
                          [ "Id", "azurerm_monitor_workspace" ],
                          [ "A_string", "prometheus_shared" ]
                        ]
                      ],
                      [ "String", "1" ]
                    ]
                  ],
                  [ "A_string", "id" ]
                ]
              ]
            ]
          ]
        ],
        [
          "Block",
          {
            "type_": "rule",
            "labels": [],
            "body": [
              [ "Attribute", "enabled", [ "Bool", true ] ],
              [
                "Attribute",
                "record",
                [ "String", "instance:node_num_cpu:sum" ]
              ],
              [
                "Attribute",
                "expression",
                [
                  "Heredoc",
                  [
                    "EOF",
                    "\ncount without (cpu, mode) (  node_cpu_seconds_total{job=\"node\",mode=\"idle\"})\n"
                  ]
                ]
              ]
            ]
          }
        ],
        [
          "Block",
          {
            "type_": "rule",
            "labels": [],
            "body": [
              [ "Attribute", "enabled", [ "Bool", true ] ],
              [
                "Attribute",
                "record",
                [ "String", "instance:node_cpu_utilisation:rate5m" ]
              ],
              [
                "Attribute",
                "expression",
                [
                  "Heredoc",
                  [
                    "EOF",
                    "\n1 - avg without (cpu) (  sum without (mode) (rate(node_cpu_seconds_total{job=\"node\", mode=~\"idle|iowait|steal\"}[5m])))\n"
                  ]
                ]
              ]
            ]
          }
        ],
        [
          "Block",
          {
            "type_": "rule",
            "labels": [],
            "body": [
              [ "Attribute", "enabled", [ "Bool", true ] ],
              [
                "Attribute",
                "record",
                [ "String", "instance:node_load1_per_cpu:ratio" ]
              ],
              [
                "Attribute",
                "expression",
                [
                  "Heredoc",
                  [
                    "EOF",
                    "\n(  node_load1{job=\"node\"}/  instance:node_num_cpu:sum{job=\"node\"})\n"
                  ]
                ]
              ]
            ]
          }
        ],
        [
          "Block",
          {
            "type_": "rule",
            "labels": [],
            "body": [
              [ "Attribute", "enabled", [ "Bool", true ] ],
              [
                "Attribute",
                "record",
                [ "String", "instance:node_memory_utilisation:ratio" ]
              ],
              [
                "Attribute",
                "expression",
                [
                  "Heredoc",
                  [
                    "EOF",
                    "\n1 - (  (    node_memory_MemAvailable_bytes{job=\"node\"}    or    (      node_memory_Buffers_bytes{job=\"node\"}      +      node_memory_Cached_bytes{job=\"node\"}      +      node_memory_MemFree_bytes{job=\"node\"}      +      node_memory_Slab_bytes{job=\"node\"}    )  )/  node_memory_MemTotal_bytes{job=\"node\"})\n"
                  ]
                ]
              ]
            ]
          }
        ],
        [
          "Block",
          {
            "type_": "rule",
            "labels": [],
            "body": [
              [ "Attribute", "enabled", [ "Bool", true ] ],
              [
                "Attribute",
                "record",
                [ "String", "instance:node_vmstat_pgmajfault:rate5m" ]
              ],
              [
                "Attribute",
                "expression",
                [
                  "Heredoc",
                  [
                    "EOF",
                    "\nrate(node_vmstat_pgmajfault{job=\"node\"}[5m])\n"
                  ]
                ]
              ]
            ]
          }
        ],
        [
          "Block",
          {
            "type_": "rule",
            "labels": [],
            "body": [
              [ "Attribute", "enabled", [ "Bool", true ] ],
              [
                "Attribute",
                "record",
                [
                  "String",
                  "instance_device:node_disk_io_time_seconds:rate5m"
                ]
              ],
              [
                "Attribute",
                "expression",
                [
                  "Heredoc",
                  [
                    "EOF",
                    "\nrate(node_disk_io_time_seconds_total{job=\"node\", device!=\"\"}[5m])\n"
                  ]
                ]
              ]
            ]
          }
        ],
        [
          "Block",
          {
            "type_": "rule",
            "labels": [],
            "body": [
              [ "Attribute", "enabled", [ "Bool", true ] ],
              [
                "Attribute",
                "record",
                [
                  "String",
                  "instance_device:node_disk_io_time_weighted_seconds:rate5m"
                ]
              ],
              [
                "Attribute",
                "expression",
                [
                  "Heredoc",
                  [
                    "EOF",
                    "\nrate(node_disk_io_time_weighted_seconds_total{job=\"node\", device!=\"\"}[5m])\n"
                  ]
                ]
              ]
            ]
          }
